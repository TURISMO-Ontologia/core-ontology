/VehicleExperienceShape> a sh:NodeShape;  rdfs:label "Experiencia en vehículo"@es, "Vehicle experience"@en;  sh:description "Servicio turístico que ofrece el uso temporal de un vehículo durante un periodo concreto, generalmente vinculado a una actividad recreativa o de ocio."@es,    "Tourism service that provides the temporary use of a vehicle for a specific period, generally linked to a recreational or leisure activity."@en;  sh:name "Experiencia en vehículo"@es, "Vehicle experience"@en;  sh:nodeKind sh:IRI;  sh:targetClass estur:VehicleExperience;  sh:property <http://ontologia.segittur.es/turismo/shapes/VehicleExperienceVehicleExperienceTypeSKOS> .<http://ontologia.segittur.es/turismo/shapes/VehicleExperienceVehicleExperienceTypeSKOS>  a sh:PropertyShape;  rdfs:comment "A list of vehicle types through which specific experiences can be carried out."@en,    "Listado de vehículos con los cuales se pueden realizar determinadas experiencias."@es;  sh:path estur:vehicleExperienceType;  sh:class skos:Concept;  sh:property <http://ontologia.segittur.es/turismo/shapes/VehicleExperienceVehicleExperienceTypeSKOSInScheme>;  sh:severity sh:violation;  sh:message "vehicleExperienceType: The instance of VehicleExperience has a vehicleExperienceType value that is not a SKOS concept."@en .<http://ontologia.segittur.es/turismo/shapes/VehicleExperienceVehicleExperienceTypeSKOSInScheme>  a sh:PropertyShape;  sh:path skos:inScheme;  sh:hasValue <https://ontologia.segittur.es/turismo/kos/VehicleExperienceType>;  sh:severity sh:violation;  sh:message "vehicleExperienceType: The instance of VehicleExperience has a vehicleExperienceType value that is not one of the predefined values and cannot be converted into a SKOS concept on this list: https://ontologia.segittur.es/turismo/kos/VehicleExperienceType."@en .<http://ontologia.segittur.es/turismo/shapes/VehicleRentalAgencyVehicleTypeSKOS> a    sh:PropertyShape;  rdfs:comment "Categories or classifications of vehicles based on their design, size, purpose, and characteristics."@en,    "Categorías o clasificaciones de vehículos según su diseño, tamaño, propósito y características."@es;  sh:path estur:vehicleType;  sh:class skos:Concept;  sh:property <http://ontologia.segittur.es/turismo/shapes/VehicleRentalAgencyVehicleTypeSKOSInScheme>;  sh:severity sh:violation;  sh:message "vehicleType: The instance of VehicleRentalAgency has a vehicleType value that is not a SKOS concept."@en .<http://ontologia.segittur.es/turismo/shapes/VehicleRentalAgencyVehicleTypeSKOSInScheme>  a sh:PropertyShape;  sh:path skos:inScheme;  sh:hasValue <https://ontologia.segittur.es/turismo/kos/VehicleType>;  sh:severity sh:violation;  sh:message "vehicleType: The instance of VehicleRentalAgency has a vehicleType value that is not one of the predefined values and cannot be converted into a SKOS concept on this list: https://ontologia.segittur.es/turismo/kos/VehicleType."@en .<http://ontologia.segittur.es/turismo/shapes/VisibilityShape> a sh:NodeShape;  rdfs:label "Visibilidad"@es, "Visibility"@en;  sh:description "Visibilidad que se puede asociar a cualquier entidad turística, permitiendo determinar su nivel de visibilidad para distintos tipos de criterios (desestacionalización, desaturación, descentralización o general)"@es,    "Visibility that can be associated with any tourism entity, allowing its level of visibility to be determined for different types of criteria (deseasonalization, desaturation, decentralization or general)"@en;  sh:name "Visibilidad"@es, "Visibility"@en;  sh:nodeKind sh:IRI;  sh:targetClass estur:Visibility;  sh:property <http://ontologia.segittur.es/turismo/shapes/VisibilityVisibilityCriteriaSKOS> .<http://ontologia.segittur.es/turismo/shapes/VisibilityVisibilityCriteriaSKOS> a sh:PropertyShape;  rdfs:comment "Criterio de visibilidad para una entidad turística."@es, "Visibility criteria for a tourism entity."@en;  sh:path estur:visibilityCriteria;  sh