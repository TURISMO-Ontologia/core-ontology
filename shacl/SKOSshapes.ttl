@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .@prefix owl: <http://www.w3.org/2002/07/owl#> .@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .@prefix sh: <http://www.w3.org/ns/shacl#> .@prefix skos: <http://www.w3.org/2004/02/skos/core#> .@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .@prefix estur: <https://ontologia.segittur.es/turismo/def/core#> .<http://ontologia.segittur.es/turismo/shapes/AccommodationEstablishmentShape> a sh:NodeShape;  rdfs:label "Accommodation establishment"@en, "Establecimiento alojativo"@es;  sh:description "Establecimiento que ofrece alojamiento turístico."@es, "Establishment providing tourist accommodation."@en;  sh:name "Accommodation establishment"@en, "Establecimiento alojativo"@es;  sh:nodeKind sh:IRI;  sh:targetClass estur:AccommodationEstablishment;  sh:property <http://ontologia.segittur.es/turismo/shapes/AccommodationEstablishmentAccommodationRatingSKOS>,    <http://ontologia.segittur.es/turismo/shapes/AccommodationEstablishmentAccommodationRateTypeSKOS>,    <http://ontologia.segittur.es/turismo/shapes/AccommodationEstablishmentAccommodationUnitCategorySKOS> .<http://ontologia.segittur.es/turismo/shapes/AccommodationEstablishmentAccommodationRatingSKOS>  a sh:PropertyShape;  rdfs:comment "Grading or classification scheme system providing an assessment of the facilities, services or both provided by tourist accommodation. Typically within five categories, often indicated by one to five symbols."@en,    "Sistema de clasificación o categorización que evalúa las instalaciones, los servicios o ambos aspectos de los alojamientos turísticos. Normalmente se divide en cinco categorías, que suelen indicarse con uno a cinco símbolos."@es;  sh:path estur:accommodationRating;  sh:class skos:Concept;  sh:property <http://ontologia.segittur.es/turismo/shapes/AccommodationEstablishmentAccommodationRatingSKOSInScheme>;  sh:severity sh:violation;  sh:message "accommodationRating: The instance of AccommodationEstablishment has a accommodationRating value that is not a SKOS concept."@en .<http://ontologia.segittur.es/turismo/shapes/AccommodationEstablishmentAccommodationRatingSKOSInScheme>  a sh:PropertyShape;  sh:path skos:inScheme;  sh:hasValue <https://ontologia.segittur.es/turismo/kos/AccommodationRatingSystem>;  sh:severity sh:violation;  sh:message "accommodationRating: The instance of AccommodationEstablishment has a accommodationRating value that is not one of the predefined values and cannot be converted into a SKOS concept on this list: https://ontologia.segittur.es/turismo/kos/AccommodationRatingSystem."@en .<http://ontologia.segittur.es/turismo/shapes/RulesAndTipsShape> a sh:NodeShape;  rdfs:label "Reglas y consejos"@es, "Rules and tips"@en;  sh:description "A set of principles, standards and recommendations established by a tourism destination with the aim of ensuring a safe, respectful and satisfying experience for tourists, the local community and the environment."@en,    "Conjunto de principios, normas y recomendaciones que establece un destino turístico con el objetivo de garantizar una experiencia segura, respetuosa y satisfactoria tanto para los turistas como para la comunidad local y el entorno."@es;  sh:name "Reglas y consejos"@es, "Rules and tips"@en;  sh:nodeKind sh:IRI;  sh:targetClass estur:RulesAndTips;  sh:property <http://ontologia.segittur.es/turismo/shapes/RulesAndTipsAdversityTypeSKOS> .<http://ontologia.segittur.es/turismo/shapes/RulesAndTipsAdversityTypeSKOS> a sh:PropertyShape;  rdfs:comment "A situation or event characterized by significant misfortune, lasting over a period of time and involving a varying degree of severity."@en,    "Situación o suceso con un fuerte componente de infortunio, una cierta duración en el tiempo y con un mayor o menor grado de gravedad."@es;  sh:path estur:adversityType;  sh:class skos:Concept;  sh:property <http://ontologia.segittur.es/turismo/shapes/RulesAndTipsAdversityTypeSKOSInScheme>;  sh:severity sh:violation;  sh:message "adversityType: The instance of RulesAndTips has a adversityType value that is not a SKOS concept."@en .<http://ontologia.segittur.es/turismo/shapes/RulesAndTipsAdversityTypeSKOSInScheme>  a sh:PropertyShape;  sh:path skos:inScheme;  sh:hasValue <https://ontologia.segittur.es/turismo/kos/AdversityType>;  sh:severity sh:violation;  sh:message "adversityType: The instance of RulesAndTips has a adversityType value that is not one of the predefined values and cannot be converted into a SKOS concept on this list: https://ontologia.segittur.es/turismo/kos/AdversityType."@en .<http://ontologia.segittur.es/turismo/shapes/AgrotourismExperienceShape> a sh:NodeShape;  rdfs:label "Agrotourism experience"@en, "Experiencia agroturística"@es;  sh:description "Experiences resulting from the provision of tourism services on primary sector exploitations that are compatible with the main production and capable of attracting visitors to whom they can convey satisfying sensations"@en,    "Experiencias resultantes de la prestación de servicios turísticos en explotaciones del sector primario compatibles con la producción principal y capaces de atraer visitantes a los que transmitirles sensaciones satisfactorias."@es;  sh:name "Agrotourism experience"@en, "Experiencia agroturística"@es;  sh:nodeKind sh:IRI;  sh:targetClass estur:AgrotourismExperience;  sh:property <http://ontologia.segittur.es/turismo/shapes/AgrotourismExperienceAgrotourismExperienceRelatedProductSKOS>,    <http://ontologia.segittur.es/turismo/shapes/AgrotourismExperienceAgrotourismExperienceTypeSKOS> .<http://ontologia.segittur.es/turismo/shapes/AgrotourismExperienceAgrotourismExperienceRelatedProductSKOS>  a sh:PropertyShape;  rdfs:comment "An agri-food product linked to an agrotourism experience."@en, "Producto agroalimentario vinculado con una experiencia agroturística."@es;  sh:path estur:agrotourismExperienceRelatedProduct;  sh:class skos:Concept;  sh:property <http://ontologia.segittur.es/turismo/shapes/AgrotourismExperienceAgrotourismExperienceRelatedProductSKOSInScheme>;  sh:severity sh:violation;  sh:message "agrotourismExperienceRelatedProduct: The instance of AgrotourismExperience has a agrotourismExperienceRelatedProduct value that is not a SKOS concept."@en .<http://ontologia.segittur.es/turismo/shapes/AgrotourismExperienceAgrotourismExperienceRelatedProductSKOSInScheme>  a sh:PropertyShape;  sh:path skos:inScheme;  sh:hasValue <https://ontologia.segittur.es/turismo/kos/AgrotourismExperienceRelatedProduct>;  sh:severity sh:violation;  sh:message "agrotourismExperienceRelatedProduct: The instance of AgrotourismExperience has a agrotourismExperienceRelatedProduct value that is not one of the predefined values and cannot be converted into a SKOS concept on this list: https://ontologia.segittur.es/turismo/kos/AgrotourismExperienceRelatedProduct."@en .<http://ontologia.segittur.es/turismo/shapes/AgrotourismExperienceAgrotourismExperienceTypeSKOS>  a sh:PropertyShape;  rdfs:comment "Naturaleza o temática de la experiencia agroturística ofrecida, en función de las actividades desarrolladas."@es,    "Nature or theme of the agrotourism experience offered, based on the activities carried out. "@en;  sh:path estur:agrotourismExperienceType;  sh:class skos:Concept;  sh:property <http://ontologia.segittur.es/turismo/shapes/AgrotourismExperienceAgrotourismExperienceTypeSKOSInScheme>;  sh:severity sh:violation;  sh:message "agrotourismExperienceType: The instance of AgrotourismExperience has a agrotourismExperienceType value that is not a SKOS concept."@en .<http://ontologia.segittur.es/turismo/shapes/AgrotourismExperienceAgrotourismExperienceTypeSKOSInScheme>  a sh:PropertyShape;  sh:path skos:inScheme;  sh:hasValue <https://ontologia.segittur.es/turismo/kos/AgrotourismExperienceType>;  sh:severity sh:violation;  sh:message "agrotourismExperienceType: The instance of AgrotourismExperience has a agrotourismExperienceType value that is not one of the predefined values and cannot be converted into a SKOS concept on this list: https://ontologia.segittur.es/turismo/kos/AgrotourismExperienceType."@en .<http://ontologia.segittur.es/turismo/shapes/BeachShape> a sh:NodeShape;  rdfs:label "Beach"@en, "Playa"@es;  sh:description "Natural or artificial area, formed by sand, gravel, pebble, rock or another material, that facilitates access to the water and the bathing area where leisure activities are carried out and where services are provided."@es,    "Área natural o artificial, formada por arena, grava, guijarros, rocas u otro material, que facilita el acceso al agua y a la zona de baño donde se realizan actividades de ocio y se prestan servicios."@en;  sh:name "Beach"@en, "Playa"@es;  sh:nodeKind sh:IRI;  sh:targetClass estur:Beach;  sh:property <http://ontologia.segittur.es/turismo/shapes/BeachBeachTypeSKOS>, <http://ontologia.segittur.es/turismo/shapes/BeachHasBeachServiceSKOS> .<http://ontologia.segittur.es/turismo/shapes/BeachBeachTypeSKOS> a sh:PropertyShape;  rdfs:comment "Diferentes categorías o clasificaciones que se utilizan para describir y diferenciar las playas según sus características físicas y ambientales."@es,    "Different categories or classifications used to describe and distinguish beaches according to their physical and environmental characteristics."@en;  sh:path estur:beachType;  sh:class skos:Concept;  sh:property <http://ontologia.segittur.es/turismo/shapes/BeachBeachTypeSKOSInScheme>;  sh:severity sh:violation;  sh:message "beachType: The instance of Beach has a beachType value that is not a SKOS concept."@en .<http://ontologia.segittur.es/turismo/shapes/BeachBeachTypeSKOSInScheme> a sh:PropertyShape;  sh:path skos:inScheme;  sh:hasValue <https://ontologia.segittur.es/turismo/kos/BeachType>;  sh:severity sh:violation;  sh:message "beachType: The instance of Beach has a beachType value that is not one of the predefined values and cannot be converted into a SKOS concept on this list: https://ontologia.segittur.es/turismo/kos/BeachType."@en .<http://ontologia.segittur.es/turismo/shapes/ScheduleShape> a sh:NodeShape;  rdfs:label "Programación"@es, "Schedule"@en;  sh:description "Planificación temporal que define cuándo un servicio, evento u oferta se repite o se produce en intervalos específicos."@es,    "Time-based plan that defines when a service, event, or offer occurs repeatedly or at specific intervals."@en;  sh:name "Programación"@es, "Schedule"@en;  sh:nodeKind sh:IRI;  sh:targetClass estur:Schedule;  sh:property <http://ontologia.segittur.es/turismo/shapes/ScheduleByDaySKOS>, <http://ontologia.segittur.es/turismo/shapes/ScheduleByMonthSKOS> .<http://ontologia.segittur.es/turismo/shapes/ScheduleByDaySKOS> a sh:PropertyShape;  rdfs:comment "Indica los días específicos de la semana en los que la programación de un evento, servicio o propuesta especial se realiza de forma recurrente (por ejemplo, lunes y martes)"@es,    "Indicates the specific days of the week on which the schedule for an event, service, or special offer takes place on a recurring basis (for example, Monday and Tuesday)."@en;  sh:path estur:byDay;  sh:class skos:Concept;  sh:property <http://ontologia.segittur.es/turismo/shapes/ScheduleByDaySKOSInScheme>;  sh:severity sh:violation;  sh:message "byDay: The instance of Schedule has a byDay value that is not a SKOS concept."@en .<http://ontologia.segittur.es/turismo/shapes/ScheduleByDaySKOSInScheme> a sh:PropertyShape;  sh:path skos:inScheme;  sh:hasValue <https://ontologia.segittur.es/turismo/kos/DayOfTheWeek>;  sh:severity sh:violation;  sh:message "byDay: The instance of Schedule has a byDay value that is not one of the predefined values and cannot be converted into a SKOS concept on this list: https://ontologia.segittur.es/turismo/kos/DayOfTheWeek."@en .<http://ontologia.segittur.es/turismo/shapes/ScheduleByMonthSKOS> a sh:PropertyShape;  rdfs:comment "Indica el mes o los meses específicos del calendario en los que la programación de un evento, servicio o propuesta especial se realiza de forma recurrente."@es,    "Indicates the specific month or months of the calendar in which the scheduling of an event, service, or special offer takes place on a recurring basis."@en;  sh:path estur:byMonth;  sh:class skos:Concept;  sh:property <http://ontologia.segittur.es/turismo/shapes/ScheduleByMonthSKOSInScheme>;  sh:severity sh:violation;  sh:message "byMonth: The instance of Schedule has a byMonth value that is not a SKOS concept."@en .<http://ontologia.segittur.es/turismo/shapes/ScheduleByMonthSKOSInScheme> a sh:PropertyShape;  sh:path skos:inScheme;  sh:hasValue <https://ontologia.segittur.es/turismo/kos/MonthOfTheYear>;  sh:severity sh:violation;  sh:message "byMonth: The instance of Schedule has a byMonth value that is not one of the predefined values and cannot be converted into a SKOS concept on this list: https://ontologia.segittur.es/turismo/kos/MonthOfTheYear."@en .<http://ontologia.segittur.es/turismo/shapes/CertificationShape> a sh:NodeShape;  rdfs:label "Certificación"@es, "Certification"@en;  sh:description "Certificados que indican el cumplimiento de normas, requisitos, características o exigencias"@es,    "Certificates that indicate compliance with standards, requirements, characteristics or demands"@en;  sh:name "Certificación"@es, "Certification"@en;  sh:nodeKind sh:IRI;  sh:targetClass estur:Certification;  sh:property <http://ontologia.segittur.es/turismo/shapes/CertificationCertificationTypeSKOS> .<http://ontologia.segittur.es/turismo/shapes/CertificationCertificationTypeSKOS> a    sh:PropertyShape;  rdfs:comment "List of relevant national and international tourism certifications for events, destinations, tourism resources, public services, and tourism organisations, including their facilities and services."@en,    "Listado de certificaciones turísticas de referencia en el ámbito nacional e internacional para eventos, destinos, recursos turísticos, servicios públicos y empresas turísticas, incluyendo sus instalaciones y servicios."@es;  sh:path estur:certificationType;  sh:class skos:Concept;  sh:property <http://ontologia.segittur.es/turismo/shapes/CertificationCertificationTypeSKOSInScheme>;  sh:severity sh:violation;  sh:message "certificationType: The instance of Certification has a certificationType value that is not a SKOS concept."@en .<http://ontologia.segittur.es/turismo/shapes/CertificationCertificationTypeSKOSInScheme>  a sh:PropertyShape;  sh:path skos:inScheme;  sh:hasValue <https://ontologia.segittur.es/turismo/kos/CertificationType>;  sh:severity sh:violation;  sh:message "certificationType: The instance of Certification has a certificationType value that is not one of the predefined values and cannot be converted into a SKOS concept on this list: https://ontologia.segittur.es/turismo/kos/CertificationType."@en .<http://ontologia.segittur.es/turismo/shapes/PetAdmissionPolicyShape> a sh:NodeShape;  rdfs:label "Pet admission policy"@en, "Política de admisión de mascotas"@es;  sh:description "Criteria for permitting or restricting pets from entering certain places."@en,    "Criterio de permisión o restricción para el ingreso de mascotas a ciertos lugares."@es;  sh:name "Pet admission policy"@en, "Política de admisión de mascotas"@es;  sh:nodeKind sh:IRI;  sh:targetClass estur:PetAdmissionPolicy;  sh:property <http://ontologia.segittur.es/turismo/shapes/PetAdmissionPolicyCompulsoryZoosanitaryProductSKOS>,    <http://ontologia.segittur.es/turismo/shapes/PetAdmissionPolicySpeciesSKOS> .<http://ontologia.segittur.es/turismo/shapes/PetAdmissionPolicyCompulsoryZoosanitaryProductSKOS>  a sh:PropertyShape;  rdfs:comment "Substances, active ingredients, formulations or preparations intended for the diagnosis, prevention, treatment, alleviation or cure of diseases or ailments in animals, and whose administration is required for admission."@en,    "Sustancias, ingredientes activos, formulaciones o preparados destinados al diagnóstico, prevención, tratamiento, alivio o cura de las enfermedades o dolencias de los animales, y cuya administración es requerida para su admisión."@es;  sh:path estur:compulsoryZoosanitaryProduct;  sh:class skos:Concept;  sh:property <http://ontologia.segittur.es/turismo/shapes/PetAdmissionPolicyCompulsoryZoosanitaryProductSKOSInScheme>;  sh:severity sh:violation;  sh:message "compulsoryZoosanitaryProduct: The instance of PetAdmissionPolicy has a compulsoryZoosanitaryProduct value that is not a SKOS concept."@en .<http://ontologia.segittur.es/turismo/shapes/PetAdmissionPolicyCompulsoryZoosanitaryProductSKOSInScheme>  a sh:PropertyShape;  sh:path skos:inScheme;  sh:hasValue <https://ontologia.segittur.es/turismo/kos/CompulsoryZoosanitaryProduct>;  sh:severity sh:violation;  sh:message "compulsoryZoosanitaryProduct: The instance of PetAdmissionPolicy has a compulsoryZoosanitaryProduct value that is not one of the predefined values and cannot be converted into a SKOS concept on this list: https://ontologia.segittur.es/turismo/kos/CompulsoryZoosanitaryProduct."@en .<http://ontologia.segittur.es/turismo/shapes/OpeningHoursShape> a sh:NodeShape;  rdfs:label "Horario de apertura"@es, "Opening hours"@en;  sh:description "Period of time during which a business, establishment or service is available to serve customers or carry out commercial activities."@en,    "Período de tiempo durante el cual un negocio, establecimiento o servicio está disponible para atender a clientes o realizar actividades comerciales."@es;  sh:name "Horario de apertura"@es, "Opening hours"@en;  sh:nodeKind sh:IRI;  sh:targetClass estur:OpeningHours;  sh:property <http://ontologia.segittur.es/turismo/shapes/OpeningHoursDayOfTheWeekSKOS> .<http://ontologia.segittur.es/turismo/shapes/OpeningHoursDayOfTheWeekSKOS> a sh:PropertyShape;  rdfs:comment "One of the seven named periods (Monday through Sunday) that constitute a standard weekly cycle, used to define recurring time slots."@en,    "Uno de los siete periodos nombrados (de lunes a domingo) que constituyen un ciclo semanal estándar, utilizado para definir franjas horarias recurrentes."@es;  sh:path estur:dayOfTheWeek;  sh:class skos:Concept;  sh:property <http://ontologia.segittur.es/turismo/shapes/OpeningHoursDayOfTheWeekSKOSInScheme>;  sh:severity sh:violation;  sh:message "dayOfTheWeek: The instance of OpeningHours has a dayOfTheWeek value that is not a SKOS concept."@en .<http://ontologia.segittur.es/turismo/shapes/OpeningHoursDayOfTheWeekSKOSInScheme>  a sh:PropertyShape;  sh:path skos:inScheme;  sh:hasValue <https://ontologia.segittur.es/turismo/kos/DayOfTheWeek>;  sh:severity sh:violation;  sh:message "dayOfTheWeek: The instance of OpeningHours has a dayOfTheWeek value that is not one of the predefined values and cannot be converted into a SKOS concept on this list: https://ontologia.segittur.es/turismo/kos/DayOfTheWeek."@en .<http://ontologia.segittur.es/turismo/shapes/TourismDestinationShape> a sh:NodeShape;  rdfs:label "Destino turístico"@es, "Tourism destination"@en;  sh:description "Espacio físico con o sin límites administrativos y/o analíticos en el que un visitante puede pasar la noche, que consiste en una agrupación o coubicación de productos y servicios, así como de actividades y experiencias a lo largo de la cadena de valor del turismo, y que constituye una unidad básica de análisis del turismo. Incorpora a diversas partes interesadas y puede conectarse en red para formar destinos más grandes. También es intangible, con su imagen e identidad, que pueden influir en su competitividad en el mercado."@es,    "Physical space with or without administrative and/or analytical boundaries in which a visitor can spend an overnight, consisting of a clustering or co-location of products and services and of activities and experiences along the tourism value chain and a basic unit of analysis of tourism. It incorporates various stakeholders and can network to form larger destinations. It is also intangible with its image and identity, which can influence its market competitiveness"@en;  sh:name "Destino turístico"@es, "Tourism destination"@en;  sh:nodeKind sh:IRI;  sh:targetClass estur:TourismDestination;  sh:property <http://ontologia.segittur.es/turismo/shapes/TourismDestinationDestinationTypeSKOS> .<http://ontologia.segittur.es/turismo/shapes/TourismDestinationDestinationTypeSKOS>  a sh:PropertyShape;  rdfs:comment "Categorisation of the space according to its main characteristics and attractions."@en,    "Categorización del espacio en función de sus características y atractivos principales."@es;  sh:path estur:destinationType;  sh:class skos:Concept;  sh:property <http://ontologia.segittur.es/turismo/shapes/TourismDestinationDestinationTypeSKOSInScheme>;  sh:severity sh:violation;  sh:message "destinationType: The instance of TourismDestination has a destinationType value that is not a SKOS concept."@en .<http://ontologia.segittur.es/turismo/shapes/TourismDestinationDestinationTypeSKOSInScheme>  a sh:PropertyShape;  sh:path skos:inScheme;  sh:hasValue <https://ontologia.segittur.es/turismo/kos/DestinationType>;  sh:severity sh:violation;  sh:message "destinationType: The instance of TourismDestination has a destinationType value that is not one of the predefined values and cannot be converted into a SKOS concept on this list: https://ontologia.segittur.es/turismo/kos/DestinationType."@en .<http://ontologia.segittur.es/turismo/shapes/EventShape> a sh:NodeShape;  rdfs:label "Event"@en, "Evento"@es;  sh:description "Experience which takes place at a specific time and location."@en,    "Experiencia que tiene lugar en un momento y lugar específicos."@es;  sh:name "Event"@en, "Evento"@es;  sh:nodeKind sh:IRI;  sh:targetClass estur:Event;  sh:property <http://ontologia.segittur.es/turismo/shapes/EventEventTypeSKOS>, <http://ontologia.segittur.es/turismo/shapes/EventHasAdditionalEventServiceSKOS> .<http://ontologia.segittur.es/turismo/shapes/EventEventTypeSKOS> a sh:PropertyShape;  rdfs:comment "Clasificación utilizada para agrupar jerárquicamente los diferentes tipos de eventos que se llevan a cabo en función de su naturaleza o temática."@es,    "Classification used to hierarchically group the different types of events that take place according to their nature or theme."@en;  sh:path estur:eventType;  sh:class skos:Concept;  sh:property <http://ontologia.segittur.es/turismo/shapes/EventEventTypeSKOSInScheme>;  sh:severity sh:violation;  sh:message "eventType: The instance of Event has a eventType value that is not a SKOS concept."@en .<http://ontologia.segittur.es/turismo/shapes/EventEventTypeSKOSInScheme> a sh:PropertyShape;  sh:path skos:inScheme;  sh:hasValue <https://ontologia.segittur.es/turismo/kos/EventType>;  sh:severity sh:violation;  sh:message "eventType: The instance of Event has a eventType value that is not one of the predefined values and cannot be converted into a SKOS concept on this list: https://ontologia.segittur.es/turismo/kos/EventType."@en .<http://ontologia.segittur.es/turismo/shapes/HandicraftsShape> a sh:NodeShape;  rdfs:label "Handicrafts"@en, "Tienda de artesanías"@es;  sh:description "Shop dedicated to the sale of objects or artifacts, done manually or with the use of traditional or rudimentary means, with skill, dexterity, quality and creativity."@en,    "Tienda que se dedica a la venta de objetos o artefactos, realizados manualmente o con medios tradicionales o rudimentarios, con habilidad, destreza, calidad y creatividad."@es;  sh:name "Handicrafts"@en, "Tienda de artesanías"@es;  sh:nodeKind sh:IRI;  sh:targetClass estur:Handicrafts;  sh:property <http://ontologia.segittur.es/turismo/shapes/HandicraftsHandicraftsTypeSKOS> .<http://ontologia.segittur.es/