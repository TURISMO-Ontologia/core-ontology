achHasBeachServiceSKOS> a sh:PropertyShape;  rdfs:comment "Complementary or additional services that may be offered at a beach alongside its main service or activity in order to enhance or improve the user experience."@en,    "Servicios complementarios o adicionales que pueden ofrecerse en una playa junto a su servicio o actividad principal para ampliar o mejorar la experiencia del usuario"@es;  sh:path estur:hasBeachService;  sh:class skos:Concept;  sh:property <http://ontologia.segittur.es/turismo/shapes/BeachHasBeachServiceSKOSInScheme>;  sh:severity sh:violation;  sh:message "hasBeachService: The instance of Beach has a hasBeachService value that is not a SKOS concept."@en .<http://ontologia.segittur.es/turismo/shapes/BeachHasBeachServiceSKOSInScheme> a sh:PropertyShape;  sh:path skos:inScheme;  sh:hasValue <https://ontologia.segittur.es/turismo/kos/BeachService>;  sh:severity sh:violation;  sh:message "hasBeachService: The instance of Beach has a hasBeachService value that is not one of the predefined values and cannot be converted into a SKOS concept on this list: https://ontologia.segittur.es/turismo/kos/BeachService."@en .<http://ontologia.segittur.es/turismo/shapes/LakeShape> a sh:NodeShape;  rdfs:label "Lago"@es, "Lake"@en;  sh:description "Gran masa permanente de agua depositada en depresiones del terreno."@es,    "Large permanent mass of water deposited in depressions in the ground."@en;  sh:name "Lago"@es, "Lake"@en;  sh:nodeKind sh:IRI;  sh:targetClass estur:Lake;  sh:property <http://ontologia.segittur.es/turismo/shapes/LakeHasLakeServiceSKOS> .<http://ontologia.segittur.es/turismo/shapes/LakeHasLakeServiceSKOS> a sh:PropertyShape;  rdfs:comment "Complementary or additional services that may be offered at a lake alongside its main service or activity in order to enhance or improve the user experience."@en,    "Servicios complementarios o adicionales que pueden ofrecerse en un lago junto a su servicio o actividad principal par