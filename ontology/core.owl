        <rdfs:label xml:lang="gl">ten descrición</rdfs:label>
        <rdfs:label xml:lang="es">tiene descripción</rdfs:label>
        <rdfs:label xml:lang="ca">té descripció</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">té descripció</rdfs:label>
        <estur-annot:orderInCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#int">2</estur-annot:orderInCategory>
        <estur-annot:presentationOrderCategory>generalInfo</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


