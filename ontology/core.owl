        <rdfs:comment xml:lang="gl">Necesidade de que os animais usen un dispositivo no fociño para que non mordan.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Necessitat que els animals utilitzen un dispositiu al musell perquè no mosseguin.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Necessitat que els animals utilitzin un dispositiu al musell perquè no mosseguin.</rdfs:comment>
        <rdfs:label xml:lang="gl">esixe o uso de bozo</rdfs:label>
        <rdfs:label xml:lang="es">exige uso de bozal</rdfs:label>
        <rdfs:label xml:lang="ca">exigeix l&apos;ús de morrió</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">exigix l&apos;ús de morrió</rdfs:label>
        <rdfs:label xml:lang="eu">muturrekoa erabiltzea eskatzen du</rdfs:label>
        <rdfs:label xml:lang="en">muzzle wear required</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#name -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#name">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Keyword"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Place"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Promotion"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#RulesAndTips"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismEntity"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="ca">Denominació oficial o comunament acceptada utilitzada per identificar una organització, esdeveniment, servei o punt d&apos;interès turístic.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Denominació oficial o comunament acceptada utilitzada per identificar una organització, esdeveniment, servici o punt d&apos;interès turístic.</rdfs:comment>
        <rdfs:comment xml:lang="es">Denominación oficial o comúnmente aceptada utilizada para identificar una organización, evento, servicio o punto de interés turístico.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Denominación oficial ou comunmente aceptada utilizada para identificar unha organización, evento, servizo ou punto de interese turístico.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Erakunde, ekitaldi, zerbitzu edo interesgune turistiko bat identifikatzeko erabiltzen den izendapen ofiziala edo orokorrean onartua.</rdfs:comment>
        <rdfs:comment xml:lang="en">Official or commonly accepted name used to identify an organisation, event, service or tourism point of interest.</rdfs:comment>
        <rdfs:label xml:lang="eu">izena</rdfs:label>
        <rdfs:label xml:lang="en">name</rdfs:label>
        <rdfs:label xml:lang="ca">nom</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">nom</rdfs:label>
        <rdfs:label xml:lang="es">nombre</rdfs:label>
        <rdfs:label xml:lang="gl">nome</rdfs:label>
        <estur-annot:presentationOrderCategory>generalInfo</estur-annot:presentationOrderCategory>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#nonStretchableLeashRequired -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#nonStretchableLeashRequired">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#PetAdmissionPolicy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="eu">Animaliak luzatu ezin den uhal batekin gidatzeko edo lotzeko beharra.</rdfs:comment>
        <rdfs:comment xml:lang="en">Animals must be led or restrained with a rope that cannot be extended.</rdfs:comment>
        <rdfs:comment xml:lang="es">Necesidad de que los animales sean conducidos o sujetados con una cuerda que no pueda extenderse.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Necesidade de que os animais sexan conducidos ou suxeitados cunha correa que non poida estenderse.</rdfs:comment>
