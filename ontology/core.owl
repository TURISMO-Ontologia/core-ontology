        </rdfs:domain>
        <rdfs:range rdf:resource="https://ontologia.segittur.es/turismo/def/core#Location"/>
        <rdfs:comment xml:lang="eu">Leku baten kokapen fisikoari buruzko informazioa ematen du.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Proporciona informació sobre la ubicació física d&apos;un lloc.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Proporciona informació sobre la ubicació física d&apos;un lloc.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Proporciona información sobre a localización física dun lugar.</rdfs:comment>
        <rdfs:comment xml:lang="es">Proporciona información sobre la ubicación física de un lugar.</rdfs:comment>
        <rdfs:comment xml:lang="en">Provides information about the physical location of a place.</rdfs:comment>
        <rdfs:label xml:lang="en">has location</rdfs:label>
        <rdfs:label xml:lang="eu">kokapena du</rdfs:label>
        <rdfs:label xml:lang="gl">ten localización</rdfs:label>
        <rdfs:label xml:lang="es">tiene localización</rdfs:label>
        <rdfs:label xml:lang="ca">té localització</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">té localització</rdfs:label>
        <estur-annot:orderInCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</estur-annot:orderInCategory>
        <estur-annot:presentationOrderCategory>location</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#hasMultimedia -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#hasMultimedia">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismEntity"/>
        <rdfs:range rdf:resource="https://ontologia.segittur.es/turismo/def/core#Multimedia"/>
        <rdfs:comment xml:lang="en">A digital file containing audio, video, or image content.</rdfs:comment>
        <rdfs:comment xml:lang="es">Archivo digital que contiene audio, vídeo o imágenes.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Audioa, bideoa edo irudiak dituen fitxategi digitala.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Ficheiro dixital que contén audio, vídeo ou imaxes.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Fitxer digital que conté àudio, vídeo o imatges.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Fitxer digital que conté àudio, vídeo o imatges.</rdfs:comment>
        <rdfs:label xml:lang="en">has multimedia</rdfs:label>
        <rdfs:label xml:lang="eu">multimedia du</rdfs:label>
        <rdfs:label xml:lang="gl">ten multimedia</rdfs:label>
        <rdfs:label xml:lang="es">tiene multimedia</rdfs:label>
        <rdfs:label xml:lang="ca">té multimèdia</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">té multimèdia</rdfs:label>
        <estur-annot:orderInCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</estur-annot:orderInCategory>
        <estur-annot:presentationOrderCategory>multimedia</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#hasOpeningHours -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#hasOpeningHours">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#Place"/>
        <rdfs:range rdf:resource="https://ontologia.segittur.es/turismo/def/core#OpeningHours"/>
        <rdfs:comment xml:lang="es">El horario de apertura de un lugar determinado.</rdfs:comment>
        <rdfs:comment xml:lang="ca">L&apos;horari d&apos;obertura d&apos;un lloc determinat.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">L&apos;horari d&apos;obertura d&apos;un lloc determinat.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Leku jakin baten irekiera-ordutegia.</rdfs:comment>
        <rdfs:comment xml:lang="gl">O horario de apertura dun lugar determinado.</rdfs:comment>
        <rdfs:comment xml:lang="en">The opening hours of a certain place.</rdfs:comment>
        <rdfs:label xml:lang="en">has opening hours</rdfs:label>
        <rdfs:label xml:lang="eu">irekiera-ordutegia du</rdfs:label>
        <rdfs:label xml:lang="gl">ten horario de apertura</rdfs:label>
        <rdfs:label xml:lang="es">tiene horario de apertura</rdfs:label>
        <rdfs:label xml:lang="ca">té horari d&apos;obertura</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">té horari d&apos;obertura</rdfs:label>
        <estur-annot:orderInCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</estur-annot:orderInCategory>
        <estur-annot:presentationOrderCategory>generalInfo</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#hasPriceClass -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#hasPriceClass">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#AdventureActivity"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#AgrotourismExperience"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Tour"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#VehicleExperience"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/PriceClass"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">A range of prices at which products or services are offered, allowing them to be classified into different segments within a given market or industry.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Produktuak edo zerbitzuak eskaintzen diren prezio-tartea, merkatu edo industria jakin bateko segmentuetan sailkatzeko aukera ematen duena.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Rang de preus en què s&apos;ofereixen productes o serveis que permet classificar-los en diferents segments dins d&apos;un mercat o indústria determinats.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Rang de preus en què s&apos;oferixen productes o servicis que permet classificar-los en diferents segments dins d&apos;un mercat o indústria determinats.</rdfs:comment>
        <rdfs:comment xml:lang="es">Rango de precios en el que se ofrecen productos o servicios que permiten clasificarlos en diferentes segmentos dentro de un determinado mercado o industria.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Rango de prezos no que se ofrecen produtos ou servizos que permite clasificalos en diferentes segmentos dentro dun determinado mercado ou industria.</rdfs:comment>
        <rdfs:label xml:lang="es">gama de precios</rdfs:label>
        <rdfs:label xml:lang="gl">gama de prezos</rdfs:label>
        <rdfs:label xml:lang="ca">gamma de preus</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">gamma de preus</rdfs:label>
        <rdfs:label xml:lang="en">has price class</rdfs:label>
        <rdfs:label xml:lang="eu">prezio-gama</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#hasPriceSpecification -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#hasPriceSpecification">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#BicycleSharingSystem"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Event"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#ParkingFacility"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#SpecialOffer"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismService"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://ontologia.segittur.es/turismo/def/core#PriceSpecification"/>
        <rdfs:comment xml:lang="en">A structured definition of the cost associated with a tourism offering, including amount, currency, validity period, and applicable taxes or fees.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Definició estructurada del cost associat a una prestació turística, incloent-hi l&apos;import, la divisa, la validesa i els impostos o taxes aplicables.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Definició estructurada del cost associat a una prestació turística, incloent-hi l&apos;import, la divisa, la validesa i els impostos o taxes aplicables.</rdfs:comment>
        <rdfs:comment xml:lang="es">Definición estructurada del coste asociado a una prestación turística, incluyendo el importe, la divisa, la validez y los impuestos o tasas aplicables.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Definición estruturada do custo asociado a unha prestación turística, incluídos o importe, a divisa, a validez e os impostos ou taxas aplicables.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Turismo-prestazio bati lotutako kostuaren definizio egituratua, zenbatekoa, dibisa, baliozkotasuna eta aplikatu beharreko zergak edo tasak barne.</rdfs:comment>
        <rdfs:label xml:lang="en">has price specification</rdfs:label>
        <rdfs:label xml:lang="eu">prezioaren zehaztapena du</rdfs:label>
        <rdfs:label xml:lang="gl">ten especificación do prezo</rdfs:label>
        <rdfs:label xml:lang="es">tiene especificación del precio</rdfs:label>
        <rdfs:label xml:lang="ca">té especificació del preu</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">té especificació del preu</rdfs:label>
        <estur-annot:orderInCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</estur-annot:orderInCategory>
        <estur-annot:presentationOrderCategory>contact</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#hasRiverService -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#hasRiverService">
        <rdfs:subPropertyOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalService"/>
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#River"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/RiverService"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Complementary or additional services that may be offered at a river alongside its main service or activity in order to enhance or improve the user experience.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ibai batean zerbitzu edo jarduera nagusiarekin batera eskain daitezkeen zerbitzu osagarri edo gehigarriak, erabiltzailearen esperientzia zabaltzeko edo hobetzeko.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Serveis complementaris o addicionals que es poden oferir en un riu juntament amb el seu servei o activitat principal per ampliar o millorar l&apos;experiència de l&apos;usuari.</rdfs:comment>
        <rdfs:comment xml:lang="es">Servicios complementarios o adicionales que pueden ofrecerse en un río junto a su servicio o actividad principal para ampliar o mejorar la experiencia del usuario.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Servicis complementaris o addicionals que es poden oferir en un riu juntament amb el seu servici o activitat principal per ampliar o millorar l&apos;experiència de l&apos;usuari.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Servizos complementarios ou adicionais que poden ofrecerse nun río xunto co seu servizo ou actividade principal para ampliar ou mellorar a experiencia do usuario.</rdfs:comment>
        <rdfs:label xml:lang="en">has river service</rdfs:label>
        <rdfs:label xml:lang="eu">ibaiko zerbitzuak ditu</rdfs:label>
        <rdfs:label xml:lang="gl">ten servizos de río</rdfs:label>
        <rdfs:label xml:lang="es">tiene servicios de río</rdfs:label>
        <rdfs:label xml:lang="ca">té serveis de riu</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">té servicis de riu</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#hasRulesAndTips -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#hasRulesAndTips">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Route"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismDestination"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://ontologia.segittur.es/turismo/def/core#RulesAndTips"/>
        <rdfs:comment xml:lang="en">A set of principles, standards and recommendations established by a tourism destination with the aim of ensuring a safe, respectful and satisfying experience for tourists, the local community and the environment.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Conjunt de principis, normes i recomanacions que estableix una destinació turística amb l&apos;objectiu de garantir una experiència segura, respectuosa i satisfactòria tant per als turistes com per a la comunitat local i l&apos;entorn.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Conjunt de principis, normes i recomanacions que establix una destinació turística amb l&apos;objectiu de garantir una experiència segura, respectuosa i satisfactòria tant per als turistes com per a la comunitat local i l&apos;entorn.</rdfs:comment>
        <rdfs:comment xml:lang="es">Conjunto de principios, normas y recomendaciones que establece un destino turístico con el objetivo de garantizar una experiencia segura, respetuosa y satisfactoria tanto para los turistas como para la comunidad local y el entorno.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Conxunto de principios, normas e recomendacións que establece un destino turístico co obxectivo de garantir unha experiencia segura, respectuosa e satisfactoria tanto para os turistas como para a comunidade local e o contorno.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Helmuga turistiko batek ezartzen dituen printzipio, arau eta gomendioen multzoa, turistentzat zein tokiko komunitatearentzat eta ingurunearentzat esperientzia segurua, errespetuzkoa eta gogobetegarria bermatzeko helburuarekin.</rdfs:comment>
        <rdfs:label xml:lang="eu">arauak eta aholkuak ditu</rdfs:label>
        <rdfs:label xml:lang="en">has rules and tips</rdfs:label>
        <rdfs:label xml:lang="gl">ten regras e consellos</rdfs:label>
        <rdfs:label xml:lang="es">tiene reglas y consejos</rdfs:label>
        <rdfs:label xml:lang="ca">té regles i consells</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">té regles i consells</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#hasSocialMediaProfile -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#hasSocialMediaProfile">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Event"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismDestination"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrganisation"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismResource"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://ontologia.segittur.es/turismo/def/core#SocialMediaProfile"/>
        <rdfs:comment xml:lang="ca">Comptes individuals o d&apos;empreses creats en plataformes digitals dissenyades per a la interacció social. Permeten a les persones i organitzacions compartir informació, publicar contingut, interactuar amb altres usuaris i construir una presència en línia.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Comptes individuals o d&apos;empreses creats en plataformes digitals dissenyades per a la interacció social. Permeten a les persones i organitzacions compartir informació, publicar contingut, interactuar amb altres usuaris i construir una presència en línia.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Contas individuais ou de empresas creadas en plataformas dixitais deseñadas para a interacción social. Permiten ás persoas e organizacións compartir información, publicar contido, interactuar con outros usuarios e construír unha presenza en liña.</rdfs:comment>
        <rdfs:comment xml:lang="es">Cuentas individuales o de empresas creadas en plataformas digitales diseñadas para la interacción social. Permiten a las personas y organizaciones compartir información, publicar contenido, interactuar con otros usuarios y construir una presencia en línea.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Gizarte-harremanetarako diseinatutako plataforma digitaletan sortutako banakako edo enpresetako kontuak. Pertsonei eta erakundeei informazioa partekatzeko, edukiak argitaratzeko, beste erabiltzaileekin elkarreragiteko eta sareko presentzia eraikitzeko aukera ematen diete.</rdfs:comment>
        <rdfs:comment xml:lang="en">Individual or company accounts created on digital platforms designed for social interaction. They allow individuals and organisations to share information, publish content, interact with other users and build an online presence.</rdfs:comment>
        <rdfs:label xml:lang="en">has social media profile</rdfs:label>
        <rdfs:label xml:lang="eu">sare sozialetako profila du</rdfs:label>
        <rdfs:label xml:lang="gl">ten perfil de redes sociais</rdfs:label>
        <rdfs:label xml:lang="es">tiene perfil de redes sociales</rdfs:label>
        <rdfs:label xml:lang="ca">té perfil de xarxes socials</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">té perfil de xarxes socials</rdfs:label>
        <estur-annot:orderInCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</estur-annot:orderInCategory>
        <estur-annot:presentationOrderCategory>contact</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#hasSubEvent -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#hasSubEvent">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#Event"/>
        <rdfs:range rdf:resource="https://ontologia.segittur.es/turismo/def/core#Event"/>
        <rdfs:comment xml:lang="eu">Ekitaldi bat edo gehiago ekitaldi honen parte direla adierazten duen erlazioa.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Relació que indica que un o diversos esdeveniments formen part d&apos;aquest esdeveniment.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Relació que indica que un o diversos esdeveniments formen part d&apos;este esdeveniment.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Relación que indica que un ou varios eventos forman parte deste evento.</rdfs:comment>
        <rdfs:comment xml:lang="es">Relación que indica que uno o varios eventos forman parte de este evento.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relationship indicating that one or more events are part of this event.</rdfs:comment>
        <rdfs:label xml:lang="eu">azpiekitaldia du</rdfs:label>
        <rdfs:label xml:lang="en">has subevent</rdfs:label>
        <rdfs:label xml:lang="gl">ten subevento</rdfs:label>
        <rdfs:label xml:lang="es">tiene subevento</rdfs:label>
        <rdfs:label xml:lang="ca">té subesdeveniment</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">té subesdeveniment</rdfs:label>
        <estur-annot:orderInCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</estur-annot:orderInCategory>
        <estur-annot:presentationOrderCategory>acknowledgement</estur-annot:presentationOrderCategory>
        <estur-annot:tooltip xml:lang="en">Points out events that are part of this event.</estur-annot:tooltip>
        <estur-annot:tooltip xml:lang="es">Señala eventos que forman parte de este evento</estur-annot:tooltip>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#hasSuperEvent -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#hasSuperEvent">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#Event"/>
        <rdfs:range rdf:resource="https://ontologia.segittur.es/turismo/def/core#Event"/>
        <rdfs:comment xml:lang="eu">Ekitaldi bat maila handiagoko ekitaldi baten edo ekitaldi nagusi baten parte dela adierazten duen erlazioa.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Relació que indica que un esdeveniment forma part d&apos;un esdeveniment de nivell superior o esdeveniment principal.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Relació que indica que un esdeveniment forma part d&apos;un esdeveniment de nivell superior o esdeveniment principal.</rdfs:comment>
        <rdfs:comment xml:lang="es">Relación que indica que un evento forma parte de un evento de mayor nivel o evento principal.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Relación que indica que un evento forma parte dun evento de maior nivel ou evento principal.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relationship that indicates that the event is part of a higher-level or main event.</rdfs:comment>
        <rdfs:label xml:lang="eu">goi-mailako ekitaldia du</rdfs:label>
        <rdfs:label xml:lang="en">has super event</rdfs:label>
        <rdfs:label xml:lang="gl">ten superevento</rdfs:label>
        <rdfs:label xml:lang="es">tiene superevento</rdfs:label>
        <rdfs:label xml:lang="ca">té esdeveniment superior</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">té esdeveniment superior</rdfs:label>
        <estur-annot:orderInCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</estur-annot:orderInCategory>
        <estur-annot:presentationOrderCategory>acknowledgement</estur-annot:presentationOrderCategory>
        <estur-annot:tooltip xml:lang="es">Especifica el evento del que forma parte este subevento</estur-annot:tooltip>
        <estur-annot:tooltip xml:lang="en">Specifies the event of which this sub-event is part</estur-annot:tooltip>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#hasTag -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#hasTag">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Event"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Route"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#SpecialOffer"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismDestination"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismIntermediary"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismService"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/Tag"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="ca">Conjunt d&apos;etiquetes utilitzades per classificar i descriure de manera sintètica característiques, temàtiques, atributs o enfocaments experiencials associats a un element.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Conjunt d&apos;etiquetes utilitzades per classificar i descriure de manera sintètica característiques, temàtiques, atributs o enfocaments experiencials associats a un element.</rdfs:comment>
        <rdfs:comment xml:lang="es">Conjunto de etiquetas utilizadas para clasificar y describir de forma sintética características, temáticas, atributos o enfoques experienciales asociados a un elemento.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Conxunto de etiquetas utilizadas para clasificar e describir de forma sintética características, temáticas, atributos ou enfoques experienciais asociados a un elemento.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Elementu bati lotutako ezaugarriak, gaiak, atributuak edo esperientzia-ikuspegiak labur sailkatzeko eta deskribatzeko erabiltzen diren etiketen multzoa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Set of tags used to classify and describe, in a transversal manner, characteristics, themes, attributes or experiential approaches associated with an item.</rdfs:comment>
        <rdfs:label xml:lang="eu">etiketa du</rdfs:label>
        <rdfs:label xml:lang="en">has tag</rdfs:label>
        <rdfs:label xml:lang="gl">ten etiqueta</rdfs:label>
        <rdfs:label xml:lang="es">tiene etiqueta</rdfs:label>
        <rdfs:label xml:lang="ca">té etiqueta</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">té etiqueta</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#hasTimeSlot -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#hasTimeSlot">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#OpeningHours"/>
        <rdfs:range rdf:resource="https://ontologia.segittur.es/turismo/def/core#TimeSlot"/>
        <rdfs:comment xml:lang="ca">Interval temporal que defineix un període continu d&apos;obertura, delimitat per una hora d&apos;inici i una hora de finalització, i utilitzat per descriure trams horaris dins d&apos;un dia concret.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Interval temporal que definix un període continu d&apos;obertura, delimitat per una hora d&apos;inici i una hora de finalització, i utilitzat per descriure trams horaris dins d&apos;un dia concret.</rdfs:comment>
        <rdfs:comment xml:lang="es">Intervalo temporal que define un periodo continuo de apertura, delimitado por una hora de inicio y una hora de finalización, y utilizado para describir tramos horarios dentro de un día concreto.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Intervalo temporal que define un período continuo de apertura, delimitado por unha hora de inicio e unha hora de finalización, e utilizado para describir tramos horarios dentro dun día concreto.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Irekita egoteko aldi jarraitu bat zehazten duen denbora-tartea, hasiera-ordu batek eta amaiera-ordu batek mugatua, egun jakin bateko ordutegi-tarteak deskribatzeko erabiltzen dena.</rdfs:comment>
        <rdfs:comment xml:lang="en">Time interval that defines a continuous period of opening, delimited by a start time and an end time, and used to describe time ranges within a specific day.</rdfs:comment>
        <rdfs:label xml:lang="en">has time slot</rdfs:label>
        <rdfs:label xml:lang="eu">ordutegi-tartea du</rdfs:label>
        <rdfs:label xml:lang="gl">ten franxa horaria</rdfs:label>
        <rdfs:label xml:lang="es">tiene franja horaria</rdfs:label>
        <rdfs:label xml:lang="ca">té franja horària</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">té franja horària</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#hasTourismOrRelatedFacility -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#hasTourismOrRelatedFacility">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#AccommodationCompany"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#ComplementaryActivitiesCompany"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#EventOrganisationCompany"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#PassengerTransportCompany"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#RestaurantCompany"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismIntermediary"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
        <rdfs:comment xml:lang="es">Asocia una organización con una instalación turística o vinculada.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Asocia unha organización cunha instalación turística ou vinculada.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Associa una organització amb una instal·lació turística o vinculada.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Associa una organització amb una instal·lació turística o vinculada.</rdfs:comment>
        <rdfs:comment xml:lang="en">Associates an organisation with a tourism or related facility.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Erakunde bat turismo-instalazio edo hari lotutako instalazio batekin lotzen du.</rdfs:comment>
        <rdfs:label xml:lang="en">has tourism or related facility</rdfs:label>
        <rdfs:label xml:lang="eu">lotutako baliabidea edo instalazioa du</rdfs:label>
        <rdfs:label xml:lang="gl">ten recurso ou instalación asociada</rdfs:label>
        <rdfs:label xml:lang="es">tiene recurso o instalación asociada</rdfs:label>
        <rdfs:label xml:lang="ca">té recurs o instal·lació associada</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">té recurs o instal·lació associada</rdfs:label>
        <estur-annot:orderInCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</estur-annot:orderInCategory>
        <estur-annot:presentationOrderCategory>acknowledgement</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#historicalOrCulturalResourceContains -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#historicalOrCulturalResourceContains">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#OldTown"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Quarter"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Square"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="eu">Baliabide historiko edo kultural batek izan ditzakeen turismo-instalazioak edo haiei lotutako instalazioak eta baliabide historiko edo kulturalak adierazten ditu.</rdfs:comment>
        <rdfs:comment xml:lang="es">Indica instalaciones turísticas o vinculadas, y recursos históricos o culturales que un recurso histórico o cultural puede contener.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Indica instalacións turísticas ou vinculadas, e recursos históricos ou culturais que un recurso histórico ou cultural pode conter.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Indica instal·lacions turístiques o vinculades, i recursos històrics o culturals que pot contenir un recurs històric o cultural.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Indica instal·lacions turístiques o vinculades, i recursos històrics o culturals que pot contenir un recurs històric o cultural.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates tourism or related facilities, and historical or cultural resources that a historical or cultural resource may contain.</rdfs:comment>
        <rdfs:label xml:lang="eu">baliabide historiko edo kulturalak dauka</rdfs:label>
        <rdfs:label xml:lang="ca">el recurs històric o cultural conté</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">el recurs històric o cultural conté</rdfs:label>
        <rdfs:label xml:lang="en">historical or cultural resource contains</rdfs:label>
        <rdfs:label xml:lang="gl">o recurso histórico ou cultural contén</rdfs:label>
        <rdfs:label xml:lang="es">recurso histórico o cultural contiene</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
        <estur-annot:tooltip xml:lang="es">Indica instalaciones turísticas o vinculadas, y recursos históricos o culturales que un recurso histórico o cultural puede contener.</estur-annot:tooltip>
        <estur-annot:tooltip xml:lang="en">Indicates tourist or related facilities, and historical or cultural resources that a historical or cultural resource may contain</estur-annot:tooltip>
    </owl:ObjectProperty>
    


