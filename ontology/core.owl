        <rdfs:label xml:lang="ca">punt d&apos;interès de referència</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">punt d&apos;interès de referència</rdfs:label>
        <rdfs:label xml:lang="gl">punto de interese de referencia</rdfs:label>
        <rdfs:label xml:lang="es">punto de interés de referencia</rdfs:label>
        <rdfs:label xml:lang="en">reference point of interest</rdfs:label>
