        <rdfs:label xml:lang="ca-valencia">té servici addicional de la instal·lació de lleure i cultura</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
        <estur-annot:visibleResource xml:lang="en">has additional leisure and culture facility service</estur-annot:visibleResource>
    </owl:ObjectProperty>
    


