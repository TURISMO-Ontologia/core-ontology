    <!-- https://ontologia.segittur.es/turismo/def/core#Palace -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Palace">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">A large and luxurious residence intended for kings, aristocrats, or other prominent figures.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Erregeen, aristokraten edo pertsonaia garrantzitsuen bizileku izateko etxe handi eta luxuzkoa.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Mansió gran i luxosa destinada a ser residència de reis, aristòcrates o personatges importants.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Mansió gran i luxosa destinada a ser residència de reis, aristòcrates o personatges importants.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Mansión grande e luxosa destinada a ser residencia de reis, aristócratas ou personaxes importantes.</rdfs:comment>
        <rdfs:comment xml:lang="es">Mansión grande y lujosa destinada a ser residencia de reyes, de aristócratas o de personajes importantes.</rdfs:comment>
        <rdfs:label xml:lang="eu">Jauregia</rdfs:label>
        <rdfs:label xml:lang="en">Palace</rdfs:label>
        <rdfs:label xml:lang="es">Palacio</rdfs:label>
        <rdfs:label xml:lang="gl">Palacio</rdfs:label>
        <rdfs:label xml:lang="ca">Palau</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Palau</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#ParcelAndCourier -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#ParcelAndCourier">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#MiscellaneousBusiness"/>
        <rdfs:comment xml:lang="eu">Enpresa batek gutunak eta paketeak banatzeko ematen duen zerbitzua.</rdfs:comment>
        <rdfs:comment xml:lang="en">Mail and package delivery service carried out by a company.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Servei de repartiment de correspondència i paquets fet per una empresa.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Servici de repartiment de correspondència i paquets fet per una empresa.</rdfs:comment>
        <rdfs:comment xml:lang="es">Servicio de reparto de correspondencia y de paquetes realizado por una empresa.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Servizo de repartición de correspondencia e paquetes realizado por unha empresa.</rdfs:comment>
        <rdfs:label xml:lang="eu">Paketeria eta mezularitza</rdfs:label>
        <rdfs:label xml:lang="gl">Paquetaría e mensaxaría</rdfs:label>
        <rdfs:label xml:lang="ca">Paqueteria i missatgeria</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Paqueteria i missatgeria</rdfs:label>
        <rdfs:label xml:lang="es">Paquetería y mensajería</rdfs:label>
        <rdfs:label xml:lang="en">Parcel and courier</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#ParkingFacility -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#ParkingFacility">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TransportInfrastructure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasPriceSpecification"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#PriceSpecification"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#disabledParking"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#isIndoorParking"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Ibilgailuak aparkatzeko lekua edo esparrua.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Lloc o recinte destinat a aparcar vehicles.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Lloc o recinte destinat a aparcar vehicles.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugar o recinto destinado a aparcar vehículos.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugar ou recinto destinado a aparcar vehículos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Place or area intended for parking vehicles.</rdfs:comment>
        <rdfs:label xml:lang="gl">Aparcadoiro</rdfs:label>
        <rdfs:label xml:lang="ca">Aparcament</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Aparcament</rdfs:label>
        <rdfs:label xml:lang="es">Aparcamiento</rdfs:label>
        <rdfs:label xml:lang="eu">Aparkalekua</rdfs:label>
        <rdfs:label xml:lang="en">Parking facility</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#PartyAndEntertainmentFacility -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#PartyAndEntertainmentFacility">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalPartyAndEntertainmentFacilityService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalTourismOrRelatedFacilityService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Espacios destinados a la diversión, celebración y entretenimiento de las personas, diseñados para ofrecer experiencias sociales y recreativas a través de música, baile, bebidas, espectáculos en vivo y actividades temáticas o lúdicas.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espais destinats a la diversió, la celebració i l&apos;entreteniment de les persones, dissenyats per oferir experiències socials i recreatives a través de música, ball, begudes, espectacles en viu i activitats temàtiques o lúdiques.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espais destinats a la diversió, la celebració i l&apos;entreteniment de les persones, dissenyats per oferir experiències socials i recreatives a través de música, ball, begudes, espectacles en viu i activitats temàtiques o lúdiques.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazos destinados á diversión, á celebración e ao entretemento das persoas, deseñados para ofrecer experiencias sociais e recreativas a través de música, baile, bebidas, espectáculos en directo e actividades temáticas ou lúdicas.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Pertsonak dibertitzeko, ospatzeko eta entretenitzeko espazioak, musikaren, dantzaren, edarien, zuzeneko ikuskizunen eta gaikako edo jolas-jardueren bidez gizarte- eta jolas-esperientziak eskaintzeko diseinatuak.</rdfs:comment>
        <rdfs:comment xml:lang="en">Spaces intended for fun, celebration and entertainment of people, designed to offer social and recreational experiences through music, dance, drinks, live shows and thematic or recreational activities.</rdfs:comment>
        <rdfs:label xml:lang="gl">Instalación para festas e entretemento</rdfs:label>
        <rdfs:label xml:lang="es">Instalación para fiestas y entretenimiento</rdfs:label>
        <rdfs:label xml:lang="ca">Instal·lació per a festes i entreteniment</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Instal·lació per a festes i entreteniment</rdfs:label>
        <rdfs:label xml:lang="eu">Jaietarako eta entretenimendurako instalazioa</rdfs:label>
        <rdfs:label xml:lang="en">Party and entertainment facility</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#PassengerTransportCompany -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#PassengerTransportCompany">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrganisation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasTourismOrRelatedFacility"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#offers"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#TransportService"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Empresa dedicada al desplazamiento de personas y sus equipajes en vehículos construidos y acondicionados para tal fin.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Empresa dedicada al desplaçament de persones i els seus equipatges en vehicles construïts i condicionats amb aquesta finalitat.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Empresa dedicada al desplaçament de persones i els seus equipatges en vehicles construïts i condicionats amb esta finalitat.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Empresa dedicada ao desprazamento de persoas e das súas equipaxes en vehículos construídos e acondicionados para tal fin.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Pertsonak eta haien ekipajeak horretarako eraiki eta egokitutako ibilgailuetan lekualdatzen dituen enpresa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Tourism organisation dedicated to transporting people and their luggage in vehicles built and equipped for this purpose.</rdfs:comment>
        <rdfs:label xml:lang="eu">Bidaiariak garraiatzeko konpainia</rdfs:label>
        <rdfs:label xml:lang="ca">Companyia de transport de viatgers</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Companyia de transport de viatgers</rdfs:label>
        <rdfs:label xml:lang="es">Compañía de transporte de viajeros</rdfs:label>
        <rdfs:label xml:lang="gl">Compañía de transporte de viaxeiros</rdfs:label>
        <rdfs:label xml:lang="en">Passenger transport company</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Perfumery -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Perfumery">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#RetailAndFashionBusiness"/>
