    <!-- https://ontologia.segittur.es/turismo/def/core#logo -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#logo">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#Multimedia"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="eu">Turismo-entitate baten nortasuna bisualki irudikatzeko erabiltzen den irudi-fitxategirako URLa, haren ezagutza eta aurkezpena errazten dituena.</rdfs:comment>
        <rdfs:comment xml:lang="es">URL que enlaza al archivo de imagen utilizado para representar visualmente la identidad de una entidad turística, facilitando su reconocimiento y presentación.</rdfs:comment>
        <rdfs:comment xml:lang="gl">URL que enlaza co ficheiro de imaxe utilizado para representar visualmente a identidade dunha entidade turística, facilitando o seu recoñecemento e presentación.</rdfs:comment>
        <rdfs:comment xml:lang="ca">URL que enllaça amb el fitxer d&apos;imatge utilitzat per representar visualment la identitat d&apos;una entitat turística, facilitant-ne el reconeixement i la presentació.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">URL que enllaça amb el fitxer d&apos;imatge utilitzat per representar visualment la identitat d&apos;una entitat turística, facilitant-ne el reconeixement i la presentació.</rdfs:comment>
        <rdfs:comment xml:lang="en">URL that links to the image file used to visually represent the identity of a tourism entity, facilitating its recognition and presentation.</rdfs:comment>
        <rdfs:label xml:lang="en">logo</rdfs:label>
        <rdfs:label xml:lang="es">logo</rdfs:label>
        <rdfs:label xml:lang="ca">logotip</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">logotip</rdfs:label>
        <rdfs:label xml:lang="gl">logotipo</rdfs:label>
        <rdfs:label xml:lang="eu">logotipoa</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#longDescription -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#longDescription">
