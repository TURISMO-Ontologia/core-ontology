        <rdfs:comment xml:lang="es">Hora de cierre de un recurso o servicio</rdfs:comment>
        <rdfs:comment xml:lang="gl">Hora de peche dun recurso ou servizo</rdfs:comment>
        <rdfs:comment xml:lang="ca">Hora de tancament d&apos;un recurs o servei</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Hora de tancament d&apos;un recurs o servici</rdfs:comment>
        <rdfs:label xml:lang="en">closes at</rdfs:label>
        <rdfs:label xml:lang="es">hora de cierre</rdfs:label>
        <rdfs:label xml:lang="gl">hora de peche</rdfs:label>
        <rdfs:label xml:lang="ca">hora de tancament</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">hora de tancament</rdfs:label>
        <rdfs:label xml:lang="eu">itxiera-ordua</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#conditions -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#conditions">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#AdditionalInformation"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#PetAdmissionPolicy"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="ca">Circumstàncies o requisits específics que s&apos;han de complir perquè alguna cosa succeeixi o es dugui a terme adequadament.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Circumstàncies o requisits específics que s&apos;han de complir perquè alguna cosa succeïsca o es dugui a terme adequadament.</rdfs:comment>
        <rdfs:comment xml:lang="es">Circunstancias o requisitos específicos que deben cumplirse para que algo suceda o se lleve a cabo de manera adecuada.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Circunstancias ou requisitos específicos que deben cumprirse para que algo suceda ou se leve a cabo de maneira adecuada.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specific circumstances or requirements that must be met for something to occur or be carried out properly.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Zerbait gertatzeko edo behar bezala egiteko bete behar diren inguruabar edo betekizun zehatzak.</rdfs:comment>
        <rdfs:label xml:lang="eu">baldintzak</rdfs:label>
        <rdfs:label xml:lang="es">condiciones</rdfs:label>
        <rdfs:label xml:lang="ca">condicions</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">condicions</rdfs:label>
        <rdfs:label xml:lang="gl">condicións</rdfs:label>
        <rdfs:label xml:lang="en">conditions</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#country -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#country">
