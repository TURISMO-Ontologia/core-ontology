    <!-- https://ontologia.segittur.es/turismo/def/core#hasLocation -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#hasLocation">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#DestinationExperience"/>
