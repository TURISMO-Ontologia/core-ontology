    <!-- http://www.openlinksw.com/schemas/virtrdf#Geometry -->

    <rdfs:Datatype rdf:about="http://www.openlinksw.com/schemas/virtrdf#Geometry"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#time -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#time"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2004/02/skos/core#inScheme -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#inScheme"/>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#accommodationRateType -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#accommodationRateType">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#LodgingService"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/AccommodationRateType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="eu">Ostatu-establezimenduei eta ostatu-zerbitzuei berariaz aplikatzen zaizkien tarifak.</rdfs:comment>
        <rdfs:comment xml:lang="en">Rates applicable specifically to accommodation establishments and lodging services.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Tarifas aplicables especificamente a establecementos de aloxamento e servizos de hospedaxe.</rdfs:comment>
        <rdfs:comment xml:lang="es">Tarifas aplicables específicamente a establecimientos alojativos y servicios de hospedaje.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Tarifes aplicables específicament a establiments d&apos;allotjament i serveis d&apos;hostalatge.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Tarifes aplicables específicament a establiments d&apos;allotjament i servicis d&apos;hostalatge.</rdfs:comment>
        <rdfs:label xml:lang="en">accommodation rate type</rdfs:label>
        <rdfs:label xml:lang="eu">ostatu-tarifa mota</rdfs:label>
        <rdfs:label xml:lang="es">tipo de tarifa de alojamiento</rdfs:label>
        <rdfs:label xml:lang="gl">tipo de tarifa de aloxamento</rdfs:label>
        <rdfs:label xml:lang="ca">tipus de tarifa d&apos;allotjament</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">tipus de tarifa d&apos;allotjament</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#accommodationRating -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#accommodationRating">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/AccommodationRatingSystem"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Grading or classification scheme system providing an assessment of the facilities, services or both provided by tourist accommodation. Typically within five categories, often indicated by one to five symbols.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ostatu turistikoen instalazioak, zerbitzuak edo bi alderdiak ebaluatzen dituen sailkapen- edo kategorizazio-sistema. Normalean bost kategoriatan banatzen da, eta horiek ikur batetik bostera bitartean adierazi ohi dira.</rdfs:comment>
        <rdfs:comment xml:lang="es">Sistema de clasificación o categorización que evalúa las instalaciones, los servicios o ambos aspectos de los alojamientos turísticos. Normalmente se divide en cinco categorías, que suelen indicarse con uno a cinco símbolos.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Sistema de clasificación ou categorización que avalía as instalacións, os servizos ou ambos os aspectos dos aloxamentos turísticos. Normalmente divídese en cinco categorías, que adoitan indicarse con un a cinco símbolos.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Sistema de classificació o categorització que avalua les instal·lacions, els serveis o tots dos aspectes dels allotjaments turístics. Normalment es divideix en cinc categories, que se solen indicar amb un a cinc símbols.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Sistema de classificació o categorització que avalua les instal·lacions, els servicis o tots dos aspectes dels allotjaments turístics. Normalment es dividix en cinc categories, que se solen indicar amb un a cinc símbols.</rdfs:comment>
        <rdfs:label xml:lang="en">accommodation rating</rdfs:label>
        <rdfs:label xml:lang="es">clasificación del alojamiento</rdfs:label>
        <rdfs:label xml:lang="gl">clasificación do aloxamento</rdfs:label>
        <rdfs:label xml:lang="ca">classificació de l&apos;allotjament</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">classificació de l&apos;allotjament</rdfs:label>
        <rdfs:label xml:lang="eu">ostatuaren sailkapena</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#accommodationUnitCategory -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#accommodationUnitCategory">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#LodgingService"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/AccommodationUnitCategory"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="eu">Ostatuko bezeroei eskaintzen zaien ostatu-unitate mota, gutxienez oheak eta higiene-zerbitzuak ematen dizkiena.</rdfs:comment>
        <rdfs:comment xml:lang="es">Tipo de unidad de alojamiento que se ofrece a los huéspedes y en la que se les proporcionan, como mínimo, camas y servicios de higiene.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Tipo de unidade de aloxamento que se ofrece aos hóspedes e na que se lles proporcionan, como mínimo, camas e servizos de hixiene.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Tipus d&apos;unitat d&apos;allotjament que s&apos;ofereix als hostes i en què se&apos;ls proporcionen, com a mínim, llits i serveis d&apos;higiene.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Tipus d&apos;unitat d&apos;allotjament que s&apos;oferix als hostes i en què se&apos;ls proporcionen, com a mínim, llits i servicis d&apos;higiene.</rdfs:comment>
        <rdfs:comment xml:lang="en">Type of accommodation unit offered to guests, in which they are provided with, at least, sleeping and sanitary facilities.</rdfs:comment>
        <rdfs:label xml:lang="en">accommodation unit category</rdfs:label>
        <rdfs:label xml:lang="eu">ostatu-unitate mota</rdfs:label>
        <rdfs:label xml:lang="es">tipo de unidad de alojamiento</rdfs:label>
        <rdfs:label xml:lang="gl">tipo de unidade de aloxamento</rdfs:label>
        <rdfs:label xml:lang="ca">tipus d&apos;unitat d&apos;allotjament</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">tipus d&apos;unitat d&apos;allotjament</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#adventureActivityType -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#adventureActivityType">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#AdventureActivity"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#AdventureActivityCentre"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/AdventureActivityType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Actividades físicas, deportivas o recreativas ofrecidas por el centro.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Actividades físicas, deportivas ou recreativas ofrecidas polo centro.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Activitats físiques, esportives o recreatives ofertes pel centre.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Activitats físiques, esportives o recreatives ofertes pel centre.</rdfs:comment>
        <rdfs:comment xml:lang="en">Physical, sports, or recreational activities offered by the facility.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Zentroak eskaintzen dituen jarduera fisikoak, kirol-jarduerak edo jolas-jarduerak.</rdfs:comment>
        <rdfs:label xml:lang="eu">abentura-jarduera mota</rdfs:label>
        <rdfs:label xml:lang="en">adventure activity type</rdfs:label>
        <rdfs:label xml:lang="es">tipo de actividad de aventura</rdfs:label>
        <rdfs:label xml:lang="gl">tipo de actividade de aventura</rdfs:label>
        <rdfs:label xml:lang="ca">tipus d&apos;activitat d&apos;aventura</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">tipus d&apos;activitat d&apos;aventura</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#adversityType -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#adversityType">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#RulesAndTips"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/AdversityType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">A situation or event characterized by significant misfortune, lasting over a period of time and involving a varying degree of severity.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Situació o esdeveniment amb un fort component de dissort, una certa durada en el temps i un grau de gravetat més o menys elevat.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Situació o esdeveniment amb un fort component de dissort, una certa durada en el temps i un grau de gravetat més o menys elevat.</rdfs:comment>
        <rdfs:comment xml:lang="es">Situación o suceso con un fuerte componente de infortunio, una cierta duración en el tiempo y con un mayor o menor grado de gravedad.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Situación ou suceso cun forte compoñente de infortunio, unha certa duración no tempo e cun maior ou menor grao de gravidade.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Zorigaitz-osagai handia, denboran iraupen jakina eta larritasun-maila handiagoa edo txikiagoa dituen egoera edo gertakaria.</rdfs:comment>
        <rdfs:label xml:lang="en">adversity type</rdfs:label>
        <rdfs:label xml:lang="eu">ezbehar mota</rdfs:label>
        <rdfs:label xml:lang="es">tipo de adversidad</rdfs:label>
        <rdfs:label xml:lang="gl">tipo de adversidade</rdfs:label>
        <rdfs:label xml:lang="ca">tipus d&apos;adversitat</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">tipus d&apos;adversitat</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#agrotourismExperienceRelatedProduct -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#agrotourismExperienceRelatedProduct">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#AgrotourismExperience"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/AgrotourismExperienceRelatedProduct"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">An agri-food product linked to an agrotourism experience.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Esperientzia agroturistiko bati lotutako nekazaritzako elikadura-produktua.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Producte agroalimentari vinculat a una experiència agroturística.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Producte agroalimentari vinculat a una experiència agroturística.</rdfs:comment>
        <rdfs:comment xml:lang="es">Producto agroalimentario vinculado con una experiencia agroturística.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Produto agroalimentario vinculado cunha experiencia agroturística.</rdfs:comment>
        <rdfs:label xml:lang="en">agrotourism experience related product</rdfs:label>
        <rdfs:label xml:lang="eu">esperientzia agroturistikoarekin lotutako produktua</rdfs:label>
        <rdfs:label xml:lang="ca">producte relacionat amb una experiència agroturística</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">producte relacionat amb una experiència agroturística</rdfs:label>
        <rdfs:label xml:lang="es">producto relacionado con experiencia agroturística</rdfs:label>
        <rdfs:label xml:lang="gl">produto relacionado cunha experiencia agroturística</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#agrotourismExperienceType -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#agrotourismExperienceType">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#AgrotourismExperience"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/AgrotourismExperienceType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="eu">Eskainitako esperientzia agroturistikoaren izaera edo gaia, egindako jardueren arabera.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Naturalesa o temàtica de l&apos;experiència agroturística oferta, en funció de les activitats desenvolupades.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Naturalesa o temàtica de l&apos;experiència agroturística oferta, en funció de les activitats desenvolupades.</rdfs:comment>
        <rdfs:comment xml:lang="es">Naturaleza o temática de la experiencia agroturística ofrecida, en función de las actividades desarrolladas.</rdfs:comment>
        <rdfs:comment xml:lang="en">Nature or theme of the agrotourism experience offered, based on the activities carried out. </rdfs:comment>
        <rdfs:comment xml:lang="gl">Natureza ou temática da experiencia agroturística ofrecida, en función das actividades desenvolvidas.</rdfs:comment>
        <rdfs:label xml:lang="en">agrotourism experience type</rdfs:label>
        <rdfs:label xml:lang="eu">esperientzia agroturistiko mota</rdfs:label>
        <rdfs:label xml:lang="es">tipo de experiencia agroturística</rdfs:label>
        <rdfs:label xml:lang="gl">tipo de experiencia agroturística</rdfs:label>
        <rdfs:label xml:lang="ca">tipus d&apos;experiència agroturística</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">tipus d&apos;experiència agroturística</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#author -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#author">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Description"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Multimedia"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismDestination"/>
        <rdfs:comment xml:lang="ca">Destinació turística responsable de generar el contingut multimèdia d&apos;una entitat turística.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Destinació turística responsable de generar el contingut multimèdia d&apos;una entitat turística.</rdfs:comment>
        <rdfs:comment xml:lang="es">Destino turístico responsable de generar el contenido multimedia de una entidad turística.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Destino turístico responsable de xerar o contido multimedia dunha entidade turística.</rdfs:comment>
        <rdfs:comment xml:lang="en">Tourism destination responsible for generating multimedia content for a tourism entity.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Turismo-entitate baten multimedia-edukia sortzeko ardura duen helmuga turistikoa.</rdfs:comment>
        <rdfs:label xml:lang="en">author</rdfs:label>
        <rdfs:label xml:lang="ca">autor</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">autor</rdfs:label>
        <rdfs:label xml:lang="es">autor</rdfs:label>
        <rdfs:label xml:lang="gl">autor</rdfs:label>
        <rdfs:label xml:lang="eu">egilea</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#availableLanguage -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#availableLanguage">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Event"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismService"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="http://id.loc.gov/vocabulary/iso639-2"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="eu">Artikulu, eduki edo baliabide bat erabiltzeko, aurkezteko edo komunikatzeko hizkuntza edo hizkuntza-multzoa, ahoz, idatziz edo bestelako adierazpideen bidez.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Idioma o conjunt d&apos;idiomes en què un article, contingut o recurs es pot utilitzar, presentar o comunicar, ja siga de manera parlada, escrita o mitjançant altres mitjans d&apos;expressió.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Idioma o conjunt d&apos;idiomes en què un article, contingut o recurs es pot utilitzar, presentar o comunicar, ja sigui de manera parlada, escrita o mitjançant altres mitjans d&apos;expressió.</rdfs:comment>
        <rdfs:comment xml:lang="es">Idioma o conjunto de idiomas en los que un artículo, contenido o recurso puede ser utilizado, presentado o comunicado, ya sea de forma hablada, escrita o mediante otros medios de expresión.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Idioma ou conxunto de idiomas nos que un artigo, contido ou recurso pode ser utilizado, presentado ou comunicado, xa sexa de forma falada, escrita ou mediante outros medios de expresión.</rdfs:comment>
        <rdfs:comment xml:lang="en">Language or set of languages in which an article, content, or resource can be used, presented, or communicated, whether in spoken, written, or other forms of expression.</rdfs:comment>
        <rdfs:label xml:lang="en">available language</rdfs:label>
        <rdfs:label xml:lang="eu">hizkuntza erabilgarria</rdfs:label>
        <rdfs:label xml:lang="ca">idioma disponible</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">idioma disponible</rdfs:label>
        <rdfs:label xml:lang="es">idioma disponible</rdfs:label>
        <rdfs:label xml:lang="gl">idioma dispoñible</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#beachType -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#beachType">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#Beach"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/BeachType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Diferentes categorías o clasificaciones que se utilizan para describir y diferenciar las playas según sus características físicas y ambientales.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Diferentes categorías ou clasificacións que se utilizan para describir e diferenciar as praias segundo as súas características físicas e ambientais.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Diferents categories o classificacions que s&apos;utilitzen per descriure i diferenciar les platges segons les seues característiques físiques i ambientals.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Diferents categories o classificacions que s&apos;utilitzen per descriure i diferenciar les platges segons les seves característiques físiques i ambientals.</rdfs:comment>
        <rdfs:comment xml:lang="en">Different categories or classifications used to describe and distinguish beaches according to their physical and environmental characteristics.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Hondartzak ezaugarri fisikoen eta ingurumen-ezaugarrien arabera deskribatzeko eta bereizteko erabiltzen diren kategoria edo sailkapenak.</rdfs:comment>
        <rdfs:label xml:lang="en">beach type</rdfs:label>
        <rdfs:label xml:lang="eu">hondartza mota</rdfs:label>
        <rdfs:label xml:lang="es">tipo de playa</rdfs:label>
        <rdfs:label xml:lang="gl">tipo de praia</rdfs:label>
        <rdfs:label xml:lang="ca">tipus de platja</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">tipus de platja</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#byDay -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#byDay">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#Schedule"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/DayOfTheWeek"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="eu">Ekitaldi, zerbitzu edo proposamen berezi baten programazioa behin eta berriz egiten den asteko egun zehatzak adierazten ditu (adibidez, astelehenak eta astearteak)</rdfs:comment>
        <rdfs:comment xml:lang="ca">Indica els dies específics de la setmana en què la programació d&apos;un esdeveniment, servei o proposta especial es realitza de manera recurrent (per exemple, dilluns i dimarts)</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Indica els dies específics de la setmana en què la programació d&apos;un esdeveniment, servici o proposta especial es realitza de manera recurrent (per exemple, dilluns i dimarts)</rdfs:comment>
        <rdfs:comment xml:lang="es">Indica los días específicos de la semana en los que la programación de un evento, servicio o propuesta especial se realiza de forma recurrente (por ejemplo, lunes y martes)</rdfs:comment>
        <rdfs:comment xml:lang="gl">Indica os días específicos da semana nos que a programación dun evento, servizo ou proposta especial se realiza de forma recorrente (por exemplo, luns e martes)</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates the specific days of the week on which the schedule for an event, service, or special offer takes place on a recurring basis (for example, Monday and Tuesday).</rdfs:comment>
        <rdfs:label xml:lang="en">by day</rdfs:label>
        <rdfs:label xml:lang="eu">egunaren arabera</rdfs:label>
        <rdfs:label xml:lang="ca">per dia</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">per dia</rdfs:label>
        <rdfs:label xml:lang="es">por día</rdfs:label>
        <rdfs:label xml:lang="gl">por día</rdfs:label>
        <estur-annot:orderInCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</estur-annot:orderInCategory>
        <estur-annot:presentationOrderCategory>contact</estur-annot:presentationOrderCategory>
        <estur-annot:tooltip xml:lang="es">Indica los días recurrentes de la programación. Por ejemplo, abierto los lunes y martes</estur-annot:tooltip>
        <estur-annot:tooltip xml:lang="en">Indicates the recurring days of the schedule. For example, open on Mondays and Tuesdays.</estur-annot:tooltip>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#byMonth -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#byMonth">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#Schedule"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/MonthOfTheYear"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="eu">Ekitaldi, zerbitzu edo proposamen berezi baten programazioa behin eta berriz egiten den egutegiko hilabete zehatza edo hilabete zehatzak adierazten ditu.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Indica el mes o els mesos específics del calendari en què la programació d&apos;un esdeveniment, servei o proposta especial es realitza de manera recurrent.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Indica el mes o els mesos específics del calendari en què la programació d&apos;un esdeveniment, servici o proposta especial es realitza de manera recurrent.</rdfs:comment>
        <rdfs:comment xml:lang="es">Indica el mes o los meses específicos del calendario en los que la programación de un evento, servicio o propuesta especial se realiza de forma recurrente.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Indica o mes ou os meses específicos do calendario nos que a programación dun evento, servizo ou proposta especial se realiza de forma recorrente.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates the specific month or months of the calendar in which the scheduling of an event, service, or special offer takes place on a recurring basis.</rdfs:comment>
        <rdfs:label xml:lang="en">by month</rdfs:label>
        <rdfs:label xml:lang="eu">hilabetearen arabera</rdfs:label>
        <rdfs:label xml:lang="ca">per mes</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">per mes</rdfs:label>
        <rdfs:label xml:lang="es">por mes</rdfs:label>
        <rdfs:label xml:lang="gl">por mes</rdfs:label>
        <estur-annot:orderInCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11</estur-annot:orderInCategory>
        <estur-annot:presentationOrderCategory>contact</estur-annot:presentationOrderCategory>
        <estur-annot:tooltip xml:lang="es">Indica el/los mes(es) recurrente(s) del calendario de la programación</estur-annot:tooltip>
        <estur-annot:tooltip xml:lang="en">Indicates the recurring month(s) of the schedule</estur-annot:tooltip>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#certificationType -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#certificationType">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#Certification"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/CertificationType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="eu">Ekitaldi, helmuga, baliabide turistiko, zerbitzu publiko eta turismo-enpresentzako estatuko eta nazioarteko erreferentziazko turismo-ziurtagirien zerrenda, haien instalazioak eta zerbitzuak barne.</rdfs:comment>
        <rdfs:comment xml:lang="en">List of relevant national and international tourism certifications for events, destinations, tourism resources, public services, and tourism organisations, including their facilities and services.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lista de certificacións turísticas de referencia no ámbito nacional e internacional para eventos, destinos, recursos turísticos, servizos públicos e empresas turísticas, incluídas as súas instalacións e servizos.</rdfs:comment>
        <rdfs:comment xml:lang="es">Listado de certificaciones turísticas de referencia en el ámbito nacional e internacional para eventos, destinos, recursos turísticos, servicios públicos y empresas turísticas, incluyendo sus instalaciones y servicios.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Llista de certificacions turístiques de referència en l&apos;àmbit nacional i internacional per a esdeveniments, destinacions, recursos turístics, serveis públics i empreses turístiques, incloent-hi les seves instal·lacions i serveis.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Llista de certificacions turístiques de referència en l&apos;àmbit nacional i internacional per a esdeveniments, destinacions, recursos turístics, servicis públics i empreses turístiques, incloent-hi les seues instal·lacions i servicis.</rdfs:comment>
        <rdfs:label xml:lang="en">certification type</rdfs:label>
        <rdfs:label xml:lang="es">tipo de certificación</rdfs:label>
        <rdfs:label xml:lang="gl">tipo de certificación</rdfs:label>
        <rdfs:label xml:lang="ca">tipus de certificació</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">tipus de certificació</rdfs:label>
        <rdfs:label xml:lang="eu">ziurtagiri mota</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#compulsoryZoosanitaryProduct -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#compulsoryZoosanitaryProduct">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#PetAdmissionPolicy"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/CompulsoryZoosanitaryProduct"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="eu">Animalien gaixotasun edo gaitzak diagnostikatzeko, prebenitzeko, tratatzeko, arintzeko edo sendatzeko substantziak, osagai aktiboak, formulazioak edo prestakinak, animaliak onartzeko eman behar zaizkienak.</rdfs:comment>
        <rdfs:comment xml:lang="en">Substances, active ingredients, formulations or preparations intended for the diagnosis, prevention, treatment, alleviation or cure of diseases or ailments in animals, and whose administration is required for admission.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Substancias, ingredientes activos, formulacións ou preparados destinados ao diagnóstico, prevención, tratamento, alivio ou cura das enfermidades ou doenzas dos animais, e cuxa administración é requirida para a súa admisión.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Substàncies, ingredients actius, formulacions o preparats destinats al diagnòstic, prevenció, tractament, alleujament o cura de les malalties o afeccions dels animals, l&apos;administració dels quals és necessària per a la seua admissió.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Substàncies, ingredients actius, formulacions o preparats destinats al diagnòstic, prevenció, tractament, alleujament o cura de les malalties o afeccions dels animals, l&apos;administració dels quals és necessària per a la seva admissió.</rdfs:comment>
        <rdfs:comment xml:lang="es">Sustancias, ingredientes activos, formulaciones o preparados destinados al diagnóstico, prevención, tratamiento, alivio o cura de las enfermedades o dolencias de los animales, y cuya administración es requerida para su admisión.</rdfs:comment>
        <rdfs:label xml:lang="en">compulsory zoosanitary product</rdfs:label>
        <rdfs:label xml:lang="eu">nahitaezko animalia-osasuneko produktua</rdfs:label>
        <rdfs:label xml:lang="ca">producte zoosanitari obligatori</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">producte zoosanitari obligatori</rdfs:label>
        <rdfs:label xml:lang="es">producto zoosanitario obligatorio</rdfs:label>
        <rdfs:label xml:lang="gl">produto zoosanitario obrigatorio</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#dayOfTheWeek -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#dayOfTheWeek">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#OpeningHours"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/DayOfTheWeek"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="eu">Aste-ziklo estandar bat osatzen duten zazpi aldi izendatuetako bat (astelehenetik igandera), ordutegi-tarte errepikakorrak zehazteko erabiltzen dena.</rdfs:comment>
        <rdfs:comment xml:lang="en">One of the seven named periods (Monday through Sunday) that constitute a standard weekly cycle, used to define recurring time slots.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Un dels set períodes amb nom (de dilluns a diumenge) que constitueixen un cicle setmanal estàndard, utilitzat per definir franges horàries recurrents.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Un dels set períodes amb nom (de dilluns a diumenge) que constituïxen un cicle setmanal estàndard, utilitzat per definir franges horàries recurrents.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Un dos sete períodos con nome (de luns a domingo) que constitúen un ciclo semanal estándar, utilizado para definir franxas horarias recorrentes.</rdfs:comment>
        <rdfs:comment xml:lang="es">Uno de los siete periodos nombrados (de lunes a domingo) que constituyen un ciclo semanal estándar, utilizado para definir franjas horarias recurrentes.</rdfs:comment>
        <rdfs:label xml:lang="eu">asteko eguna</rdfs:label>
        <rdfs:label xml:lang="en">day of the week</rdfs:label>
        <rdfs:label xml:lang="ca">dia de la setmana</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">dia de la setmana</rdfs:label>
        <rdfs:label xml:lang="gl">día da semana</rdfs:label>
        <rdfs:label xml:lang="es">día de la semana</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#destinationType -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#destinationType">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismDestination"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/DestinationType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Categorisation of the space according to its main characteristics and attractions.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Categorització de l&apos;espai en funció de les seues característiques i atractius principals.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Categorització de l&apos;espai en funció de les seves característiques i atractius principals.</rdfs:comment>
        <rdfs:comment xml:lang="es">Categorización del espacio en función de sus características y atractivos principales.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Categorización do espazo en función das súas características e atractivos principais.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Espazioaren kategorizazioa, haren ezaugarri eta erakargarritasun nagusien arabera.</rdfs:comment>
        <rdfs:label xml:lang="en">destination type</rdfs:label>
        <rdfs:label xml:lang="eu">helmuga mota</rdfs:label>
        <rdfs:label xml:lang="es">tipo de destino</rdfs:label>
        <rdfs:label xml:lang="gl">tipo de destino</rdfs:label>
        <rdfs:label xml:lang="ca">tipus de destinació</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">tipus de destinació</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#eventSchedule -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#eventSchedule">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#Event"/>
        <rdfs:range rdf:resource="https://ontologia.segittur.es/turismo/def/core#Schedule"/>
        <rdfs:comment xml:lang="es">Asociación de un evento con una programación.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Asociación dun evento cunha programación.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Associació d&apos;un esdeveniment amb una programació.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Associació d&apos;un esdeveniment amb una programació.</rdfs:comment>
        <rdfs:comment xml:lang="en">Association of an event with a schedule.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ekitaldi bat programazio batekin lotzea.</rdfs:comment>
        <rdfs:label xml:lang="eu">ekitaldiaren programazioa</rdfs:label>
        <rdfs:label xml:lang="en">event schedule</rdfs:label>
        <rdfs:label xml:lang="ca">programació de l&apos;esdeveniment</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">programació de l&apos;esdeveniment</rdfs:label>
        <rdfs:label xml:lang="es">programación del evento</rdfs:label>
        <rdfs:label xml:lang="gl">programación do evento</rdfs:label>
        <estur-annot:orderInCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</estur-annot:orderInCategory>
        <estur-annot:presentationOrderCategory>contact</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#eventType -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#eventType">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#Event"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/EventType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Clasificación utilizada para agrupar jerárquicamente los diferentes tipos de eventos que se llevan a cabo en función de su naturaleza o temática.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Clasificación utilizada para agrupar xerarquicamente os diferentes tipos de eventos que se levan a cabo en función da súa natureza ou temática.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Classificació utilitzada per agrupar jeràrquicament els diferents tipus d&apos;esdeveniments que es duen a terme en funció de la seua naturalesa o temàtica.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Classificació utilitzada per agrupar jeràrquicament els diferents tipus d&apos;esdeveniments que es duen a terme en funció de la seva naturalesa o temàtica.</rdfs:comment>
        <rdfs:comment xml:lang="en">Classification used to hierarchically group the different types of events that take place according to their nature or theme.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Egiten diren ekitaldi motak izaeraren edo gaiaren arabera hierarkikoki multzokatzeko erabiltzen den sailkapena.</rdfs:comment>
        <rdfs:label xml:lang="eu">ekitaldi mota</rdfs:label>
        <rdfs:label xml:lang="en">event type</rdfs:label>
        <rdfs:label xml:lang="es">tipo de evento</rdfs:label>
        <rdfs:label xml:lang="gl">tipo de evento</rdfs:label>
        <rdfs:label xml:lang="ca">tipus d&apos;esdeveniment</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">tipus d&apos;esdeveniment</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#frequentlyAskedQuestion -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#frequentlyAskedQuestion">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#AdditionalInformation"/>
        <rdfs:range rdf:resource="https://ontologia.segittur.es/turismo/def/core#FrequentlyAskedQuestion"/>
        <rdfs:comment xml:lang="en">A collection of questions and answers that address the most common doubts users have about a particular topic, product, service, or organisation.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Erabiltzaileek gai, produktu, zerbitzu edo enpresa jakin bati buruz izaten dituzten zalantza ohikoenak lantzen dituen galdera-erantzunen bilduma.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Recompilación de preguntas e respostas que abordan as dúbidas máis comúns que teñen os usuarios sobre un tema, produto, servizo ou empresa en particular.</rdfs:comment>
        <rdfs:comment xml:lang="es">Recopilación de preguntas y respuestas que abordan las dudas más comunes que tienen los usuarios sobre un tema, producto, servicio o empresa en particular.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Recull de preguntes i respostes que aborden els dubtes més comuns dels usuaris sobre un tema, producte, servei o empresa en particular.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Recull de preguntes i respostes que aborden els dubtes més comuns dels usuaris sobre un tema, producte, servici o empresa en particular.</rdfs:comment>
        <rdfs:label xml:lang="en">frequently asked question</rdfs:label>
        <rdfs:label xml:lang="eu">ohiko galdera</rdfs:label>
        <rdfs:label xml:lang="es">pregunta frecuente</rdfs:label>
        <rdfs:label xml:lang="gl">pregunta frecuente</rdfs:label>
        <rdfs:label xml:lang="ca">pregunta freqüent</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">pregunta freqüent</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#handicraftsType -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#handicraftsType">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#Handicrafts"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/HandicraftsType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="eu">Artisautza-denden kategorizazioa, eskaintzen duten produktu motaren arabera.</rdfs:comment>
        <rdfs:comment xml:lang="en">Categorisation of handicraft shops according to the type of product they offer.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Categorització de les botigues d&apos;artesania en funció del tipus de producte que ofereixen.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Categorització de les botigues d&apos;artesania en funció del tipus de producte que oferixen.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Categorización das tendas de artesanía en función do tipo de produto que ofrecen.</rdfs:comment>
        <rdfs:comment xml:lang="es">Categorización de las tiendas de artesanías en función del tipo de producto que ofrece.</rdfs:comment>
        <rdfs:label xml:lang="eu">artisautza mota</rdfs:label>
        <rdfs:label xml:lang="en">handicrafts yype</rdfs:label>
        <rdfs:label xml:lang="es">tipo de artesanía</rdfs:label>
        <rdfs:label xml:lang="gl">tipo de artesanía</rdfs:label>
        <rdfs:label xml:lang="ca">tipus d&apos;artesania</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">tipus d&apos;artesania</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#hasAcknowledgement -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#hasAcknowledgement">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Event"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismDestination"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrganisation"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismResource"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismService"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TouristInformationOffice"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://ontologia.segittur.es/turismo/def/core#Acknowledgement"/>
        <rdfs:comment xml:lang="en">Achievements or distinctions awarded to people, companies or products for meeting certain standards or specific criteria. These recognitions may include certifications, awards, or other types of honors that recognize quality, performance, compliance, or excellence in a particular field.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Assoliments o distincions atorgats a persones, empreses o productes per complir determinats estàndards o criteris específics. Aquests reconeixements poden incloure certificacions, premis o altres tipus de distincions que reconeixen la qualitat, el rendiment, el compliment de normes o l&apos;excel·lència en un àmbit determinat.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Assoliments o distincions atorgats a persones, empreses o productes per complir determinats estàndards o criteris específics. Estos reconeixements poden incloure certificacions, premis o altres tipus de distincions que reconeixen la qualitat, el rendiment, el compliment de normes o l&apos;excel·lència en un àmbit determinat.</rdfs:comment>
        <rdfs:comment xml:lang="es">Logros o distinciones otorgadas a personas, empresas o productos por cumplir con ciertos estándares o criterios específicos. Estos reconocimientos pueden incluir certificaciones, premios u otros tipos de distinciones que reconocen la calidad, el rendimiento, el cumplimiento de normas o la excelencia en un determinado campo.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Logros ou distincións outorgados a persoas, empresas ou produtos por cumprir certos estándares ou criterios específicos. Estes recoñecementos poden incluír certificacións, premios ou outros tipos de distincións que recoñecen a calidade, o rendemento, o cumprimento de normas ou a excelencia nun determinado campo.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Zenbait estandar edo irizpide zehatz betetzeagatik pertsonei, enpresei edo produktuei emandako lorpenak edo sariak. Aitorpen horien artean egon daitezke ziurtagiriak, sariak edo arlo jakin bateko kalitatea, errendimendua, arauak betetzea edo bikaintasuna aitortzen duten bestelako bereizgarriak.</rdfs:comment>
        <rdfs:label xml:lang="eu">aitorpena du</rdfs:label>
        <rdfs:label xml:lang="en">has acknowledgement</rdfs:label>
        <rdfs:label xml:lang="gl">ten recoñecemento</rdfs:label>
        <rdfs:label xml:lang="es">tiene reconocimiento</rdfs:label>
        <rdfs:label xml:lang="ca">té reconeixement</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">té reconeixement</rdfs:label>
        <estur-annot:orderInCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</estur-annot:orderInCategory>
        <estur-annot:presentationOrderCategory>acknowledgement</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


