        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="eu">Garraio-azpiegitura batek izan ditzakeen turismo-instalazioak edo haiei lotutako instalazioak eta zerbitzu publikoak adierazten ditu.</rdfs:comment>
        <rdfs:comment xml:lang="es">Indica instalaciones turísticas o vinculadas y servicios públicos que una infraestructura de transporte puede contener.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Indica instalacións turísticas ou vinculadas e servizos públicos que unha infraestrutura de transporte pode conter.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Indica instal·lacions turístiques o vinculades i serveis públics que pot contenir una infraestructura de transport.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Indica instal·lacions turístiques o vinculades i servicis públics que pot contenir una infraestructura de transport.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates tourism or related facilities and public services that a transport infrastructure may contain.</rdfs:comment>
        <rdfs:label xml:lang="gl">a infraestrutura de transporte contén</rdfs:label>
        <rdfs:label xml:lang="eu">garraio-azpiegiturak dauka</rdfs:label>
        <rdfs:label xml:lang="es">infraestructura de transporte contiene</rdfs:label>
        <rdfs:label xml:lang="ca">la infraestructura de transport conté</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">la infraestructura de transport conté</rdfs:label>
        <rdfs:label xml:lang="en">transport infrastructure contains</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
        <estur-annot:tooltip xml:lang="es">Indica instalaciones turísticas o vinculadas y servicios públicos que una infraestructura de transporte puede contener</estur-annot:tooltip>
        <estur-annot:tooltip xml:lang="en">Indicates tourist or related facilities and public services that a transport infrastructure may contain</estur-annot:tooltip>
    </owl:ObjectProperty>
    


