        <rdfs:comment xml:lang="gl">Texto completo que proporciona unha explicación detallada e contextualizada sobre a entidade descrita.</rdfs:comment>
        <rdfs:label xml:lang="gl">descrición longa</rdfs:label>
        <rdfs:label xml:lang="ca">descripció llarga</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">descripció llarga</rdfs:label>
        <rdfs:label xml:lang="es">descripción larga</rdfs:label>
        <rdfs:label xml:lang="eu">deskribapen luzea</rdfs:label>
        <rdfs:label xml:lang="en">long description</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:DatatypeProperty>
    


