        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#offeredBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismDestination"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrganisation"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#eventSchedule"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#Schedule"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasContactPoint"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#BookingChannel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasLocation"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#Location"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasSuperEvent"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#Event"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#saleEndDate"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#saleStartDate"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#maximumAttendeeCapacity"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#numberedSeats"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#outdoorEvent"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#saleEndDate"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#saleStartDate"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Experience which takes place at a specific time and location.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Experiencia que ten lugar nun momento e lugar específicos.</rdfs:comment>
        <rdfs:comment xml:lang="es">Experiencia que tiene lugar en un momento y lugar específicos.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Experiència que té lloc en un moment i lloc específics.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Experiència que té lloc en un moment i lloc específics.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Une eta leku jakin batean gertatzen den esperientzia.</rdfs:comment>
        <rdfs:label xml:lang="eu">Ekitaldia</rdfs:label>
        <rdfs:label xml:lang="ca">Esdeveniment</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Esdeveniment</rdfs:label>
        <rdfs:label xml:lang="en">Event</rdfs:label>
        <rdfs:label xml:lang="es">Evento</rdfs:label>
        <rdfs:label xml:lang="gl">Evento</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#EventAttendanceFacility -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#EventAttendanceFacility">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalEventAttendanceFacilityService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalTourismOrRelatedFacilityService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Espacios diseñados y equipados para albergar la celebración de diversas actividades y acontecimientos.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espais dissenyats i equipats per acollir la celebració de diverses activitats i esdeveniments.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espais dissenyats i equipats per acollir la celebració de diverses activitats i esdeveniments.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazos deseñados e equipados para acoller a celebración de diversas actividades e acontecementos.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Hainbat jarduera eta ekitaldi hartzeko diseinatutako eta hornitutako espazioak.</rdfs:comment>
        <rdfs:comment xml:lang="en">Spaces designed and equipped to host various activities and events.</rdfs:comment>
        <rdfs:label xml:lang="eu">Ekitaldietarako instalazioa</rdfs:label>
        <rdfs:label xml:lang="en">Event attendance facility</rdfs:label>
        <rdfs:label xml:lang="es">Instalación para eventos</rdfs:label>
        <rdfs:label xml:lang="gl">Instalación para eventos</rdfs:label>
        <rdfs:label xml:lang="ca">Instal·lació per a esdeveniments</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Instal·lació per a esdeveniments</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#EventOrganisationCompany -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#EventOrganisationCompany">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrganisation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasTourismOrRelatedFacility"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Batez ere ekitaldi baten diseinuaz, plangintzaz, koordinazioaz, ekoizpenaz eta gauzatzeaz arduratzen den enpresa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Company that is mainly responsible for the design, planning, coordination, as well as the production and execution of an event.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Empresa que s&apos;encarrega principalment del disseny, la planificació, la coordinació, la producció i l&apos;execució d&apos;un esdeveniment.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Empresa que s&apos;encarrega principalment del disseny, la planificació, la coordinació, la producció i l&apos;execució d&apos;un esdeveniment.</rdfs:comment>
        <rdfs:comment xml:lang="es">Empresa que se encarga principalmente del diseño, la planificación, la coordinación, así como la producción y ejecución de un evento.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Empresa que se encarga principalmente do deseño, a planificación, a coordinación, a produción e a execución dun evento.</rdfs:comment>
        <rdfs:label xml:lang="eu">Ekitaldiak antolatzeko enpresa</rdfs:label>
        <rdfs:label xml:lang="ca">Empresa d&apos;organització d&apos;esdeveniments</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Empresa d&apos;organització d&apos;esdeveniments</rdfs:label>
        <rdfs:label xml:lang="es">Empresa de organización de eventos</rdfs:label>
        <rdfs:label xml:lang="gl">Empresa de organización de eventos</rdfs:label>
        <rdfs:label xml:lang="en">Event organisation company</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#ExchangeBureau -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#ExchangeBureau">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#FinancialService"/>
        <rdfs:comment xml:lang="eu">Bezeroei dibisa bat beste baten truke aldatzeko aukera ematen dien erakundea edo zentroa.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Organització o centre que permet als clients canviar una divisa per una altra.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Organització o centre que permet als clients canviar una divisa per una altra.</rdfs:comment>
        <rdfs:comment xml:lang="es">Organización o centro que permite a los clientes cambiar una divisa por otra.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Organización ou centro que permite aos clientes cambiar unha divisa por outra.</rdfs:comment>
        <rdfs:comment xml:lang="en">Organization or facility that allows customers to exchange one currency for another</rdfs:comment>
        <rdfs:label xml:lang="es">Casa de cambio</rdfs:label>
        <rdfs:label xml:lang="gl">Casa de cambio</rdfs:label>
        <rdfs:label xml:lang="eu">Dibisa-trukerako bulegoa</rdfs:label>
        <rdfs:label xml:lang="en">Exchange bureau</rdfs:label>
        <rdfs:label xml:lang="ca">Oficina de canvi</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Oficina de canvi</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#ExhibitionHall -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#ExhibitionHall">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#LeisureAndCultureFacility"/>
        <rdfs:comment xml:lang="eu">Arte plastikoak sustatzeko, bultzatzeko eta zabaltzeko espazioa.</rdfs:comment>
        <rdfs:comment xml:lang="es">Espacio de fomento, promoción y difusión de las artes plásticas.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espai de foment, promoció i difusió de les arts plàstiques.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espai de foment, promoció i difusió de les arts plàstiques.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazo de fomento, promoción e difusión das artes plásticas.</rdfs:comment>
        <rdfs:comment xml:lang="en">Space for the promotion, promotion and dissemination of the plastic arts.</rdfs:comment>
        <rdfs:label xml:lang="eu">Erakusketa-aretoa</rdfs:label>
        <rdfs:label xml:lang="en">Exhibition hall</rdfs:label>
        <rdfs:label xml:lang="ca">Sala d&apos;exposicions</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Sala d&apos;exposicions</rdfs:label>
        <rdfs:label xml:lang="es">Sala de exposiciones</rdfs:label>
        <rdfs:label xml:lang="gl">Sala de exposicións</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Fairground -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Fairground">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#EventAttendanceFacility"/>
        <rdfs:comment xml:lang="en">A facility intended for hosting fairs, exhibitions, and other temporary events open to the public, composed of large and modular spaces, indoor or outdoor, adapted for the exhibition and promotion of products and services.</rdfs:comment>
        <rdfs:comment xml:lang="es">Instalación destinada a la celebración de ferias, exposiciones y otros eventos temporales abiertos al público, formada por espacios amplios y modulares, cubiertos o al aire libre, adaptados para la exhibición y promoción de productos y servicios.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Instalación destinada á celebración de feiras, exposicións e outros eventos temporais abertos ao público, formada por espazos amplos e modulares, cubertos ou ao aire libre, adaptados á exhibición e promoción de produtos e servizos.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Instal·lació destinada a celebrar fires, exposicions i altres esdeveniments temporals oberts al públic, formada per espais amplis i modulars, coberts o a l&apos;aire lliure, adaptats a l&apos;exhibició i promoció de productes i serveis.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Instal·lació destinada a celebrar fires, exposicions i altres esdeveniments temporals oberts al públic, formada per espais amplis i modulars, coberts o a l&apos;aire lliure, adaptats a l&apos;exhibició i promoció de productes i servicis.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Jendearentzat irekitako azokak, erakusketak eta aldi baterako beste ekitaldi batzuk egiteko instalazioa, produktu eta zerbitzuak erakusteko eta sustatzeko egokitutako espazio zabal eta modularrez osatua, estalita edo aire zabalean.</rdfs:comment>
        <rdfs:label xml:lang="eu">Azoka-esparrua</rdfs:label>
        <rdfs:label xml:lang="en">Fairground</rdfs:label>
        <rdfs:label xml:lang="ca">Recinte firal</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Recinte firal</rdfs:label>
        <rdfs:label xml:lang="gl">Recinto feiral</rdfs:label>
        <rdfs:label xml:lang="es">Recinto ferial</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#FarmSchool -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#FarmSchool">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#AgrotourismFacility"/>
        <rdfs:comment xml:lang="en">Educational and learning space where activities related to nature, the rural world and respect for the environment are carried out.</rdfs:comment>
        <rdfs:comment xml:lang="es">Espacio educativo y de aprendizaje donde se realizan actividades relacionadas con la naturaleza, el mundo rural y el respeto al medio ambiente.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espai educatiu i d&apos;aprenentatge on es duen a terme activitats relacionades amb la natura, el món rural i el respecte al medi ambient.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espai educatiu i d&apos;aprenentatge on es duen a terme activitats relacionades amb la natura, el món rural i el respecte al medi ambient.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazo educativo e de aprendizaxe onde se realizan actividades relacionadas coa natureza, o mundo rural e o respecto ao medio ambiente.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Naturarekin, landa-munduarekin eta ingurumenarekiko errespetuarekin lotutako jarduerak egiten diren hezkuntza- eta ikaskuntza-espazioa.</rdfs:comment>
        <rdfs:label xml:lang="eu">Baserri-eskola</rdfs:label>
        <rdfs:label xml:lang="en">Farm school</rdfs:label>
        <rdfs:label xml:lang="ca">Granja escola</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Granja escola</rdfs:label>
        <rdfs:label xml:lang="es">Granja escuela</rdfs:label>
        <rdfs:label xml:lang="gl">Granxa escola</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#FerryOperator -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#FerryOperator">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PassengerTransportCompany"/>
        <rdfs:comment xml:lang="en">Company dedicated to operating maritime transportation services for passengers and vehicles through ferries and specific maritime routes.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Companyia dedicada a operar serveis de transport marítim de passatgers i vehicles mitjançant ferris i rutes marítimes específiques.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Companyia dedicada a operar servicis de transport marítim de passatgers i vehicles mitjançant ferris i rutes marítimes específiques.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Compañía dedicada a operar servizos de transporte marítimo de pasaxeiros e vehículos mediante ferris e rutas marítimas específicas.</rdfs:comment>
        <rdfs:comment xml:lang="es">Compañía que se dedica a operar servicios de transporte marítimo de pasajeros y vehículos a través de ferris y rutas marítimas específicas.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ferryen bidez eta itsas ibilbide jakinetan bidaiariak eta ibilgailuak itsasoz garraiatzeko zerbitzuak ustiatzen dituen konpainia.</rdfs:comment>
        <rdfs:label xml:lang="en">Ferry operator</rdfs:label>
        <rdfs:label xml:lang="eu">Ferry-operadorea</rdfs:label>
        <rdfs:label xml:lang="ca">Operador de ferris</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Operador de ferris</rdfs:label>
        <rdfs:label xml:lang="es">Operador de ferris</rdfs:label>
        <rdfs:label xml:lang="gl">Operador de ferris</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#FinancialService -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#FinancialService">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#LocalBusiness"/>
        <rdfs:comment xml:lang="es">Actividad o función relacionada con la gestión, el manejo o la intermediación de dinero y recursos financieros.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Actividade ou función relacionada coa xestión, o manexo ou a intermediación de diñeiro e recursos financeiros.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Activitat o funció relacionada amb la gestió, el maneig o la intermediació de diners i recursos financers.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Activitat o funció relacionada amb la gestió, el maneig o la intermediació de diners i recursos financers.</rdfs:comment>
        <rdfs:comment xml:lang="en">Activity or function related to the management, handling or intermediation of money and financial resources.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Diruaren eta finantza-baliabideen kudeaketarekin, erabilerarekin edo bitartekaritzarekin lotutako jarduera edo funtzioa.</rdfs:comment>
        <rdfs:label xml:lang="en">Financial service</rdfs:label>
        <rdfs:label xml:lang="eu">Finantza-zerbitzua</rdfs:label>
        <rdfs:label xml:lang="ca">Servei financer</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Servici financer</rdfs:label>
        <rdfs:label xml:lang="es">Servicio financiero</rdfs:label>
        <rdfs:label xml:lang="gl">Servizo financeiro</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#FireStation -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#FireStation">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
        <rdfs:comment xml:lang="en">Competent body for the prevention, preparation and attention of fires and other emergencies</rdfs:comment>
        <rdfs:comment xml:lang="eu">Suteak eta beste larrialdi batzuk prebenitzeko, haiei aurre egiteko prestatzeko eta erantzuteko organo eskuduna</rdfs:comment>
        <rdfs:comment xml:lang="ca">Òrgan competent per a la prevenció, preparació i atenció d&apos;incendis i altres emergències</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Òrgan competent per a la prevenció, preparació i atenció d&apos;incendis i altres emergències</rdfs:comment>
        <rdfs:comment xml:lang="gl">Órgano competente para a prevención, preparación e atención de incendios e outras emerxencias</rdfs:comment>
        <rdfs:comment xml:lang="es">Órgano competente para la prevención, preparación y atención de incendios y otras emergencias</rdfs:comment>
        <rdfs:label xml:lang="es">Estación de bomberos</rdfs:label>
        <rdfs:label xml:lang="en">Fire station</rdfs:label>
        <rdfs:label xml:lang="ca">Parc de bombers</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Parc de bombers</rdfs:label>
        <rdfs:label xml:lang="gl">Parque de bombeiros</rdfs:label>
        <rdfs:label xml:lang="eu">Suhiltzaile-etxea</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#FoodAndBeverageService -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#FoodAndBeverageService">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismService"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#offeredBy"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#RestaurantCompany"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#relatedTourismOrRelatedFacility"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#averagePricePerPerson"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en"> A tourism service that encompasses the preparation, provision, and consumption of food and beverages offered to customers by food and beverage establishments, either for on-site consumption or takeaway.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Jatetxe-establezimenduek bezeroei eskaintzen dizkieten elikagai eta edariak prestatzea, egitea, hornitzea eta kontsumitzea barne hartzen duen turismo-zerbitzua, establezimenduan bertan kontsumitzeko nahiz eramateko.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Servei turístic que comprèn la preparació, elaboració, subministrament i consum d&apos;aliments i begudes oferts als clients per establiments de restauració, ja sigui per consumir-los al mateix establiment o per emportar.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Servici turístic que comprèn la preparació, elaboració, subministrament i consum d&apos;aliments i begudes oferts als clients per establiments de restauració, ja siga per consumir-los al mateix establiment o per emportar.</rdfs:comment>
        <rdfs:comment xml:lang="es">Servicio turístico que comprende la preparación, elaboración, suministro y consumo de alimentos y bebidas ofrecidos a los clientes por establecimientos de restauración, ya sea para su consumo en el propio establecimiento o para llevar.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Servizo turístico que comprende a preparación, elaboración, subministración e consumo de alimentos e bebidas ofrecidos aos clientes por establecementos de restauración, xa sexa para o seu consumo no propio establecemento ou para levar.</rdfs:comment>
        <rdfs:label xml:lang="en">Food and beverage service</rdfs:label>
        <rdfs:label xml:lang="eu">Janari- eta edari-zerbitzua</rdfs:label>
        <rdfs:label xml:lang="ca">Servei de menjars i begudes</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Servici de menjars i begudes</rdfs:label>
        <rdfs:label xml:lang="es">Servicio de comidas y bebidas</rdfs:label>
        <rdfs:label xml:lang="gl">Servizo de comidas e bebidas</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#FoodEstablishment -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalFoodEstablishmentService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalTourismOrRelatedFacilityService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#menuOptions"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#offersGastronomicResource"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#GastronomicResource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#servesCuisine"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasPriceClass"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasPriceSpecification"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#PriceSpecification"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#averagePricePerPerson"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Businesses dedicated to the production of foods and beverages prepared for consumption.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Kontsumitzeko prest dauden janariak eta edariak prestatzen dituzten negozioak.</rdfs:comment>
        <rdfs:comment xml:lang="es">Negocios dedicados a la elaboración de comidas y bebidas preparadas para su consumo.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Negocios dedicados á elaboración de comidas e bebidas preparadas para o seu consumo.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Negocis dedicats a l&apos;elaboració de menjars i begudes preparats per al consum.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Negocis dedicats a l&apos;elaboració de menjars i begudes preparats per al consum.</rdfs:comment>
        <rdfs:label xml:lang="gl">Establecemento de restauración</rdfs:label>
        <rdfs:label xml:lang="es">Establecimiento de restauración</rdfs:label>
        <rdfs:label xml:lang="ca">Establiment de restauració</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Establiment de restauració</rdfs:label>
        <rdfs:label xml:lang="en">Food establishment</rdfs:label>
        <rdfs:label xml:lang="eu">Jatetxe-establezimendua</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#FoodStall -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#FoodStall">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment"/>
        <rdfs:comment xml:lang="eu">Eserlekurik gabeko saltokia, bezeroek mokadu arinak, edariak eta prestatutako janariak eros ditzaketena.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Parada sense seients on els clients poden comprar aperitius lleugers i begudes, així com menjars preparats.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Parada sense seients on els clients poden comprar aperitius lleugers i begudes, així com menjars preparats.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Posto sen sitio para sentar onde os clientes poden comprar aperitivos lixeiros e bebidas, así como comidas preparadas.</rdfs:comment>
        <rdfs:comment xml:lang="es">Puesto sin sitio para sentarse donde los clientes pueden comprar aperitivos ligeros y bebidas, así como comidas preparadas.</rdfs:comment>
        <rdfs:comment xml:lang="en">Stall without place for sitting from which customers can purchase light snacks and beverages, as well as fully prepared meals.</rdfs:comment>
        <rdfs:label xml:lang="en">Food stall</rdfs:label>
        <rdfs:label xml:lang="eu">Janari-postua</rdfs:label>
        <rdfs:label xml:lang="ca">Parada de menjar</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Parada de menjar</rdfs:label>
        <rdfs:label xml:lang="gl">Posto de comida</rdfs:label>
        <rdfs:label xml:lang="es">Puesto de comida</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#FootballField -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#FootballField">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#SportFacility"/>
        <rdfs:comment xml:lang="en">A sports venue designed and equipped for football, featuring a regulation-sized pitch and perimeter areas for spectators.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Futbolean aritzeko diseinatu eta hornitutako kirol-esparrua, arauzko neurriak dituen jokalekua eta publikoarentzako perimetro-eremuak dituena.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Recinte esportiu dissenyat i equipat per a la pràctica del futbol, amb un terreny de joc de dimensions reglamentàries i zones perimetrals per al públic.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Recinte esportiu dissenyat i equipat per a la pràctica del futbol, amb un terreny de joc de dimensions reglamentàries i zones perimetrals per al públic.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Recinto deportivo deseñado e equipado para a práctica do fútbol, que conta cun terreo de xogo de dimensións regulamentarias e zonas perimetrais para o público.</rdfs:comment>
        <rdfs:comment xml:lang="es">Recinto deportivo diseñado y equipado para la práctica del fútbol, que cuenta con un terreno de juego de dimensiones reglamentarias y zonas perimetrales para el público.</rdfs:comment>
        <rdfs:label xml:lang="ca">Camp de futbol</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Camp de futbol</rdfs:label>
        <rdfs:label xml:lang="es">Campo de fútbol</rdfs:label>
        <rdfs:label xml:lang="gl">Campo de fútbol</rdfs:label>
        <rdfs:label xml:lang="en">Football field</rdfs:label>
        <rdfs:label xml:lang="eu">Futbol-zelaia</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Forest -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Forest">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#naturalResourceContains"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Ecosistema donde la vegetación predominante la constituyen los árboles y arbustos.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Ecosistema on la vegetació predominant està constituïda per arbres i arbustos.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Ecosistema on la vegetació predominant està constituïda per arbres i arbustos.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Ecosistema onde a vexetación predominante está constituída por árbores e arbustos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Ecosystem where the predominant vegetation is trees and shrubs.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Landaredi nagusia zuhaitzek eta zuhaixkek osatzen duten ekosistema.</rdfs:comment>
        <rdfs:label xml:lang="eu">Basoa</rdfs:label>
        <rdfs:label xml:lang="ca">Bosc</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Bosc</rdfs:label>
        <rdfs:label xml:lang="es">Bosque</rdfs:label>
        <rdfs:label xml:lang="gl">Bosque</rdfs:label>
        <rdfs:label xml:lang="en">Forest</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#FrequentlyAskedQuestion -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#FrequentlyAskedQuestion">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#answer"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#question"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A structured set of question-and-answer pairs that collect and clarify the most common inquiries raised by users.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Conjunt estructurat de parelles de pregunta i resposta que recullen i aclareixen els dubtes més habituals dels usuaris.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Conjunt estructurat de parelles de pregunta i resposta que recullen i aclarixen els dubtes més habituals dels usuaris.</rdfs:comment>
        <rdfs:comment xml:lang="es">Conjunto estructurado de pares de pregunta y respuesta que recopilan y aclaran las dudas más habituales planteadas por los usuarios.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Conxunto estruturado de pares de pregunta e resposta que recompilan e aclaran as dúbidas máis habituais presentadas polos usuarios.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Erabiltzaileek izaten dituzten zalantza ohikoenak bildu eta argitzen dituen galdera-erantzun bikoteen multzo egituratua.</rdfs:comment>
        <rdfs:label xml:lang="en">Frequently Asked Question</rdfs:label>
        <rdfs:label xml:lang="eu">Ohiko galdera</rdfs:label>
        <rdfs:label xml:lang="es">Pregunta frecuente</rdfs:label>
        <rdfs:label xml:lang="gl">Pregunta frecuente</rdfs:label>
        <rdfs:label xml:lang="ca">Pregunta freqüent</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Pregunta freqüent</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Garden -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Garden">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">A landscaped area where plant species are cultivated, which may also include elements such as fountains, sculptures, or recreational spaces.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Landare-espezieak lantzen diren lurra, beste elementu batzuk ere izan ditzakeena, hala nola iturriak, eskulturak edo aisialdi-eremuak.</rdfs:comment>
        <rdfs:comment xml:lang="es">Terreno donde se cultivan especies vegetales, con posible añadidura de otros elementos como fuentes, esculturas o zonas de ocio.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Terreny on es cultiven espècies vegetals, amb la possible incorporació d&apos;altres elements com ara fonts, escultures o zones de lleure.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Terreny on es cultiven espècies vegetals, amb la possible incorporació d&apos;altres elements com ara fonts, escultures o zones de lleure.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Terreo onde se cultivan especies vexetais, coa posible incorporación doutros elementos como fontes, esculturas ou zonas de lecer.</rdfs:comment>
        <rdfs:label xml:lang="en">Garden</rdfs:label>
        <rdfs:label xml:lang="eu">Hiri-parkea</rdfs:label>
        <rdfs:label xml:lang="ca">Jardí</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Jardí</rdfs:label>
        <rdfs:label xml:lang="es">Jardín</rdfs:label>
        <rdfs:label xml:lang="eu">Lorategia</rdfs:label>
        <rdfs:label xml:lang="ca">Parc urbà</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Parc urbà</rdfs:label>
        <rdfs:label xml:lang="gl">Parque urbano</rdfs:label>
        <rdfs:label xml:lang="en">Urban park</rdfs:label>
        <rdfs:label xml:lang="gl">Xardín</rdfs:label>
        <skos:altLabel xml:lang="es">Parque urbano</skos:altLabel>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#GasStation -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#GasStation">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TransportInfrastructure"/>
        <rdfs:comment xml:lang="gl">Establecemento ou posto de venda no que se vende e subministra gasolina ou outros combustibles a vehículos automóbiles.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento o puesto de venta en el que se vende y suministra a vehículos automóviles gasolina u otros combustibles.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment o punt de venda on es ven i se subministra gasolina o altres combustibles a vehicles automòbils.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment o punt de venda on es ven i se subministra gasolina o altres combustibles a vehicles automòbils.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment or sales stand in which gasoline or other fuels are sold and supplied to automobile vehicles.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Motor-ibilgailuei gasolina edo beste erregai batzuk saltzen eta hornitzen dizkien establezimendua edo saltokia.</rdfs:comment>
        <rdfs:label xml:lang="ca">Benzinera</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Benzinera</rdfs:label>
        <rdfs:label xml:lang="en">Gas station</rdfs:label>
        <rdfs:label xml:lang="eu">Gasolindegia</rdfs:label>
        <rdfs:label xml:lang="gl">Gasolineira</rdfs:label>
        <rdfs:label xml:lang="es">Gasolinera</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#GastronomicMarket -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#GastronomicMarket">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment"/>
        <rdfs:comment xml:lang="eu">Janari- eta edari-postuak espazio komun batean biltzen dituen lekua, gourmet produktuak eta prestakinak kontsumitzeko.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Lloc on es reuneixen diferents parades de menjar i beguda en un espai comú on consumir productes i elaboracions de caràcter gurmet.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Lloc on es reunixen diferents parades de menjar i beguda en un espai comú on consumir productes i elaboracions de caràcter gurmet.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugar donde se reúnen diferentes puestos de comida y bebida en un espacio común donde consumir productos y elaboraciones de carácter gourmet.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugar onde se reúnen diferentes postos de comida e bebida nun espazo común no que consumir produtos e elaboracións de carácter gourmet.</rdfs:comment>
        <rdfs:comment xml:lang="en">Place where different food and drink stalls meet in a common space where you can consume gourmet products and preparations.</rdfs:comment>
        <rdfs:label xml:lang="en">Gastronomic market</rdfs:label>
        <rdfs:label xml:lang="es">Mercado gastronómico</rdfs:label>
        <rdfs:label xml:lang="gl">Mercado gastronómico</rdfs:label>
        <rdfs:label xml:lang="ca">Mercat gastronòmic</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Mercat gastronòmic</rdfs:label>
        <rdfs:label xml:lang="eu">Merkatu gastronomikoa</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#GastronomicResource -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#GastronomicResource">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismResource"/>
        <rdfs:comment xml:lang="en">Element related to gastronomy that holds tourism value due to its ability to represent culinary traditions, products, techniques, or food-related expressions, and to contribute to the identity and attractiveness of a destination</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Element vinculat a la gastronomia amb valor turístic per la seua capacitat de representar tradicions culinàries, productes, tècniques o manifestacions alimentàries i de contribuir a la identitat i l&apos;atractiu d&apos;una destinació.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Element vinculat a la gastronomia amb valor turístic per la seva capacitat de representar tradicions culinàries, productes, tècniques o manifestacions alimentàries i de contribuir a la identitat i l&apos;atractiu d&apos;una destinació.</rdfs:comment>
        <rdfs:comment xml:lang="es">Elemento vinculado a la gastronomía que posee valor turístico por su capacidad para representar tradiciones culinarias, productos, técnicas o manifestaciones alimentarias, y contribuir a la identidad y atractivo de un destino.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Elemento vinculado á gastronomía que posúe valor turístico pola súa capacidade para representar tradicións culinarias, produtos, técnicas ou manifestacións alimentarias e contribuír á identidade e ao atractivo dun destino.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Gastronomiari lotutako elementua, sukaldaritza-tradizioak, produktuak, teknikak edo elikadura-adierazpenak irudikatzeko eta helmuga baten nortasuna eta erakargarritasuna indartzeko duen gaitasunagatik turismo-balioa duena.</rdfs:comment>
        <rdfs:label xml:lang="eu">Baliabide gastronomikoa</rdfs:label>
        <rdfs:label xml:lang="en">Gastronomic resource</rdfs:label>
        <rdfs:label xml:lang="ca">Recurs gastronòmic</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Recurs gastronòmic</rdfs:label>
        <rdfs:label xml:lang="es">Recurso gastronómico</rdfs:label>
        <rdfs:label xml:lang="gl">Recurso gastronómico</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#GeneralStore -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#GeneralStore">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#GroceriesService"/>
        <rdfs:comment xml:lang="gl">Establecemento ou tenda comercial que vende diversos produtos alimenticios.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento o tienda comercial que vende diversos productos alimenticios.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment o botiga comercial que ven diversos productes alimentaris.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment o botiga comercial que ven diversos productes alimentaris.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment or commercial store that sells various food products.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Hainbat elikagai saltzen dituen establezimendua edo merkataritza-denda.</rdfs:comment>
        <rdfs:label xml:lang="ca">Botiga de queviures</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Botiga de queviures</rdfs:label>
        <rdfs:label xml:lang="en">General store</rdfs:label>
        <rdfs:label xml:lang="eu">Janari-denda</rdfs:label>
        <rdfs:label xml:lang="gl">Tenda de comestibles</rdfs:label>
        <rdfs:label xml:lang="es">Tienda de ultramarinos</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Geyser -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Geyser">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
        <rdfs:comment xml:lang="en">A special type of hot spring that periodically ejects a column of hot water and steam into the air.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Aldian behin ur berozko eta lurrunezko zutabe bat airera jaurtitzen duen iturri termal mota berezia.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Tipo especial de fonte termal que emite periodicamente unha columna de auga quente e vapor ao aire.</rdfs:comment>
        <rdfs:comment xml:lang="es">Tipo especial de fuente termal que emite periódicamente una columna de agua caliente y vapor al aire.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Tipus especial de font termal que emet periòdicament una columna d&apos;aigua calenta i vapor a l&apos;aire.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Tipus especial de font termal que emet periòdicament una columna d&apos;aigua calenta i vapor a l&apos;aire.</rdfs:comment>
        <rdfs:label xml:lang="eu">Geiserra</rdfs:label>
        <rdfs:label xml:lang="en">Geyser</rdfs:label>
        <rdfs:label xml:lang="ca">Guèiser</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Guèiser</rdfs:label>
        <rdfs:label xml:lang="es">Géiser</rdfs:label>
        <rdfs:label xml:lang="gl">Géiser</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Glamping -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Glamping">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment"/>
        <rdfs:comment xml:lang="en">A form of camping that combines the experience of staying outdoors with the comforts and amenities characteristic of high-end hotel establishments.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Aire zabalean kanpatzeko esperientzia goi-mailako hotel-establezimenduen erosotasunekin eta prestazioekin uztartzen duen kanpaldi-modalitatea.</rdfs:comment>
        <rdfs:comment xml:lang="es">Modalidad de acampada que combina la experiencia de acampar al aire libre con las comodidades y prestaciones propias de establecimientos hoteleros de alta categoría.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Modalidade de acampada que combina a experiencia de acampar ao aire libre coas comodidades e prestacións propias de establecementos hoteleiros de alta categoría.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Modalitat d&apos;acampada que combina l&apos;experiència d&apos;acampar a l&apos;aire lliure amb les comoditats i prestacions pròpies d&apos;establiments hotelers d&apos;alta categoria.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Modalitat d&apos;acampada que combina l&apos;experiència d&apos;acampar a l&apos;aire lliure amb les comoditats i prestacions pròpies d&apos;establiments hotelers d&apos;alta categoria.</rdfs:comment>
        <rdfs:label xml:lang="en">Glamping</rdfs:label>
        <rdfs:label xml:lang="es">Glamping</rdfs:label>
        <rdfs:label xml:lang="gl">Glamping</rdfs:label>
        <rdfs:label xml:lang="eu">Glampinga</rdfs:label>
        <rdfs:label xml:lang="ca">Glàmping</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Glàmping</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#GolfCourse -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#GolfCourse">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#SportFacility"/>
        <rdfs:comment xml:lang="eu">Golfean aritzeko aire zabaleko belar naturaleko eremu zabala.</rdfs:comment>
        <rdfs:comment xml:lang="en">Large outdoor natural grass area where golf is practiced.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Àrea àmplia de gespa natural a l&apos;aire lliure on es practica el golf.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Àrea àmplia de gespa natural a l&apos;aire lliure on es practica el golf.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Área ampla de herba natural ao aire libre onde se practica o golf.</rdfs:comment>
        <rdfs:comment xml:lang="es">Área amplia de hierba natural al aire libre donde se practica el golf.</rdfs:comment>
        <rdfs:label xml:lang="ca">Camp de golf</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Camp de golf</rdfs:label>
        <rdfs:label xml:lang="es">Campo de golf</rdfs:label>
        <rdfs:label xml:lang="gl">Campo de golf</rdfs:label>
        <rdfs:label xml:lang="en">Golf course</rdfs:label>
        <rdfs:label xml:lang="eu">Golf-zelaia</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#GroceriesService -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#GroceriesService">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#LocalBusiness"/>
        <rdfs:comment xml:lang="es">Espacios físicos que proporcionan a los consumidores un lugar accesible y conveniente donde se ofrecen productos alimenticios para su compra y consumo.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espais físics que proporcionen als consumidors un lloc accessible i pràctic on s&apos;ofereixen productes alimentaris per comprar-los i consumir-los.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espais físics que proporcionen als consumidors un lloc accessible i pràctic on s&apos;oferixen productes alimentaris per comprar-los i consumir-los.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazos físicos que proporcionan aos consumidores un lugar accesible e práctico onde se ofrecen produtos alimenticios para a súa compra e consumo.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Kontsumitzaileei elikagaiak erosteko eta kontsumitzeko leku irisgarri eta erosoa eskaintzen dieten espazio fisikoak.</rdfs:comment>
        <rdfs:comment xml:lang="en">Physical spaces that provide consumers with an accessible and convenient place where food products are offered for purchase and consumption.</rdfs:comment>
        <rdfs:label xml:lang="eu">Elikadura-zerbitzua</rdfs:label>
        <rdfs:label xml:lang="en">Groceries service</rdfs:label>
        <rdfs:label xml:lang="ca">Servei d&apos;alimentació</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Servici d&apos;alimentació</rdfs:label>
        <rdfs:label xml:lang="es">Servicio de alimentación</rdfs:label>
        <rdfs:label xml:lang="gl">Servizo de alimentación</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#GuestHouse -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#GuestHouse">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment"/>
        <rdfs:comment xml:lang="eu">Batez ere bertan ostatu hartzen duten bezeroei ostatua eta otorduak eskaintzen dizkien establezimendua.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento que ofrece aloxamento e comidas principalmente aos hóspedes aloxados.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento que ofrece alojamiento y comidas principalmente para los huéspedes alojados.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment que ofereix allotjament i àpats principalment als hostes allotjats.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment que oferix allotjament i àpats principalment als hostes allotjats.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment offering accommodation where meals are available mainly for accommodated guests.</rdfs:comment>
        <rdfs:label xml:lang="en">Guest house</rdfs:label>
        <rdfs:label xml:lang="ca">Pensió</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Pensió</rdfs:label>
        <rdfs:label xml:lang="es">Pensión</rdfs:label>
        <rdfs:label xml:lang="gl">Pensión</rdfs:label>
        <rdfs:label xml:lang="eu">Pentsioa</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Gym -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Gym">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#SportFacility"/>
        <rdfs:comment xml:lang="eu">Gimnasia egiteko eta kirol jakin batzuetan aritzeko instalazio eta tresna egokiez hornitutako lokala.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Local dotado das instalacións e dos aparellos adecuados para facer ximnasia e practicar certos deportes.</rdfs:comment>
        <rdfs:comment xml:lang="es">Local dotado de las instalaciones y los aparatos adecuados para hacer gimnasia y practicar ciertos deportes.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Local dotat de les instal·lacions i els aparells adequats per fer gimnàstica i practicar determinats esports.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Local dotat de les instal·lacions i els aparells adequats per fer gimnàstica i practicar determinats esports.</rdfs:comment>
        <rdfs:comment xml:lang="en">Local equipped with the appropriate facilities and equipment to do gymnastics and practice certain sports.</rdfs:comment>
        <rdfs:label xml:lang="es">Gimnasio</rdfs:label>
        <rdfs:label xml:lang="eu">Gimnasioa</rdfs:label>
        <rdfs:label xml:lang="ca">Gimnàs</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Gimnàs</rdfs:label>
        <rdfs:label xml:lang="en">Gym</rdfs:label>
        <rdfs:label xml:lang="gl">Ximnasio</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Hairdressing -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Hairdressing">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#MiscellaneousBusiness"/>
        <rdfs:comment xml:lang="gl">Establecemento no que se peitea, corta, arranxa e coida o cabelo.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento en el que se peina, se corta, se arregla y se cuida el cabello.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment on es pentina, es talla, s&apos;arregla i es cuida el cabell.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment on es pentina, es talla, s&apos;arregla i es cuida el cabell.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment where hair is combed, cut, groomed and cared for.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ilea orraztu, moztu, txukundu eta zaintzen den establezimendua.</rdfs:comment>
        <rdfs:label xml:lang="en">Hairdressing</rdfs:label>
        <rdfs:label xml:lang="eu">Ile-apaindegia</rdfs:label>
        <rdfs:label xml:lang="es">Peluquería</rdfs:label>
        <rdfs:label xml:lang="gl">Perrucaría</rdfs:label>
        <rdfs:label xml:lang="ca">Perruqueria</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Perruqueria</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Handicrafts -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Handicrafts">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#AgrotourismFacility"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#handicraftsType"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="ca">Botiga dedicada a vendre objectes o artefactes fets a mà o amb mitjans tradicionals o rudimentaris, amb habilitat, destresa, qualitat i creativitat.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Botiga dedicada a vendre objectes o artefactes fets a mà o amb mitjans tradicionals o rudimentaris, amb habilitat, destresa, qualitat i creativitat.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Eskuz edo bitarteko tradizional edo oinarrizkoekin trebetasunez, abileziaz, kalitatez eta sormenez egindako objektuak edo tresnak saltzen dituen denda.</rdfs:comment>
        <rdfs:comment xml:lang="en">Shop dedicated to the sale of objects or artifacts, done manually or with the use of traditional or rudimentary means, with skill, dexterity, quality and creativity.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Tenda dedicada á venda de obxectos ou artefactos realizados manualmente ou con medios tradicionais ou rudimentarios, con habilidade, destreza, calidade e creatividade.</rdfs:comment>
        <rdfs:comment xml:lang="es">Tienda que se dedica a la venta de objetos o artefactos, realizados manualmente o con medios tradicionales o rudimentarios, con habilidad, destreza, calidad y creatividad.</rdfs:comment>
        <rdfs:label xml:lang="eu">Artisautza-denda</rdfs:label>
        <rdfs:label xml:lang="ca">Botiga d&apos;artesania</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Botiga d&apos;artesania</rdfs:label>
        <rdfs:label xml:lang="en">Handicrafts</rdfs:label>
        <rdfs:label xml:lang="gl">Tenda de artesanía</rdfs:label>
        <rdfs:label xml:lang="es">Tienda de artesanías</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#HealthAndWellnessFacility -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#HealthAndWellnessFacility">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalTourismOrRelatedFacilityService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Espacio destinado a la prestación de servicios orientados a la salud, el bienestar físico y mental y la relajación, mediante tratamientos, terapias o actividades especializadas</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espai destinat a prestar serveis orientats a la salut, el benestar físic i mental i la relaxació, mitjançant tractaments, teràpies o activitats especialitzades</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espai destinat a prestar servicis orientats a la salut, el benestar físic i mental i la relaxació, mitjançant tractaments, teràpies o activitats especialitzades</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazo destinado á prestación de servizos orientados á saúde, ao benestar físico e mental e á relaxación, mediante tratamentos, terapias ou actividades especializadas</rdfs:comment>
        <rdfs:comment xml:lang="en">Facility intended for the provision of services aimed at health, physical and mental well-being, and relaxation, through specialized treatments, therapies, or activities.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Tratamendu, terapia edo jarduera espezializatuen bidez osasunera, ongizate fisiko eta mentalera eta erlaxaziora bideratutako zerbitzuak emateko espazioa</rdfs:comment>
        <rdfs:label xml:lang="en">Health and wellness facility</rdfs:label>
        <rdfs:label xml:lang="es">Instalación de salud y bienestar</rdfs:label>
        <rdfs:label xml:lang="gl">Instalación de saúde e benestar</rdfs:label>
        <rdfs:label xml:lang="ca">Instal·lació de salut i benestar</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Instal·lació de salut i benestar</rdfs:label>
        <rdfs:label xml:lang="eu">Osasun- eta ongizate-instalazioa</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#HealthResort -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#HealthResort">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HealthAndWellnessFacility"/>
        <rdfs:comment xml:lang="en">A health and wellness establishment that utilizes thermal or mineral waters for therapeutic, preventive, relaxation, and leisure purposes.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento de saúde e benestar que utiliza augas termais ou minerais con fins terapéuticos, preventivos, de relaxación e de lecer.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento de salud y bienestar que utiliza aguas termales o minerales con fines terapéuticos, preventivos, de relajación y de ocio.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment de salut i benestar que utilitza aigües termals o minerals amb finalitats terapèutiques, preventives, de relaxació i de lleure.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment de salut i benestar que utilitza aigües termals o minerals amb finalitats terapèutiques, preventives, de relaxació i de lleure.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ur termalak edo mineralak helburu terapeutikoekin, prebentzioarekin, erlaxazioarekin eta aisialdiarekin erabiltzen dituen osasun- eta ongizate-establezimendua.</rdfs:comment>
        <rdfs:label xml:lang="eu">Bainuetxea</rdfs:label>
        <rdfs:label xml:lang="ca">Balneari</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Balneari</rdfs:label>
        <rdfs:label xml:lang="es">Balneario</rdfs:label>
        <rdfs:label xml:lang="gl">Balneario</rdfs:label>
        <rdfs:label xml:lang="en">Health resort</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#Place"/>
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalHistoricalOrCulturalResourceService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalTourismResourceService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#paymentMethod"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#touristType"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#travelUnit"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#additionalClassification"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#maximumAttendeeCapacity"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#publicAccess"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Historiaren, arkeologiaren, arkitekturaren edo kulturaren ikuspegitik turistentzat balio esanguratsua duten lekuak, tokiak eta egiturak.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Llocs, indrets i estructures amb un valor significatiu per als turistes des del punt de vista històric, arqueològic, arquitectònic o cultural.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Llocs, indrets i estructures amb un valor significatiu per als turistes des del punt de vista històric, arqueològic, arquitectònic o cultural.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugares, sitios e estruturas que teñen un valor significativo para os turistas desde o punto de vista histórico, arqueolóxico, arquitectónico ou cultural.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugares, sitios y estructuras que tienen un valor significativo para los turistas desde el punto de vista histórico, arqueológico, arquitectónico o cultural.</rdfs:comment>
        <rdfs:comment xml:lang="en">Places, sites and structures that have significant value to tourists from a historical, archaeological, architectural or cultural point of view</rdfs:comment>
        <rdfs:label xml:lang="eu">Baliabide historiko edo kulturala</rdfs:label>
        <rdfs:label xml:lang="en">Historical or cultural resource</rdfs:label>
        <rdfs:label xml:lang="ca">Recurs històric o cultural</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Recurs històric o cultural</rdfs:label>
        <rdfs:label xml:lang="es">Recurso histórico o cultural</rdfs:label>
        <rdfs:label xml:lang="gl">Recurso histórico ou cultural</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#HolidayPackage -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#HolidayPackage">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismService"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#offeredBy"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismIntermediary"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#itinerary"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#Itinerary"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#includes"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#isAllinclusive"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#notIncluded"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Bidaia-agentzien bidez soilik merkaturatzen den esperientzia, bezeroak prezio bat ordainduta bi turismo-zerbitzu edo gehiago (ostatua, mantenua edo garraioa) biltzen dituena.</rdfs:comment>
        <rdfs:comment xml:lang="en">Experience that is marketed only through travel agencies that contains two or more tourist services (accommodation, maintenance or transportation) for which the client pays a price.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Experiencia comercializada unicamente por medio das axencias de viaxes que contén dous ou máis servizos turísticos (aloxamento, manutención ou transporte) polos que o cliente aboa un prezo.</rdfs:comment>
        <rdfs:comment xml:lang="es">Experiencia que se comercializa únicamente por medio de las agencias de viajes que contiene dos o más servicios de carácter turístico (alojamiento, manutención o transporte) por el que el cliente abona un precio.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Experiència comercialitzada únicament per mitjà d&apos;agències de viatges que conté dos o més serveis turístics (allotjament, manutenció o transport) pels quals el client abona un preu.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Experiència comercialitzada únicament per mitjà d&apos;agències de viatges que conté dos o més servicis turístics (allotjament, manutenció o transport) pels quals el client abona un preu.</rdfs:comment>
        <rdfs:label xml:lang="en">Holiday package</rdfs:label>
        <rdfs:label xml:lang="ca">Paquet turístic</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Paquet turístic</rdfs:label>
        <rdfs:label xml:lang="es">Paquete turístico</rdfs:label>
        <rdfs:label xml:lang="gl">Paquete turístico</rdfs:label>
        <rdfs:label xml:lang="eu">Turismo-paketea</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Hostal -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Hostal">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment"/>
        <rdfs:comment xml:lang="gl">Establecemento de aloxamento turístico que proporciona servizos básicos de hospedaxe, cunha categoría e un nivel de servizos inferiores aos dun hotel.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento de alojamiento turístico que proporciona servicios básicos de hospedaje, con una categoría y nivel de servicios inferiores a los de un hotel.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment d&apos;allotjament turístic que proporciona serveis bàsics d&apos;hostalatge, amb una categoria i un nivell de serveis inferiors als d&apos;un hotel.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment d&apos;allotjament turístic que proporciona servicis bàsics d&apos;hostalatge, amb una categoria i un nivell de servicis inferiors als d&apos;un hotel.</rdfs:comment>
        <rdfs:comment xml:lang="en">HA tourist accommodation establishment that provides basic lodging services, with a category and level of amenities lower than those of a hotel.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Oinarrizko ostatu-zerbitzuak ematen dituen ostatu turistikoaren establezimendua, hotel batena baino kategoria eta zerbitzu-maila txikiagokoa.</rdfs:comment>
        <rdfs:label xml:lang="ca">Hostal</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Hostal</rdfs:label>
        <rdfs:label xml:lang="en">Hostal</rdfs:label>
        <rdfs:label xml:lang="es">Hostal</rdfs:label>
        <rdfs:label xml:lang="gl">Hostal</rdfs:label>
        <rdfs:label xml:lang="eu">Hostala</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Hostel -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Hostel">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment"/>
        <rdfs:comment xml:lang="eu">Egonaldi laburretarako hotel-establezimendua, oro har igarobide edo leku estrategiko batean kokatua.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento hoteleiro para estadías curtas, xeralmente situado nun lugar de paso ou estratéxico.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento hotelero para estancias cortas, generalmente situado en un lugar de paso o estratégico.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment hoteler per a estades curtes, generalment situat en un lloc de pas o estratègic.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment hoteler per a estades curtes, generalment situat en un lloc de pas o estratègic.</rdfs:comment>
        <rdfs:comment xml:lang="en">Hotel establishment for short stays, generally located in a transit or strategic location.</rdfs:comment>
        <rdfs:label xml:lang="ca">Alberg</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Alberg</rdfs:label>
        <rdfs:label xml:lang="es">Albergue</rdfs:label>
        <rdfs:label xml:lang="gl">Albergue</rdfs:label>
        <rdfs:label xml:lang="eu">Aterpetxea</rdfs:label>
        <rdfs:label xml:lang="en">Hostel</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Hotel -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Hotel">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#parador"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Commercial establishment providing at least reception, accommodation and guest services, recognized or registered as such in the applicable legislation. It might also offer food and beverage services and/or other ancillary services.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento comercial que ofrece, como mínimo, servizos de recepción, aloxamento e atención ao hóspede, recoñecido ou rexistrado como tal na lexislación aplicable. Tamén pode ofrecer servizos de restauración e/ou outros servizos auxiliares.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento comercial que ofrece, como mínimo, servicios de recepción, alojamiento y atención al huésped, reconocido o registrado como tal en la legislación aplicable. También puede ofrecer servicios de restauración y/u otros servicios auxiliares.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment comercial que ofereix, com a mínim, serveis de recepció, allotjament i atenció a l&apos;hoste, reconegut o registrat com a tal en la legislació aplicable. També pot oferir serveis de restauració i/o altres serveis auxiliars.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment comercial que oferix, com a mínim, servicis de recepció, allotjament i atenció a l&apos;hoste, reconegut o registrat com a tal en la legislació aplicable. També pot oferir servicis de restauració i/o altres servicis auxiliars.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Gutxienez harrera-, ostatu- eta bezeroarentzako arreta-zerbitzuak eskaintzen dituen merkataritza-establezimendua, aplikatzekoa den legerian hala aitortua edo erregistratua. Jatetxe-zerbitzuak eta/edo bestelako zerbitzu lagungarriak ere eskain ditzake.</rdfs:comment>
        <rdfs:label xml:lang="ca">Hotel</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Hotel</rdfs:label>
        <rdfs:label xml:lang="en">Hotel</rdfs:label>
        <rdfs:label xml:lang="es">Hotel</rdfs:label>
        <rdfs:label xml:lang="gl">Hotel</rdfs:label>
        <rdfs:label xml:lang="eu">Hotela</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#IceCreamShop -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#IceCreamShop">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment"/>
        <rdfs:comment xml:lang="gl">Establecemento no que se comercializan e serven xeados.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento en el que se comercializan y se sirven helados.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment on es comercialitzen i se serveixen gelats.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment on es comercialitzen i se servixen gelats.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment in which ice cream is sold and served.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Izozkiak saltzen eta zerbitzatzen diren establezimendua.</rdfs:comment>
        <rdfs:label xml:lang="ca">Gelateria</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Gelateria</rdfs:label>
        <rdfs:label xml:lang="es">Heladería</rdfs:label>
        <rdfs:label xml:lang="en">Ice cream shop</rdfs:label>
        <rdfs:label xml:lang="eu">Izozki-denda</rdfs:label>
        <rdfs:label xml:lang="gl">Xeadaría</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Inn -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Inn">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment"/>
        <rdfs:comment xml:lang="gl">Establecemento no que se preparan e serven comidas e que está decorado de forma tradicional e rústica.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento en el que se preparan y sirven comidas y que está decorado de forma tradicional y rústica.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment on es preparen i se serveixen àpats i que està decorat de manera tradicional i rústica.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment on es preparen i se servixen àpats i que està decorat de manera tradicional i rústica.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment in which meals are prepared and served and which is decorated in a traditional and rustic way.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Janariak prestatu eta zerbitzatzen diren establezimendua, modu tradizional eta landatarrean apaindua.</rdfs:comment>
        <rdfs:label xml:lang="ca">Fonda</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Fonda</rdfs:label>
        <rdfs:label xml:lang="eu">Jatetxe tradizionala</rdfs:label>
        <rdfs:label xml:lang="es">Mesón</rdfs:label>
        <rdfs:label xml:lang="gl">Mesón</rdfs:label>
        <rdfs:label xml:lang="en">inn</rdfs:label>
        <skos:altLabel xml:lang="es">Venta</skos:altLabel>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#InterpretationCentre -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#InterpretationCentre">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#EducationalFacility"/>
        <rdfs:comment xml:lang="es">Espacio que revela el significado y la relación del patrimonio con el visitante que llega hasta el sitio turístico que lo contiene.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espai que revela el significat i la relació del patrimoni amb el visitant que arriba al lloc turístic que el conté.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espai que revela el significat i la relació del patrimoni amb el visitant que arriba al lloc turístic que el conté.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazo que revela o significado e a relación do patrimonio co visitante que chega ao sitio turístico que o contén.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ondarea dagoen turismo-lekura iristen den bisitariari ondarearen esanahia eta harekiko lotura azaltzen dizkion espazioa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Space that reveals the meaning and relationship of heritage with the visitor who arrives at the tourist site that contains it.</rdfs:comment>
        <rdfs:label xml:lang="ca">Centre d&apos;interpretació</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Centre d&apos;interpretació</rdfs:label>
        <rdfs:label xml:lang="es">Centro de interpretación</rdfs:label>
        <rdfs:label xml:lang="gl">Centro de interpretación</rdfs:label>
        <rdfs:label xml:lang="en">Interpretation centre</rdfs:label>
        <rdfs:label xml:lang="eu">Interpretazio-zentroa</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Itinerary -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Itinerary">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasItineraryElement"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#ItineraryElement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasItineraryElement"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#ItineraryElement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A collection of points of interest involved in a route or tourism service.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Colección de puntos de interese de referencia asociados á realización dunha ruta ou servizo turístico.</rdfs:comment>
        <rdfs:comment xml:lang="es">Colección de puntos de interés de referencia asociados a la realización de una ruta o servicio turístico.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Col·lecció de punts d&apos;interès de referència associats a la realització d&apos;una ruta o servei turístic.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Col·lecció de punts d&apos;interès de referència associats a la realització d&apos;una ruta o servici turístic.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ibilbide edo turismo-zerbitzu bat egiteari lotutako erreferentziazko interesguneen bilduma.</rdfs:comment>
        <rdfs:label xml:lang="eu">Ibilbidea</rdfs:label>
        <rdfs:label xml:lang="ca">Itinerari</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Itinerari</rdfs:label>
        <rdfs:label xml:lang="es">Itinerario</rdfs:label>
        <rdfs:label xml:lang="gl">Itinerario</rdfs:label>
        <rdfs:label xml:lang="en">Itinerary</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#ItineraryElement -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#ItineraryElement">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#refPointOfInterest"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Event"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Place"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#refPointOfInterestAsText"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#position"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A point of interest with, optionally, the position or numerical order it occupies in the sequence of an itinerary.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Erreferentziazko interesgune bat, aukeran ibilbide baten sekuentzian duen posizioa edo zenbakizko ordena adierazita.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Un punt d&apos;interès de referència amb, opcionalment, la posició o l&apos;ordre numèric que ocupa en la seqüència d&apos;un itinerari.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Un punt d&apos;interès de referència amb, opcionalment, la posició o l&apos;ordre numèric que ocupa en la seqüència d&apos;un itinerari.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Un punto de interese de referencia con, opcionalmente, a posición ou orde numérica que ocupa na secuencia dun itinerario.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un punto de interés de referencia con, opcionalmente, la posición u orden numérico que ocupa en la secuencia de un itinerario.</rdfs:comment>
        <rdfs:label xml:lang="ca">Element d&apos;un itinerari</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Element d&apos;un itinerari</rdfs:label>
        <rdfs:label xml:lang="es">Elemento de un itinerario</rdfs:label>
        <rdfs:label xml:lang="gl">Elemento dun itinerario</rdfs:label>
        <rdfs:label xml:lang="eu">Ibilbide bateko elementua</rdfs:label>
        <rdfs:label xml:lang="en">Itinerary element</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#JewelryAndWatches -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#JewelryAndWatches">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#RetailAndFashionBusiness"/>
        <rdfs:comment xml:lang="eu">Bitxiak eta erlojuak saltzen diren establezimendua</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento onde se venden xoias e reloxos</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento donde se venden joyas y relojes</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment on es venen joies i rellotges</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment on es venen joies i rellotges</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment where jewelry and watches are sold</rdfs:comment>
        <rdfs:label xml:lang="eu">Bitxi- eta erloju-denda</rdfs:label>
        <rdfs:label xml:lang="en">Jewelry and watches</rdfs:label>
        <rdfs:label xml:lang="ca">Joieria i rellotgeria</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Joieria i rellotgeria</rdfs:label>
        <rdfs:label xml:lang="es">Joyería y relojería</rdfs:label>
        <rdfs:label xml:lang="gl">Xoiaría e reloxaría</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Karaoke -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Karaoke">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PartyAndEntertainmentFacility"/>
        <rdfs:comment xml:lang="eu">Karaokerako instalazioak dituen lokal publikoa; karaoke-ekipoa grabatutako musika baten gainean abestiak interpretatzeko erabiltzen da, pantaila batean agertzen den hitzei jarraituz.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Local públic amb instal·lacions per a karaoke, equip que s&apos;utilitza per interpretar cançons sobre un fons musical enregistrat mentre se segueix la lletra que apareix en una pantalla.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Local públic amb instal·lacions per a karaoke, equip que s&apos;utilitza per interpretar cançons sobre un fons musical enregistrat mentre se seguix la lletra que apareix en una pantalla.</rdfs:comment>
        <rdfs:comment xml:lang="es">Local público con instalaciones para karaoke, equipo que se usa para interpretar canciones sobre un fondo musical grabado, mientras se sigue la letra que aparece en una pantalla.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Local público con instalacións para karaoke, equipo que se usa para interpretar cancións sobre un fondo musical gravado mentres se segue a letra que aparece nunha pantalla.</rdfs:comment>
        <rdfs:comment xml:lang="en">Public venue with karaoke facilities, equipment used to perform songs over a recorded musical background, while following the lyrics that appear on a screen.</rdfs:comment>
        <rdfs:label xml:lang="ca">Karaoke</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Karaoke</rdfs:label>
        <rdfs:label xml:lang="en">Karaoke</rdfs:label>
        <rdfs:label xml:lang="es">Karaoke</rdfs:label>
        <rdfs:label xml:lang="gl">Karaoke</rdfs:label>
        <rdfs:label xml:lang="eu">Karaokea</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#KartsCircuit -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#KartsCircuit">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#SportFacility"/>
        <rdfs:comment xml:lang="es">Espacio provisto de una o varias pistas preparadas para disputar carreras con estos vehículos.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espai proveït d&apos;una o diverses pistes preparades per disputar curses amb aquests vehicles.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espai proveït d&apos;una o diverses pistes preparades per disputar curses amb estos vehicles.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazo provisto dunha ou varias pistas preparadas para disputar carreiras con estes vehículos.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ibilgailu horiekin lasterketak egiteko prestatutako pista bat edo gehiago dituen espazioa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Space provided with one or more tracks prepared to compete in races with these vehicles.</rdfs:comment>
        <rdfs:label xml:lang="ca">Circuit de karts</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Circuit de karts</rdfs:label>
        <rdfs:label xml:lang="es">Circuito de karts</rdfs:label>
        <rdfs:label xml:lang="gl">Circuíto de karts</rdfs:label>
        <rdfs:label xml:lang="eu">Kart-zirkuitua</rdfs:label>
        <rdfs:label xml:lang="en">Karts circuit</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Keyword -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Keyword">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#name"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Keyword used to describe tourism entities</rdfs:comment>
        <rdfs:comment xml:lang="es">Palabra clave utilizada para describir entidades turísticas</rdfs:comment>
        <rdfs:comment xml:lang="gl">Palabra clave utilizada para describir entidades turísticas</rdfs:comment>
        <rdfs:comment xml:lang="ca">Paraula clau utilitzada per descriure entitats turístiques</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Paraula clau utilitzada per descriure entitats turístiques</rdfs:comment>
        <rdfs:comment xml:lang="eu">Turismo-entitateak deskribatzeko erabiltzen den gako-hitza</rdfs:comment>
        <rdfs:label xml:lang="eu">Gako-hitza</rdfs:label>
        <rdfs:label xml:lang="en">Keyword</rdfs:label>
        <rdfs:label xml:lang="es">Palabra clave</rdfs:label>
        <rdfs:label xml:lang="gl">Palabra clave</rdfs:label>
        <rdfs:label xml:lang="ca">Paraula clau</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Paraula clau</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Kiosk -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Kiosk">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#RetailAndFashionBusiness"/>
        <rdfs:comment xml:lang="eu">Egunkariak, aldizkariak, gozokiak eta bestelako gaiak saltzeko merkataritza-lokal txikia.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Local comercial de pequeno tamaño destinado á venda de xornais, revistas, lambetadas e outros artigos.</rdfs:comment>
        <rdfs:comment xml:lang="es">Local comercial de pequeño tamaño destinado a la venta de periódicos, revistas, golosinas y otros artículos.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Petit local comercial destinat a vendre diaris, revistes, llaminadures i altres articles.</rdfs:comment>
        <rdfs:comment xml:lang="en">Small commercial premises for the sale of newspapers, magazines, candy and other items.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Xicotet local comercial destinat a vendre diaris, revistes, llaminadures i altres articles.</rdfs:comment>
        <rdfs:label xml:lang="en">Kiosk</rdfs:label>
        <rdfs:label xml:lang="eu">Kioskoa</rdfs:label>
        <rdfs:label xml:lang="ca">Quiosc</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Quiosc</rdfs:label>
        <rdfs:label xml:lang="es">Quiosco</rdfs:label>
        <rdfs:label xml:lang="gl">Quiosco</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Label -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Label">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#Acknowledgement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasDescription"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#Description"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#labelType"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Aquellos reconocimientos que el propio establecimiento se otorga, o que son obtenidos a través de una membresía.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Establezimenduak bere buruari ematen dizkion edo kidetza baten bidez lortzen diren aitorpenak.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Reconeixements que el mateix establiment s&apos;atorga o que s&apos;obtenen per la pertinença a una organització.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Reconeixements que el mateix establiment s&apos;atorga o que s&apos;obtenen per la pertinença a una organització.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Recoñecementos que o propio establecemento se outorga ou que se obteñen a través dunha afiliación.</rdfs:comment>
        <rdfs:comment xml:lang="en">Those recognitions that the establishment itself grants, or that are obtained through a membership.</rdfs:comment>
        <rdfs:label xml:lang="eu">Bereizgarria</rdfs:label>
        <rdfs:label xml:lang="ca">Distintiu</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Distintiu</rdfs:label>
        <rdfs:label xml:lang="es">Distintivo</rdfs:label>
        <rdfs:label xml:lang="gl">Distintivo</rdfs:label>
        <rdfs:label xml:lang="en">Label</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Lake -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Lake">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasLakeService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Gran masa permanente de agua depositada en depresiones del terreno.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Gran masa permanente de auga depositada en depresións do terreo.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Gran massa permanent d&apos;aigua dipositada en depressions del terreny.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Gran massa permanent d&apos;aigua dipositada en depressions del terreny.</rdfs:comment>
        <rdfs:comment xml:lang="en">Large permanent mass of water deposited in depressions in the ground.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Lurreko sakonuneetan metatutako ur-masa handi iraunkorra.</rdfs:comment>
        <rdfs:label xml:lang="es">Lago</rdfs:label>
        <rdfs:label xml:lang="gl">Lago</rdfs:label>
        <rdfs:label xml:lang="en">Lake</rdfs:label>
        <rdfs:label xml:lang="eu">Lakua</rdfs:label>
        <rdfs:label xml:lang="ca">Llac</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Llac</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Landscape -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Landscape">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
        <rdfs:comment xml:lang="es">A natural space that is remarkable for its artistic beauty.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Bere edertasun artistikoagatik nabarmentzen den natura-espazioa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Espacio natural admirable por su aspecto artístico.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espai natural que destaca per la seua bellesa artística.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espai natural que destaca per la seva bellesa artística.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazo natural que destaca pola súa beleza artística.</rdfs:comment>
        <rdfs:label xml:lang="en">Landscape</rdfs:label>
        <rdfs:label xml:lang="eu">Paisaia</rdfs:label>
        <rdfs:label xml:lang="es">Paisaje</rdfs:label>
        <rdfs:label xml:lang="ca">Paisatge</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Paisatge</rdfs:label>
        <rdfs:label xml:lang="gl">Paisaxe</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#LeisureAndCultureFacility -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#LeisureAndCultureFacility">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalLeisureAndCultureFacilityService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalTourismOrRelatedFacilityService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Espacios destinados a actividades recreativas, artísticas y culturales que ofrecen oportunidades para el entretenimiento, la diversión y la apreciación de diversas formas de expresión artística y cultural.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espais destinats a activitats recreatives, artístiques i culturals que ofereixen oportunitats per a l&apos;entreteniment, la diversió i l&apos;apreciació de diverses formes d&apos;expressió artística i cultural.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espais destinats a activitats recreatives, artístiques i culturals que oferixen oportunitats per a l&apos;entreteniment, la diversió i l&apos;apreciació de diverses formes d&apos;expressió artística i cultural.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazos destinados a actividades recreativas, artísticas e culturais que ofrecen oportunidades para o entretemento, a diversión e a apreciación de diversas formas de expresión artística e cultural.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Jolas-, arte- eta kultura-jardueretarako espazioak, entretenitzeko, dibertitzeko eta askotariko adierazpen artistikoak eta kulturalak balioesteko aukerak eskaintzen dituztenak.</rdfs:comment>
        <rdfs:comment xml:lang="en">Spaces for recreational, artistic and cultural activities that offer opportunities for entertainment, fun and appreciation of various forms of artistic and cultural expression.</rdfs:comment>
        <rdfs:label xml:lang="gl">Instalación de cultura e lecer</rdfs:label>
        <rdfs:label xml:lang="es">Instalación de cultura y ocio</rdfs:label>
        <rdfs:label xml:lang="ca">Instal·lació de cultura i lleure</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Instal·lació de cultura i lleure</rdfs:label>
        <rdfs:label xml:lang="eu">Kultura- eta aisialdi-instalazioa</rdfs:label>
        <rdfs:label xml:lang="en">Leisure and culture facility</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Library -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Library">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#LeisureAndCultureFacility"/>
        <rdfs:comment xml:lang="en">A place dedicated to the acquisition, preservation, study, and display of books and documents.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Liburuak eta dokumentuak eskuratzea, kontserbatzea, aztertzea eta erakustea helburu duen lekua.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Lloc que té com a finalitat adquirir, conservar, estudiar i exposar llibres i documents.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Lloc que té com a finalitat adquirir, conservar, estudiar i exposar llibres i documents.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugar cuxa finalidade consiste na adquisición, conservación, estudo e exposición de libros e documentos.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugar cuya finalidad consiste en la adquisición, conservación, estudio y exposición de libros y documentos.</rdfs:comment>
        <rdfs:label xml:lang="ca">Biblioteca</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Biblioteca</rdfs:label>
        <rdfs:label xml:lang="es">Biblioteca</rdfs:label>
        <rdfs:label xml:lang="gl">Biblioteca</rdfs:label>
        <rdfs:label xml:lang="en">Library</rdfs:label>
        <rdfs:label xml:lang="eu">Liburutegia</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#LocalBusiness -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#LocalBusiness">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
        <rdfs:comment xml:lang="en">Company or commercial establishment that operates in a specific physical location that provides products or services.</rdfs:comment>
        <rdfs:comment xml:lang="es">Empresa o establecimiento comercial que opera en una ubicación física específica que proporciona productos o servicios.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Empresa o establiment comercial que opera en una ubicació física específica i proporciona productes o serveis.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Empresa o establiment comercial que opera en una ubicació física específica i proporciona productes o servicis.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Empresa ou establecemento comercial que opera nunha localización física específica e proporciona produtos ou servizos.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Kokapen fisiko jakin batean jarduten duen eta produktuak edo zerbitzuak eskaintzen dituen enpresa edo merkataritza-establezimendua.</rdfs:comment>
        <rdfs:label xml:lang="en">Local business</rdfs:label>
        <rdfs:label xml:lang="ca">Negoci local</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Negoci local</rdfs:label>
        <rdfs:label xml:lang="es">Negocio local</rdfs:label>
        <rdfs:label xml:lang="gl">Negocio local</rdfs:label>
        <rdfs:label xml:lang="eu">Tokiko negozioa</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Location -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Location">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#municipality"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#autonomousCommunity"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#country"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#locality"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#postalCode"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#province"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#streetAddress"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#county"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#island"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Leku baten kokapen fisikoari buruzko informazioa ematen du.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Proporciona informació sobre la ubicació física d&apos;un lloc.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Proporciona informació sobre la ubicació física d&apos;un lloc.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Proporciona información sobre a localización física dun lugar.</rdfs:comment>
        <rdfs:comment xml:lang="es">Proporciona información sobre la ubicación física de un lugar.</rdfs:comment>
        <rdfs:comment xml:lang="en">Provides information about the physical location of a place.</rdfs:comment>
        <rdfs:label xml:lang="eu">Kokapena</rdfs:label>
        <rdfs:label xml:lang="ca">Localització</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Localització</rdfs:label>
        <rdfs:label xml:lang="es">Localización</rdfs:label>
        <rdfs:label xml:lang="gl">Localización</rdfs:label>
        <rdfs:label xml:lang="en">Location</rdfs:label>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Lodge -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Lodge">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment"/>
        <rdfs:comment xml:lang="gl">Establecemento hoteleiro formado por varias unidades de aloxamento independentes (bungalós, cabanas, vilas) edificadas en contornos naturais e construídas con materiais propios do lugar, normalmente madeira, cuxo fin é achegar o cliente á natureza.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento hotelero formado por varias unidades independientes alojativas (bungalows, cabañas, villas) edificadas en entornos naturales y construidos con materiales propios del lugar, normalmente madera, cuyo fin es acercar al cliente a la naturaleza.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment hoteler format per diverses unitats d&apos;allotjament independents (bungalous, cabanes, vil·les) edificades en entorns naturals i construïdes amb materials propis del lloc, normalment fusta, amb la finalitat d&apos;apropar el client a la natura.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment hoteler format per diverses unitats d&apos;allotjament independents (bungalous, cabanes, vil·les) edificades en entorns naturals i construïdes amb materials propis del lloc, normalment fusta, amb la finalitat d&apos;apropar el client a la natura.</rdfs:comment>
        <rdfs:comment xml:lang="en">Hotel establishment made up of several independent accommodation units (bungalows, cabins, villas) built in natural environments and built with local materials, usually wood, whose purpose is to bring the client closer to nature.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Natura-inguruneetan tokiko materialekin, normalean zurez, eraikitako ostatu-unitate independente batzuez (bungalowak, etxolak, txaletak) osatutako hotel-establezimendua, bezeroa naturara hurbiltzea helburu duena.</rdfs:comment>
        <rdfs:label xml:lang="ca">Lodge</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Lodge</rdfs:label>
        <rdfs:label xml:lang="en">Lodge</rdfs:label>
        <rdfs:label xml:lang="es">Lodge</rdfs:label>
        <rdfs:label xml:lang="gl">Lodge</rdfs:label>
        <rdfs:label xml:lang="eu">Lodge ostatua</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#LodgingService -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#LodgingService">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismService"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#relatedTourismOrRelatedFacility"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#averagePricePerPerson"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#numberOfAccommodationUnits"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#numberOfBeds"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A proposal of a tourism organisation to sell a specific set of products (accommodation) or services under specific conditions or rates, for a certain price.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Proposta d&apos;una organització turística per vendre un conjunt específic de productes (hostalatge) o serveis en condicions o tarifes específiques, per un preu determinat.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Proposta d&apos;una organització turística per vendre un conjunt específic de productes (hostalatge) o servicis en condicions o tarifes específiques, per un preu determinat.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Proposta dunha organización turística para vender un conxunto específico de produtos (hospedaxe) ou servizos en condicións ou tarifas específicas, por un prezo determinado.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Turismo-erakunde baten proposamena, produktu (ostatua) edo zerbitzu multzo jakin bat baldintza edo tarifa zehatzetan eta prezio jakin baten truke saltzeko.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una propuesta de una organización turística para vender un conjunto específico de productos (hospedaje) o servicios en condiciones o tarifas específicas, por un precio determinado.</rdfs:comment>
        <rdfs:label xml:lang="en">Lodging service</rdfs:label>
        <rdfs:label xml:lang="eu">Ostatu-zerbitzua</rdfs:label>
        <rdfs:label xml:lang="ca">Servei d&apos;hostalatge</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Servici d&apos;hostalatge</rdfs:label>
        <rdfs:label xml:lang="es">Servicio de hospedaje</rdfs:label>
        <rdfs:label xml:lang="gl">Servizo de hospedaxe</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#LuggageStorage -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#LuggageStorage">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#MiscellaneousBusiness"/>
        <rdfs:comment xml:lang="eu">Ekipajea modu seguruan eta denbora laburrez gordetzeko erreserbatutako lekuak.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Llocs reservats per guardar l&apos;equipatge de manera segura i durant períodes curts.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Llocs reservats per guardar l&apos;equipatge de manera segura i durant períodes curts.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugares reservados para gardar a equipaxe de forma segura e durante períodos curtos.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugares reservados para guardar el equipaje de forma segura y para espacios de tiempo cortos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Reserved places to store luggage safely and for short periods of time.</rdfs:comment>
        <rdfs:label xml:lang="ca">Consigna d&apos;equipatge</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Consigna d&apos;equipatge</rdfs:label>
        <rdfs:label xml:lang="es">Consigna de equipaje</rdfs:label>
        <rdfs:label xml:lang="gl">Consigna de equipaxe</rdfs:label>
        <rdfs:label xml:lang="eu">Ekipaje-gordailua</rdfs:label>
        <rdfs:label xml:lang="en">Lugagge storage</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#MassageCentre -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#MassageCentre">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HealthAndWellnessFacility"/>
        <rdfs:comment xml:lang="en">Business that provides relaxation, health and body well-being services through therapeutic and anti-stress massages.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Masaje terapeutikoen eta estresaren aurkako masajeen bidez erlaxazio-, osasun- eta gorputz-ongizateko zerbitzuak eskaintzen dituen negozioa.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Negoci que ofereix serveis de relaxació, salut i benestar corporal mitjançant massatges terapèutics i antiestrès.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Negoci que oferix servicis de relaxació, salut i benestar corporal mitjançant massatges terapèutics i antiestrès.</rdfs:comment>
        <rdfs:comment xml:lang="es">Negocio que brinda los servicios de relax, salud y bienestar corporal por medio de masajes terapéuticos y anti estrés.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Negocio que ofrece servizos de relaxación, saúde e benestar corporal mediante masaxes terapéuticas e antiestrés.</rdfs:comment>
        <rdfs:label xml:lang="ca">Centre de massatges</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Centre de massatges</rdfs:label>
        <rdfs:label xml:lang="es">Centro de masajes</rdfs:label>
        <rdfs:label xml:lang="gl">Centro de masaxes</rdfs:label>
        <rdfs:label xml:lang="eu">Masaje-zentroa</rdfs:label>
        <rdfs:label xml:lang="en">Massage centre</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#MedicalBusiness -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#MedicalBusiness">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#LocalBusiness"/>
        <rdfs:comment xml:lang="ca">Atenció i cura de la salut proporcionades per professionals sanitaris per mantenir, promoure i restablir la salut de les persones, prevenir malalties i lesions i oferir diagnòstic, tractament i seguiment mèdic.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Atenció i cura de la salut proporcionades per professionals sanitaris per mantenir, promoure i restablir la salut de les persones, prevenir malalties i lesions i oferir diagnòstic, tractament i seguiment mèdic.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Atención e coidado da saúde proporcionados por profesionais sanitarios para manter, promover e restablecer a saúde das persoas, previr enfermidades e lesións e ofrecer diagnóstico, tratamento e seguimento médico.</rdfs:comment>
        <rdfs:comment xml:lang="es">Atención y cuidado de la salud proporcionados por profesionales de la salud para mantener, promover y restablecer la salud de las personas, prevenir enfermedades y lesiones, y brindar diagnóstico, tratamiento y seguimiento médico.</rdfs:comment>
        <rdfs:comment xml:lang="en">Health care and care provided by health professionals to maintain, promote and restore people&apos;s health, prevent illness and injury, and provide diagnosis, treatment and medical follow-up.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Osasun-profesionalek emandako osasun-arreta eta -zaintza, pertsonen osasuna mantentzeko, sustatzeko eta berreskuratzeko, gaixotasunak eta lesioak prebenitzeko eta diagnostikoa, tratamendua eta mediku-jarraipena eskaintzeko.</rdfs:comment>
        <rdfs:label xml:lang="en">Medical business</rdfs:label>
        <rdfs:label xml:lang="eu">Medikuntza-negozioa</rdfs:label>
        <rdfs:label xml:lang="ca">Negoci mèdic</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Negoci mèdic</rdfs:label>
        <rdfs:label xml:lang="es">Negocio médico</rdfs:label>
        <rdfs:label xml:lang="gl">Negocio médico</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Minaret -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Minaret">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">A tower of a mosque from which the muezzin calls Muslims to prayer.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Meskitetako dorrea, handik muezinak musulmanei otoitz-orduetan dei egiten diena.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Torre das mesquitas desde a que o muecín convoca os musulmáns nas horas de oración.</rdfs:comment>
        <rdfs:comment xml:lang="es">Torre de las mezquitas desde cuya altura convoca el almuédano a los musulmanes en las horas de oración.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Torre de les mesquites des de la qual el muetzí convoca els musulmans a les hores de pregària.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Torre de les mesquites des de la qual el muetzí convoca els musulmans a les hores de pregària.</rdfs:comment>
        <rdfs:label xml:lang="ca">Minaret</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Minaret</rdfs:label>
        <rdfs:label xml:lang="en">Minaret</rdfs:label>
        <rdfs:label xml:lang="es">Minarete</rdfs:label>
        <rdfs:label xml:lang="gl">Minarete</rdfs:label>
        <rdfs:label xml:lang="eu">Minaretea</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#MiscellaneousBusiness -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#MiscellaneousBusiness">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#LocalBusiness"/>
        <rdfs:comment xml:lang="eu">Bezeroen beharrak asetzeko hainbat zerbitzu eskaintzen diren espazio fisikoak.</rdfs:comment>
        <rdfs:comment xml:lang="es">Espacios físicos donde se ofrecen una variedad de servicios para satisfacer las necesidades de los clientes.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espais físics on s&apos;ofereixen diversos serveis per satisfer les necessitats dels clients.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espais físics on s&apos;oferixen diversos servicis per satisfer les necessitats dels clients.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazos físicos onde se ofrecen diversos servizos para satisfacer as necesidades dos clientes.</rdfs:comment>
        <rdfs:comment xml:lang="en">Physical spaces where a variety of services are offered to satisfy customer needs.</rdfs:comment>
        <rdfs:label xml:lang="eu">Askotariko negozioak</rdfs:label>
        <rdfs:label xml:lang="en">Miscellaneous business</rdfs:label>
        <rdfs:label xml:lang="es">Negocios varios</rdfs:label>
        <rdfs:label xml:lang="gl">Negocios varios</rdfs:label>
        <rdfs:label xml:lang="ca">Negocis diversos</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Negocis diversos</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Monastery -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Monastery">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">A residence, typically located outside urban areas, where monks live together in community</rdfs:comment>
        <rdfs:comment xml:lang="ca">Casa, habitualment fora de població, on viuen monjos en comunitat.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Casa, habitualment fora de població, on viuen monjos en comunitat.</rdfs:comment>
        <rdfs:comment xml:lang="es">Casa, ordinariamente fuera de poblado, donde viven monjes en comunidad.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Casa, ordinariamente fóra de poboado, onde viven monxes en comunidade.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Monjeak komunitatean bizi diren etxea, oro har herrigunetik kanpo dagoena.</rdfs:comment>
        <rdfs:label xml:lang="es">Monasterio</rdfs:label>
        <rdfs:label xml:lang="eu">Monasterioa</rdfs:label>
        <rdfs:label xml:lang="en">Monastery</rdfs:label>
        <rdfs:label xml:lang="ca">Monestir</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Monestir</rdfs:label>
        <rdfs:label xml:lang="gl">Mosteiro</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Monument -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Monument">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">An architectural or sculptural structure, generally of large dimensions, erected to commemorate a person or a memorable event.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Construcció arquitectònica o escultòrica, generalment de grans dimensions, que s&apos;erigeix en record d&apos;una persona o un fet memorable.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Construcció arquitectònica o escultòrica, generalment de grans dimensions, que s&apos;erigix en record d&apos;una persona o un fet memorable.</rdfs:comment>
        <rdfs:comment xml:lang="es">Construcción arquitectónica o escultórica, generalmente de grandes dimensiones, que se erige en recuerdo de una persona o hecho memorable.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Construción arquitectónica ou escultórica, xeralmente de grandes dimensións, que se erixe en lembranza dunha persoa ou dun feito memorable.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Pertsona edo gertaera gogoangarri baten oroimenez eraikitako eraikuntza arkitektonikoa edo eskultorikoa, normalean tamaina handikoa.</rdfs:comment>
        <rdfs:label xml:lang="ca">Monument</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Monument</rdfs:label>
        <rdfs:label xml:lang="en">Monument</rdfs:label>
        <rdfs:label xml:lang="es">Monumento</rdfs:label>
        <rdfs:label xml:lang="gl">Monumento</rdfs:label>
        <rdfs:label xml:lang="eu">Monumentua</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Mosque -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Mosque">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">A Muslim place of worship.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Musulmanen tenplua.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Temple musulmà.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Temple musulmà.</rdfs:comment>
        <rdfs:comment xml:lang="es">Templo musulmán.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Templo musulmán.</rdfs:comment>
        <rdfs:label xml:lang="eu">Meskita</rdfs:label>
        <rdfs:label xml:lang="ca">Mesquita</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Mesquita</rdfs:label>
        <rdfs:label xml:lang="gl">Mesquita</rdfs:label>
        <rdfs:label xml:lang="es">Mezquita</rdfs:label>
        <rdfs:label xml:lang="en">Mosque</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Motel -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Motel">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment"/>
        <rdfs:comment xml:lang="en">Modest type of tourist accommodation characterized by being located close to roads and offering accommodation and parking for short-term stays.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ostatu turistiko xume mota, errepideetatik gertu dagoena eta egonaldi laburretarako ostatua eta aparkalekua eskaintzen dituena.</rdfs:comment>
        <rdfs:comment xml:lang="es">Tipo de alojamiento turístico modesto que se caracteriza por estar situado próximo a carreteras y ofrecer alojamiento y aparcamiento para estancias de corta duración.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Tipo de aloxamento turístico modesto que se caracteriza por estar situado preto de estradas e ofrecer aloxamento e aparcadoiro para estadías de curta duración.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Tipus d&apos;allotjament turístic modest caracteritzat per situar-se a prop de carreteres i oferir allotjament i aparcament per a estades curtes.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Tipus d&apos;allotjament turístic modest caracteritzat per situar-se a prop de carreteres i oferir allotjament i aparcament per a estades curtes.</rdfs:comment>
        <rdfs:label xml:lang="ca">Motel</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Motel</rdfs:label>
        <rdfs:label xml:lang="en">Motel</rdfs:label>
        <rdfs:label xml:lang="es">Motel</rdfs:label>
        <rdfs:label xml:lang="gl">Motel</rdfs:label>
        <rdfs:label xml:lang="eu">Motela</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Mountain -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Mountain">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#naturalResourceContains"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="ca">Gran elevació natural del terreny.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Gran elevació natural del terreny.</rdfs:comment>
        <rdfs:comment xml:lang="es">Gran elevación natural del terreno.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Gran elevación natural do terreo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Great natural elevation of the land</rdfs:comment>
        <rdfs:comment xml:lang="eu">Lurraren goragune natural handia.</rdfs:comment>
        <rdfs:label xml:lang="eu">Mendia</rdfs:label>
        <rdfs:label xml:lang="es">Montaña</rdfs:label>
        <rdfs:label xml:lang="gl">Montaña</rdfs:label>
        <rdfs:label xml:lang="en">Mountain</rdfs:label>
        <rdfs:label xml:lang="ca">Muntanya</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Muntanya</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#MountainRefuge -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#MountainRefuge">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment"/>
        <rdfs:comment xml:lang="ca">Allotjament aïllat situat a la muntanya, amb personal o sense, que sol oferir habitacions compartides.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Allotjament aïllat situat a la muntanya, amb personal o sense, que sol oferir habitacions compartides.</rdfs:comment>
        <rdfs:comment xml:lang="es">Alojamiento aislado situado en la montaña, con o sin personal, que suele ofrecer habitaciones compartidas.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Aloxamento illado situado na montaña, con ou sen persoal, que adoita ofrecer habitacións compartidas.</rdfs:comment>
        <rdfs:comment xml:lang="en">An isolated accommodation located in the mountains, with or without staff, that usually offers shared rooms.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Mendian kokatutako ostatu bakartua, langileekin edo gabe, normalean logela partekatuak eskaintzen dituena.</rdfs:comment>
        <rdfs:label xml:lang="eu">Mendi-aterpea</rdfs:label>
        <rdfs:label xml:lang="en">Mountain refuge</rdfs:label>
        <rdfs:label xml:lang="ca">Refugi de muntanya</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Refugi de muntanya</rdfs:label>
        <rdfs:label xml:lang="es">Refugio de montaña</rdfs:label>
        <rdfs:label xml:lang="gl">Refuxio de montaña</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#MovieTheater -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#MovieTheater">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#LeisureAndCultureFacility"/>
        <rdfs:comment xml:lang="gl">Establecemento destinado á proxección de películas cinematográficas.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento destinado a la proyección de películas cinematográficas.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment destinat a la projecció de pel·lícules cinematogràfiques.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment destinat a la projecció de pel·lícules cinematogràfiques.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment intended for the projection of cinematographic films.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Zinema-filmak proiektatzeko establezimendua.</rdfs:comment>
        <rdfs:label xml:lang="es">Cine</rdfs:label>
        <rdfs:label xml:lang="gl">Cine</rdfs:label>
        <rdfs:label xml:lang="ca">Cinema</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Cinema</rdfs:label>
        <rdfs:label xml:lang="en">Movie theater</rdfs:label>
        <rdfs:label xml:lang="eu">Zinema</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Multimedia -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Multimedia">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#author"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismDestination"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#audio"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#secondaryImage"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#text"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#video"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#mainImage"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#logo"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#url"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A digital file containing audio, video, or image content.</rdfs:comment>
        <rdfs:comment xml:lang="es">Archivo digital que contiene audio, vídeo o imágenes.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Audioa, bideoa edo irudiak dituen fitxategi digitala.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Ficheiro dixital que contén audio, vídeo ou imaxes.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Fitxer digital que conté àudio, vídeo o imatges.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Fitxer digital que conté àudio, vídeo o imatges.</rdfs:comment>
        <rdfs:label xml:lang="en">Multimedia</rdfs:label>
        <rdfs:label xml:lang="es">Multimedia</rdfs:label>
        <rdfs:label xml:lang="eu">Multimedia</rdfs:label>
        <rdfs:label xml:lang="gl">Multimedia</rdfs:label>
        <rdfs:label xml:lang="ca">Multimèdia</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Multimèdia</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Museum -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Museum">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#LeisureAndCultureFacility"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#museumType"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="ca">Institució legalment reconeguda com a tal, oberta al públic, que adquireix, conserva, investiga, difon i exposa el patrimoni material i immaterial de la humanitat i el seu entorn amb finalitats educatives, d&apos;estudi i de gaudi.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Institució legalment reconeguda com a tal, oberta al públic, que adquirix, conserva, investiga, difon i exposa el patrimoni material i immaterial de la humanitat i el seu entorn amb finalitats educatives, d&apos;estudi i de gaudi.</rdfs:comment>
        <rdfs:comment xml:lang="es">Institución legalmente reconocida como tal, abierta al público, que adquiere, conserva, investiga, difunde y expone el patrimonio material e inmaterial de la humanidad y su entorno con fines educativos, de estudio y de disfrute.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Institución legalmente recoñecida como tal, aberta ao público, que adquire, conserva, investiga, difunde e expón o patrimonio material e inmaterial da humanidade e do seu contorno con fins educativos, de estudo e de gozo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Institution legally recognized as such, open to the public, which acquires, conserves, researches, communicates and exhibits the tangible and intangible heritage of humanity and its environment for the purposes of education, study and enjoyment.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Legez halakotzat aitortutako eta jendearentzat irekita dagoen erakundea, gizateriaren eta haren ingurunearen ondare materiala eta immateriala eskuratu, kontserbatu, ikertu, zabaldu eta erakusten dituena, hezkuntza-, azterketa- eta gozamen-helburuekin.</rdfs:comment>
        <rdfs:label xml:lang="es">Museo</rdfs:label>
        <rdfs:label xml:lang="gl">Museo</rdfs:label>
        <rdfs:label xml:lang="eu">Museoa</rdfs:label>
        <rdfs:label xml:lang="ca">Museu</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Museu</rdfs:label>
        <rdfs:label xml:lang="en">Museum</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#MusicVenue -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#MusicVenue">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#EventAttendanceFacility"/>
        <rdfs:comment xml:lang="es">Local dedicado a interpretaciones de música en vivo</rdfs:comment>
        <rdfs:comment xml:lang="gl">Local dedicado a interpretacións de música en directo</rdfs:comment>
        <rdfs:comment xml:lang="ca">Local dedicat a interpretacions de música en viu</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Local dedicat a interpretacions de música en viu</rdfs:comment>
        <rdfs:comment xml:lang="en">Venue dedicated to live music performances</rdfs:comment>
        <rdfs:comment xml:lang="eu">Zuzeneko musika-emanaldietarako lokala</rdfs:comment>
        <rdfs:label xml:lang="eu">Kontzertu-aretoa</rdfs:label>
        <rdfs:label xml:lang="en">Music venue</rdfs:label>
        <rdfs:label xml:lang="gl">Sala de concertos</rdfs:label>
        <rdfs:label xml:lang="ca">Sala de concerts</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Sala de concerts</rdfs:label>
        <rdfs:label xml:lang="es">Sala de conciertos</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#NaturalPark -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#NaturalPark">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#naturalResourceContains"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Espacio natural legalmente protegido que, por su belleza o por la singularidad de su fauna y flora, posee valor ecológico y cultural.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espai natural legalment protegit que, per la bellesa o la singularitat de la fauna i la flora, té valor ecològic i cultural.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espai natural legalment protegit que, per la bellesa o la singularitat de la fauna i la flora, té valor ecològic i cultural.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazo natural legalmente protexido que, pola súa beleza ou pola singularidade da súa fauna e flora, posúe valor ecolóxico e cultural.</rdfs:comment>
        <rdfs:comment xml:lang="en">Legally protected natural space that, due to its beauty or the uniqueness of its fauna and flora, has ecological and cultural value</rdfs:comment>
        <rdfs:comment xml:lang="eu">Legez babestutako natura-espazioa, edertasunagatik edo fauna eta flora bereziengatik balio ekologikoa eta kulturala duena.</rdfs:comment>
        <rdfs:label xml:lang="eu">Natura-parkea</rdfs:label>
        <rdfs:label xml:lang="en">Natural park</rdfs:label>
        <rdfs:label xml:lang="ca">Parc natural</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Parc natural</rdfs:label>
        <rdfs:label xml:lang="es">Parque natural</rdfs:label>
        <rdfs:label xml:lang="gl">Parque natural</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#NaturalResource -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#NaturalResource">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#Place"/>
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalTourismResourceService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#paymentMethod"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#touristType"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#travelUnit"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#additionalClassification"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#maximumAttendeeCapacity"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#publicAccess"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="ca">Lloc, paisatge o fenomen de la natura que té un valor especial i atractiu per als turistes. Són apreciats per la bellesa paisatgística, la biodiversitat, les característiques geològiques úniques o les experiències a l&apos;aire lliure que ofereixen als visitants.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Lloc, paisatge o fenomen de la natura que té un valor especial i atractiu per als turistes. Són apreciats per la bellesa paisatgística, la biodiversitat, les característiques geològiques úniques o les experiències a l&apos;aire lliure que oferixen als visitants.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugar, paisaje o fenómeno de la naturaleza que posee un valor especial y atractivo para los turistas. Son apreciados por su belleza escénica, biodiversidad, características geológicas únicas o experiencias al aire libre que ofrecen a los visitantes.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugar, paisaxe ou fenómeno da natureza que posúe un valor especial e atractivo para os turistas. Son apreciados pola súa beleza paisaxística, biodiversidade, características xeolóxicas únicas ou experiencias ao aire libre que ofrecen aos visitantes.</rdfs:comment>
        <rdfs:comment xml:lang="en">Place, landscape or natural phenomenon that has a special and attractive value for tourists. They are appreciated for their scenic beauty, biodiversity, unique geological features or outdoor experiences they offer to visitors.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Turistentzat balio berezia eta erakargarria duen naturako leku, paisaia edo fenomenoa. Paisaiaren edertasunagatik, biodibertsitateagatik, ezaugarri geologiko bakarrengatik edo bisitariei eskaintzen dizkieten aire zabaleko esperientziengatik balioesten dira.</rdfs:comment>
        <rdfs:label xml:lang="eu">Natura-baliabidea</rdfs:label>
        <rdfs:label xml:lang="en">Natural resource</rdfs:label>
        <rdfs:label xml:lang="ca">Recurs natural</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Recurs natural</rdfs:label>
        <rdfs:label xml:lang="es">Recurso natural</rdfs:label>
        <rdfs:label xml:lang="gl">Recurso natural</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#NaturalViewPoint -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#NaturalViewPoint">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
        <rdfs:comment xml:lang="ca">Lloc o punt elevat des del qual es pot contemplar fàcilment un paisatge.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Lloc o punt elevat des del qual es pot contemplar fàcilment un paisatge.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugar o punto elevado desde el cual puede contemplarse con facilidad un paisaje.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugar ou punto elevado desde o que se pode contemplar con facilidade unha paisaxe.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Paisaia bat erraz ikusteko aukera ematen duen leku edo puntu garaia.</rdfs:comment>
        <rdfs:comment xml:lang="en">Place or elevated point from which a landscape can be easily seen</rdfs:comment>
        <rdfs:label xml:lang="eu">Begiratoki naturala</rdfs:label>
        <rdfs:label xml:lang="gl">Miradoiro natural</rdfs:label>
        <rdfs:label xml:lang="ca">Mirador natural</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Mirador natural</rdfs:label>
        <rdfs:label xml:lang="es">Mirador natural</rdfs:label>
        <rdfs:label xml:lang="en">Natural viewpoint</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#NightClub -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#NightClub">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PartyAndEntertainmentFacility"/>
        <rdfs:comment xml:lang="en"> A late-night entertainment establishment for dancing and socializing, featuring recorded music (usually by a DJ), light shows, and a bar service.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Dantzarako eta gizarte-harremanetarako diseinatutako gaueko aisialdi-establezimendua, musika (normalean DJ batek jarria), argi-jokoak eta edari-zerbitzua dituena.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento de lecer nocturno deseñado para o baile e a socialización, caracterizado por contar con música (xeralmente dun DJ), xogos de luces e servizo de bebidas.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento de ocio nocturno diseñado para el baile y la socialización, caracterizado por contar con música (generalmente de un DJ), juegos de luces y servicio de bebidas.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment d&apos;oci nocturn dissenyat per al ball i la socialització, caracteritzat per disposar de música (generalment d&apos;un discjòquei), jocs de llums i servei de begudes.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment d&apos;oci nocturn dissenyat per al ball i la socialització, caracteritzat per disposar de música (generalment d&apos;un discjòquei), jocs de llums i servici de begudes.</rdfs:comment>
        <rdfs:label xml:lang="ca">Discoteca</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Discoteca</rdfs:label>
        <rdfs:label xml:lang="es">Discoteca</rdfs:label>
        <rdfs:label xml:lang="gl">Discoteca</rdfs:label>
        <rdfs:label xml:lang="eu">Diskoteka</rdfs:label>
        <rdfs:label xml:lang="en">Night club</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#OldTown -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#OldTown">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#historicalOrCulturalResourceContains"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es"> Área urbana que constituye el núcleo histórico de una localidad, caracterizada por edificaciones y espacios de valor histórico, cultural o arquitectónico, y considerada un recurso de interés turístico.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Herri baten gune historikoa osatzen duen hiri-eremua, balio historiko, kultural edo arkitektonikoko eraikinak eta espazioak dituena eta interes turistikoko baliabidetzat hartzen dena.</rdfs:comment>
        <rdfs:comment xml:lang="en">Urban area that constitutes the historical core of a locality, characterized by buildings and spaces of historical, cultural, or architectural value, and considered a tourism resource.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Àrea urbana que constitueix el nucli històric d&apos;una localitat, caracteritzada per edificacions i espais de valor històric, cultural o arquitectònic, i considerada un recurs d&apos;interès turístic.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Àrea urbana que constituïx el nucli històric d&apos;una localitat, caracteritzada per edificacions i espais de valor històric, cultural o arquitectònic, i considerada un recurs d&apos;interès turístic.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Área urbana que constitúe o núcleo histórico dunha localidade, caracterizada por edificacións e espazos de valor histórico, cultural ou arquitectónico, e considerada un recurso de interese turístico.</rdfs:comment>
        <rdfs:label xml:lang="eu">Alde zaharra</rdfs:label>
        <rdfs:label xml:lang="gl">Casco antigo</rdfs:label>
        <rdfs:label xml:lang="es">Casco antiguo</rdfs:label>
        <rdfs:label xml:lang="ca">Nucli antic</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Nucli antic</rdfs:label>
        <rdfs:label xml:lang="en">Old town</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#OliveOilMill -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#OliveOilMill">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#AgrotourismFacility"/>
        <rdfs:comment xml:lang="es"> Instalación donde se procesan las aceitunas para obtener aceite de oliva.</rdfs:comment>
        <rdfs:comment xml:lang="en">Facility where olives are processed to obtain olive oil.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Instalación onde se procesan as olivas para obter aceite de oliva.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Instal·lació on es processen les olives per obtenir oli d&apos;oliva.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Instal·lació on es processen les olives per obtenir oli d&apos;oliva.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Olibak oliba-olioa lortzeko prozesatzen diren instalazioa.</rdfs:comment>
        <rdfs:label xml:lang="es">Almazara</rdfs:label>
        <rdfs:label xml:lang="gl">Muíño de aceite</rdfs:label>
        <rdfs:label xml:lang="eu">Olio-errota</rdfs:label>
        <rdfs:label xml:lang="en">Olive oil mill</rdfs:label>
        <rdfs:label xml:lang="ca">Trull</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Trull</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#OpeningHours -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#OpeningHours">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#dayOfTheWeek"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasDailyOpeningHours"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#DailyOpeningHours"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasDescription"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#Description"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasTimeSlot"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#TimeSlot"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasDailyOpeningHours"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">7</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#DailyOpeningHours"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#open24Hours"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#temporaryClosure"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#validFrom"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#validThrough"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Negozio, establezimendu edo zerbitzu bat bezeroei arreta emateko edo merkataritza-jarduerak egiteko erabilgarri dagoen denbora-aldia.</rdfs:comment>
        <rdfs:comment xml:lang="en">Period of time during which a business, establishment or service is available to serve customers or carry out commercial activities.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Període de temps durant el qual un negoci, establiment o servei està disponible per atendre clients o dur a terme activitats comercials.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Període de temps durant el qual un negoci, establiment o servici està disponible per atendre clients o dur a terme activitats comercials.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Período de tempo durante o que un negocio, establecemento ou servizo está dispoñible para atender clientes ou realizar actividades comerciais.</rdfs:comment>
        <rdfs:comment xml:lang="es">Período de tiempo durante el cual un negocio, establecimiento o servicio está disponible para atender a clientes o realizar actividades comerciales.</rdfs:comment>
        <rdfs:label xml:lang="ca">Horari d&apos;obertura</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Horari d&apos;obertura</rdfs:label>
        <rdfs:label xml:lang="es">Horario de apertura</rdfs:label>
        <rdfs:label xml:lang="gl">Horario de apertura</rdfs:label>
        <rdfs:label xml:lang="eu">Irekiera-ordutegia</rdfs:label>
        <rdfs:label xml:lang="en">Opening hours</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#OrnamentalFountain -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#OrnamentalFountain">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">A structure, typically involving water, designed to enhance the aesthetic value of an indoor or outdoor space through its form, design, and visual and/or auditory effects.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Barruko nahiz kanpoko espazio bat bere formaren, diseinuaren eta ikusizko eta/edo entzunezko efektuen bidez edertzeko diseinatutako egitura, normalean urezkoa.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Estructura, habitualment d&apos;aigua, dissenyada per embellir un espai, tant interior com exterior, mitjançant la forma, el disseny i els efectes visuals i/o auditius.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Estructura, habitualment d&apos;aigua, dissenyada per embellir un espai, tant interior com exterior, mitjançant la forma, el disseny i els efectes visuals i/o auditius.</rdfs:comment>
        <rdfs:comment xml:lang="es">Estructura, típicamente de agua, diseñada para embellecer un espacio, tanto interior como exterior, a través de su forma, diseño y efectos visuales y/o auditivos.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Estrutura, habitualmente de auga, deseñada para embelecer un espazo, tanto interior como exterior, mediante a súa forma, deseño e efectos visuais e/ou auditivos.</rdfs:comment>
        <rdfs:label xml:lang="eu">Apaingarri-iturria</rdfs:label>
        <rdfs:label xml:lang="ca">Font ornamental</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Font ornamental</rdfs:label>
        <rdfs:label xml:lang="gl">Fonte ornamental</rdfs:label>
        <rdfs:label xml:lang="es">Fuente ornamental</rdfs:label>
        <rdfs:label xml:lang="en">Ornamental Fountain</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#PaddleCourt -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#PaddleCourt">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#SportFacility"/>
        <rdfs:comment xml:lang="en">A rectangular sports court designed for padel, defined by a perimeter enclosure.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Padelean aritzeko diseinatutako kirol-esparru angeluzuzena, itxitura batez mugatua.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Recinte esportiu rectangular dissenyat per a la pràctica del pàdel i delimitat per un tancament.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Recinte esportiu rectangular dissenyat per a la pràctica del pàdel i delimitat per un tancament.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Recinto deportivo rectangular deseñado para a práctica do pádel e delimitado por un cerramento.</rdfs:comment>
        <rdfs:comment xml:lang="es">Recinto deportivo rectangular diseñado para la práctica del pádel delimitado por un cerramiento.</rdfs:comment>
        <rdfs:label xml:lang="en">Paddle court</rdfs:label>
        <rdfs:label xml:lang="eu">Padel-pista</rdfs:label>
        <rdfs:label xml:lang="ca">Pista de pàdel</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Pista de pàdel</rdfs:label>
        <rdfs:label xml:lang="es">Pista de pádel</rdfs:label>
        <rdfs:label xml:lang="gl">Pista de pádel</rdfs:label>
