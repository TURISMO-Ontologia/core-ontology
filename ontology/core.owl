    <!-- https://ontologia.segittur.es/turismo/def/core#Planetarium -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Planetarium">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#LeisureAndCultureFacility"/>
        <rdfs:comment xml:lang="eu">Astronomiarekin lotutako ikuskizunak proiektatzeko egokitutako egitura.</rdfs:comment>
        <rdfs:comment xml:lang="es">Estructura acondicionada para la proyección de espectáculos relacionados con la astronomía.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Estructura condicionada per projectar espectacles relacionats amb l&apos;astronomia.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Estructura condicionada per projectar espectacles relacionats amb l&apos;astronomia.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Estrutura acondicionada para a proxección de espectáculos relacionados coa astronomía.</rdfs:comment>
        <rdfs:comment xml:lang="en">Structure equipped for the projection of shows related to astronomy.</rdfs:comment>
        <rdfs:label xml:lang="ca">Planetari</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Planetari</rdfs:label>
        <rdfs:label xml:lang="es">Planetario</rdfs:label>
        <rdfs:label xml:lang="gl">Planetario</rdfs:label>
        <rdfs:label xml:lang="eu">Planetarioa</rdfs:label>
        <rdfs:label xml:lang="en">Planetarium</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
