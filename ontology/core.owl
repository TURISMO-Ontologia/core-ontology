    <!-- http://www.opengis.net/ont/geosparql#Feature -->

    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Feature"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->

    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#ConceptScheme -->

    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#ConceptScheme">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#ATM -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#ATM">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#FinancialService"/>
        <rdfs:comment xml:lang="eu">Banku batekin informatikoki konektatutako makina, gako pertsonal bat esleituta duen txartel edo libreta magnetiko baten bidez banku-eragiketa jakin batzuk egiteko aukera ematen duena.</rdfs:comment>
        <rdfs:comment xml:lang="en">Machine computer-connected to a bank that allows certain banking operations to be carried out using a card or magnetic book that has a personal password assigned to it.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Màquina connectada informàticament amb un banc que permet efectuar determinades operacions bancàries mitjançant una targeta o llibreta magnètica que té assignada una clau personal.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Màquina connectada informàticament amb un banc que permet efectuar determinades operacions bancàries mitjançant una targeta o llibreta magnètica que té assignada una clau personal.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Máquina conectada informaticamente cun banco que permite efectuar certas operacións bancarias mediante unha tarxeta ou libreta magnética que ten asignada unha clave persoal.</rdfs:comment>
        <rdfs:comment xml:lang="es">Máquina conectada informáticamente con un banco que permite efectuar ciertas operaciones bancarias mediante una tarjeta o libreta magnética que tienen asignada una clave personal.</rdfs:comment>
        <rdfs:label xml:lang="en">ATM</rdfs:label>
        <rdfs:label xml:lang="gl">Caixeiro automático</rdfs:label>
        <rdfs:label xml:lang="ca">Caixer automàtic</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Caixer automàtic</rdfs:label>
        <rdfs:label xml:lang="es">Cajero automático</rdfs:label>
        <rdfs:label xml:lang="eu">Kutxazain automatikoa</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#AccessoriesAndComplements -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#AccessoriesAndComplements">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#RetailAndFashionBusiness"/>
        <rdfs:comment xml:lang="gl">Establecemento no que se venden obxectos que complementan a indumentaria dunha persoa, como bolsos, calzado, paraugas, gravatas, sombreiros, lentes, luvas, etc.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento en el que se venden objetos que complementan la indumentaria de una persona, como bolsos, calzado, paraguas, corbatas, sombreros, gafas, guantes, etc.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment on es venen objectes que complementen la indumentària d&apos;una persona, com ara bosses, calçat, paraigües, corbates, barrets, ulleres, guants, etc.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment on es venen objectes que complementen la indumentària d&apos;una persona, com ara bosses, calçat, paraigües, corbates, barrets, ulleres, guants, etc.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment in which objects that complement a person&apos;s clothing are sold, such as bags, footwear, umbrellas, ties, hats, glasses, gloves, etc.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Pertsona baten janzkera osatzen duten objektuak saltzen diren establezimendua, hala nola poltsak, oinetakoak, aterkiak, gorbatak, kapelak, betaurrekoak, eskularruak eta abar.</rdfs:comment>
        <rdfs:label xml:lang="en">Accessories and complements</rdfs:label>
        <rdfs:label xml:lang="ca">Botiga d&apos;accessoris i complements</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Botiga d&apos;accessoris i complements</rdfs:label>
        <rdfs:label xml:lang="eu">Osagarrien denda</rdfs:label>
        <rdfs:label xml:lang="gl">Tenda de accesorios e complementos</rdfs:label>
        <rdfs:label xml:lang="es">Tienda de accesorios y complementos</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#AccommodationCompany -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#AccommodationCompany">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrganisation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasTourismOrRelatedFacility"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasTourismOrRelatedFacility"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Gutxienez oheak eta higiene-zerbitzuak eskaintzen dituen hornitzailea</rdfs:comment>
        <rdfs:comment xml:lang="gl">Provedor de, polo menos, camas e servizos de hixiene</rdfs:comment>
        <rdfs:comment xml:lang="es">Proveedor de, al menos, camas y servicios de higiene</rdfs:comment>
        <rdfs:comment xml:lang="ca">Proveïdor de, com a mínim, llits i serveis d&apos;higiene</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Proveïdor de, com a mínim, llits i servicis d&apos;higiene</rdfs:comment>
        <rdfs:comment xml:lang="en">Provider of at least sleeping and sanitary facilities</rdfs:comment>
        <rdfs:label xml:lang="en">Accommodation company</rdfs:label>
        <rdfs:label xml:lang="ca">Empresa d&apos;allotjament</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Empresa d&apos;allotjament</rdfs:label>
        <rdfs:label xml:lang="es">Empresa de alojamiento</rdfs:label>
        <rdfs:label xml:lang="gl">Empresa de aloxamento</rdfs:label>
        <rdfs:label xml:lang="eu">Ostatu-enpresa</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#accommodationRateType"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#accommodationRating"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#accommodationUnitCategory"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalAccommodationService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalTourismOrRelatedFacilityService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasPriceClass"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#autonomousCheckIn"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#checkInTime"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#checkOutTime"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#numberOfAccommodationUnits"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#numberOfBeds"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="gl">Establecemento que ofrece aloxamento turístico.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento que ofrece alojamiento turístico.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment que ofereix allotjament turístic.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment que oferix allotjament turístic.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment providing tourist accommodation.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ostatu turistikoa eskaintzen duen establezimendua.</rdfs:comment>
        <rdfs:label xml:lang="en">Accommodation establishment</rdfs:label>
        <rdfs:label xml:lang="gl">Establecemento de aloxamento</rdfs:label>
        <rdfs:label xml:lang="es">Establecimiento alojativo</rdfs:label>
        <rdfs:label xml:lang="ca">Establiment d&apos;allotjament</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Establiment d&apos;allotjament</rdfs:label>
        <rdfs:label xml:lang="eu">Ostatu-establezimendua</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Acknowledgement -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Acknowledgement">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#name"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#recognizedBy"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Achievements or distinctions awarded to people, companies or products for meeting certain standards or specific criteria. These recognitions may include certifications, awards, or other types of honors that recognize quality, performance, compliance, or excellence in a particular field.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Assoliments o distincions atorgats a persones, empreses o productes per complir determinats estàndards o criteris específics. Aquests reconeixements poden incloure certificacions, premis o altres tipus de distincions que reconeixen la qualitat, el rendiment, el compliment de normes o l&apos;excel·lència en un àmbit determinat.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Assoliments o distincions atorgats a persones, empreses o productes per complir determinats estàndards o criteris específics. Estos reconeixements poden incloure certificacions, premis o altres tipus de distincions que reconeixen la qualitat, el rendiment, el compliment de normes o l&apos;excel·lència en un àmbit determinat.</rdfs:comment>
        <rdfs:comment xml:lang="es">Logros o distinciones otorgadas a personas, empresas o productos por cumplir con ciertos estándares o criterios específicos. Estos reconocimientos pueden incluir certificaciones, premios u otros tipos de distinciones que reconocen la calidad, el rendimiento, el cumplimiento de normas o la excelencia en un determinado campo.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Logros ou distincións outorgados a persoas, empresas ou produtos por cumprir certos estándares ou criterios específicos. Estes recoñecementos poden incluír certificacións, premios ou outros tipos de distincións que recoñecen a calidade, o rendemento, o cumprimento de normas ou a excelencia nun determinado campo.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Zenbait estandar edo irizpide zehatz betetzeagatik pertsonei, enpresei edo produktuei emandako lorpenak edo sariak. Aitorpen horien artean egon daitezke ziurtagiriak, sariak edo arlo jakin bateko kalitatea, errendimendua, arauak betetzea edo bikaintasuna aitortzen duten bestelako bereizgarriak.</rdfs:comment>
        <rdfs:label xml:lang="en">Acknowledgement</rdfs:label>
        <rdfs:label xml:lang="eu">Aitorpena</rdfs:label>
        <rdfs:label xml:lang="ca">Reconeixement</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Reconeixement</rdfs:label>
        <rdfs:label xml:lang="es">Reconocimiento</rdfs:label>
        <rdfs:label xml:lang="gl">Recoñecemento</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#AdditionalInformation -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#AdditionalInformation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#frequentlyAskedQuestion"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#FrequentlyAskedQuestion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#petAdmissionPolicy"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#PetAdmissionPolicy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#accessTip"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#conditions"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#curiosities"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#remarks"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Additional details, data or explanations that complement or expand the main information provided. It is extra information that can provide clarification, context, or specific details on a given topic.</rdfs:comment>
        <rdfs:comment xml:lang="es">Detalles, datos o explicaciones adicionales que complementan o amplían la información principal proporcionada. Es información extra que puede proporcionar aclaraciones, contexto o detalles específicos sobre un tema determinado.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Detalles, datos ou explicacións adicionais que complementan ou amplían a información principal proporcionada. É información extra que pode proporcionar aclaracións, contexto ou detalles específicos sobre un tema determinado.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Detalls, dades o explicacions addicionals que complementen o amplien la informació principal proporcionada. És informació extra que pot proporcionar aclariments, context o detalls específics sobre un tema determinat.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Detalls, dades o explicacions addicionals que complementen o amplien la informació principal proporcionada. És informació extra que pot proporcionar aclariments, context o detalls específics sobre un tema determinat.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Emandako informazio nagusia osatzen edo zabaltzen duten xehetasun, datu edo azalpen gehigarriak. Gai jakin bati buruzko argibideak, testuingurua edo xehetasun zehatzak eman ditzakeen informazio gehigarria da.</rdfs:comment>
        <rdfs:label xml:lang="en">Additional information</rdfs:label>
        <rdfs:label xml:lang="ca">Informació addicional</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Informació addicional</rdfs:label>
        <rdfs:label xml:lang="es">Información adicional</rdfs:label>
        <rdfs:label xml:lang="gl">Información adicional</rdfs:label>
        <rdfs:label xml:lang="eu">Informazio gehigarria</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#AdventureActivity -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#AdventureActivity">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismService"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#relatedTourismOrRelatedFacility"/>
                <owl:someValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#AdventureActivityCentre"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasPriceClass"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#offeredBy"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#ComplementaryActivitiesCompany"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#technicalDifficulty"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#includes"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Jolas- edo kirol-jarduera bat egitean oinarritutako turismo-zerbitzua, oro har erronka fisiko edo tekniko baten edo hautemandako arrisku baten maila jakin bati lotua.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Servei turístic basat en la realització d&apos;una activitat recreativa o esportiva, generalment associada a un cert grau de repte físic, tècnic o de risc percebut.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Servici turístic basat en la realització d&apos;una activitat recreativa o esportiva, generalment associada a un cert grau de repte físic, tècnic o de risc percebut.</rdfs:comment>
        <rdfs:comment xml:lang="es">Servicio turístico basado en la realización de una actividad recreativa o deportiva, generalmente asociada a un cierto grado de desafío físico, técnico o de riesgo percibido.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Servizo turístico baseado na realización dunha actividade recreativa ou deportiva, xeralmente asociada a un certo grao de desafío físico, técnico ou de risco percibido.</rdfs:comment>
        <rdfs:comment xml:lang="en">Tourism service based on the performance of a recreational or sporting activity, generally associated with a certain degree of physical, technical, or perceived risk.</rdfs:comment>
        <rdfs:label xml:lang="eu">Abentura-jarduera</rdfs:label>
        <rdfs:label xml:lang="es">Actividad de aventura</rdfs:label>
        <rdfs:label xml:lang="gl">Actividade de aventura</rdfs:label>
        <rdfs:label xml:lang="ca">Activitat d&apos;aventura</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Activitat d&apos;aventura</rdfs:label>
        <rdfs:label xml:lang="en">Adventure activity</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#AdventureActivityCentre -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#AdventureActivityCentre">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#SportFacility"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#adventureActivityType"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Center oriented towards sports or practices that involve, in addition to physical activity, intense recreational activity in the natural environment.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Centre orientat als esports o pràctiques que comporten, a més d&apos;una activitat física, una intensa activitat recreativa en el medi natural.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Centre orientat als esports o pràctiques que comporten, a més d&apos;una activitat física, una intensa activitat recreativa en el medi natural.</rdfs:comment>
        <rdfs:comment xml:lang="es">Centro orientado a los deportes o prácticas que conllevan, además de una actividad física, una intensa actividad recreativa en el medio natural.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Centro orientado aos deportes ou prácticas que implican, ademais dunha actividade física, unha intensa actividade recreativa no medio natural.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Jarduera fisikoaz gain natura-ingurunean jolas-jarduera bizia dakarten kiroletara edo jardunetara bideratutako zentroa.</rdfs:comment>
        <rdfs:label xml:lang="eu">Abentura-jardueren zentroa</rdfs:label>
        <rdfs:label xml:lang="en">Adventure activity centre</rdfs:label>
        <rdfs:label xml:lang="ca">Centre d&apos;activitats d&apos;aventura</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Centre d&apos;activitats d&apos;aventura</rdfs:label>
        <rdfs:label xml:lang="es">Centro de actividades de aventura</rdfs:label>
        <rdfs:label xml:lang="gl">Centro de actividades de aventura</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Advice -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Advice">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#RulesAndTips"/>
        <rdfs:comment xml:lang="en">Communication to the user of advice and good practices.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Comunicació a l&apos;usuari de consells i bones pràctiques.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Comunicació a l&apos;usuari de consells i bones pràctiques.</rdfs:comment>
        <rdfs:comment xml:lang="es">Comunicación al usuario de consejos y buenas prácticas.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Comunicación ao usuario de consellos e boas prácticas.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Erabiltzaileari aholkuak eta jardunbide egokiak jakinaraztea.</rdfs:comment>
        <rdfs:label xml:lang="en">Advice</rdfs:label>
        <rdfs:label xml:lang="eu">Gomendioa</rdfs:label>
        <rdfs:label xml:lang="ca">Recomanació</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Recomanació</rdfs:label>
        <rdfs:label xml:lang="es">Recomendación</rdfs:label>
        <rdfs:label xml:lang="gl">Recomendación</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#AgrotourismExperience -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#AgrotourismExperience">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismService"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#agrotourismExperienceRelatedProduct"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#agrotourismExperienceType"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasPriceClass"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#offeredBy"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#ComplementaryActivitiesCompany"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#refPointOfInterest"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#Place"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#relatedTourismOrRelatedFacility"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#timeOfTheDay"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#includes"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#notIncluded"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Experiences resulting from the provision of tourism services on primary sector exploitations that are compatible with the main production and capable of attracting visitors to whom they can convey satisfying sensations.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Experiencias resultantes da prestación de servizos turísticos en explotacións do sector primario compatibles coa produción principal e capaces de atraer visitantes aos que transmitir sensacións satisfactorias.</rdfs:comment>
        <rdfs:comment xml:lang="es">Experiencias resultantes de la prestación de servicios turísticos en explotaciones del sector primario compatibles con la producción principal y capaces de atraer visitantes a los que transmitirles sensaciones satisfactorias.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Experiències resultants de la prestació de serveis turístics en explotacions del sector primari compatibles amb la producció principal i capaces d&apos;atreure visitants als quals transmetre sensacions satisfactòries.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Experiències resultants de la prestació de servicis turístics en explotacions del sector primari compatibles amb la producció principal i capaces d&apos;atreure visitants als quals transmetre sensacions satisfactòries.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Lehen sektoreko ustiategietan turismo-zerbitzuak ematetik sortutako esperientziak, ekoizpen nagusiarekin bateragarriak eta bisitariak erakartzeko eta haiei sentsazio atseginak helarazteko gai direnak.</rdfs:comment>
        <rdfs:label xml:lang="en">Agrotourism experience</rdfs:label>
        <rdfs:label xml:lang="eu">Esperientzia agroturistikoa</rdfs:label>
        <rdfs:label xml:lang="es">Experiencia agroturística</rdfs:label>
        <rdfs:label xml:lang="gl">Experiencia agroturística</rdfs:label>
        <rdfs:label xml:lang="ca">Experiència agroturística</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Experiència agroturística</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#AgrotourismFacility -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#AgrotourismFacility">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalTourismOrRelatedFacilityService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#offers"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#AgrotourismExperience"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasPriceClass"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Bisitariak erakartzeko gai diren eta ustiategiaren ekoizpen nagusiarekin bateragarriak diren esperientzia agroturistikoak sortzen dituzten turismo-zerbitzuak eskaintzen dituzten lehen sektoreko ustiategiak.</rdfs:comment>
        <rdfs:comment xml:lang="es">Explotaciones del sector primario que prestan servicios turísticos resultantes en experiencias agroturísticas capaces de atraer visitantes y compatibles con la producción principal de la explotación.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Explotacions del sector primari que presten serveis turístics que donen lloc a experiències agroturístiques capaces d&apos;atreure visitants i compatibles amb la producció principal de l&apos;explotació.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Explotacions del sector primari que presten servicis turístics que donen lloc a experiències agroturístiques capaces d&apos;atreure visitants i compatibles amb la producció principal de l&apos;explotació.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Explotacións do sector primario que prestan servizos turísticos que dan lugar a experiencias agroturísticas capaces de atraer visitantes e compatibles coa produción principal da explotación.</rdfs:comment>
        <rdfs:comment xml:lang="en">Primary sector exploitation providing tourist services resulting in agrotourism experiences capable of attracting visitors and compatible with the main production of the exploitation.</rdfs:comment>
        <rdfs:label xml:lang="en">Agrotourism facility</rdfs:label>
        <rdfs:label xml:lang="es">Instalación agroturística</rdfs:label>
        <rdfs:label xml:lang="gl">Instalación agroturística</rdfs:label>
        <rdfs:label xml:lang="eu">Instalazio agroturistikoa</rdfs:label>
        <rdfs:label xml:lang="ca">Instal·lació agroturística</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Instal·lació agroturística</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Airport -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Airport">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TransportInfrastructure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#transportInfrastructureContains"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A facility where air transportation originates stops and / or terminates and where passengers and/or cargo can be taken on or off and/or maintenance re-stocking or re-fueling takes place.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Aireko garraioa hasi, eten edo amaitzen den instalazioa, bidaiariak eta/edo zama ontziratzeko edo lehorreratzeko eta/edo mantentze-, hornitze- edo erregai-hornitze lanak egiteko erabiltzen dena.</rdfs:comment>
        <rdfs:comment xml:lang="es">Instalación en la que se inicia, interrumpe o finaliza el transporte aéreo y en la que se puede embarcar o desembarcar pasajeros y/o carga, y/o se realizan tareas de mantenimiento, reabastecimiento o repostaje.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Instalación na que se inicia, interrompe ou finaliza o transporte aéreo e na que se poden embarcar ou desembarcar pasaxeiros e/ou carga, e/ou se realizan tarefas de mantemento, reabastecemento ou reposición de combustible.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Instal·lació on s&apos;inicia, s&apos;interromp o finalitza el transport aeri i on es poden embarcar o desembarcar passatgers i/o càrrega, i/o s&apos;hi fan tasques de manteniment, reabastament o proveïment de combustible.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Instal·lació on s&apos;inicia, s&apos;interromp o finalitza el transport aeri i on es poden embarcar o desembarcar passatgers i/o càrrega, i/o s&apos;hi fan tasques de manteniment, reabastament o proveïment de combustible.</rdfs:comment>
        <rdfs:label xml:lang="ca">Aeroport</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Aeroport</rdfs:label>
        <rdfs:label xml:lang="gl">Aeroporto</rdfs:label>
        <rdfs:label xml:lang="es">Aeropuerto</rdfs:label>
        <rdfs:label xml:lang="eu">Aireportua</rdfs:label>
        <rdfs:label xml:lang="en">Airport</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Alcazar -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Alcazar">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">A fortified castle located in a strategic position, especially when enclosed by defensive walls.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Castell fortificat situat en un lloc estratègic, especialment quan està emmurallat.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Castell fortificat situat en un lloc estratègic, especialment quan està emmurallat.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Castelo fortificado situado nun lugar estratéxico, especialmente cando está amurallado.</rdfs:comment>
        <rdfs:comment xml:lang="es">Castillo fortificado situado en un lugar estratégico, especialmente cuando está amurallado.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Leku estrategiko batean kokatutako gaztelu gotortua, batez ere harresiz inguratuta dagoenean.</rdfs:comment>
        <rdfs:label xml:lang="en">Alcazar</rdfs:label>
        <rdfs:label xml:lang="ca">Alcàsser</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Alcàsser</rdfs:label>
        <rdfs:label xml:lang="es">Alcázar</rdfs:label>
        <rdfs:label xml:lang="gl">Alcázar</rdfs:label>
        <rdfs:label xml:lang="eu">Alkazarra</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Amphitheatre -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Amphitheatre">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">An oval or circular structure equipped with tiered seating surrounding a central sandy area, where public spectacles were held in ancient Rome.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Construcció oval o circular proveïda de grades al voltant d&apos;una zona de arena central, on a l&apos;antiga Roma se celebraven espectacles públics.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Construcció oval o circular proveïda de grades al voltant d&apos;una zona de sorra central, on a l&apos;antiga Roma se celebraven espectacles públics.</rdfs:comment>
        <rdfs:comment xml:lang="es">Construcción oval o circular provista de un graderío alrededor de una zona arenosa central, en la que en la antigua Roma se celebraban espectáculos públicos.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Construción oval ou circular provista de bancadas arredor dunha zona areosa central, na que na antiga Roma se celebraban espectáculos públicos.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Erdiko hareazko eremu baten inguruan harmailak dituen eraikuntza obalatua edo zirkularra, antzinako Erroman ikuskizun publikoak egiteko erabiltzen zena.</rdfs:comment>
        <rdfs:label xml:lang="ca">Amfiteatre</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Amfiteatre</rdfs:label>
        <rdfs:label xml:lang="en">Amphitheater</rdfs:label>
        <rdfs:label xml:lang="es">Anfiteatro</rdfs:label>
        <rdfs:label xml:lang="gl">Anfiteatro</rdfs:label>
        <rdfs:label xml:lang="eu">Anfiteatroa</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#AmusementPark -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#AmusementPark">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#LeisureAndCultureFacility"/>
        <rdfs:comment xml:lang="en">A venue that hosts a wide variety of attractions and events for fun and entertainment.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Dibertitzeko eta entretenitzeko askotariko atrakzioak eta ekitaldiak hartzen dituen esparrua.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Recinte que acull una gran varietat d&apos;atraccions i esdeveniments destinats a la diversió i l&apos;entreteniment.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Recinte que acull una gran varietat d&apos;atraccions i esdeveniments destinats a la diversió i l&apos;entreteniment.</rdfs:comment>
        <rdfs:comment xml:lang="es">Recinto que acoge una gran variedad de atracciones y acontecimientos destinados a la diversión y al entretenimiento.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Recinto que acolle unha gran variedade de atraccións e acontecementos destinados á diversión e ao entretemento.</rdfs:comment>
        <rdfs:label xml:lang="en">Amusement park</rdfs:label>
        <rdfs:label xml:lang="eu">Jolas-parkea</rdfs:label>
        <rdfs:label xml:lang="ca">Parc d&apos;atraccions</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Parc d&apos;atraccions</rdfs:label>
        <rdfs:label xml:lang="es">Parque de atracciones</rdfs:label>
        <rdfs:label xml:lang="gl">Parque de atraccións</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Aparthotel -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Aparthotel">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment"/>
        <rdfs:comment xml:lang="en"> Apartment hotel where accommodation is provided in studios or apartments.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Apartahotel onde se ofrece aloxamento en estudios ou apartamentos.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Aparthotel on s&apos;ofereix allotjament en estudis o apartaments.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Aparthotel on s&apos;oferix allotjament en estudis o apartaments.</rdfs:comment>
        <rdfs:comment xml:lang="es">Apartotel donde se ofrece alojamiento en estudios o apartamentos.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Estudioetan edo apartamentuetan ostatua eskaintzen duen apartamentuen hotela.</rdfs:comment>
        <rdfs:label xml:lang="es">Apartahotel</rdfs:label>
        <rdfs:label xml:lang="gl">Apartahotel</rdfs:label>
        <rdfs:label xml:lang="eu">Apartamentuen hotela</rdfs:label>
        <rdfs:label xml:lang="ca">Aparthotel</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Aparthotel</rdfs:label>
        <rdfs:label xml:lang="en">Aparthotel</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Aquarium -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Aquarium">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#LeisureAndCultureFacility"/>
        <rdfs:comment xml:lang="en">Enclosure intended for the exhibition of live aquatic animals.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Recinte destinat a l&apos;exhibició d&apos;animals aquàtics vius.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Recinte destinat a l&apos;exhibició d&apos;animals aquàtics vius.</rdfs:comment>
        <rdfs:comment xml:lang="es">Recinto destinado a la exhibición de animales acuáticos vivos.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Recinto destinado á exhibición de animais acuáticos vivos.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Uretako animalia biziak erakusteko esparrua.</rdfs:comment>
        <rdfs:label xml:lang="es">Acuario</rdfs:label>
        <rdfs:label xml:lang="gl">Acuario</rdfs:label>
        <rdfs:label xml:lang="ca">Aquari</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Aquari</rdfs:label>
        <rdfs:label xml:lang="en">Aquarium</rdfs:label>
        <rdfs:label xml:lang="eu">Aquariuma</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Aqueduct -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Aqueduct">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en"> A bridge-like structure supported by one or more rows of arches, designed to carry water across a deep natural depression.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Arku-ilara batek edo gehiagok eutsitako zubi-itxurako eraikuntza, lurreko sakonune handi baten alde batetik bestera ura eramateko erabiltzen dena.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Construcció en forma de pont sostinguda per una o més files d&apos;arcs sobre la qual es condueix aigua d&apos;un costat a l&apos;altre d&apos;una depressió pronunciada del terreny.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Construcció en forma de pont sostinguda per una o més files d&apos;arcs sobre la qual es conduïx aigua d&apos;un costat a l&apos;altre d&apos;una depressió pronunciada del terreny.</rdfs:comment>
        <rdfs:comment xml:lang="es">Construcción en forma de puente soportado por una o más filas de arcos sobre la cual se conduce agua de un lado a otro de una fuerte depresión de terreno.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Construción en forma de ponte soportada por unha ou máis filas de arcos sobre a que se conduce auga dun lado ao outro dunha forte depresión do terreo.</rdfs:comment>
        <rdfs:label xml:lang="gl">Acuaduto</rdfs:label>
        <rdfs:label xml:lang="es">Acueducto</rdfs:label>
        <rdfs:label xml:lang="eu">Akueduktua</rdfs:label>
        <rdfs:label xml:lang="en">Aqueduct</rdfs:label>
        <rdfs:label xml:lang="ca">Aqüeducte</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Aqüeducte</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#ArabicBath -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#ArabicBath">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">Arab baths, also known as hammam, are public bathing spaces that combine body cleansing with relaxation and well-being.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Bainu arabiarrak, hammam izenez ere ezagunak, gorputzaren garbiketa erlaxazioarekin eta ongizatearekin uztartzen duten bainatzeko espazio publikoak dira.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Els banys àrabs, també coneguts com a hammam, són espais públics de bany que combinen la neteja del cos amb la relaxació i el benestar.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Els banys àrabs, també coneguts com a hammam, són espais públics de bany que combinen la neteja del cos amb la relaxació i el benestar.</rdfs:comment>
        <rdfs:comment xml:lang="es">Los baños árabes, también conocidos como hammam, son espacios públicos de baño que combinan la limpieza del cuerpo con la relajación y el bienestar.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Os baños árabes, tamén coñecidos como hammam, son espazos públicos de baño que combinan a limpeza do corpo coa relaxación e o benestar.</rdfs:comment>
        <rdfs:label xml:lang="en">Arabic bath</rdfs:label>
        <rdfs:label xml:lang="eu">Bainu arabiarrak</rdfs:label>
        <rdfs:label xml:lang="ca">Banys àrabs</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Banys àrabs</rdfs:label>
        <rdfs:label xml:lang="es">Baños árabes</rdfs:label>
        <rdfs:label xml:lang="gl">Baños árabes</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Arcade -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Arcade">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#LeisureAndCultureFacility"/>
        <rdfs:comment xml:lang="eu">Diru-kopuru jakin baten truke jolasteko denbora eskaintzen duten makinak edo jokoak dituen lekua.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Lloc amb un conjunt de màquines o jocs en què, a canvi d&apos;una quantitat determinada de diners, s&apos;obté un temps de joc.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Lloc amb un conjunt de màquines o jocs en què, a canvi d&apos;una quantitat determinada de diners, s&apos;obté un temps de joc.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugar donde se encuentran un conjunto de máquinas o juegos, en los que a cambio de una determinada cantidad de dinero se obtiene un tiempo de juego.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugar onde se atopa un conxunto de máquinas ou xogos nos que, a cambio dunha determinada cantidade de diñeiro, se obtén un tempo de xogo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Place where a set of machines or games are found, in which in exchange for a certain amount of money you get playing time.</rdfs:comment>
        <rdfs:label xml:lang="en">Arcade</rdfs:label>
        <rdfs:label xml:lang="eu">Jolas-aretoa</rdfs:label>
        <rdfs:label xml:lang="ca">Saló recreatiu</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Saló recreatiu</rdfs:label>
        <rdfs:label xml:lang="es">Salón recreativo</rdfs:label>
        <rdfs:label xml:lang="gl">Salón recreativo</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Arch -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Arch">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">A structural element with a curved or polygonal profile.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Element constructiu de directriu corbada o poligonal.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Element constructiu de directriu corbada o poligonal.</rdfs:comment>
        <rdfs:comment xml:lang="es">Elemento constructivo de directriz en forma curvada o poligonal.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Elemento construtivo de directriz curvada ou poligonal.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Gidalerro kurbatua edo poligonala duen eraikuntza-elementua.</rdfs:comment>
        <rdfs:label xml:lang="ca">Arc</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Arc</rdfs:label>
        <rdfs:label xml:lang="en">Arch</rdfs:label>
        <rdfs:label xml:lang="es">Arco</rdfs:label>
        <rdfs:label xml:lang="gl">Arco</rdfs:label>
        <rdfs:label xml:lang="eu">Arkua</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#ArcheologicalSite -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#ArcheologicalSite">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">A place where archaeological remains are found.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Aztarna arkeologikoak dauden lekua.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Lloc on es troben restes arqueològiques.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Lloc on es troben restes arqueològiques.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugar donde se hallan restos arqueológicos.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugar onde se atopan restos arqueolóxicos.</rdfs:comment>
        <rdfs:label xml:lang="en">Archaelogical site</rdfs:label>
        <rdfs:label xml:lang="eu">Aztarnategi arkeologikoa</rdfs:label>
        <rdfs:label xml:lang="ca">Jaciment arqueològic</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Jaciment arqueològic</rdfs:label>
        <rdfs:label xml:lang="gl">Xacemento arqueolóxico</rdfs:label>
        <rdfs:label xml:lang="es">Yacimiento arqueológico</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#ArtGallery -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#ArtGallery">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#LeisureAndCultureFacility"/>
        <rdfs:comment xml:lang="eu">Artelanak erakusteko eta saltzeko establezimendua.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento para a exposición e venda de obras de arte.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento para exposición y venta de obras de arte.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment d&apos;exposició i venda d&apos;obres d&apos;art.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment d&apos;exposició i venda d&apos;obres d&apos;art.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment for exhibition and sale of works of art.</rdfs:comment>
        <rdfs:label xml:lang="en">Art gallery</rdfs:label>
        <rdfs:label xml:lang="eu">Arte-galeria</rdfs:label>
        <rdfs:label xml:lang="ca">Galeria d&apos;art</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Galeria d&apos;art</rdfs:label>
        <rdfs:label xml:lang="es">Galería de arte</rdfs:label>
        <rdfs:label xml:lang="gl">Galería de arte</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Auditorium -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Auditorium">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#EventAttendanceFacility"/>
        <rdfs:comment xml:lang="eu">Kontzertuetarako, errezitaldietarako, hitzaldietarako, solasaldietarako, jendaurreko irakurketetarako eta abarretarako aretoa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Room for concerts, recitals, conferences, colloquiums, public readings, etc.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Sala destinada a concertos, recitais, conferencias, coloquios, lecturas públicas, etc.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Sala destinada a concerts, recitals, conferències, col·loquis, lectures públiques, etc.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Sala destinada a concerts, recitals, conferències, col·loquis, lectures públiques, etc.</rdfs:comment>
        <rdfs:comment xml:lang="es">Sala destinada a conciertos, recitales, conferencias, coloquios, lecturas públicas, etc.</rdfs:comment>
        <rdfs:label xml:lang="ca">Auditori</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Auditori</rdfs:label>
        <rdfs:label xml:lang="es">Auditorio</rdfs:label>
        <rdfs:label xml:lang="gl">Auditorio</rdfs:label>
        <rdfs:label xml:lang="eu">Auditorioa</rdfs:label>
        <rdfs:label xml:lang="en">Auditorium</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#BakeryAndPastry -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#BakeryAndPastry">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#GroceriesService"/>
        <rdfs:comment xml:lang="gl">Establecemento onde se fan e/ou se venden pans, pasteis, pastas ou outros doces.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento donde se hacen y/o se venden panes, pasteles, pastas u otros dulces.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment on es fan i/o es venen pans, pastissos, pastes o altres dolços.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment on es fan i/o es venen pans, pastissos, pastes o altres dolços.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment where breads, cakes, pastas or other sweets are made and/or sold.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ogia, pastelak, pastak edo bestelako gozokiak egiten eta/edo saltzen diren establezimendua.</rdfs:comment>
        <rdfs:label xml:lang="en">Bakery and pastry</rdfs:label>
        <rdfs:label xml:lang="ca">Fleca i pastisseria</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Fleca i pastisseria</rdfs:label>
        <rdfs:label xml:lang="eu">Okindegia eta gozotegia</rdfs:label>
        <rdfs:label xml:lang="gl">Panadaría e pastelaría</rdfs:label>
        <rdfs:label xml:lang="es">Panadería y pastelería</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#BankOffice -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#BankOffice">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#FinancialService"/>
        <rdfs:comment xml:lang="eu">Finantza-erakunde batek bezeroei laguntza pertsonala eta automatizatua eskaintzen dien lekua.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Lloc on una institució financera ofereix assistència personal i automatitzada als clients.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Lloc on una institució financera oferix assistència personal i automatitzada als clients.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugar donde una institución financiera ofrece asistencia personal y automatizada a los clientes.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugar onde unha institución financeira ofrece asistencia persoal e automatizada aos clientes.</rdfs:comment>
        <rdfs:comment xml:lang="en">Place where a financial institution offers personal and automated assistance to customers</rdfs:comment>
        <rdfs:label xml:lang="en">Bank office</rdfs:label>
        <rdfs:label xml:lang="eu">Banku-bulegoa</rdfs:label>
        <rdfs:label xml:lang="es">Oficina bancaria</rdfs:label>
        <rdfs:label xml:lang="gl">Oficina bancaria</rdfs:label>
        <rdfs:label xml:lang="ca">Oficina bancària</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Oficina bancària</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Bar -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Bar">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment"/>
        <rdfs:comment xml:lang="eu">Edari alkoholdunak edo alkoholik gabeak saltzeko barra duen establezimendua, batzuetan, espezializazioaren arabera, otordu arinak ere zerbitzatzen dituena.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento equipado cunha barra na que se venden bebidas alcohólicas ou non alcohólicas e no que, en ocasións, se serven comidas lixeiras, dependendo da especialización.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento equipado con una barra en la que se venden bebidas alcohólicas o no alcohólicas y en el que, en ocasiones, se sirven comidas ligeras, dependiendo de la especialización.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment equipat amb una barra on es venen begudes alcohòliques o no alcohòliques i on, de vegades, se serveixen àpats lleugers, segons l&apos;especialització.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment equipat amb una barra on es venen begudes alcohòliques o no alcohòliques i on, de vegades, se servixen àpats lleugers, segons l&apos;especialització.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment equipped with a counter selling alcoholic or non-alcoholic beverages, and where light food is sometimes served depending on the specialization.</rdfs:comment>
        <rdfs:label xml:lang="ca">Bar</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Bar</rdfs:label>
        <rdfs:label xml:lang="en">Bar</rdfs:label>
        <rdfs:label xml:lang="es">Bar</rdfs:label>
        <rdfs:label xml:lang="gl">Bar</rdfs:label>
        <rdfs:label xml:lang="eu">Taberna</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Basilica -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Basilica">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">A church distinguished by its antiquity, magnificence, or the significance of the rites celebrated within it.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Antzinatasunagatik, handitasunagatik edo bertan egiten diren kultuengatik nabarmentzen den eliza.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Església notable per l&apos;antiguitat o magnificència o pels cultes que s&apos;hi celebren.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Església notable per l&apos;antiguitat o magnificència o pels cultes que s&apos;hi celebren.</rdfs:comment>
        <rdfs:comment xml:lang="es">Iglesia notable por su antigüedad o magnificencia o por los cultos que en ella se celebran.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Igrexa notable pola súa antigüidade ou magnificencia ou polos cultos que nela se celebran.</rdfs:comment>
        <rdfs:label xml:lang="en">Basilica</rdfs:label>
        <rdfs:label xml:lang="eu">Basilika</rdfs:label>
        <rdfs:label xml:lang="ca">Basílica</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Basílica</rdfs:label>
        <rdfs:label xml:lang="es">Basílica</rdfs:label>
        <rdfs:label xml:lang="gl">Basílica</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#BasketballCourt -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#BasketballCourt">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#SportFacility"/>
        <rdfs:comment xml:lang="en">Flat surface, indoor or outdoor, with a hoop at each end suspended about three meters high for practicing this sport.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Kirol hau egiteko barruko edo kanpoko gainazal laua, mutur bakoitzean hiru metro inguruko altueran esekitako uztai bana duena.</rdfs:comment>
        <rdfs:comment xml:lang="es">Superficie plana, interior o exterior, con un aro en cada extremo suspendido a unos tres metros de altura para la práctica de este deporte.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Superficie plana, interior ou exterior, cun aro en cada extremo suspendido a uns tres metros de altura para a práctica deste deporte.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Superfície plana, interior o exterior, amb una cistella a cada extrem suspesa a uns tres metres d&apos;altura per practicar aquest esport.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Superfície plana, interior o exterior, amb una cistella a cada extrem suspesa a uns tres metres d&apos;altura per practicar este esport.</rdfs:comment>
        <rdfs:label xml:lang="en">Basketball court</rdfs:label>
        <rdfs:label xml:lang="es">Cancha de baloncesto</rdfs:label>
        <rdfs:label xml:lang="gl">Cancha de baloncesto</rdfs:label>
        <rdfs:label xml:lang="ca">Pista de bàsquet</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Pista de bàsquet</rdfs:label>
        <rdfs:label xml:lang="eu">Saskibaloi-kantxa</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Bazaar -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Bazaar">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#RetailAndFashionBusiness"/>
        <rdfs:comment xml:lang="eu">Askotariko produktuak saltzen diren establezimendua, hala nola arropa, erlojuak, jostailuak, etxeko gaiak eta opari-objektuak.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento no que se venden produtos moi diversos, como roupa, reloxos, xoguetes, artigos para a casa e obxectos de agasallo.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento en el que se venden gran diversidad de productos, como ropa, relojes, juguetes, artículos para la casa y objetos de regalo.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment on es venen productes molt diversos, com ara roba, rellotges, joguines, articles per a la llar i objectes de regal.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment on es venen productes molt diversos, com ara roba, rellotges, joguines, articles per a la llar i objectes de regal.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment where a wide variety of products are sold, such as clothing, watches, toys, household items and gift items.</rdfs:comment>
        <rdfs:label xml:lang="ca">Basar</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Basar</rdfs:label>
        <rdfs:label xml:lang="en">Bazaar</rdfs:label>
        <rdfs:label xml:lang="es">Bazar</rdfs:label>
        <rdfs:label xml:lang="gl">Bazar</rdfs:label>
        <rdfs:label xml:lang="eu">Bazarra</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Beach -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Beach">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#beachType"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasBeachService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#naturalResourceContains"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Hondarrez, legarrez, harribilez, arrokaz edo beste material batez osatutako eremu natural edo artifiziala, aisialdiko jarduerak egiten eta zerbitzuak ematen diren uretarako eta bainu-eremurako sarbidea errazten duena.</rdfs:comment>
        <rdfs:comment xml:lang="es">Natural or artificial area, formed by sand, gravel, pebble, rock or another material, that facilitates access to the water and the bathing area where leisure activities are carried out and where services are provided.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Àrea natural o artificial, formada per arena, grava, còdols, roca o un altre material, que facilita l&apos;accés a l&apos;aigua i a la zona de bany on es duen a terme activitats de lleure i es presten servicis.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Àrea natural o artificial, formada per sorra, grava, còdols, roca o un altre material, que facilita l&apos;accés a l&apos;aigua i a la zona de bany on es duen a terme activitats de lleure i es presten serveis.</rdfs:comment>
        <rdfs:comment xml:lang="en">Área natural o artificial, formada por arena, grava, guijarros, rocas u otro material, que facilita el acceso al agua y a la zona de baño donde se realizan actividades de ocio y se prestan servicios.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Área natural ou artificial, formada por area, grava, croios, rocha ou outro material, que facilita o acceso á auga e á zona de baño onde se realizan actividades de lecer e se prestan servizos.</rdfs:comment>
        <rdfs:label xml:lang="en">Beach</rdfs:label>
        <rdfs:label xml:lang="eu">Hondartza</rdfs:label>
        <rdfs:label xml:lang="ca">Platja</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Platja</rdfs:label>
        <rdfs:label xml:lang="es">Playa</rdfs:label>
        <rdfs:label xml:lang="gl">Praia</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#BeachBar -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#BeachBar">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment"/>
        <rdfs:comment xml:lang="eu">Hondartza ondoan janaria eta edariak eskaintzen dituen establezimendu txikia, aire zabaleko terraza edo mahai-eremua duena.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Pequeno establecemento ao pé da praia que ofrece comidas e bebidas e que dispón dunha terraza ou área de mesas ao aire libre.</rdfs:comment>
        <rdfs:comment xml:lang="es">Pequeño establecimiento a pie de playa, que ofrece comidas y bebidas y que posee una terraza o área de mesas al aire libre.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Petit establiment a peu de platja que ofereix menjars i begudes i que disposa d&apos;una terrassa o zona de taules a l&apos;aire lliure.</rdfs:comment>
        <rdfs:comment xml:lang="en">Small establishment on the beach, which offers food and drinks and has a terrace or outdoor table area.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Xicotet establiment a peu de platja que oferix menjars i begudes i que disposa d&apos;una terrassa o zona de taules a l&apos;aire lliure.</rdfs:comment>
        <rdfs:label xml:lang="en">Beach bar</rdfs:label>
        <rdfs:label xml:lang="es">Chiringuito</rdfs:label>
        <rdfs:label xml:lang="gl">Chiringuito</rdfs:label>
        <rdfs:label xml:lang="eu">Hondartzako txosna</rdfs:label>
        <rdfs:label xml:lang="ca">Quingueta de platja</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Quingueta de platja</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#BeachClub -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#BeachClub">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PartyAndEntertainmentFacility"/>
        <rdfs:comment xml:lang="eu">Kostaldeko aisialdi- eta entretenimendu-lekua, hotel baten antzeko instalazioak eta zerbitzuak dituena, ostatu hartzeko aukerarik gabe.</rdfs:comment>
        <rdfs:comment xml:lang="en">Leisure and entertainment venue in coastal areas with facilities and services similar to those of a hotel, but without the lodging option.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Lloc de lleure i entreteniment en zones costaneres amb instal·lacions i serveis semblants als d&apos;un hotel, però sense opció d&apos;allotjament.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Lloc de lleure i entreteniment en zones costaneres amb instal·lacions i servicis semblants als d&apos;un hotel, però sense opció d&apos;allotjament.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugar de lecer e entretemento nas zonas costeiras con instalacións e servizos semellantes aos dun hotel, pero sen opción de hospedaxe.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugar de ocio y entretenimiento en las zonas costeras con instalaciones y servicios semejantes a los de un hotel, pero sin la opción de hospedaje.</rdfs:comment>
        <rdfs:label xml:lang="en">Beach club</rdfs:label>
        <rdfs:label xml:lang="ca">Club de platja</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Club de platja</rdfs:label>
        <rdfs:label xml:lang="es">Club de playa</rdfs:label>
        <rdfs:label xml:lang="gl">Club de praia</rdfs:label>
        <rdfs:label xml:lang="eu">Hondartzako kluba</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#BeautyCentre -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#BeautyCentre">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HealthAndWellnessFacility"/>
        <rdfs:comment xml:lang="eu">Edertasunera eta gorputzaren zaintzara bideratutako establezimendua.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento orientado á beleza e ao coidado do corpo.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento orientado a la belleza y cuidado del cuerpo.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment orientat a la bellesa i la cura del cos.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment orientat a la bellesa i la cura del cos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment aimed at beauty and body care.</rdfs:comment>
        <rdfs:label xml:lang="en">Beauty centre</rdfs:label>
        <rdfs:label xml:lang="ca">Centre d&apos;estètica</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Centre d&apos;estètica</rdfs:label>
        <rdfs:label xml:lang="gl">Centro de estética</rdfs:label>
        <rdfs:label xml:lang="es">Centro estético</rdfs:label>
        <rdfs:label xml:lang="eu">Estetika-zentroa</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#BellTower -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#BellTower">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">A tall tower, whether freestanding, attached, or integrated ninto a building, where bells are housed.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Kanpaiak jartzeko dorre altua, bakartua, eraikin bati atxikia edo eraikin batean integratua.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Torre elevada, exempta, adossada o integrada en un edifici, on es col·loquen les campanes.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Torre elevada, exempta, adossada o integrada en un edifici, on es col·loquen les campanes.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Torre elevada, exenta, acaroada ou integrada nun edificio, onde se colocan as campás.</rdfs:comment>
        <rdfs:comment xml:lang="es">Torre elevada, exenta, adosada o integrada en un edificio, donde se colocan las campanas.</rdfs:comment>
        <rdfs:label xml:lang="en">Bell tower</rdfs:label>
        <rdfs:label xml:lang="ca">Campanar</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Campanar</rdfs:label>
        <rdfs:label xml:lang="es">Campanario</rdfs:label>
        <rdfs:label xml:lang="gl">Campanario</rdfs:label>
        <rdfs:label xml:lang="eu">Kanpandorrea</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#BicycleSharingSystem -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#BicycleSharingSystem">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TransportInfrastructure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasPriceSpecification"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#PriceSpecification"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Erabiltzaileen eskura hainbat bizikleta jartzen dituen zerbitzua, aldi baterako garraiobide gisa erabil ditzaten.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Servei que posa a disposició dels usuaris un conjunt de bicicletes perquè s&apos;utilitzin temporalment com a mitjà de transport.</rdfs:comment>
        <rdfs:comment xml:lang="en">Service that makes a series of bicycles available to users to be used temporarily as a means of transportation.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Servici que posa a disposició dels usuaris un conjunt de bicicletes perquè s&apos;utilitzen temporalment com a mitjà de transport.</rdfs:comment>
        <rdfs:comment xml:lang="es">Servicio que pone a disposición de los usuarios una serie de bicicletas para que sean utilizadas temporalmente como medio de transporte.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Servizo que pon á disposición dos usuarios unha serie de bicicletas para que sexan utilizadas temporalmente como medio de transporte.</rdfs:comment>
        <rdfs:label xml:lang="en">Bicycle sharing system</rdfs:label>
        <rdfs:label xml:lang="eu">Bizikleta partekatuen sistema</rdfs:label>
        <rdfs:label xml:lang="es">Sistema de bicicletas compartidas</rdfs:label>
        <rdfs:label xml:lang="gl">Sistema de bicicletas compartidas</rdfs:label>
        <rdfs:label xml:lang="ca">Sistema de bicicletes compartides</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Sistema de bicicletes compartides</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#BikeLane -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#BikeLane">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TransportInfrastructure"/>
        <rdfs:comment xml:lang="en">Cycle route that runs adjacent to the road in one or two directions.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Galtzadari atxikita doan noranzko bakarreko edo bikoitzeko bizikleta-bidea.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Via ciclista que discorre adossada a la calçada en un sentit o en tots dos.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Via ciclista que discorre adossada a la calçada en un sentit o en tots dos.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Vía ciclista que discorre pegada á calzada nun ou en ambos os sentidos.</rdfs:comment>
        <rdfs:comment xml:lang="es">Vía ciclista que discurre adosada a la calzada en uno o en doble sentido.</rdfs:comment>
        <rdfs:label xml:lang="eu">Bidegorria</rdfs:label>
        <rdfs:label xml:lang="en">Bike lane</rdfs:label>
        <rdfs:label xml:lang="ca">Carril bici</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Carril bici</rdfs:label>
        <rdfs:label xml:lang="es">Carril bici</rdfs:label>
        <rdfs:label xml:lang="gl">Carril bici</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Bingo -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Bingo">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PartyAndEntertainmentFacility"/>
        <rdfs:comment xml:lang="en">An establishment specifically designed for playing bingo games and offering the chance to win prizes.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Bingoan jokatzeko eta sariak irabazteko aukera izateko berariaz diseinatutako establezimendua.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento deseñado especificamente para realizar xogos de bingo e ter a oportunidade de gañar premios.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento diseñado específicamente para la realización de juegos de bingo y tener la oportunidad de ganar premios.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment dissenyat específicament per jugar al bingo i tenir l&apos;oportunitat de guanyar premis.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment dissenyat específicament per jugar al bingo i tenir l&apos;oportunitat de guanyar premis.</rdfs:comment>
        <rdfs:label xml:lang="ca">Bingo</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Bingo</rdfs:label>
        <rdfs:label xml:lang="en">Bingo</rdfs:label>
        <rdfs:label xml:lang="es">Bingo</rdfs:label>
        <rdfs:label xml:lang="gl">Bingo</rdfs:label>
        <rdfs:label xml:lang="eu">Bingoa</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#BookingChannel -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#BookingChannel">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#ContactPoint"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#onSite"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#Location"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Leku, ekitaldi edo erakunde batek erreserba egiteko eskura jartzen dituen bitartekoak edo plataformak.</rdfs:comment>
        <rdfs:comment xml:lang="en">Means or platforms that a place, event, or organisation offers for the purpose of making a booking.</rdfs:comment>
        <rdfs:comment xml:lang="es">Medios o plataformas que pone a disposición un lugar, evento u organización para realizar una reserva.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Medios ou plataformas que un lugar, evento ou organización pon á disposición para realizar unha reserva.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Mitjans o plataformes que un lloc, esdeveniment o organització posa a disposició per fer una reserva.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Mitjans o plataformes que un lloc, esdeveniment o organització posa a disposició per fer una reserva.</rdfs:comment>
        <rdfs:label xml:lang="en">Booking channel</rdfs:label>
        <rdfs:label xml:lang="ca">Canal de reserva</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Canal de reserva</rdfs:label>
        <rdfs:label xml:lang="es">Canal de reserva</rdfs:label>
        <rdfs:label xml:lang="gl">Canle de reserva</rdfs:label>
        <rdfs:label xml:lang="eu">Erreserba-kanala</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Bookshop -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Bookshop">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#RetailAndFashionBusiness"/>
        <rdfs:comment xml:lang="ca">Botiga on es venen llibres.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Botiga on es venen llibres.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Liburuak saltzen diren denda.</rdfs:comment>
        <rdfs:comment xml:lang="en">Shop where books are sold</rdfs:comment>
        <rdfs:comment xml:lang="gl">Tenda onde se venden libros.</rdfs:comment>
        <rdfs:comment xml:lang="es">Tienda donde se venden libros.</rdfs:comment>
        <rdfs:label xml:lang="en">Bookshop</rdfs:label>
        <rdfs:label xml:lang="gl">Libraría</rdfs:label>
        <rdfs:label xml:lang="es">Librería</rdfs:label>
        <rdfs:label xml:lang="eu">Liburu-denda</rdfs:label>
        <rdfs:label xml:lang="ca">Llibreria</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Llibreria</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#BowlingAlley -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#BowlingAlley">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#SportFacility"/>
        <rdfs:comment xml:lang="en">A recreational facility equipped with lanes for bowling, often featuring catering and complementary entertainment services.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Boloetan aritzeko pistak dituen jolas-instalazioa, jatetxe-zerbitzuak eta entretenimendu osagarria ere izan ohi dituena.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Instalación recreativa equipada con pistas para a práctica dos birlos, que adoita integrar servizos de restauración e entretemento complementario.</rdfs:comment>
        <rdfs:comment xml:lang="es">Instalación recreativa equipada con pistas para la práctica de bolos, que suele integrar servicios de restauración y entretenimiento complementario.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Instal·lació recreativa equipada amb pistes per jugar a bitlles, que sol integrar serveis de restauració i entreteniment complementari.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Instal·lació recreativa equipada amb pistes per jugar a bitlles, que sol integrar servicis de restauració i entreteniment complementari.</rdfs:comment>
        <rdfs:label xml:lang="eu">Bola-jokalekua</rdfs:label>
        <rdfs:label xml:lang="gl">Boleira</rdfs:label>
        <rdfs:label xml:lang="ca">Bolera</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Bolera</rdfs:label>
        <rdfs:label xml:lang="es">Bolera</rdfs:label>
        <rdfs:label xml:lang="en">Bowling alley</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Brewery -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Brewery">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment"/>
        <rdfs:comment xml:lang="eu">Espezialitate gisa garagardoa zerbitzatzen duen establezimendua.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento no que se serve cervexa como especialidade.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento en el que se sirve cerveza como especialidad.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment on se serveix cervesa com a especialitat.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment on se servix cervesa com a especialitat.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment in which beer is served as specialty.</rdfs:comment>
        <rdfs:label xml:lang="en">Brewery</rdfs:label>
        <rdfs:label xml:lang="es">Cervecería</rdfs:label>
        <rdfs:label xml:lang="ca">Cerveseria</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Cerveseria</rdfs:label>
        <rdfs:label xml:lang="gl">Cervexaría</rdfs:label>
        <rdfs:label xml:lang="eu">Garagardotegia</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Bridge -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Bridge">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">A structure made of stone, brick, wood, iron, concrete, or other materials, built over rivers, moats, or other areas to connect two sides</rdfs:comment>
        <rdfs:comment xml:lang="ca">Construcció de pedra, maó, fusta, ferro, formigó, etc., que es construeix sobre rius, fossats i altres llocs per comunicar dos costats.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Construcció de pedra, maó, fusta, ferro, formigó, etc., que es construïx sobre rius, fossats i altres llocs per comunicar dos costats.</rdfs:comment>
        <rdfs:comment xml:lang="es">Construcción de piedra, ladrillo, madera, hierro, hormigón, etc., que se construye y forma sobre los ríos, fosos y otros sitios, para comunicar dos lados.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Construción de pedra, ladrillo, madeira, ferro, formigón, etc., que se constrúe sobre ríos, foxos e outros sitios para comunicar dous lados.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ibai, lubaki eta beste leku batzuen gainean bi aldeak lotzeko eraikitako harrizko, adreiluzko, zurezko, burdinazko, hormigoizko eta abarrezko eraikuntza.</rdfs:comment>
        <rdfs:label xml:lang="en">Bridge</rdfs:label>
        <rdfs:label xml:lang="ca">Pont</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Pont</rdfs:label>
        <rdfs:label xml:lang="gl">Ponte</rdfs:label>
        <rdfs:label xml:lang="es">Puente</rdfs:label>
        <rdfs:label xml:lang="eu">Zubia</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#BullRing -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#BullRing">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#EventAttendanceFacility"/>
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">A generally circular structure with tiered seating, intended for bullfighting but also used for other types of events.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Construcció generalment circular i amb grades destinada a la lídia de toros, tot i que també es pot utilitzar per a altres tipus d&apos;esdeveniments.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Construcció generalment circular i amb grades destinada a la lídia de toros, tot i que també es pot utilitzar per a altres tipus d&apos;esdeveniments.</rdfs:comment>
        <rdfs:comment xml:lang="es">Construcción generalmente circular y con graderías, destinada a la lidia de toros, aunque también puede ser utilizada para otros tipos de eventos.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Construción xeralmente circular e con bancadas destinada á lida de touros, aínda que tamén pode utilizarse para outros tipos de eventos.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Zezenei aurre egiteko erabiltzen den eraikuntza, normalean zirkularra eta harmailaduna, beste ekitaldi mota batzuetarako ere erabil daitekeena.</rdfs:comment>
        <rdfs:label xml:lang="en">Bullring</rdfs:label>
        <rdfs:label xml:lang="es">Plaza de toros</rdfs:label>
        <rdfs:label xml:lang="ca">Plaça de toros</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Plaça de toros</rdfs:label>
        <rdfs:label xml:lang="gl">Praza de touros</rdfs:label>
        <rdfs:label xml:lang="eu">Zezen-plaza</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#BusOperator -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#BusOperator">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PassengerTransportCompany"/>
        <rdfs:comment xml:lang="eu">Aurrez ezarritako ibilbideetan autobus bidez bidaiariak garraiatzeko zerbitzuak ematen espezializatutako enpresa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Company specialized in providing passenger transport services using coaches on pre-established routes.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Empresa especialitzada a prestar serveis de transport de passatgers amb autocars en rutes preestablertes.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Empresa especialitzada a prestar servicis de transport de passatgers amb autocars en rutes preestablertes.</rdfs:comment>
        <rdfs:comment xml:lang="es">Empresa especializada en la prestación de servicios de transporte de pasajeros utilizando autocares en rutas preestablecidas.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Empresa especializada na prestación de servizos de transporte de pasaxeiros mediante autocares en rutas preestablecidas.</rdfs:comment>
        <rdfs:label xml:lang="eu">Autobus-operadorea</rdfs:label>
        <rdfs:label xml:lang="en">Bus operator</rdfs:label>
        <rdfs:label xml:lang="ca">Operador d&apos;autocars</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Operador d&apos;autocars</rdfs:label>
        <rdfs:label xml:lang="es">Operador de autocares</rdfs:label>
        <rdfs:label xml:lang="gl">Operador de autocares</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#BusStation -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#BusStation">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TransportInfrastructure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#transportInfrastructureContains"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Autobusen irteeretarako eta iritsieretarako instalazioa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Facility for the arrival and departure of buses.</rdfs:comment>
        <rdfs:comment xml:lang="es">Instalación destinada a la llegada y salida de autobuses.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Instalación destinada á chegada e saída de autobuses.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Instal·lació destinada a l&apos;arribada i eixida d&apos;autobusos.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Instal·lació destinada a l&apos;arribada i sortida d&apos;autobusos.</rdfs:comment>
        <rdfs:label xml:lang="eu">Autobus-geltokia</rdfs:label>
        <rdfs:label xml:lang="en">Bus station</rdfs:label>
        <rdfs:label xml:lang="ca">Estació d&apos;autobusos</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Estació d&apos;autobusos</rdfs:label>
        <rdfs:label xml:lang="es">Estación de autobuses</rdfs:label>
        <rdfs:label xml:lang="gl">Estación de autobuses</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#CafeOrCoffeeShop -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#CafeOrCoffeeShop">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment"/>
        <rdfs:comment xml:lang="eu">Edari hotzak eta beroak, pastelak, batzuetan sandwichak, otordu arinak eta kafe-aleak zerbitzatzen eta/edo saltzen diren establezimendua.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento onde se serven e/ou venden bebidas frías e quentes, pasteis, ás veces sándwiches, comidas lixeiras e café en gran.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento donde se sirven y/o venden bebidas frías y calientes, pasteles, a veces sándwiches, comidas ligeras y café en grano.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment on se serveixen i/o es venen begudes fredes i calentes, pastissos, de vegades entrepans, àpats lleugers i cafè en gra.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment on se servixen i/o es venen begudes fredes i calentes, pastissos, de vegades entrepans, àpats lleugers i cafè en gra.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment where hot and cold beverages, cakes, sometimes sandwiches, light meals, and coffee beans are served and/or sold.</rdfs:comment>
        <rdfs:label xml:lang="en">Cafe or coffee shop</rdfs:label>
        <rdfs:label xml:lang="gl">Cafetaría</rdfs:label>
        <rdfs:label xml:lang="ca">Cafeteria</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Cafeteria</rdfs:label>
        <rdfs:label xml:lang="es">Cafetería</rdfs:label>
        <rdfs:label xml:lang="eu">Kafetegia</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#CallShop -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#CallShop">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#MiscellaneousBusiness"/>
        <rdfs:comment xml:lang="eu">Bezeroei batez ere telefonia- eta Interneteko konexio-zerbitzuak eskaintzen dizkien lokala.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Local que ofereix als clients principalment serveis de telefonia i connexió a internet.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Local que oferix als clients principalment servicis de telefonia i connexió a internet.</rdfs:comment>
        <rdfs:comment xml:lang="es">Local que ofrece a sus clientes servicios de telefonía y conexión a internet principalmente.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Local que ofrece aos seus clientes principalmente servizos de telefonía e conexión a internet.</rdfs:comment>
        <rdfs:comment xml:lang="en">Local that offers its clients telephone services and internet connection mainly.</rdfs:comment>
        <rdfs:label xml:lang="en">Call shop</rdfs:label>
        <rdfs:label xml:lang="ca">Locutori</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Locutori</rdfs:label>
        <rdfs:label xml:lang="es">Locutorio</rdfs:label>
        <rdfs:label xml:lang="gl">Locutorio</rdfs:label>
        <rdfs:label xml:lang="eu">Mintzalekua</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Camping -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Camping">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment"/>
        <rdfs:comment xml:lang="eu">Aire zabalean dagoen establezimendu mota, turistak hartzeko ostatu- eta zerbitzu-eskaerari eta -beharrei erantzuteko behar diren instalazioak dituena.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Tipo de establecemento situado ao aire libre que dispón das instalacións necesarias para atender a demanda e as necesidades de aloxamento e servizos para albergar turistas.</rdfs:comment>
        <rdfs:comment xml:lang="es">Tipo de establecimiento situado al aire libre que posee las instalaciones necesarias para atender la demanda y las necesidades alojativas y servicios para albergar a turistas.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Tipus d&apos;establiment situat a l&apos;aire lliure que disposa de les instal·lacions necessàries per atendre la demanda i les necessitats d&apos;allotjament i serveis per acollir turistes.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Tipus d&apos;establiment situat a l&apos;aire lliure que disposa de les instal·lacions necessàries per atendre la demanda i les necessitats d&apos;allotjament i servicis per acollir turistes.</rdfs:comment>
        <rdfs:comment xml:lang="en">Type of establishment located outdoors that has the necessary facilities to meet the demand and accommodation needs and services to accommodate tourists.</rdfs:comment>
        <rdfs:label xml:lang="en">Camping</rdfs:label>
        <rdfs:label xml:lang="es">Camping</rdfs:label>
        <rdfs:label xml:lang="ca">Càmping</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Càmping</rdfs:label>
        <rdfs:label xml:lang="gl">Cámping</rdfs:label>
        <rdfs:label xml:lang="eu">Kanpina</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Campsite -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Campsite">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#EducationalFacility"/>
        <rdfs:comment xml:lang="gl">Instalación eventual en terreo aberto onde se practican actividades de convivencia ao aire libre, orientada a fins educativos e de formación.</rdfs:comment>
        <rdfs:comment xml:lang="es">Instalación eventual, en terreno abierto, donde se practican actividades de convivencia al aire libre, orientada a fines educativos y de formación.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Instal·lació eventual en terreny obert on es practiquen activitats de convivència a l&apos;aire lliure, orientada a finalitats educatives i formatives.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Instal·lació eventual en terreny obert on es practiquen activitats de convivència a l&apos;aire lliure, orientada a finalitats educatives i formatives.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Lur irekian dagoen aldi baterako instalazioa, aire zabalean bizikidetza-jarduerak egiteko erabiltzen dena, hezkuntza- eta prestakuntza-helburuekin.</rdfs:comment>
        <rdfs:comment xml:lang="en">Possible installation, in open terrain, where outdoor coexistence activities are practiced, aimed at educational and training purposes.</rdfs:comment>
        <rdfs:label xml:lang="ca">Campament</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Campament</rdfs:label>
        <rdfs:label xml:lang="es">Campamento</rdfs:label>
        <rdfs:label xml:lang="gl">Campamento</rdfs:label>
        <rdfs:label xml:lang="en">Campsite</rdfs:label>
        <rdfs:label xml:lang="eu">Kanpalekua</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Canal -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Canal">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
        <rdfs:comment xml:lang="en">Artificial channel through which water is conducted to discharge it or for other uses</rdfs:comment>
        <rdfs:comment xml:lang="es">Cauce artificial por donde se conduce el agua para darle salida o para otros usos</rdfs:comment>
        <rdfs:comment xml:lang="gl">Leito artificial por onde se conduce a auga para darlle saída ou para outros usos</rdfs:comment>
        <rdfs:comment xml:lang="ca">Llera artificial per on es condueix l&apos;aigua per donar-li sortida o per a altres usos</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Llera artificial per on es conduïx l&apos;aigua per donar-li eixida o per a altres usos</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ura husteko edo beste erabilera batzuetarako bideratzen duen ubide artifiziala</rdfs:comment>
        <rdfs:label xml:lang="ca">Canal</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Canal</rdfs:label>
        <rdfs:label xml:lang="en">Canal</rdfs:label>
        <rdfs:label xml:lang="es">Canal</rdfs:label>
        <rdfs:label xml:lang="gl">Canal</rdfs:label>
        <rdfs:label xml:lang="eu">Ubidea</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#CaravanArea -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#CaravanArea">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TransportInfrastructure"/>
        <rdfs:comment xml:lang="eu">Autokarabanak eta furgoneta kanperrak aparkatzeko eta gaua igarotzeko berariaz izendatutako espazioa, ibilgailu mota horietara egokitutako zerbitzuak eskaintzen dituena</rdfs:comment>
        <rdfs:comment xml:lang="es">Espacio específicamente designado para el estacionamiento y pernocta de autocaravanas y campers, que ofrece servicios adaptados a este tipo de vehículos</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espai específicament designat per a l&apos;estacionament i pernoctació d&apos;autocaravanes i furgonetes càmper, que ofereix serveis adaptats a aquest tipus de vehicles</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espai específicament designat per a l&apos;estacionament i pernoctació d&apos;autocaravanes i furgonetes càmper, que oferix servicis adaptats a este tipus de vehicles</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazo especificamente designado para o estacionamento e pernoita de autocaravanas e furgonetas cámper, que ofrece servizos adaptados a este tipo de vehículos</rdfs:comment>
        <rdfs:comment xml:lang="en">Space specifically designated for parking and overnight stays for motorhomes and campers, which offers services adapted to this type of vehicle.</rdfs:comment>
        <rdfs:label xml:lang="eu">Autokarabanen eremua</rdfs:label>
        <rdfs:label xml:lang="en">Caravan area</rdfs:label>
        <rdfs:label xml:lang="ca">Àrea d&apos;autocaravanes</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Àrea d&apos;autocaravanes</rdfs:label>
        <rdfs:label xml:lang="es">Área de autocaravanas</rdfs:label>
        <rdfs:label xml:lang="gl">Área de autocaravanas</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Casino -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Casino">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PartyAndEntertainmentFacility"/>
        <rdfs:comment xml:lang="en">An establishment dedicated to gambling activities, where shows, concerts, dances, and other events may also be offered.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ausazko jokoetan aritzeko establezimendua, batzuetan ikuskizunak, kontzertuak, dantzak edo bestelako jarduerak ere eskaintzen dituena.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento destinado á práctica de xogos de azar, onde en ocasións tamén se ofrecen espectáculos, concertos, bailes ou outras actividades.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento destinado a la práctica de juegos de azar, donde en ocasiones también se ofrecen espectáculos, conciertos, bailes u otras actividades.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment destinat als jocs d&apos;atzar, on de vegades també s&apos;ofereixen espectacles, concerts, balls o altres activitats.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment destinat als jocs d&apos;atzar, on de vegades també s&apos;oferixen espectacles, concerts, balls o altres activitats.</rdfs:comment>
        <rdfs:label xml:lang="ca">Casino</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Casino</rdfs:label>
        <rdfs:label xml:lang="en">Casino</rdfs:label>
        <rdfs:label xml:lang="es">Casino</rdfs:label>
        <rdfs:label xml:lang="gl">Casino</rdfs:label>
        <rdfs:label xml:lang="eu">Kasinoa</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Castle -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Castle">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">A building or group of buildings surrounded by walls, moats, and other defensive works, typically constructed on elevated ground and strategically located for warfare.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Edifici o conjunt d&apos;edificis envoltats de muralles, fossats i altres obres de fortificació, construït generalment en un lloc elevat i estratègicament situat per a la guerra.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Edifici o conjunt d&apos;edificis envoltats de muralles, fossats i altres obres de fortificació, construït generalment en un lloc elevat i estratègicament situat per a la guerra.</rdfs:comment>
        <rdfs:comment xml:lang="es">Edificio o conjunto de edificios rodeados de murallas, fosos y otras obras de fortificación, construido generalmente en un lugar elevado y estratégicamente situado para la guerra.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Edificio ou conxunto de edificios rodeados de murallas, foxos e outras obras de fortificación, construído xeralmente nun lugar elevado e situado estratexicamente para a guerra.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Harresiz, lubakiz eta beste gotortze-obrez inguratutako eraikina edo eraikin-multzoa, oro har leku garai batean eta gerrarako estrategikoki kokatua eraikia.</rdfs:comment>
        <rdfs:label xml:lang="ca">Castell</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Castell</rdfs:label>
        <rdfs:label xml:lang="gl">Castelo</rdfs:label>
        <rdfs:label xml:lang="es">Castillo</rdfs:label>
        <rdfs:label xml:lang="en">Castle</rdfs:label>
        <rdfs:label xml:lang="eu">Gaztelua</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Catacomb -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Catacomb">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="eu">Antzinako Mediterraneoko zibilizazio batzuek ehorzteko eraiki eta erabili zituzten lurpeko galeriak.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Galeries subterrànies que algunes civilitzacions mediterrànies antigues van construir i utilitzar com a lloc d&apos;enterrament.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Galeries subterrànies que algunes civilitzacions mediterrànies antigues van construir i utilitzar com a lloc d&apos;enterrament.</rdfs:comment>
        <rdfs:comment xml:lang="es">Galerías subterráneas que algunas civilizaciones mediterráneas antiguas construyeron y utilizaron como lugar de enterramiento.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Galerías subterráneas que algunhas civilizacións mediterráneas antigas construíron e utilizaron como lugar de enterramento.</rdfs:comment>
        <rdfs:comment xml:lang="en">Underground galleries built and used by certain ancient Mediterranean civilizations as burial places.</rdfs:comment>
        <rdfs:label xml:lang="en">Catacomb</rdfs:label>
        <rdfs:label xml:lang="ca">Catacumba</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Catacumba</rdfs:label>
        <rdfs:label xml:lang="es">Catacumba</rdfs:label>
        <rdfs:label xml:lang="gl">Catacumba</rdfs:label>
        <rdfs:label xml:lang="eu">Katakonba</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#CateringService -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#CateringService">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment"/>
        <rdfs:comment xml:lang="eu">Ekitaldi handietarako nahiz txikietarako, formaletarako nahiz informaletarako, elikagaiak eta edariak hornitzeko zerbitzua.</rdfs:comment>
        <rdfs:comment xml:lang="en">Food and beverage services for events, whether large or small, formal or informal.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Servei de provisió d&apos;aliments i begudes per a esdeveniments, ja siguin grans o petits, formals o informals.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Servici de provisió d&apos;aliments i begudes per a esdeveniments, ja siguen grans o xicotets, formals o informals.</rdfs:comment>
        <rdfs:comment xml:lang="es">Servicio de provisión de alimentos y bebidas para eventos, ya sean grandes o pequeños, formales o informales.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Servizo de provisión de alimentos e bebidas para eventos, xa sexan grandes ou pequenos, formais ou informais.</rdfs:comment>
        <rdfs:label xml:lang="en">Catering service</rdfs:label>
        <rdfs:label xml:lang="eu">Catering-zerbitzua</rdfs:label>
        <rdfs:label xml:lang="ca">Servei de càtering</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Servici de càtering</rdfs:label>
        <rdfs:label xml:lang="es">Servicio de catering</rdfs:label>
        <rdfs:label xml:lang="gl">Servizo de cátering</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Cathedral -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Cathedral">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="eu">Apezpikuak, bere kabildoarekin batera, egoitza edo katedra duen eliza nagusia.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Església principal on el bisbe, amb el seu capítol, té la seu o càtedra.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Església principal on el bisbe, amb el seu capítol, té la seu o càtedra.</rdfs:comment>
        <rdfs:comment xml:lang="es">Iglesia principal en que el obispo, con su cabildo, tiene su sede o cátedra.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Igrexa principal na que o bispo, co seu cabido, ten a súa sede ou cátedra.</rdfs:comment>
        <rdfs:comment xml:lang="en">The principal church where the bishop, together with the cathedral chapter, has his seat.</rdfs:comment>
        <rdfs:label xml:lang="ca">Catedral</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Catedral</rdfs:label>
        <rdfs:label xml:lang="es">Catedral</rdfs:label>
        <rdfs:label xml:lang="gl">Catedral</rdfs:label>
        <rdfs:label xml:lang="en">Cathedral</rdfs:label>
        <rdfs:label xml:lang="eu">Katedrala</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Cave -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Cave">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
        <rdfs:comment xml:lang="es">Cavidad natural del terreno causada por algún tipo de erosión de corrientes de agua, hielo o lava.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Cavidade natural do terreo causada por algún tipo de erosión de correntes de auga, xeo ou lava.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Cavitat natural del terreny causada per algun tipus d&apos;erosió de corrents d&apos;aigua, gel o lava.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Cavitat natural del terreny causada per algun tipus d&apos;erosió de corrents d&apos;aigua, gel o lava.</rdfs:comment>
        <rdfs:comment xml:lang="en">Natural cavity in the ground caused by some type of erosion from water currents, ice or lava.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ur-korronteen, izotzaren edo labaren higadura motaren batek sortutako lurreko barrunbe naturala.</rdfs:comment>
        <rdfs:label xml:lang="en">Cave</rdfs:label>
        <rdfs:label xml:lang="ca">Cova o caverna</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Cova o caverna</rdfs:label>
        <rdfs:label xml:lang="gl">Cova ou caverna</rdfs:label>
        <rdfs:label xml:lang="es">Cueva o caverna</rdfs:label>
        <rdfs:label xml:lang="eu">Koba edo leizea</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Cemetery -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Cemetery">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">An enclosed area generally designated for the burial or interment of deceased persons.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Hildako pertsonak ehorzteko edo lurperatzeko esparrua, oro har mugatua.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Recinte generalment delimitat destinat a l&apos;enterrament o sepultura de persones mortes.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Recinte generalment delimitat destinat a l&apos;enterrament o sepultura de persones mortes.</rdfs:comment>
        <rdfs:comment xml:lang="es">Recinto generalmente delimitado destinado al enterramiento o sepultura de personas fallecidas.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Recinto xeralmente delimitado destinado ao enterramento ou sepultura de persoas falecidas.</rdfs:comment>
        <rdfs:label xml:lang="es">Cementerio</rdfs:label>
        <rdfs:label xml:lang="ca">Cementiri</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Cementiri</rdfs:label>
        <rdfs:label xml:lang="en">Cemetery</rdfs:label>
        <rdfs:label xml:lang="gl">Cemiterio</rdfs:label>
        <rdfs:label xml:lang="eu">Hilerria</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Certification -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Certification">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#Acknowledgement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasDescription"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#Description"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#certificationType"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#url"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#validFrom"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#validThrough"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Arauak, betekizunak, ezaugarriak edo eskakizunak betetzen direla adierazten duten ziurtagiriak</rdfs:comment>
        <rdfs:comment xml:lang="es">Certificados que indican el cumplimiento de normas, requisitos, características o exigencias</rdfs:comment>
        <rdfs:comment xml:lang="gl">Certificados que indican o cumprimento de normas, requisitos, características ou esixencias</rdfs:comment>
        <rdfs:comment xml:lang="en">Certificates that indicate compliance with standards, requirements, characteristics or demands</rdfs:comment>
        <rdfs:comment xml:lang="ca">Certificats que indiquen el compliment de normes, requisits, característiques o exigències</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Certificats que indiquen el compliment de normes, requisits, característiques o exigències</rdfs:comment>
        <rdfs:label xml:lang="ca">Certificació</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Certificació</rdfs:label>
        <rdfs:label xml:lang="es">Certificación</rdfs:label>
        <rdfs:label xml:lang="gl">Certificación</rdfs:label>
        <rdfs:label xml:lang="en">Certification</rdfs:label>
        <rdfs:label xml:lang="eu">Ziurtagiria</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Chapel -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Chapel">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">A building adjacent to a church, or forming part of it, containing an altar and dedicated to a particular devotion.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Edifici contigu a una església o que en forma part, amb altar i advocació particulars.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Edifici contigu a una església o que en forma part, amb altar i advocació particulars.</rdfs:comment>
        <rdfs:comment xml:lang="es">Edificio contiguo a una iglesia o parte integrante de ella, con altar y advocación particular.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Edificio contiguo a unha igrexa ou parte integrante dela, con altar e advocación particular.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Eliza baten ondoko edo haren barruko eraikina, aldare eta adbokazio bereziak dituena.</rdfs:comment>
        <rdfs:label xml:lang="en">Chapel</rdfs:label>
        <rdfs:label xml:lang="gl">Ermida</rdfs:label>
        <rdfs:label xml:lang="ca">Ermita</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Ermita</rdfs:label>
        <rdfs:label xml:lang="es">Ermita</rdfs:label>
        <rdfs:label xml:lang="eu">Ermita</rdfs:label>
        <skos:altLabel xml:lang="es">Capilla</skos:altLabel>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#ChillOut -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#ChillOut">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PartyAndEntertainmentFacility"/>
        <rdfs:comment xml:lang="en">A place where drinks are served and calm and relaxing electronic music is listened to.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Edariak zerbitzatzen eta musika elektroniko lasaia eta erlaxagarria entzuten den lokala.</rdfs:comment>
        <rdfs:comment xml:lang="es">Local en el que se despachan bebidas y se escucha música electrónica tranquila y relajante.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Local no que se serven bebidas e se escoita música electrónica tranquila e relaxante.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Local on se serveixen begudes i s&apos;escolta música electrònica tranquil·la i relaxant.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Local on se servixen begudes i s&apos;escolta música electrònica tranquil·la i relaxant.</rdfs:comment>
        <rdfs:label xml:lang="en">Chill out</rdfs:label>
        <rdfs:label xml:lang="es">Chill out</rdfs:label>
        <rdfs:label xml:lang="eu">Chill out</rdfs:label>
        <rdfs:label xml:lang="gl">Chill out</rdfs:label>
        <rdfs:label xml:lang="ca">Chill-out</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Chill-out</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#ChocolateShop -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#ChocolateShop">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment"/>
        <rdfs:comment xml:lang="gl">Establecemento no que se serve chocolate á cunca, bebidas e produtos de pastelaría.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento en el que se sirve chocolate a la taza, bebidas y productos de pastelería.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment on se serveix xocolata desfeta, begudes i productes de pastisseria.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment on se servix xocolata desfeta, begudes i productes de pastisseria.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment that serves hot chocolate, drinks and pastries.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Txokolate beroa, edariak eta gozogintzako produktuak zerbitzatzen diren establezimendua.</rdfs:comment>
        <rdfs:label xml:lang="gl">Chocolataría</rdfs:label>
        <rdfs:label xml:lang="en">Chocolate shop</rdfs:label>
        <rdfs:label xml:lang="es">Chocolatería</rdfs:label>
        <rdfs:label xml:lang="eu">Txokolategia</rdfs:label>
        <rdfs:label xml:lang="ca">Xocolateria</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Xocolateria</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Church -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Church">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">A Christian place of worship.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Kristau-tenplua.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Temple cristià.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Temple cristià.</rdfs:comment>
        <rdfs:comment xml:lang="es">Templo cristiano.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Templo cristián.</rdfs:comment>
        <rdfs:label xml:lang="en">Church</rdfs:label>
        <rdfs:label xml:lang="eu">Eliza</rdfs:label>
        <rdfs:label xml:lang="ca">Església</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Església</rdfs:label>
        <rdfs:label xml:lang="es">Iglesia</rdfs:label>
        <rdfs:label xml:lang="gl">Igrexa</rdfs:label>
        <rdfs:label xml:lang="en">Parish</rdfs:label>
        <rdfs:label xml:lang="eu">Parrokia</rdfs:label>
        <rdfs:label xml:lang="gl">Parroquia</rdfs:label>
        <rdfs:label xml:lang="ca">Parròquia</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Parròquia</rdfs:label>
        <skos:altLabel xml:lang="es">Parroquia</skos:altLabel>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#ChurroShop -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#ChurroShop">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment"/>
        <rdfs:comment xml:lang="gl">Establecemento no que se elaboran e comercializan churros e porras de forma artesanal, así como chocolate á cunca.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento en el que se elaboran y se comercializan churros y porras, de forma artesanal, así como chocolate a la taza.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment on s&apos;elaboren i es comercialitzen xurros i porres de manera artesanal, així com xocolata desfeta.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment on s&apos;elaboren i es comercialitzen xurros i porres de manera artesanal, així com xocolata desfeta.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment where artisanal churros and porras are made and sold, as well as hot chocolate.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Txurroak eta porrak artisau eran egin eta saltzen dituen establezimendua, txokolate beroa ere eskaintzen duena.</rdfs:comment>
        <rdfs:label xml:lang="gl">Churraría</rdfs:label>
        <rdfs:label xml:lang="es">Churrería</rdfs:label>
        <rdfs:label xml:lang="en">Churro shop</rdfs:label>
        <rdfs:label xml:lang="eu">Txurro-denda</rdfs:label>
        <rdfs:label xml:lang="ca">Xurreria</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Xurreria</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#CiderBar -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#CiderBar">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment"/>
        <rdfs:comment xml:lang="eu">Espezialitate gisa sagardoa saltzen eta kontsumitzen den establezimendua.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento no que se vende e se consome sidra como especialidade.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento en el que se vende y se consume sidra como especialidad.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment on es ven i es consumeix sidra com a especialitat.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment on es ven i es consumix sidra com a especialitat.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment in which cider is sold and consumed as a specialty.</rdfs:comment>
        <rdfs:label xml:lang="en">Cider bar</rdfs:label>
        <rdfs:label xml:lang="eu">Sagardotegia</rdfs:label>
        <rdfs:label xml:lang="gl">Sidraría</rdfs:label>
        <rdfs:label xml:lang="ca">Sidreria</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Sidreria</rdfs:label>
        <rdfs:label xml:lang="es">Sidrería</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#CivilProtection -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#CivilProtection">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
        <rdfs:comment xml:lang="eu">Pertsonak eta ondasunak babesten dituen zerbitzu publikoa, larrialdi eta hondamendi mota guztien aurrean erantzun egokia bermatuz.</rdfs:comment>
        <rdfs:comment xml:lang="en">Public service that protects people and property, guaranteeing an adequate response to different types of emergencies and catastrophes</rdfs:comment>
        <rdfs:comment xml:lang="ca">Servei públic que protegeix les persones i els béns garantint una resposta adequada davant dels diferents tipus d&apos;emergències i catàstrofes.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Servici públic que protegix les persones i els béns garantint una resposta adequada davant dels diferents tipus d&apos;emergències i catàstrofes.</rdfs:comment>
        <rdfs:comment xml:lang="es">Servicio público que protege a las personas y bienes garantizando una respuesta adecuada ante los distintos tipos de emergencias y catástrofes.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Servizo público que protexe as persoas e os bens garantindo unha resposta adecuada ante os distintos tipos de emerxencias e catástrofes.</rdfs:comment>
        <rdfs:label xml:lang="eu">Babes zibila</rdfs:label>
        <rdfs:label xml:lang="en">Civil protection</rdfs:label>
        <rdfs:label xml:lang="ca">Protecció civil</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Protecció civil</rdfs:label>
        <rdfs:label xml:lang="es">Protección civil</rdfs:label>
        <rdfs:label xml:lang="gl">Protección civil</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#ClimbingWall -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#ClimbingWall">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#SportFacility"/>
        <rdfs:comment xml:lang="eu">Eskalada entrenatzeko harkaitz-horma batez osatutako kirol-instalazioa.</rdfs:comment>
        <rdfs:comment xml:lang="es">Instalación deportiva consistente en una pared rocosa para el entrenamiento de la escalada.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Instalación deportiva consistente nunha parede rochosa para o adestramento da escalada.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Instal·lació esportiva consistent en una paret rocosa per a l&apos;entrenament de l&apos;escalada.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Instal·lació esportiva consistent en una paret rocosa per a l&apos;entrenament de l&apos;escalada.</rdfs:comment>
        <rdfs:comment xml:lang="en">Sports facility consisting of a rock wall for climbing training.</rdfs:comment>
        <rdfs:label xml:lang="en">Climbing wall</rdfs:label>
        <rdfs:label xml:lang="ca">Rocòdrom</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Rocòdrom</rdfs:label>
        <rdfs:label xml:lang="es">Rocódromo</rdfs:label>
        <rdfs:label xml:lang="gl">Rocódromo</rdfs:label>
        <rdfs:label xml:lang="eu">Rokodromoa</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Cloister -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Cloister">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">A gallery that encloses the main courtyard of a church or monastery.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Eliza edo komentu bateko patio nagusia inguratzen duen galeria.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Galeria que envolta el pati principal d&apos;una església o convent.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Galeria que envolta el pati principal d&apos;una església o convent.</rdfs:comment>
        <rdfs:comment xml:lang="es">Galería que cerca el patio principal de una iglesia o convento.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Galería que rodea o patio principal dunha igrexa ou convento.</rdfs:comment>
        <rdfs:label xml:lang="ca">Claustre</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Claustre</rdfs:label>
        <rdfs:label xml:lang="es">Claustro</rdfs:label>
        <rdfs:label xml:lang="gl">Claustro</rdfs:label>
        <rdfs:label xml:lang="en">Cloister</rdfs:label>
        <rdfs:label xml:lang="eu">Klaustroa</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Clothing -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Clothing">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#RetailAndFashionBusiness"/>
        <rdfs:comment xml:lang="en">A retail establishment dedicated to the sale of clothing, footwear, and accessories that follow current design and market trends.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Diseinuaren eta merkatuaren egungo joerei jarraitzen dieten jantziak, oinetakoak eta osagarriak txikizka saltzen dituen establezimendua.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento dedicado á venda polo miúdo de pezas de vestir, calzado e accesorios que seguen as tendencias actuais do deseño e do mercado.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento dedicado a la venta minorista de prendas devestir, calzado y accesorios que siguen las tendencias actuales del diseño y el mercado.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment dedicat a la venda al detall de peces de vestir, calçat i accessoris que segueixen les tendències actuals del disseny i del mercat.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment dedicat a la venda al detall de peces de vestir, calçat i accessoris que seguixen les tendències actuals del disseny i del mercat.</rdfs:comment>
        <rdfs:label xml:lang="ca">Botiga de moda</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Botiga de moda</rdfs:label>
        <rdfs:label xml:lang="en">Clothing</rdfs:label>
        <rdfs:label xml:lang="eu">Moda-denda</rdfs:label>
        <rdfs:label xml:lang="gl">Tenda de moda</rdfs:label>
        <rdfs:label xml:lang="es">Tienda de moda</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#CocktailBar -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#CocktailBar">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment"/>
        <rdfs:comment xml:lang="gl">Establecemento dedicado á elaboración e ao servizo de cócteles, entendidos como combinacións de distintas bebidas e outros ingredientes, xeralmente de carácter alcohólico.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento dedicado a la elaboración y al servicio de cócteles, entendidos como resultantes de la combinación de distintas bebidas y otros ingredientes, generalmente de carácter alcohólico.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment dedicat a l&apos;elaboració i al servei de còctels, entesos com a combinacions de diferents begudes i altres ingredients, generalment de caràcter alcohòlic.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment dedicat a l&apos;elaboració i al servici de còctels, entesos com a combinacions de diferents begudes i altres ingredients, generalment de caràcter alcohòlic.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment dedicated to the preparation and service of cocktails, understood as beverages resulting from the combination of different drinks and other ingredients, generally of an alcoholic nature.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Koktelak prestatu eta zerbitzatzen dituen establezimendua; koktelak hainbat edari eta beste osagai batzuk nahastuta egiten dira, oro har alkoholdunak.</rdfs:comment>
        <rdfs:label xml:lang="en">Cocktail bar</rdfs:label>
        <rdfs:label xml:lang="gl">Coctelaría</rdfs:label>
        <rdfs:label xml:lang="ca">Cocteleria</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Cocteleria</rdfs:label>
        <rdfs:label xml:lang="es">Coctelería</rdfs:label>
        <rdfs:label xml:lang="eu">Koktel-taberna</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#ComplementaryActivitiesCompany -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#ComplementaryActivitiesCompany">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrganisation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasTourismOrRelatedFacility"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#offers"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#AdventureActivity"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#AgrotourismExperience"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TicketOrEntrance"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Tour"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasTourismOrRelatedFacility"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="ca">Organització turística dedicada a prestar activitats o serveis que satisfan necessitats vinculades a una o diverses tipologies turístiques concretes.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Organització turística dedicada a prestar activitats o servicis que satisfan necessitats vinculades a una o diverses tipologies turístiques concretes.</rdfs:comment>
        <rdfs:comment xml:lang="es">Organización turística dedicada a la prestación de actividades o servicios que satisfacen necesidades vinculadas a una o varias tipologías turísticas concretas.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Organización turística dedicada á prestación de actividades ou servizos que satisfán necesidades vinculadas a unha ou varias tipoloxías turísticas concretas.</rdfs:comment>
        <rdfs:comment xml:lang="en">Tourism organisation dedicated to providing activities or services that meet needs related to one or more specific types of tourism.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Turismo-tipologia jakin bati edo batzuei lotutako beharrak asetzen dituzten jarduerak edo zerbitzuak eskaintzen dituen turismo-erakundea.</rdfs:comment>
        <rdfs:label xml:lang="en">Complementary activities company</rdfs:label>
        <rdfs:label xml:lang="ca">Empresa d&apos;activitats complementàries</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Empresa d&apos;activitats complementàries</rdfs:label>
        <rdfs:label xml:lang="es">Empresa de actividades complementarias</rdfs:label>
        <rdfs:label xml:lang="gl">Empresa de actividades complementarias</rdfs:label>
        <rdfs:label xml:lang="eu">Jarduera osagarrien enpresa</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#CongressCentre -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#CongressCentre">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#EventAttendanceFacility"/>
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="es">Espacio preparado para la acogida y celebración de congresos, convenciones, ferias, incentivos y cualquier otro acontecimiento similar.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espai preparat per acollir i celebrar congressos, convencions, fires, incentius i qualsevol altre esdeveniment similar.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espai preparat per acollir i celebrar congressos, convencions, fires, incentius i qualsevol altre esdeveniment similar.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazo preparado para a acollida e celebración de congresos, convencións, feiras, incentivos e calquera outro acontecemento similar.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Kongresuak, konbentzioak, azokak, pizgarri-ekitaldiak eta antzeko beste edozein ekitaldi hartzeko eta egiteko prestatutako espazioa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Space prepared for hosting and holding conferences, conventions, fairs, incentives and any other similar event.</rdfs:comment>
        <rdfs:label xml:lang="eu">Biltzar- eta erakusketa-jauregia</rdfs:label>
        <rdfs:label xml:lang="en">Congress centre</rdfs:label>
        <rdfs:label xml:lang="gl">Palacio de congresos e exposicións</rdfs:label>
        <rdfs:label xml:lang="es">Palacio de congresos y exposiciones</rdfs:label>
        <rdfs:label xml:lang="ca">Palau de congressos i exposicions</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Palau de congressos i exposicions</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#ContactPoint -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#ContactPoint">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#app"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#email"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#instantMessagingService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#telephone"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#url"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A designated means of communication (e.g., phone number, email, website) through which a person or organisation can be reached for inquiries or support.</rdfs:comment>
        <rdfs:comment xml:lang="es">Medio de comunicación designado (por ejemplo, número de teléfono, correo electrónico, URL) a través del cual se puede contactar con una persona u organización para realizar consultas o solicitar asistencia.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Medio de comunicación designado (por exemplo, número de teléfono, correo electrónico, URL) a través do cal se pode contactar cunha persoa ou organización para realizar consultas ou solicitar asistencia.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Mitjà de comunicació designat (per exemple, número de telèfon, correu electrònic, URL) a través del qual es pot contactar amb una persona o organització per fer consultes o sol·licitar assistència.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Mitjà de comunicació designat (per exemple, número de telèfon, correu electrònic, URL) a través del qual es pot contactar amb una persona o organització per fer consultes o sol·licitar assistència.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Pertsona edo erakunde batekin kontsultak egiteko edo laguntza eskatzeko harremanetan jartzeko izendatutako komunikabidea (adibidez, telefono-zenbakia, posta elektronikoa, URLa).</rdfs:comment>
        <rdfs:label xml:lang="en">Contact point</rdfs:label>
        <rdfs:label xml:lang="eu">Harremanetarako puntua</rdfs:label>
        <rdfs:label xml:lang="ca">Punt de contacte</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Punt de contacte</rdfs:label>
        <rdfs:label xml:lang="es">Punto de contacto</rdfs:label>
        <rdfs:label xml:lang="gl">Punto de contacto</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Convent -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Convent">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">A residence where members of a religious order live under the rules of their institute.</rdfs:comment>
        <rdfs:comment xml:lang="es">Casa en que viven religiosos o religiosas bajo las reglas de su instituto.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Casa na que viven relixiosos ou relixiosas baixo as regras do seu instituto.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Casa on viuen religiosos o religioses sota les regles del seu institut.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Casa on viuen religiosos o religioses sota les regles del seu institut.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Erlijiosoak edo erlijiosak beren institutuaren arauen arabera bizi diren etxea.</rdfs:comment>
        <rdfs:label xml:lang="ca">Convent</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Convent</rdfs:label>
        <rdfs:label xml:lang="en">Convent</rdfs:label>
        <rdfs:label xml:lang="es">Convento</rdfs:label>
        <rdfs:label xml:lang="gl">Convento</rdfs:label>
        <rdfs:label xml:lang="eu">Komentua</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#ConventionCentre -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#ConventionCentre">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#EventAttendanceFacility"/>
        <rdfs:comment xml:lang="en">A facility designed for hosting conventions, congresses, conferences, professional meetings, and other corporate or institutional events, equipped with versatile spaces such as modular rooms, auditoriums, and support areas, as well as the technical infrastructure and services required for the organisation and management of large-scale events.</rdfs:comment>
        <rdfs:comment xml:lang="es">Instalación destinada a la celebración de congresos, convenciones, conferencias, reuniones profesionales y otros eventos de carácter corporativo o institucional, dotada de espacios versátiles como salas modulares, auditorios y áreas de apoyo, así como de infraestructuras técnicas y servicios necesarios para la organización y gestión de eventos a gran escala.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Instalación destinada á celebración de congresos, convencións, conferencias, reunións profesionais e outros eventos de carácter corporativo ou institucional, dotada de espazos versátiles como salas modulares, auditorios e áreas de apoio, así como de infraestruturas técnicas e servizos necesarios para a organización e xestión de eventos a gran escala.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Instal·lació destinada a celebrar congressos, convencions, conferències, reunions professionals i altres esdeveniments corporatius o institucionals, dotada d&apos;espais versàtils com ara sales modulars, auditoris i àrees de suport, així com de les infraestructures tècniques i els serveis necessaris per organitzar i gestionar esdeveniments a gran escala.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Instal·lació destinada a celebrar congressos, convencions, conferències, reunions professionals i altres esdeveniments corporatius o institucionals, dotada d&apos;espais versàtils com ara sales modulars, auditoris i àrees de suport, així com de les infraestructures tècniques i els servicis necessaris per organitzar i gestionar esdeveniments a gran escala.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Kongresuak, konbentzioak, hitzaldiak, bilera profesionalak eta beste ekitaldi korporatibo edo instituzional batzuk egiteko instalazioa, erabilera anitzeko espazioak dituena, hala nola areto modularrak, auditorioak eta laguntza-eremuak, baita eskala handiko ekitaldiak antolatzeko eta kudeatzeko behar diren azpiegitura teknikoak eta zerbitzuak ere.</rdfs:comment>
        <rdfs:label xml:lang="ca">Centre de convencions</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Centre de convencions</rdfs:label>
        <rdfs:label xml:lang="es">Centro de convenciones</rdfs:label>
        <rdfs:label xml:lang="gl">Centro de convencións</rdfs:label>
        <rdfs:label xml:lang="en">Convention centre</rdfs:label>
        <rdfs:label xml:lang="eu">Konbentzio-zentroa</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Cove -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Cove">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
        <rdfs:comment xml:lang="en">A small, rounded inlet forming part of a bay, smaller than a beach and characterized by calmer waters.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Forma biribilduko badiaren zatia, hondartza baino txikiagoa eta ur lasaiagoak dituena</rdfs:comment>
        <rdfs:comment xml:lang="ca">Tram de badia de forma arrodonida, de dimensions més petites que les d&apos;una platja i amb aigües més tranquil·les</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Tram de badia de forma arrodonida, de dimensions més xicotetes que les d&apos;una platja i amb aigües més tranquil·les</rdfs:comment>
        <rdfs:comment xml:lang="es">Tramo de bahía de forma redondeada, de dimensiones más pequeñas a las de la playa y donde sus aguas son más tranquilas</rdfs:comment>
        <rdfs:comment xml:lang="gl">Treito de baía de forma arredondada, de dimensións máis pequenas ca as da praia e con augas máis tranquilas</rdfs:comment>
        <rdfs:label xml:lang="eu">Badia txikia</rdfs:label>
        <rdfs:label xml:lang="ca">Cala</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Cala</rdfs:label>
        <rdfs:label xml:lang="es">Cala</rdfs:label>
        <rdfs:label xml:lang="gl">Cala</rdfs:label>
        <rdfs:label xml:lang="en">Cove</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#CultureCentre -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#CultureCentre">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#LeisureAndCultureFacility"/>
        <rdfs:comment xml:lang="eu">Kultura-jarduerak antolatzen diren esparrua: hitzaldiak, erakusketak, solasaldiak eta abar.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Recinte on s&apos;organitzen activitats de caràcter cultural: conferències, exposicions, tertúlies, etc.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Recinte on s&apos;organitzen activitats de caràcter cultural: conferències, exposicions, tertúlies, etc.</rdfs:comment>
        <rdfs:comment xml:lang="es">Recinto en los que se organizan actividades de carácter cultural: conferencias, exposiciones, tertulias, etc.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Recinto no que se organizan actividades de carácter cultural: conferencias, exposicións, faladoiros, etc.</rdfs:comment>
        <rdfs:comment xml:lang="en">Venue where cultural activities are organized: conferences, exhibitions, gatherings, etc.</rdfs:comment>
        <rdfs:label xml:lang="ca">Centre cultural</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Centre cultural</rdfs:label>
        <rdfs:label xml:lang="es">Centro cultural</rdfs:label>
        <rdfs:label xml:lang="gl">Centro cultural</rdfs:label>
        <rdfs:label xml:lang="en">Culture centre</rdfs:label>
        <rdfs:label xml:lang="eu">Kultura-zentroa</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#DailyOpeningHours -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#DailyOpeningHours">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#dayOfTheWeek"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Asteko egun jakin bati dagokion irekiera-ordutegia, irekitzeko eta ixteko orduak dituzten ordutegi-tarte baten edo batzuen bidez zehaztua.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Horari d&apos;obertura corresponent a un dia concret de la setmana, definit mitjançant un o diversos intervals horaris amb hores d&apos;obertura i tancament.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Horari d&apos;obertura corresponent a un dia concret de la setmana, definit mitjançant un o diversos intervals horaris amb hores d&apos;obertura i tancament.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Horario de apertura correspondente a un día concreto da semana, definido mediante un ou varios intervalos horarios con horas de apertura e peche.</rdfs:comment>
        <rdfs:comment xml:lang="es">Horario de apertura correspondiente a un día concreto de la semana, definido mediante uno o varios intervalos horarios con horas de apertura y cierre.</rdfs:comment>
        <rdfs:comment xml:lang="en">Opening hours corresponding to a specific day of the week, defined by one or more time intervals with opening and closing times.</rdfs:comment>
        <rdfs:label xml:lang="en">Daily opening hours</rdfs:label>
        <rdfs:label xml:lang="eu">Eguneroko irekiera-ordutegia</rdfs:label>
        <rdfs:label xml:lang="ca">Horari d&apos;obertura diari</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Horari d&apos;obertura diari</rdfs:label>
        <rdfs:label xml:lang="es">Horario de apertura diario</rdfs:label>
        <rdfs:label xml:lang="gl">Horario de apertura diario</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Description -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Description">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#author"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismDestination"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#relatedTourismDestination"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismDestination"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#shortDescription"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#longDescription"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Elementu zehatz bati buruzko informazio zehatza eta laburtua ematen du, hala nola produktu, zerbitzu edo entitate bati buruzkoa. Bloke honek elementuaren ezaugarri nagusiak, funtzioak, onurak edo alderdi nabarmenak deskribatzen dituzten funtsezko xehetasunak jaso ohi ditu.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Proporciona informació concisa i resumida sobre un element específic, com ara un producte, servei o entitat. Aquest bloc sol contenir detalls clau i destacats que descriuen les característiques principals, funcions, beneficis o aspectes destacats de l&apos;element en qüestió.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Proporciona informació concisa i resumida sobre un element específic, com ara un producte, servici o entitat. Este bloc sol contenir detalls clau i destacats que descriuen les característiques principals, funcions, beneficis o aspectes destacats de l&apos;element en qüestió.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Proporciona información concisa e resumida sobre un elemento específico, como un produto, servizo ou entidade. Este bloque adoita conter detalles clave e destacados que describen as características principais, funcións, beneficios ou aspectos salientables do elemento en cuestión.</rdfs:comment>
        <rdfs:comment xml:lang="es">Proporciona información concisa y resumida sobre un elemento específico, como un producto, servicio o entidad. Este bloque suele contener detalles clave y destacados que describen las características principales, funciones, beneficios o aspectos destacados del elemento en cuestión.</rdfs:comment>
        <rdfs:comment xml:lang="en">Provides concise, summarized information about a specific item, such as a product, service, or entity. This block usually contains key details and highlights that describe the main features, functions, benefits or highlights of the item in question.</rdfs:comment>
        <rdfs:label xml:lang="gl">Descrición</rdfs:label>
        <rdfs:label xml:lang="ca">Descripció</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Descripció</rdfs:label>
        <rdfs:label xml:lang="es">Descripción</rdfs:label>
        <rdfs:label xml:lang="en">Description</rdfs:label>
        <rdfs:label xml:lang="eu">Deskribapena</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Desert -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Desert">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#naturalResourceContains"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Euri faltagatik ia landaredirik ez duen edo oso landaredi urria duen lurralde hareatsua edo harritsua.</rdfs:comment>
        <rdfs:comment xml:lang="en">Sandy or rocky territory, which due to the almost total lack of rain lacks or has very little vegetation</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Territori arenós o pedregós que, per la manca gairebé total de pluges, no té vegetació o en té molt poca.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Territori sorrenc o pedregós que, per la manca gairebé total de pluges, no té vegetació o en té molt poca.</rdfs:comment>
        <rdfs:comment xml:lang="es">Territorio arenoso o pedregoso, que por la falta casi total de lluvias carece de vegetación o la tiene muy escasa.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Territorio areoso ou pedregoso que, pola falta case total de chuvias, carece de vexetación ou a ten moi escasa.</rdfs:comment>
        <rdfs:label xml:lang="eu">Basamortua</rdfs:label>
        <rdfs:label xml:lang="ca">Desert</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Desert</rdfs:label>
        <rdfs:label xml:lang="en">Desert</rdfs:label>
        <rdfs:label xml:lang="gl">Deserto</rdfs:label>
        <rdfs:label xml:lang="es">Desierto</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#DestinationExperience -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#DestinationExperience">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismService"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#offeredBy"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismDestination"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasLocation"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#Location"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#itinerary"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#Itinerary"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#timeOfTheDay"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#endDateTime"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Helmugak proposatzen dituen doako bizipenak, turista bertako biztanleen bizimoduan, kulturan eta benetakotasunean murgiltzeko, bidaia egitera bultzatzeko edo bidaiaren ondoren iraungo duen eta besteei helarazi ahal izango dien oroitzapena eramateko. Turistaren eta helmugako biztanleen artean harreman emozionala ezartzea ahalbidetzen du.</rdfs:comment>
        <rdfs:comment xml:lang="en">Price-free experiences that the destination proposes so that the tourist integrates into the way of life of its inhabitants, their culture and their authenticity, to motivate the completion of the trip or so that they take away a memory that survives after it and can be transmitted to others. It allows establishing an emotional relationship between the tourist and the inhabitants of the destination.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Vivencias gratuítas que o destino propón para que o turista se integre na forma de vivir dos seus habitantes, na súa cultura e na súa autenticidade, para motivar a realización da viaxe ou para que leve unha lembranza que perdure despois e poida ser transmitida aos demais. Permite establecer unha relación emocional entre o turista e os habitantes do destino.</rdfs:comment>
        <rdfs:comment xml:lang="es">Vivencias libres de precio que el destino propone para que el turista se integre en la forma de vivir de sus habitantes, su cultura y su autenticidad, para motivar la realización del viaje o bien para que se lleve un recuerdo que perviva después del mismo y pueda ser transmitido a los demás. Permite establecer una relación emocional entre el turista y los habitantes del destino.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Vivències gratuïtes que la destinació proposa perquè el turista s&apos;integri en la manera de viure dels seus habitants, la seua cultura i la seua autenticitat, per motivar el viatge o perquè se n&apos;enduga un record que perduri després i es puga transmetre als altres. Permet establir una relació emocional entre el turista i els habitants de la destinació.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Vivències gratuïtes que la destinació proposa perquè el turista s&apos;integri en la manera de viure dels seus habitants, la seva cultura i la seva autenticitat, per motivar el viatge o perquè se n&apos;endugui un record que perduri després i es pugui transmetre als altres. Permet establir una relació emocional entre el turista i els habitants de la destinació.</rdfs:comment>
        <rdfs:label xml:lang="en">Destination experience</rdfs:label>
        <rdfs:label xml:lang="es">Experiencia en destino</rdfs:label>
        <rdfs:label xml:lang="gl">Experiencia no destino</rdfs:label>
        <rdfs:label xml:lang="ca">Experiència a la destinació</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Experiència a la destinació</rdfs:label>
        <rdfs:label xml:lang="eu">Helmugako esperientzia</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#DestinationManagementCompany -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#DestinationManagementCompany">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismIntermediary"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalDMCService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Company specialized in the organization and management of tourist services for foreign visitors in a specific destination.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Empresa especialitzada en l&apos;organització i gestió de serveis turístics per a visitants estrangers en una destinació específica.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Empresa especialitzada en l&apos;organització i gestió de servicis turístics per a visitants estrangers en una destinació específica.</rdfs:comment>
        <rdfs:comment xml:lang="es">Empresa especializada en la organización y gestión de servicios turísticos para visitantes extranjeros en un destino específico.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Empresa especializada na organización e xestión de servizos turísticos para visitantes estranxeiros nun destino específico.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Helmuga jakin batean atzerriko bisitarientzako turismo-zerbitzuak antolatzen eta kudeatzen espezializatutako enpresa.</rdfs:comment>
        <rdfs:label xml:lang="en">Destination management company</rdfs:label>
        <rdfs:label xml:lang="ca">Operador receptiu</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Operador receptiu</rdfs:label>
        <rdfs:label xml:lang="es">Operador receptivo</rdfs:label>
        <rdfs:label xml:lang="gl">Operador receptivo</rdfs:label>
        <rdfs:label xml:lang="eu">Operadore hartzailea</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#DiveSite -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#DiveSite">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
        <rdfs:comment xml:lang="eu">Natura-ingurune bateko eremu zehatza, normalean itsasokoa edo urpekoa, urpekaritzarako interesgarriak diren baldintza fisiko, biologiko edo paisajistikoak dituena.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specific area of a natural environment, generally marine or underwater, that meets physical, biological, or scenic conditions of interest for the practice of diving.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Zona específica d&apos;un entorn natural, generalment marí o subaquàtic, que reuneix condicions físiques, biològiques o paisatgístiques d&apos;interès per a la pràctica del busseig.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Zona específica d&apos;un entorn natural, generalment marí o subaquàtic, que reunix condicions físiques, biològiques o paisatgístiques d&apos;interès per a la pràctica del busseig.</rdfs:comment>
        <rdfs:comment xml:lang="es">Zona específica de un entorno natural, generalmente marino o subacuático, que reúne condiciones físicas, biológicas o paisajísticas de interés para la práctica del buceo.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Zona específica dun contorno natural, xeralmente mariño ou subacuático, que reúne condicións físicas, biolóxicas ou paisaxísticas de interese para a práctica do mergullo.</rdfs:comment>
        <rdfs:label xml:lang="en">Dive site</rdfs:label>
        <rdfs:label xml:lang="ca">Punt d&apos;immersió</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Punt d&apos;immersió</rdfs:label>
        <rdfs:label xml:lang="es">Punto de inmersión</rdfs:label>
        <rdfs:label xml:lang="gl">Punto de inmersión</rdfs:label>
        <rdfs:label xml:lang="eu">Urperatze-puntua</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#DryCleaningOrLaundry -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#DryCleaningOrLaundry">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#MiscellaneousBusiness"/>
        <rdfs:comment xml:lang="eu">Ehunak eta jantziak tindatu, lisatu edo lehorrean nahiz beste prozedura baten bidez garbitzen diren establezimendua.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento no que se tinguen, pasan o ferro ou se limpan en seco ou mediante outro procedemento tecidos e pezas de vestir.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento en el que se tiñen, se planchan o se limpian en seco o mediante otro procedimiento tejidos y prendas de vestir.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment on es tenyeixen, es planxen o es netegen en sec o mitjançant un altre procediment teixits i peces de vestir.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment on es tenyeixen, es planxen o es netegen en sec o mitjançant un altre procediment teixits i peces de vestir.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment in which fabrics and clothing are dyed, ironed, dry cleaned or otherwise cleaned.</rdfs:comment>
        <rdfs:label xml:lang="en">Dry cleaning or laundry</rdfs:label>
        <rdfs:label xml:lang="eu">Tindategia edo ikuztegia</rdfs:label>
        <rdfs:label xml:lang="ca">Tintoreria o bugaderia</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Tintoreria o bugaderia</rdfs:label>
        <rdfs:label xml:lang="es">Tintorería o lavandería</rdfs:label>
        <rdfs:label xml:lang="gl">Tinturaría ou lavandaría</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#EVChargingStation -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#EVChargingStation">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TransportInfrastructure"/>
        <rdfs:comment xml:lang="eu">Ibilgailu elektrikoen bateriak azkar kargatzeko elektrizitatea hornitzen duen lekua.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Lloc que proporciona electricitat per a la recàrrega ràpida de les bateries dels vehicles elèctrics.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Lloc que proporciona electricitat per a la recàrrega ràpida de les bateries dels vehicles elèctrics.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugar que fornece electricidade para a recarga rápida das baterías dos vehículos eléctricos.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugar que provee electricidad para la recarga rápida de las baterías de los vehículos eléctricos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Place that provides electricity for the rapid recharging of electric vehicle batteries.</rdfs:comment>
        <rdfs:label xml:lang="en">Electric vehicle charging station</rdfs:label>
        <rdfs:label xml:lang="ca">Estació de càrrega de vehicles elèctrics</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Estació de càrrega de vehicles elèctrics</rdfs:label>
        <rdfs:label xml:lang="es">Estación de carga de vehículos eléctricos</rdfs:label>
        <rdfs:label xml:lang="gl">Estación de carga de vehículos eléctricos</rdfs:label>
        <rdfs:label xml:lang="eu">Ibilgailu elektrikoak kargatzeko geltokia</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#EducationalCentre -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#EducationalCentre">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#EducationalFacility"/>
        <rdfs:comment xml:lang="gl">Establecemento destinado ao ensino.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento destinado a la enseñanza.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment destinat a l&apos;ensenyament.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment destinat a l&apos;ensenyament.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment intended for teaching.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Irakaskuntzarako establezimendua.</rdfs:comment>
        <rdfs:label xml:lang="ca">Centre educatiu</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Centre educatiu</rdfs:label>
        <rdfs:label xml:lang="es">Centro educativo</rdfs:label>
        <rdfs:label xml:lang="gl">Centro educativo</rdfs:label>
        <rdfs:label xml:lang="en">Educational centre</rdfs:label>
        <rdfs:label xml:lang="eu">Ikastetxea</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#EducationalFacility -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#EducationalFacility">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalEducationalFacilityService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalTourismOrRelatedFacilityService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Espacios dedicados al aprendizaje y desarrollo de habilidades donde los participantes, generalmente niños o jóvenes, participan en actividades educativas, recreativas y sociales fuera del entorno escolar tradicional y con un enfoque generalmente temático.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espais dedicats a l&apos;aprenentatge i al desenvolupament d&apos;habilitats on els participants, generalment infants o joves, fan activitats educatives, recreatives i socials fora de l&apos;entorn escolar tradicional i amb un enfocament generalment temàtic.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espais dedicats a l&apos;aprenentatge i al desenvolupament d&apos;habilitats on els participants, generalment infants o joves, fan activitats educatives, recreatives i socials fora de l&apos;entorn escolar tradicional i amb un enfocament generalment temàtic.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazos dedicados á aprendizaxe e ao desenvolvemento de habilidades onde os participantes, xeralmente nenos ou mozos, participan en actividades educativas, recreativas e sociais fóra do contorno escolar tradicional e cun enfoque xeralmente temático.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ikasteko eta trebetasunak garatzeko espazioak, parte-hartzaileek, oro har haurrek edo gazteek, eskola-ingurune tradizionaletik kanpo hezkuntza-, jolas- eta gizarte-jardueretan parte hartzen dutenak, normalean gai jakin baten inguruan.</rdfs:comment>
        <rdfs:comment xml:lang="en">Spaces dedicated to learning and skill development where participants, generally children or young people, participate in educational, recreational and social activities outside the traditional school environment and with a generally thematic focus.</rdfs:comment>
        <rdfs:label xml:lang="en">Educational facility</rdfs:label>
        <rdfs:label xml:lang="eu">Hezkuntza-instalazioa</rdfs:label>
        <rdfs:label xml:lang="es">Instalación educativa</rdfs:label>
        <rdfs:label xml:lang="gl">Instalación educativa</rdfs:label>
        <rdfs:label xml:lang="ca">Instal·lació educativa</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Instal·lació educativa</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#EmbassyAndConsulate -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#EmbassyAndConsulate">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
        <rdfs:comment xml:lang="eu">Herrialde bateko administrazio publikoaren ordezkaritza beste herrialde batean.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Representació de l&apos;administració pública d&apos;un país en un altre.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Representació de l&apos;administració pública d&apos;un país en un altre.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Representación da administración pública dun país noutro.</rdfs:comment>
        <rdfs:comment xml:lang="es">Representación de la administración pública de un país en otro.</rdfs:comment>
        <rdfs:comment xml:lang="en">Representation of the public administration of a country in another</rdfs:comment>
        <rdfs:label xml:lang="ca">Ambaixada i consolat</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Ambaixada i consolat</rdfs:label>
        <rdfs:label xml:lang="gl">Embaixada e consulado</rdfs:label>
        <rdfs:label xml:lang="es">Embajada y consulado</rdfs:label>
        <rdfs:label xml:lang="en">Embassy and consulate</rdfs:label>
        <rdfs:label xml:lang="eu">Enbaxada eta kontsulatua</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#EngineCircuit -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#EngineCircuit">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#SportFacility"/>
        <rdfs:comment xml:lang="en"> An area equipped with one or more tracks designed for holding races.</rdfs:comment>
        <rdfs:comment xml:lang="es">Espacio provisto de una o varias pistas preparadas para disputar carreras.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espai proveït d&apos;una o diverses pistes preparades per disputar curses.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espai proveït d&apos;una o diverses pistes preparades per disputar curses.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazo provisto dunha ou varias pistas preparadas para disputar carreiras.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Lasterketak egiteko prestatutako pista bat edo gehiago dituen espazioa.</rdfs:comment>
        <rdfs:label xml:lang="ca">Circuit de motor</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Circuit de motor</rdfs:label>
        <rdfs:label xml:lang="es">Circuito de motor</rdfs:label>
        <rdfs:label xml:lang="gl">Circuíto de motor</rdfs:label>
        <rdfs:label xml:lang="en">Engine circuit</rdfs:label>
        <rdfs:label xml:lang="eu">Motor-zirkuitua</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#EquestrianCentre -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#EquestrianCentre">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#SportFacility"/>
        <rdfs:comment xml:lang="en">A place where horseback riding is taught and practiced, catering to both the general public and more experienced riders.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Lloc on s&apos;ensenya i es practica l&apos;equitació, orientat tant al públic general com a aficionats amb coneixements més avançats.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Lloc on s&apos;ensenya i es practica l&apos;equitació, orientat tant al públic general com a aficionats amb coneixements més avançats.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugar donde se enseña y se practica la equitación, orientado tanto al público en general como a aficionados con conocimientos más avanzados.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugar onde se ensina e se practica a equitación, orientado tanto ao público en xeral como a afeccionados con coñecementos máis avanzados.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Zaldiketa irakasten eta praktikatzen den lekua, jende orokorrari zein ezagutza aurreratuagoak dituzten zaleei zuzendua.</rdfs:comment>
        <rdfs:label xml:lang="ca">Centre eqüestre</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Centre eqüestre</rdfs:label>
        <rdfs:label xml:lang="es">Centro ecuestre</rdfs:label>
        <rdfs:label xml:lang="gl">Centro ecuestre</rdfs:label>
        <rdfs:label xml:lang="en">Equestrian centre</rdfs:label>
        <rdfs:label xml:lang="eu">Zaldiketa-zentroa</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#EquestrianClub -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#EquestrianClub">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#SportFacility"/>
        <rdfs:comment xml:lang="eu">Aisialdi-, kirol- edo turismo-helburuekin zaldiak hartzen dituzten instalazioak, kirol-zaldiak hartzeko ukuiluak, alokatzeko ukuiluak eta zaldiketarako bestelako establezimenduak barne.</rdfs:comment>
        <rdfs:comment xml:lang="en">Facilities that house horses for recreational, sporting or tourist purposes, including sports stables, rental stables and other establishments for equestrian practice.</rdfs:comment>
        <rdfs:comment xml:lang="es">Instalaciones que albergan caballos con fines recreativos deportivos o turísticos incluyendo las cuadras deportivas, las cuadras en alquiler y otros establecimientos para la práctica ecuestre.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Instalacións que albergan cabalos con fins recreativos, deportivos ou turísticos, incluídas as cortes deportivas, as cortes de alugueiro e outros establecementos para a práctica ecuestre.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Instal·lacions que acullen cavalls amb finalitats recreatives, esportives o turístiques, incloent-hi quadres esportives, quadres de lloguer i altres establiments per a la pràctica eqüestre.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Instal·lacions que acullen cavalls amb finalitats recreatives, esportives o turístiques, incloent-hi quadres esportives, quadres de lloguer i altres establiments per a la pràctica eqüestre.</rdfs:comment>
        <rdfs:label xml:lang="ca">Club hípic</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Club hípic</rdfs:label>
        <rdfs:label xml:lang="es">Club hípico</rdfs:label>
        <rdfs:label xml:lang="gl">Club hípico</rdfs:label>
        <rdfs:label xml:lang="en">Equestrian club</rdfs:label>
        <rdfs:label xml:lang="eu">Hipika-kluba</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#EscapeRoom -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#EscapeRoom">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#LeisureAndCultureFacility"/>
        <rdfs:comment xml:lang="en">An interactive leisure experience based on solving puzzles and locating key items, with the objective of completing a mission or exiting a premises within a set time limit.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Enigmak ebaztean eta funtsezko objektuak aurkitzean oinarritutako aisialdi-esperientzia interaktiboa, misio bat osatzeko edo esparru batetik denbora jakin batean irteteko.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Experiencia de lecer interactivo baseada na resolución de enigmas e na localización de obxectos clave para completar unha misión ou abandonar un recinto nun tempo determinado.</rdfs:comment>
        <rdfs:comment xml:lang="es">Experiencia de ocio interactivo basada en la resolución de enigmas y la localización de objetos clave, con el fin de completar una misión o abandonar un recinto en un tiempo determinado.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Experiència de lleure interactiu basada en la resolució d&apos;enigmes i la localització d&apos;objectes clau per completar una missió o abandonar un recinte en un temps determinat.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Experiència de lleure interactiu basada en la resolució d&apos;enigmes i la localització d&apos;objectes clau per completar una missió o abandonar un recinte en un temps determinat.</rdfs:comment>
        <rdfs:label xml:lang="en">Escape room</rdfs:label>
        <rdfs:label xml:lang="es">Escape room</rdfs:label>
        <rdfs:label xml:lang="eu">Ihes-gela</rdfs:label>
        <rdfs:label xml:lang="ca">Joc d&apos;escapada</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Joc d&apos;escapada</rdfs:label>
        <rdfs:label xml:lang="gl">Xogo de escape</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Event -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Event">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#availableLanguage"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#eventType"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAcknowledgement"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#Acknowledgement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalEventService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasContactPoint"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#ContactPoint"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasPriceSpecification"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#PriceSpecification"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasSubEvent"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#Event"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasSuperEvent"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#Event"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#nearTo"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#Place"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#refPointOfInterest"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#Place"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#relatedTo"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismEntity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#touristType"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#travelUnit"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#venue"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#Place"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasContactPoint"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#ContactPoint"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#venue"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#Place"/>
