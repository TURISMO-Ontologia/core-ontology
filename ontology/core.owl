                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#itinerary"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#Itinerary"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#downhillElevation"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#maximumAttendeeCapacity"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#uphillElevation"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#duration"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#length"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#highestAltitude"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#lowestAltitude"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#physicalEffort"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#publicAccess"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#routeNavigationOrientation"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#severityOfTheEnvironment"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#terrainConditions"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A path or direction that contains a series of places that must be passed through or stopped at to reach a destination.</rdfs:comment>
        <rdfs:comment xml:lang="es">Camino o dirección que contiene una serie de lugares por los que se debe pasar o detenerse para llegar a un destino.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Camiño ou dirección que contén unha serie de lugares polos que se debe pasar ou deter para chegar a un destino.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Camí o direcció que conté una sèrie de llocs per on s&apos;ha de passar o aturar-se per arribar a una destinació.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Camí o direcció que conté una sèrie de llocs per on s&apos;ha de passar o aturar-se per arribar a una destinació.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Helmuga batera iristeko igaro edo gelditu beharreko hainbat leku biltzen dituen bidea edo norabidea.</rdfs:comment>
        <rdfs:label xml:lang="eu">Ibilbidea</rdfs:label>
        <rdfs:label xml:lang="en">Route</rdfs:label>
        <rdfs:label xml:lang="ca">Ruta</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Ruta</rdfs:label>
        <rdfs:label xml:lang="es">Ruta</rdfs:label>
        <rdfs:label xml:lang="gl">Ruta</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Rule -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Rule">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#RulesAndTips"/>
        <rdfs:comment xml:lang="eu">Jokabidea, ekintza bat behar bezala egitea edo jarduera bat behar bezala garatzea bideratzeko ezartzen den printzipioa.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Principi que s&apos;imposa per dirigir la conducta, la realització correcta d&apos;una acció o el desenvolupament correcte d&apos;una activitat.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Principi que s&apos;imposa per dirigir la conducta, la realització correcta d&apos;una acció o el desenvolupament correcte d&apos;una activitat.</rdfs:comment>
        <rdfs:comment xml:lang="es">Principio que se impone para dirigir la conducta, la correcta realización de una acción o el correcto desarrollo de una actividad.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Principio que se impón para dirixir a conduta, a correcta realización dunha acción ou o correcto desenvolvemento dunha actividade.</rdfs:comment>
        <rdfs:comment xml:lang="en">Principle that is imposed to direct behavior, the correct performance of an action or the correct development of an activity.</rdfs:comment>
        <rdfs:label xml:lang="eu">Araua</rdfs:label>
        <rdfs:label xml:lang="ca">Regla</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Regla</rdfs:label>
        <rdfs:label xml:lang="es">Regla</rdfs:label>
        <rdfs:label xml:lang="gl">Regra</rdfs:label>
        <rdfs:label xml:lang="en">Rule</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#RulesAndTips -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#RulesAndTips">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#adversityType"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasDescription"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#Description"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasDescription"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#Description"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#name"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#name"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#validFrom"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#validThrough"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A set of principles, standards and recommendations established by a tourism destination with the aim of ensuring a safe, respectful and satisfying experience for tourists, the local community and the environment.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Conjunt de principis, normes i recomanacions que estableix una destinació turística amb l&apos;objectiu de garantir una experiència segura, respectuosa i satisfactòria tant per als turistes com per a la comunitat local i l&apos;entorn.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Conjunt de principis, normes i recomanacions que establix una destinació turística amb l&apos;objectiu de garantir una experiència segura, respectuosa i satisfactòria tant per als turistes com per a la comunitat local i l&apos;entorn.</rdfs:comment>
        <rdfs:comment xml:lang="es">Conjunto de principios, normas y recomendaciones que establece un destino turístico con el objetivo de garantizar una experiencia segura, respetuosa y satisfactoria tanto para los turistas como para la comunidad local y el entorno.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Conxunto de principios, normas e recomendacións que establece un destino turístico co obxectivo de garantir unha experiencia segura, respectuosa e satisfactoria tanto para os turistas como para a comunidade local e o contorno.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Helmuga turistiko batek ezartzen dituen printzipio, arau eta gomendioen multzoa, turistentzat zein tokiko komunitatearentzat eta ingurunearentzat esperientzia segurua, errespetuzkoa eta gogobetegarria bermatzeko helburuarekin.</rdfs:comment>
        <rdfs:label xml:lang="eu">Arauak eta aholkuak</rdfs:label>
        <rdfs:label xml:lang="es">Reglas y consejos</rdfs:label>
        <rdfs:label xml:lang="ca">Regles i consells</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Regles i consells</rdfs:label>
        <rdfs:label xml:lang="gl">Regras e consellos</rdfs:label>
        <rdfs:label xml:lang="en">Rules and tips</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#RunningTrack -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#RunningTrack">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#SportFacility"/>
        <rdfs:comment xml:lang="en">Area in which the athletics discipline races are held.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Atletismoko lasterketak egiten diren eremua.</rdfs:comment>
        <rdfs:comment xml:lang="es">Zona en la que se realizan las carreras de la disciplina de atletismo.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Zona na que se realizan as carreiras da disciplina de atletismo.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Zona on es duen a terme les curses d&apos;atletisme.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Zona on es duen a terme les curses d&apos;atletisme.</rdfs:comment>
        <rdfs:label xml:lang="eu">Atletismo-pista</rdfs:label>
        <rdfs:label xml:lang="ca">Pista d&apos;atletisme</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Pista d&apos;atletisme</rdfs:label>
        <rdfs:label xml:lang="es">Pista de atletismo</rdfs:label>
        <rdfs:label xml:lang="gl">Pista de atletismo</rdfs:label>
        <rdfs:label xml:lang="en">Running track</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#RuralHouse -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#RuralHouse">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment"/>
        <rdfs:comment xml:lang="eu">Landa-eremuko lurzoru ez-urbanizagarrian dagoen higiezin batean kokatutako hotelaz kanpoko establezimendu mota, ostatu-unitate bat eta elikagaiak kontserbatzeko, manipulatzeko eta kontsumitzeko behar diren ekipamendua eta instalazioak dituena.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Tipo de establecemento extrahoteleiro situado nun inmoble en solo rústico e de ámbito rural, que dispón dunha unidade de aloxamento e do equipamento e das instalacións necesarias para a conservación, manipulación e consumo de alimentos.</rdfs:comment>
        <rdfs:comment xml:lang="es">Tipo de establecimiento extrahotelero ubicado en un inmueble situado en suelo rústico y de ámbito rural que dispone de una unidad alojativa y que cuenta con el equipamiento y las instalaciones necesarias para la conservación, manipulado y consumo de alimentos.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Tipus d&apos;establiment extrahoteler ubicat en un immoble situat en sòl rústic i en un àmbit rural, que disposa d&apos;una unitat d&apos;allotjament i de l&apos;equipament i les instal·lacions necessàries per conservar, manipular i consumir aliments.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Tipus d&apos;establiment extrahoteler ubicat en un immoble situat en sòl rústic i en un àmbit rural, que disposa d&apos;una unitat d&apos;allotjament i de l&apos;equipament i les instal·lacions necessàries per conservar, manipular i consumir aliments.</rdfs:comment>
        <rdfs:comment xml:lang="en">Type of non-hotel establishment located in a property located on rustic land and in a rural area that has an accommodation unit and that has the equipment and facilities necessary for the conservation, handling and consumption of food.</rdfs:comment>
        <rdfs:label xml:lang="ca">Casa rural</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Casa rural</rdfs:label>
        <rdfs:label xml:lang="es">Casa rural</rdfs:label>
        <rdfs:label xml:lang="gl">Casa rural</rdfs:label>
        <rdfs:label xml:lang="eu">Landetxea</rdfs:label>
        <rdfs:label xml:lang="en">Rural house</rdfs:label>
        <skos:altLabel xml:lang="es">Agroturismo</skos:altLabel>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Salina -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Salina">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
        <rdfs:comment xml:lang="ca">Lloc on es deixa evaporar aigua salada perquè només en quedi la sal, assecar-la i recollir-la després per utilitzar-la, consumir-la o vendre-la.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Lloc on es deixa evaporar aigua salada perquè només en quedi la sal, assecar-la i recollir-la després per utilitzar-la, consumir-la o vendre-la.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugar donde se deja evaporar agua salada para dejar solo la sal, secarla y recogerla luego para su utilización, consumo o venta.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugar onde se deixa evaporar auga salgada para que quede só o sal, seque e se recolla despois para a súa utilización, consumo ou venda.</rdfs:comment>
        <rdfs:comment xml:lang="en">Place where salt water is allowed to evaporate to leave only the salt, dry it and then collect it for use, consumption or sale</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ur gazia lurruntzen uzten den lekua, gatza soilik geratzeko, lehortzeko eta gero erabiltzeko, kontsumitzeko edo saltzeko biltzeko.</rdfs:comment>
        <rdfs:label xml:lang="eu">Gatzaga</rdfs:label>
        <rdfs:label xml:lang="ca">Salina</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Salina</rdfs:label>
        <rdfs:label xml:lang="en">Salina</rdfs:label>
        <rdfs:label xml:lang="es">Salina</rdfs:label>
        <rdfs:label xml:lang="gl">Salina</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Sanctuary -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Sanctuary">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">A place of worship where the image or relic of a highly venerated saint is revered.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Debozio bereziko santu baten irudia edo erlikia gurtzen den tenplua.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Temple on es venera la imatge o relíquia d&apos;un sant d&apos;especial devoció.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Temple on es venera la imatge o relíquia d&apos;un sant d&apos;especial devoció.</rdfs:comment>
        <rdfs:comment xml:lang="es">Templo en que se venera la imagen o reliquia de un santo de especial devoción.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Templo no que se venera a imaxe ou reliquia dun santo de especial devoción.</rdfs:comment>
        <rdfs:label xml:lang="en">Sanctuary</rdfs:label>
        <rdfs:label xml:lang="ca">Santuari</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Santuari</rdfs:label>
        <rdfs:label xml:lang="es">Santuario</rdfs:label>
        <rdfs:label xml:lang="gl">Santuario</rdfs:label>
        <rdfs:label xml:lang="eu">Santutegia</rdfs:label>
        <skos:altLabel xml:lang="es">Ermita</skos:altLabel>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Schedule -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Schedule">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#byDay"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#byMonth"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasDescription"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#Description"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#byMonthDay"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#byMonthWeek"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#duration"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#endDateTime"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#exceptDate"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#startDateTime"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="ca">Planificació temporal que defineix quan un servei, esdeveniment o oferta es repeteix o té lloc en intervals específics.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Planificació temporal que definix quan un servici, esdeveniment o oferta es repetix o té lloc en intervals específics.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Planificación temporal que define cando un servizo, evento ou oferta se repite ou se produce en intervalos específicos.</rdfs:comment>
        <rdfs:comment xml:lang="es">Planificación temporal que define cuándo un servicio, evento u oferta se repite o se produce en intervalos específicos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Time-based plan that defines when a service, event, or offer occurs repeatedly or at specific intervals.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Zerbitzu, ekitaldi edo eskaintza bat tarte jakinetan noiz errepikatzen edo gertatzen den zehazten duen denbora-plangintza.</rdfs:comment>
        <rdfs:label xml:lang="ca">Programació</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Programació</rdfs:label>
        <rdfs:label xml:lang="es">Programación</rdfs:label>
        <rdfs:label xml:lang="gl">Programación</rdfs:label>
        <rdfs:label xml:lang="eu">Programazioa</rdfs:label>
        <rdfs:label xml:lang="en">Schedule</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#ShootingRange -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#ShootingRange">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#SportFacility"/>
        <rdfs:comment xml:lang="en">Areas designated for shooting practice that meet the required characteristics and safety standards.</rdfs:comment>
        <rdfs:comment xml:lang="es">Espacios habilitados para la práctica del tiro que reúnan las características y medidas de seguridad pertinentes.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espais habilitats per a la pràctica del tir que reuneixin les característiques i mesures de seguretat pertinents.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espais habilitats per a la pràctica del tir que reunisquen les característiques i mesures de seguretat pertinents.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazos habilitados para a práctica do tiro que reúnan as características e medidas de seguridade pertinentes.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Tiroan aritzeko prestatutako espazioak, dagozkien segurtasun-ezaugarriak eta -neurriak betetzen dituztenak.</rdfs:comment>
        <rdfs:label xml:lang="ca">Camp de tir</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Camp de tir</rdfs:label>
        <rdfs:label xml:lang="es">Campo de tiro</rdfs:label>
        <rdfs:label xml:lang="gl">Campo de tiro</rdfs:label>
        <rdfs:label xml:lang="en">Shooting range</rdfs:label>
        <rdfs:label xml:lang="eu">Tiro-eremua</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#ShoppingMall -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#ShoppingMall">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#RetailAndFashionBusiness"/>
        <rdfs:comment xml:lang="en">A complex comprising establishments dedicated to commercial, leisure, and food and beverage activities.</rdfs:comment>
        <rdfs:comment xml:lang="es">Complejo formado por establecimientos dedicados a actividades comerciales, de ocio y restauración.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Complex format per establiments dedicats a activitats comercials, de lleure i de restauració.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Complex format per establiments dedicats a activitats comercials, de lleure i de restauració.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Complexo formado por establecementos dedicados a actividades comerciais, de lecer e de restauración.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Merkataritza-, aisialdi- eta jatetxe-jardueretarako establezimenduez osatutako konplexua.</rdfs:comment>
        <rdfs:label xml:lang="ca">Centre comercial</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Centre comercial</rdfs:label>
        <rdfs:label xml:lang="es">Centro comercial</rdfs:label>
        <rdfs:label xml:lang="gl">Centro comercial</rdfs:label>
        <rdfs:label xml:lang="eu">Merkataritza-gunea</rdfs:label>
        <rdfs:label xml:lang="en">Shopping mall</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#SingularTree -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#SingularTree">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#singularTreeType"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="ca">Arbre que destaca entre els altres per la mida, forma, edat, raresa, origen biològic, estat de conservació, bellesa o perquè forma part de mites o tradicions.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Arbre que destaca entre els altres per la mida, forma, edat, raresa, origen biològic, estat de conservació, bellesa o perquè forma part de mites o tradicions.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Tamainagatik, formagatik, adinagatik, bakantasunagatik, jatorri biologikoagatik, kontserbazio-egoeragatik, edertasunagatik edo mito edo tradizioen parte izateagatik besteen artean nabarmentzen den zuhaitza.</rdfs:comment>
        <rdfs:comment xml:lang="en">Tree that stands out among others due to its size, shape, age, rarity, biological origin, state of conservation, beauty or for being part of myths or traditions.</rdfs:comment>
        <rdfs:comment xml:lang="es">Árbol que destaca entre los demás por su tamaño, forma, edad, rareza, origen biológico, estado de conservación, belleza o por formar parte de mitos o tradiciones.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Árbore que destaca entre as demais polo seu tamaño, forma, idade, rareza, orixe biolóxica, estado de conservación, beleza ou por formar parte de mitos ou tradicións.</rdfs:comment>
        <rdfs:label xml:lang="ca">Arbre singular</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Arbre singular</rdfs:label>
        <rdfs:label xml:lang="en">Singular tree</rdfs:label>
        <rdfs:label xml:lang="eu">Zuhaitz berezia</rdfs:label>
        <rdfs:label xml:lang="es">Árbol singular</rdfs:label>
        <rdfs:label xml:lang="gl">Árbore senlleira</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#SkatePark -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#SkatePark">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#SportFacility"/>
        <rdfs:comment xml:lang="gl">Instalación deportiva deseñada especificamente para a práctica do monopatinaxe.</rdfs:comment>
        <rdfs:comment xml:lang="es">Instalación deportiva diseñada específicamente para la práctica del monopatinaje.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Instal·lació esportiva dissenyada específicament per a la pràctica del monopatí.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Instal·lació esportiva dissenyada específicament per a la pràctica del monopatí.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Skatean aritzeko berariaz diseinatutako kirol-instalazioa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Sports facility designed specifically for skateboarding.</rdfs:comment>
        <rdfs:label xml:lang="ca">Parc de patinatge</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Parc de patinatge</rdfs:label>
        <rdfs:label xml:lang="es">Parque de patinaje</rdfs:label>
        <rdfs:label xml:lang="gl">Parque de patinaxe</rdfs:label>
        <rdfs:label xml:lang="eu">Skate-parkea</rdfs:label>
        <rdfs:label xml:lang="en">Skatepark</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#SkatingRink -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#SkatingRink">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#SportFacility"/>
        <rdfs:comment xml:lang="eu">Gurpildun irristailuekin edo izotz gainean irristatzeko egokitu eta diseinatutako gainazala, pista motaren arabera.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Superficie acondicionada e deseñada para a práctica da patinaxe sobre rodas ou sobre xeo, dependendo do tipo de pista.</rdfs:comment>
        <rdfs:comment xml:lang="es">Superficie acondicionada y diseñada para la práctica del patinaje sobre ruedas o sobre hielo, dependiendo del tipo de pista.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Superfície condicionada i dissenyada per patinar sobre rodes o sobre gel, segons el tipus de pista.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Superfície condicionada i dissenyada per patinar sobre rodes o sobre gel, segons el tipus de pista.</rdfs:comment>
        <rdfs:comment xml:lang="en">Surface conditioned and designed for the practice of roller or ice skating, depending on the type of rink.</rdfs:comment>
        <rdfs:label xml:lang="eu">Irristaketa-pista</rdfs:label>
        <rdfs:label xml:lang="es">Pista de patinaje</rdfs:label>
        <rdfs:label xml:lang="ca">Pista de patinatge</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Pista de patinatge</rdfs:label>
        <rdfs:label xml:lang="gl">Pista de patinaxe</rdfs:label>
        <rdfs:label xml:lang="en">Skating rink</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#SocialMediaProfile -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#SocialMediaProfile">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#socialMediaPlatform"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#url"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="ca">Comptes individuals o d&apos;empreses creats en plataformes digitals dissenyades per a la interacció social. Permeten a les persones i organitzacions compartir informació, publicar contingut, interactuar amb altres usuaris i construir una presència en línia.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Comptes individuals o d&apos;empreses creats en plataformes digitals dissenyades per a la interacció social. Permeten a les persones i organitzacions compartir informació, publicar contingut, interactuar amb altres usuaris i construir una presència en línia.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Contas individuais ou de empresas creadas en plataformas dixitais deseñadas para a interacción social. Permiten ás persoas e organizacións compartir información, publicar contido, interactuar con outros usuarios e construír unha presenza en liña.</rdfs:comment>
        <rdfs:comment xml:lang="es">Cuentas individuales o de empresas creadas en plataformas digitales diseñadas para la interacción social. Permiten a las personas y organizaciones compartir información, publicar contenido, interactuar con otros usuarios y construir una presencia en línea.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Gizarte-harremanetarako diseinatutako plataforma digitaletan sortutako banakako edo enpresetako kontuak. Pertsonei eta erakundeei informazioa partekatzeko, edukiak argitaratzeko, beste erabiltzaileekin elkarreragiteko eta sareko presentzia eraikitzeko aukera ematen diete.</rdfs:comment>
        <rdfs:comment xml:lang="en">Individual or company accounts created on digital platforms designed for social interaction. They allow people and organizations to share information, publish content, interact with other users and build an online presence.</rdfs:comment>
        <rdfs:label xml:lang="gl">Perfil en redes sociais</rdfs:label>
        <rdfs:label xml:lang="es">Perfil en redes sociales</rdfs:label>
        <rdfs:label xml:lang="ca">Perfil en xarxes socials</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Perfil en xarxes socials</rdfs:label>
        <rdfs:label xml:lang="eu">Sare sozialetako profila</rdfs:label>
        <rdfs:label xml:lang="en">Social media profile</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Souvenir -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Souvenir">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#RetailAndFashionBusiness"/>
        <rdfs:comment xml:lang="gl">Establecemento que vende obxectos representativos dun lugar específico para que os turistas os compren como lembranza da súa viaxe ou para agasallar.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento que vende objetos representativos de un lugar específico, destinados a que los turistas los compren como recuerdo de su viaje o para regalar.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment que ven objectes representatius d&apos;un lloc específic perquè els turistes els compren com a record del viatge o per regalar.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment que ven objectes representatius d&apos;un lloc específic perquè els turistes els comprin com a record del viatge o per regalar.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment that sells items representing a specific location, intended for tourists to buy as memory of their trip or as gifts.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Leku jakin bat irudikatzen duten objektuak saltzen dituen establezimendua, turistek bidaiaren oroigarri gisa edo oparitzeko eros ditzaten.</rdfs:comment>
        <rdfs:label xml:lang="ca">Botiga de records</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Botiga de records</rdfs:label>
        <rdfs:label xml:lang="eu">Oroigarri-denda</rdfs:label>
        <rdfs:label xml:lang="en">Souvenirs</rdfs:label>
        <rdfs:label xml:lang="gl">Tenda de lembranzas</rdfs:label>
        <rdfs:label xml:lang="es">Tienda de souvenirs</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#SpecialOffer -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#SpecialOffer">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasPriceSpecification"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#PriceSpecification"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#relatedTourismOrRelatedFacility"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#touristType"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#travelUnit"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#relatedTourismOrRelatedFacility"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#offeredBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismDestination"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrganisation"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#offerSchedule"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#Schedule"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Offer of products that vary from the regular offer of tourism service providers, including, but not limited to, plans, temporary price reductions, and free gifts or extra quantities.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Proposta de productes diferents de l&apos;oferta habitual dels proveïdors de serveis turístics, incloent-hi, entre d&apos;altres, plans, reduccions temporals de preus i obsequis o quantitats addicionals.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Proposta de productes diferents de l&apos;oferta habitual dels proveïdors de servicis turístics, incloent-hi, entre d&apos;altres, plans, reduccions temporals de preus i obsequis o quantitats addicionals.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Proposta de produtos que difiren da oferta habitual dos provedores de servizos turísticos, incluídos, entre outros, plans, reducións temporais de prezos e agasallos ou cantidades adicionais.</rdfs:comment>
        <rdfs:comment xml:lang="es">Propuesta de productos que difieren de la oferta habitual de los proveedores de servicios turísticos, incluyendo, entre otros, planes, reducciones temporales de precios y obsequios o cantidades adicionales.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Turismo-zerbitzuen hornitzaileen ohiko eskaintzatik bereizten diren produktuen proposamena, besteak beste planak, aldi baterako prezio-jaitsierak eta opariak edo kopuru gehigarriak barne hartzen dituena.</rdfs:comment>
        <rdfs:label xml:lang="eu">Proposamen berezia</rdfs:label>
        <rdfs:label xml:lang="ca">Proposta especial</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Proposta especial</rdfs:label>
        <rdfs:label xml:lang="gl">Proposta especial</rdfs:label>
        <rdfs:label xml:lang="es">Propuesta especial</rdfs:label>
        <rdfs:label xml:lang="en">Special offer</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#SportFacility -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#SportFacility">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalSportFacilityService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalTourismOrRelatedFacilityService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Espacios diseñados y equipados específicamente para brindar servicios y oportunidades relacionadas con actividades deportivas y recreativas para turistas, visitantes y residentes.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espais dissenyats i equipats específicament per oferir serveis i oportunitats relacionats amb activitats esportives i recreatives per a turistes, visitants i residents.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espais dissenyats i equipats específicament per oferir servicis i oportunitats relacionats amb activitats esportives i recreatives per a turistes, visitants i residents.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazos deseñados e equipados especificamente para ofrecer servizos e oportunidades relacionados con actividades deportivas e recreativas para turistas, visitantes e residentes.</rdfs:comment>
        <rdfs:comment xml:lang="en">Spaces designed and equipped specifically to provide services and opportunities related to sports and recreational activities for tourists, visitors and residents.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Turistentzat, bisitarientzat eta biztanleentzat kirol- eta jolas-jarduerekin lotutako zerbitzuak eta aukerak eskaintzeko berariaz diseinatu eta hornitutako espazioak.</rdfs:comment>
        <rdfs:label xml:lang="es">Instalación deportiva</rdfs:label>
        <rdfs:label xml:lang="gl">Instalación deportiva</rdfs:label>
        <rdfs:label xml:lang="ca">Instal·lació esportiva</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Instal·lació esportiva</rdfs:label>
        <rdfs:label xml:lang="eu">Kirol-instalazioa</rdfs:label>
        <rdfs:label xml:lang="en">Sport facility</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#SportingGoodsStore -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#SportingGoodsStore">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#RetailAndFashionBusiness"/>
        <rdfs:comment xml:lang="en">Commercial establishment dedicated to the sale of sports-related goods, equipment, and materials, intended for the practice of sports, recreational activities, or active leisure.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento comercial dedicado á venda de artigos, equipamento e material deportivo destinados á práctica de actividades deportivas, recreativas ou de lecer activo.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento comercial dedicado a la venta de artículos, equipamiento y material deportivo, destinados a la práctica de actividades deportivas, recreativas o de ocio activo.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment comercial dedicat a la venda d&apos;articles, equipament i material esportiu destinats a la pràctica d&apos;activitats esportives, recreatives o de lleure actiu.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment comercial dedicat a la venda d&apos;articles, equipament i material esportiu destinats a la pràctica d&apos;activitats esportives, recreatives o de lleure actiu.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Kirol-, jolas- edo aisialdi aktiboko jardueretan aritzeko gaiak, ekipamendua eta kirol-materiala saltzen dituen merkataritza-establezimendua.</rdfs:comment>
        <rdfs:label xml:lang="ca">Botiga d&apos;equipament esportiu</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Botiga d&apos;equipament esportiu</rdfs:label>
        <rdfs:label xml:lang="eu">Kirol-ekipamenduaren denda</rdfs:label>
        <rdfs:label xml:lang="en">Sporting goods store</rdfs:label>
        <rdfs:label xml:lang="gl">Tenda de equipamento deportivo</rdfs:label>
        <rdfs:label xml:lang="es">Tienda de equipamiento deportivo</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#SportsCentre -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#SportsCentre">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#SportFacility"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#sportsCentrePremises"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Kirol-diziplinetan aritzeko hainbat instalazio eta azpiegitura dituen lekua.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Lloc que disposa de diferents instal·lacions i infraestructures per practicar disciplines esportives.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Lloc que disposa de diferents instal·lacions i infraestructures per practicar disciplines esportives.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugar que dispone de diferentes instalaciones e infraestructuras para la práctica de disciplinas deportivas.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugar que dispón de diferentes instalacións e infraestruturas para a práctica de disciplinas deportivas.</rdfs:comment>
        <rdfs:comment xml:lang="en">Place that has different facilities and infrastructure for practicing sports disciplines.</rdfs:comment>
        <rdfs:label xml:lang="eu">Kiroldegia</rdfs:label>
        <rdfs:label xml:lang="es">Polideportivo</rdfs:label>
        <rdfs:label xml:lang="gl">Polideportivo</rdfs:label>
        <rdfs:label xml:lang="ca">Poliesportiu</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Poliesportiu</rdfs:label>
        <rdfs:label xml:lang="en">Sports centre</rdfs:label>
        <skos:altLabel xml:lang="es">Centro deportivo</skos:altLabel>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Spring -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Spring">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
        <rdfs:comment xml:lang="ca">Corrent d&apos;aigua que brolla de terra o d&apos;entre les roques de manera natural.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Corrent d&apos;aigua que brolla de terra o d&apos;entre les roques de manera natural.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Corrente de auga que xorde do chan ou de entre as rochas de forma natural.</rdfs:comment>
        <rdfs:comment xml:lang="es">Corriente de agua que mana del suelo o de entre las rocas de forma natural.</rdfs:comment>
        <rdfs:comment xml:lang="en">Current of water that flows from the ground or between rocks naturally</rdfs:comment>
        <rdfs:comment xml:lang="eu">Lurretik edo harkaitz artetik modu naturalean sortzen den ur-lasterra.</rdfs:comment>
        <rdfs:label xml:lang="ca">Font natural</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Font natural</rdfs:label>
        <rdfs:label xml:lang="eu">Iturburua</rdfs:label>
        <rdfs:label xml:lang="gl">Manancial</rdfs:label>
        <rdfs:label xml:lang="es">Manantial</rdfs:label>
        <rdfs:label xml:lang="en">Spring</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Square -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Square">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#historicalOrCulturalResourceContains"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A broad and open space within a town or city, into which several streets typically converge. It may also serve as a place where goods are sold, neighbors gather socially, and public fairs, markets, and festivities are held.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Herri barruko leku zabal eta handia, normalean hainbat kale elkartzen direna. Batzuetan hainbat gai saltzen dira bertan, auzokoekin ohiko harremanak izaten dira eta azokak, merkatuak eta jai publikoak egiten dira.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Lloc ample i espaiós dins d&apos;una població, on solen confluir diversos carrers. De vegades s&apos;hi venen articles diversos, s&apos;hi manté el tracte habitual amb els veïns i s&apos;hi celebren fires, mercats i festes públiques.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Lloc ample i espaiós dins d&apos;una població, on solen confluir diversos carrers. De vegades s&apos;hi venen articles diversos, s&apos;hi manté el tracte habitual amb els veïns i s&apos;hi celebren fires, mercats i festes públiques.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugar ancho e espazoso dentro dunha poboación, ao que adoitan confluír varias rúas. En ocasións véndense nel artigos diversos, mantense o trato habitual cos veciños e celébranse feiras, mercados e festas públicas.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugar ancho y espacioso dentro de una población, al que suelen afluir varias calles. En ocasiones, en este lugar se venden artículos diversos, se tiene el trato común con los vecinos, y se celebran las ferias, los mercados y las fiestas públicas.</rdfs:comment>
        <rdfs:label xml:lang="es">Plaza</rdfs:label>
        <rdfs:label xml:lang="eu">Plaza</rdfs:label>
        <rdfs:label xml:lang="ca">Plaça</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Plaça</rdfs:label>
        <rdfs:label xml:lang="gl">Praza</rdfs:label>
        <rdfs:label xml:lang="en">Square</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Stadium -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Stadium">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#SportFacility"/>
        <rdfs:comment xml:lang="eu">Kirol-lehiaketetarako esparru handia, ikusleentzako harmailak dituena.</rdfs:comment>
        <rdfs:comment xml:lang="en">Large venue with stands for spectators, intended for sports competitions.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Recinte de grans dimensions amb grades per als espectadors, destinat a competicions esportives.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Recinte de grans dimensions amb grades per als espectadors, destinat a competicions esportives.</rdfs:comment>
        <rdfs:comment xml:lang="es">Recinto de grandes dimensiones con graderías para los espectadores, destinado a competiciones deportivas.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Recinto de grandes dimensións con bancadas para os espectadores, destinado a competicións deportivas.</rdfs:comment>
        <rdfs:label xml:lang="ca">Estadi</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Estadi</rdfs:label>
        <rdfs:label xml:lang="es">Estadio</rdfs:label>
        <rdfs:label xml:lang="gl">Estadio</rdfs:label>
        <rdfs:label xml:lang="eu">Estadioa</rdfs:label>
        <rdfs:label xml:lang="en">Stadium</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Supermarket -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Supermarket">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#GroceriesService"/>
        <rdfs:comment xml:lang="eu">Askotariko elikagaiak, edariak, garbiketa-produktuak eta abar txikizka saltzen dituen merkataritza-establezimendua, bezeroak bere burua zerbitzatu eta irteeran ordaintzen duena</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento comercial de venda polo miúdo no que se venden todo tipo de artigos alimenticios, bebidas, produtos de limpeza, etc., e no que o cliente se serve e paga á saída</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento comercial de venta al por menor en el que se expenden todo género de artículos alimenticios, bebidas, productos de limpieza, etc., y en el que el cliente se sirve y paga a la salida</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment comercial de venda al detall on es venen tota mena d&apos;articles alimentaris, begudes, productes de neteja, etc., i on el client se serveix i paga a la sortida</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment comercial de venda al detall on es venen tota mena d&apos;articles alimentaris, begudes, productes de neteja, etc., i on el client se servix i paga a la eixida</rdfs:comment>
        <rdfs:comment xml:lang="en">Retail commercial establishment in which all types of food items, beverages, cleaning products, etc. are sold, and in which the customer is served and pays upon departure</rdfs:comment>
        <rdfs:label xml:lang="en">Supermarket</rdfs:label>
        <rdfs:label xml:lang="es">Supermercado</rdfs:label>
        <rdfs:label xml:lang="gl">Supermercado</rdfs:label>
        <rdfs:label xml:lang="ca">Supermercat</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Supermercat</rdfs:label>
        <rdfs:label xml:lang="eu">Supermerkatua</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Swamp -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Swamp">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
        <rdfs:comment xml:lang="eu">Hondo lokaztuagoa edo gutxiago lokaztua eta landaredi ugaria dituen lur hondoratua, ura modu naturalean gelditzen dena.</rdfs:comment>
        <rdfs:comment xml:lang="en">Sunken land with a more or less muddy bottom and abundant vegetation, where the water stagnates naturally</rdfs:comment>
        <rdfs:comment xml:lang="es">Terreno hundido de fondo más o menos cenagoso y abundante vegetación, donde las aguas se estancan de forma natural.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Terreny enfonsat de fons més o menys fangós i vegetació abundant, on les aigües s&apos;estanquen de manera natural.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Terreny enfonsat de fons més o menys fangós i vegetació abundant, on les aigües s&apos;estanquen de manera natural.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Terreo afundido de fondo máis ou menos lamacento e vexetación abundante, onde as augas se estancan de forma natural.</rdfs:comment>
        <rdfs:label xml:lang="es">Pantano</rdfs:label>
        <rdfs:label xml:lang="gl">Pantano</rdfs:label>
        <rdfs:label xml:lang="ca">Pantà</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Pantà</rdfs:label>
        <rdfs:label xml:lang="en">Swamp</rdfs:label>
        <rdfs:label xml:lang="eu">Zingira</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#SwimmingPool -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#SwimmingPool">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#SportFacility"/>
        <rdfs:comment xml:lang="ca">Construcció que conté una gran quantitat d&apos;aigua i es destina al bany, la natació o altres exercicis i esports aquàtics.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Construcció que conté una gran quantitat d&apos;aigua i es destina al bany, la natació o altres exercicis i esports aquàtics.</rdfs:comment>
        <rdfs:comment xml:lang="es">Construcción que contiene gran cantidad de agua y que se destina al baño, a la natación o a otros ejercicios y deportes acuáticos.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Construción que contén gran cantidade de auga e se destina ao baño, á natación ou a outros exercicios e deportes acuáticos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Construction that contains a large amount of water and is intended for bathing, swimming or other water exercises and sports.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ur-kantitate handia duen eraikuntza, bainatzeko, igeri egiteko edo uretako beste ariketa eta kiroletarako erabiltzen dena.</rdfs:comment>
        <rdfs:label xml:lang="eu">Igerilekua</rdfs:label>
        <rdfs:label xml:lang="ca">Piscina</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Piscina</rdfs:label>
        <rdfs:label xml:lang="es">Piscina</rdfs:label>
        <rdfs:label xml:lang="gl">Piscina</rdfs:label>
        <rdfs:label xml:lang="en">Swimming pool</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Synagogue -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Synagogue">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:comment xml:lang="en">A building dedicated to the gathering and worship practices of the Jewish faith.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Edifici dedicat a la congregació i el culte de la religió jueva.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Edifici dedicat a la congregació i el culte de la religió jueva.</rdfs:comment>
        <rdfs:comment xml:lang="es">Edificio dedicado a la congregación y culto de la religión judía.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Edificio dedicado á congregación e ao culto da relixión xudía.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Erlijio juduko biltzarretarako eta gurtzarako eraikina.</rdfs:comment>
        <rdfs:label xml:lang="ca">Sinagoga</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Sinagoga</rdfs:label>
        <rdfs:label xml:lang="es">Sinagoga</rdfs:label>
        <rdfs:label xml:lang="eu">Sinagoga</rdfs:label>
        <rdfs:label xml:lang="gl">Sinagoga</rdfs:label>
        <rdfs:label xml:lang="en">Synagogue</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#TableOliveProcessingFacility -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#TableOliveProcessingFacility">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#AgrotourismFacility"/>
        <rdfs:comment xml:lang="en">A physical location linked to an agri-food processing activity or process which may form part of the agritourism offering when it organises experiences for visitors.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Lloc físic vinculat a una activitat o procés de transformació agroalimentària que pot formar part de l&apos;oferta agroturística quan desenvolupa experiències adreçades als visitants.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Lloc físic vinculat a una activitat o procés de transformació agroalimentària que pot formar part de l&apos;oferta agroturística quan desenvolupa experiències adreçades als visitants.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugar físico vinculado a una actividad o proceso de transformación agroalimentaria que puede formar parte de la oferta agroturística cuando desarrolla experiencias dirigidas a los visitantes.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugar físico vinculado a unha actividade ou proceso de transformación agroalimentaria que pode formar parte da oferta agroturística cando desenvolve experiencias dirixidas aos visitantes.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Nekazaritzako elikagaiak eraldatzeko jarduera edo prozesu bati lotutako leku fisikoa, bisitariei zuzendutako esperientziak garatzen dituenean eskaintza agroturistikoaren parte izan daitekeena.</rdfs:comment>
        <rdfs:label xml:lang="es">Entamadora</rdfs:label>
        <rdfs:label xml:lang="eu">Mahaiko olibak prestatzeko instalazioa</rdfs:label>
        <rdfs:label xml:lang="ca">Planta d&apos;elaboració d&apos;olives de taula</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Planta d&apos;elaboració d&apos;olives de taula</rdfs:label>
        <rdfs:label xml:lang="gl">Planta de elaboración de olivas de mesa</rdfs:label>
        <rdfs:label xml:lang="en">Table olive processing facility</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#TailorShop -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#TailorShop">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#RetailAndFashionBusiness"/>
        <rdfs:comment xml:lang="en">A tailor&apos;s shop and workshop</rdfs:comment>
        <rdfs:comment xml:lang="ca">Botiga i taller de sastre</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Botiga i taller de sastre</rdfs:comment>
        <rdfs:comment xml:lang="eu">Jostunaren denda eta lantegia</rdfs:comment>
        <rdfs:comment xml:lang="gl">Tenda e obradoiro de xastre</rdfs:comment>
        <rdfs:comment xml:lang="es">Tienda y taller de sastre</rdfs:comment>
        <rdfs:label xml:lang="eu">Jostundegia</rdfs:label>
        <rdfs:label xml:lang="ca">Sastreria</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Sastreria</rdfs:label>
        <rdfs:label xml:lang="es">Sastrería</rdfs:label>
        <rdfs:label xml:lang="en">Tailorshop</rdfs:label>
        <rdfs:label xml:lang="gl">Xastraría</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#TakeAwayEstablishment -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#TakeAwayEstablishment">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment"/>
        <rdfs:comment xml:lang="gl">Establecemento onde se preparan e venden alimentos listos para levar e consumir fóra do lugar de venda.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento donde se preparan y venden alimentos listos para ser llevados y consumidos fuera del lugar de venta.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment on es preparen i es venen aliments llestos per emportar i consumir fora del lloc de venda.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment on es preparen i es venen aliments llestos per emportar i consumir fora del lloc de venda.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment where food is prepared and sold ready to be taken and consumed outside the place of sale.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Saltokitik kanpo eramateko eta kontsumitzeko prest dauden elikagaiak prestatzen eta saltzen diren establezimendua.</rdfs:comment>
        <rdfs:label xml:lang="gl">Casa de comidas para levar</rdfs:label>
        <rdfs:label xml:lang="es">Casa de comidas para llevar</rdfs:label>
        <rdfs:label xml:lang="ca">Casa de menjars per emportar</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Casa de menjars per emportar</rdfs:label>
        <rdfs:label xml:lang="eu">Eramateko janarien etxea</rdfs:label>
        <rdfs:label xml:lang="en">Take away establishment</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Tavern -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Tavern">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment"/>
        <rdfs:comment xml:lang="en">A popular public establishment where drinks are served and sold, as well as meals or appetizers.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Edariak zerbitzatu eta saltzen dituen herri-izaerako establezimendu publikoa, janariak edo aperitiboak ere eskaintzen dituena.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento público de carácter popular onde se serven e venden bebidas, ademais de ofrecer comidas ou aperitivos.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento público de carácter popular donde se sirven y expenden bebidas, además de ofrecer comidas o aperitivos.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment públic de caràcter popular on se serveixen i es venen begudes, a més d&apos;oferir menjars o aperitius.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment públic de caràcter popular on se servixen i es venen begudes, a més d&apos;oferir menjars o aperitius.</rdfs:comment>
        <rdfs:label xml:lang="es">Taberna</rdfs:label>
        <rdfs:label xml:lang="eu">Taberna</rdfs:label>
        <rdfs:label xml:lang="gl">Taberna</rdfs:label>
        <rdfs:label xml:lang="en">Tavern</rdfs:label>
        <rdfs:label xml:lang="ca">Taverna</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Taverna</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#TaxiStand -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#TaxiStand">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TransportInfrastructure"/>
        <rdfs:comment xml:lang="ca">Lloc on s&apos;aturen els taxis a l&apos;espera de passatgers.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Lloc on s&apos;aturen els taxis a l&apos;espera de passatgers.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugar en que se detienen los taxis a la espera de pasajeros.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugar no que se deteñen os taxis á espera de pasaxeiros.</rdfs:comment>
        <rdfs:comment xml:lang="en">Place where taxis stop waiting for passengers.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Taxiak bidaiarien zain gelditzen diren lekua.</rdfs:comment>
        <rdfs:label xml:lang="ca">Parada de taxis</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Parada de taxis</rdfs:label>
        <rdfs:label xml:lang="es">Parada de taxis</rdfs:label>
        <rdfs:label xml:lang="gl">Parada de taxis</rdfs:label>
        <rdfs:label xml:lang="en">Taxi stand</rdfs:label>
        <rdfs:label xml:lang="eu">Taxi-geltokia</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#TeaRoom -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#TeaRoom">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment"/>
        <rdfs:comment xml:lang="en">An establishment specialized in the retail and service of teas and infusions of diverse origins.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento especializado na venda e no servizo de tés e infusións de distinta procedencia.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento especializado en la venta y servicio de tés e infusiones de distinta procedencia.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment especialitzat en la venda i el servei de tes i infusions de procedències diverses.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment especialitzat en la venda i el servici de tes i infusions de procedències diverses.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Jatorri desberdinetako teak eta infusioak saltzen eta zerbitzatzen espezializatutako establezimendua.</rdfs:comment>
        <rdfs:label xml:lang="eu">Te-etxea</rdfs:label>
        <rdfs:label xml:lang="en">Tea room</rdfs:label>
        <rdfs:label xml:lang="ca">Teteria</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Teteria</rdfs:label>
        <rdfs:label xml:lang="es">Tetería</rdfs:label>
        <rdfs:label xml:lang="gl">Tetería</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#TelephoneShop -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#TelephoneShop">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#RetailAndFashionBusiness"/>
        <rdfs:comment xml:lang="gl">Establecemento de venda polo miúdo de artigos de telefonía, teléfonos móbiles e accesorios.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento de venta al por menor de artículos de telefonía, teléfonos móviles y accesorios.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment de venda al detall d&apos;articles de telefonia, telèfons mòbils i accessoris.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment de venda al detall d&apos;articles de telefonia, telèfons mòbils i accessoris.</rdfs:comment>
        <rdfs:comment xml:lang="en">Retail establishment of telephone items, mobile phones and accessories.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Telefonia-gaiak, telefono mugikorrak eta osagarriak txikizka saltzen dituen establezimendua.</rdfs:comment>
        <rdfs:label xml:lang="ca">Botiga de telefonia</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Botiga de telefonia</rdfs:label>
        <rdfs:label xml:lang="eu">Telefonia-denda</rdfs:label>
        <rdfs:label xml:lang="en">Telephone shop</rdfs:label>
        <rdfs:label xml:lang="gl">Tenda de telefonía</rdfs:label>
        <rdfs:label xml:lang="es">Tienda de telefonía</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#TemporaryTouristInformationPoint -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#TemporaryTouristInformationPoint">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#availableLanguage"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Espacio ubicado en lugares de máxima afluencia donde se ofrece información de interés al visitante.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espai ubicat en llocs de màxima afluència on s&apos;ofereix informació d&apos;interès al visitant.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espai ubicat en llocs de màxima afluència on s&apos;oferix informació d&apos;interès al visitant.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazo situado en lugares de máxima afluencia onde se ofrece información de interese ao visitante.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Jende gehien ibiltzen den lekuetan kokatutako espazioa, bisitariari intereseko informazioa ematen zaiona.</rdfs:comment>
        <rdfs:comment xml:lang="en">Space located in places of maximum influx where information of interest to the visitor is offered</rdfs:comment>
        <rdfs:label xml:lang="eu">Aldi baterako turismo-informazioko puntua</rdfs:label>
        <rdfs:label xml:lang="ca">Punt d&apos;informació turística temporal</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Punt d&apos;informació turística temporal</rdfs:label>
        <rdfs:label xml:lang="es">Punto de información turística temporal</rdfs:label>
        <rdfs:label xml:lang="gl">Punto de información turística temporal</rdfs:label>
        <rdfs:label xml:lang="en">Temporary tourist information point</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#TennisCourt -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#TennisCourt">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#SportFacility"/>
        <rdfs:comment xml:lang="en">A rectangular surface adapted for tennis, divided by a central net and featuring various types of court surfaces depending on the style of play.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Superficie rectangular adaptada para a práctica do tenis, dividida por unha rede intermedia e acondicionada con diferentes tipos de pavimento segundo a modalidade de xogo.</rdfs:comment>
        <rdfs:comment xml:lang="es">Superficie rectangular adaptada para la práctica del tenis, dividida por una red intermedia y acondicionada con diferentes tipos de pavimento según la modalidad de juego.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Superfície rectangular adaptada per a la pràctica del tennis, dividida per una xarxa intermèdia i condicionada amb diferents tipus de paviment segons la modalitat de joc.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Superfície rectangular adaptada per a la pràctica del tennis, dividida per una xarxa intermèdia i condicionada amb diferents tipus de paviment segons la modalitat de joc.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Tenisean aritzeko egokitutako gainazal angeluzuzena, erdiko sare batez zatitua eta joko-modalitatearen arabera zoladura mota desberdinekin prestatua.</rdfs:comment>
        <rdfs:label xml:lang="es">Pista de tenis</rdfs:label>
        <rdfs:label xml:lang="gl">Pista de tenis</rdfs:label>
        <rdfs:label xml:lang="ca">Pista de tennis</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Pista de tennis</rdfs:label>
        <rdfs:label xml:lang="eu">Tenis-pista</rdfs:label>
        <rdfs:label xml:lang="en">Tennis court</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Terroir -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Terroir">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#AgrotourismFacility"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalWineTourismFacilityService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Areas of land where an indeterminate number of vineyards are located which, due to their location and microclimatic conditions, geological composition or terrain, share similar conditions and therefore produce grapes with distinctive characteristics that give rise to very unique wines, generally known as vinos de pago</rdfs:comment>
        <rdfs:comment xml:lang="es">Extensiones de terreno en las que se localizan un número indeterminado de viñas que -por razón de su situación y condiciones micro-climáticas, por su composición geológica o por su orografía- comparten condiciones similares y producen por ello uvas con características diferenciadas que dan lugar a unos vinos muy singulares, generalmente conocidos como vinos de pago</rdfs:comment>
        <rdfs:comment xml:lang="ca">Extensions de terreny on es localitza un nombre indeterminat de vinyes que, per la situació i les condicions microclimàtiques, la composició geològica o l&apos;orografia, comparteixen condicions similars i produeixen raïm amb característiques diferenciades que dona lloc a vins molt singulars, generalment coneguts com a vins de finca</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Extensions de terreny on es localitza un nombre indeterminat de vinyes que, per la situació i les condicions microclimàtiques, la composició geològica o l&apos;orografia, compartixen condicions similars i produïxen raïm amb característiques diferenciades que dona lloc a vins molt singulars, generalment coneguts com a vins de finca</rdfs:comment>
        <rdfs:comment xml:lang="gl">Extensións de terreo nas que se localiza un número indeterminado de viñas que, pola súa situación e condicións microclimáticas, pola súa composición xeolóxica ou pola súa orografía, comparten condicións similares e producen uvas con características diferenciadas que dan lugar a viños moi singulares, xeralmente coñecidos como viños de predio</rdfs:comment>
        <rdfs:comment xml:lang="eu">Mahasti kopuru zehaztugabea duten lur-eremuak, kokapenagatik eta mikroklima-baldintzengatik, osaera geologikoagatik edo orografiagatik antzeko baldintzak partekatzen dituztenak eta ezaugarri bereizgarriak dituzten mahatsak ekoizten dituztenak; horiek ardo oso bereziak sortzen dituzte, normalean sail jakin bateko ardoak deituak</rdfs:comment>
        <rdfs:label xml:lang="ca">Finca vitícola singular</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Finca vitícola singular</rdfs:label>
        <rdfs:label xml:lang="eu">Mahasti-sail berezia</rdfs:label>
        <rdfs:label xml:lang="es">Pago</rdfs:label>
        <rdfs:label xml:lang="gl">Predio vitícola singular</rdfs:label>
        <rdfs:label xml:lang="en">Terroir</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Thalasso -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Thalasso">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HealthAndWellnessFacility"/>
        <rdfs:comment xml:lang="en">A facility specialized in the therapeutic use of seawater and the marine environment for wellbeing and health purposes.</rdfs:comment>
        <rdfs:comment xml:lang="es">Instalación especializada en el uso terapéutico del agua de mar y del entorno marino con fines de bienestar y salud.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Instalación especializada no uso terapéutico da auga de mar e do contorno mariño con fins de benestar e saúde.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Instal·lació especialitzada en l&apos;ús terapèutic de l&apos;aigua de mar i de l&apos;entorn marí amb finalitats de benestar i salut.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Instal·lació especialitzada en l&apos;ús terapèutic de l&apos;aigua de mar i de l&apos;entorn marí amb finalitats de benestar i salut.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ongizate- eta osasun-helburuekin itsasoko ura eta itsas ingurunea terapeutikoki erabiltzen espezializatutako instalazioa.</rdfs:comment>
        <rdfs:label xml:lang="ca">Centre de talassoteràpia</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Centre de talassoteràpia</rdfs:label>
        <rdfs:label xml:lang="gl">Centro de talasoterapia</rdfs:label>
        <rdfs:label xml:lang="es">Talaso</rdfs:label>
        <rdfs:label xml:lang="eu">Talasoterapia-zentroa</rdfs:label>
        <rdfs:label xml:lang="en">Thalasso</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Theater -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Theater">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#LeisureAndCultureFacility"/>
        <rdfs:comment xml:lang="eu">Antzezlanak edo eszenaren bestelako ikuskizun publikoak emateko eraikina edo lekua.</rdfs:comment>
        <rdfs:comment xml:lang="en">Building or site intended for the representation of dramatic works or other public spectacles typical of the scene.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Edifici o lloc destinat a representar obres dramàtiques o altres espectacles públics propis de l&apos;escena.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Edifici o lloc destinat a representar obres dramàtiques o altres espectacles públics propis de l&apos;escena.</rdfs:comment>
        <rdfs:comment xml:lang="es">Edificio o sitio destinado a la representación de obras dramáticas o a otros espectáculos públicos propios de la escena.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Edificio ou sitio destinado á representación de obras dramáticas ou doutros espectáculos públicos propios da escena.</rdfs:comment>
        <rdfs:label xml:lang="eu">Antzokia</rdfs:label>
        <rdfs:label xml:lang="ca">Teatre</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Teatre</rdfs:label>
        <rdfs:label xml:lang="es">Teatro</rdfs:label>
        <rdfs:label xml:lang="gl">Teatro</rdfs:label>
        <rdfs:label xml:lang="en">Theater</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#TicketOrEntrance -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#TicketOrEntrance">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismService"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#offeredBy"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#ComplementaryActivitiesCompany"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#saleEndDate"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#saleStartDate"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#saleEndDate"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#saleStartDate"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="ca">Servei turístic consistent en l&apos;emissió o venda d&apos;un tiquet o entrada que atorga dret d&apos;accés, ús o participació en una activitat d&apos;una instal·lació turística o vinculada sota unes condicions i durant un període determinats.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Servici turístic consistent en l&apos;emissió o venda d&apos;un tiquet o entrada que atorga dret d&apos;accés, ús o participació en una activitat d&apos;una instal·lació turística o vinculada sota unes condicions i durant un període determinats.</rdfs:comment>
        <rdfs:comment xml:lang="es">Servicio turístico que consiste en la emisión o venta de un ticket o entrada que otorga derecho de acceso, uso o participación en una actividad de una instalación turística o vinculada bajo unas condiciones y periodo determinados.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Servizo turístico que consiste na emisión ou venda dun tícket ou entrada que outorga dereito de acceso, uso ou participación nunha actividade dunha instalación turística ou vinculada baixo unhas condicións e durante un período determinados.</rdfs:comment>
        <rdfs:comment xml:lang="en">Tourism service consisting of the issuance or sale of a ticket or entrance that grants the right of access, use, or participation in an activity at a tourism or related facility under specific conditions and within a defined period.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Turismo-instalazio edo hari lotutako instalazio bateko jarduera batera sartzeko, hura erabiltzeko edo bertan parte hartzeko eskubidea ematen duen txartel edo sarrera bat jaulki edo saltzeko turismo-zerbitzua, baldintza eta aldi jakin batzuetan.</rdfs:comment>
        <rdfs:label xml:lang="es">Ticket o entrada</rdfs:label>
        <rdfs:label xml:lang="en">Ticket or entrance</rdfs:label>
        <rdfs:label xml:lang="ca">Tiquet o entrada</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Tiquet o entrada</rdfs:label>
        <rdfs:label xml:lang="eu">Txartela edo sarrera</rdfs:label>
        <rdfs:label xml:lang="gl">Tícket ou entrada</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#TimeSlot -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#TimeSlot">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#closesAt"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#time"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#opensAt"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#time"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="ca">Interval temporal que defineix un període continu d&apos;obertura, delimitat per una hora d&apos;inici i una hora de finalització, i utilitzat per descriure trams horaris dins d&apos;un dia concret.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Interval temporal que definix un període continu d&apos;obertura, delimitat per una hora d&apos;inici i una hora de finalització, i utilitzat per descriure trams horaris dins d&apos;un dia concret.</rdfs:comment>
        <rdfs:comment xml:lang="es">Intervalo temporal que define un periodo continuo de apertura, delimitado por una hora de inicio y una hora de finalización, y utilizado para describir tramos horarios dentro de un día concreto.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Intervalo temporal que define un período continuo de apertura, delimitado por unha hora de inicio e unha hora de finalización, e utilizado para describir tramos horarios dentro dun día concreto.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Irekita egoteko aldi jarraitu bat zehazten duen denbora-tartea, hasiera-ordu batek eta amaiera-ordu batek mugatua, egun jakin bateko ordutegi-tarteak deskribatzeko erabiltzen dena.</rdfs:comment>
        <rdfs:comment xml:lang="en">Time interval that defines a continuous period of opening, delimited by a start time and an end time, and used to describe time ranges within a specific day.</rdfs:comment>
        <rdfs:label xml:lang="es">Franja horaria</rdfs:label>
        <rdfs:label xml:lang="ca">Franja horària</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Franja horària</rdfs:label>
        <rdfs:label xml:lang="gl">Franxa horaria</rdfs:label>
        <rdfs:label xml:lang="eu">Ordutegi-tartea</rdfs:label>
        <rdfs:label xml:lang="en">Time slot</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#TobaccoShop -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#TobaccoShop">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#RetailAndFashionBusiness"/>
        <rdfs:comment xml:lang="eu">Batez ere zigiluak eta tabakoa saltzen dituen negozioa, telefonia- eta hiri-garraioko aurreordainketa-txartelak kargatzeko zerbitzuak ere eskaintzen dituena.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Negoci on es venen principalment segells i tabac, a més d&apos;oferir serveis de recàrrega de targetes de prepagament de telefonia i de transport urbà.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Negoci on es venen principalment segells i tabac, a més d&apos;oferir servicis de recàrrega de targetes de prepagament de telefonia i de transport urbà.</rdfs:comment>
        <rdfs:comment xml:lang="es">Negocio donde se venden principalmente sellos y tabaco, además de ofrecer servicios de recarga de tarjetas prepago de telefonía y de transportes urbanos.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Negocio onde se venden principalmente selos e tabaco, ademais de ofrecer servizos de recarga de tarxetas de prepagamento de telefonía e de transportes urbanos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Store where stamps and tobacco are mainly sold, in addition to offering recharge services for prepaid telephone and urban transport cards.</rdfs:comment>
        <rdfs:label xml:lang="ca">Estanc</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Estanc</rdfs:label>
        <rdfs:label xml:lang="es">Estanco</rdfs:label>
        <rdfs:label xml:lang="gl">Estanco</rdfs:label>
        <rdfs:label xml:lang="eu">Tabako-denda</rdfs:label>
        <rdfs:label xml:lang="en">Tobacco shop</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Tour -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Tour">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismService"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalTourService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#offeredBy"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#ComplementaryActivitiesCompany"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourGuide"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#itinerary"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#Itinerary"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#meetingPoint"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#Place"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasPriceClass"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#timeOfTheDay"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#includes"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#dramatisedTour"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#isAllinclusive"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#notIncluded"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Experiencia turística que incluye el recorrido por algún lugar o recinto de interés, que se hace generalmente en grupo y con la ayuda de un guía que conduce y proporciona información acerca de lo que se muestra.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Experiencia turística que inclúe o percorrido por algún lugar ou recinto de interese, xeralmente en grupo e coa axuda dun guía que conduce e proporciona información sobre o que se mostra.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Experiència turística que inclou un recorregut per algun lloc o recinte d&apos;interès, generalment en grup i amb l&apos;ajuda d&apos;un guia que condueix i proporciona informació sobre el que es mostra.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Experiència turística que inclou un recorregut per algun lloc o recinte d&apos;interès, generalment en grup i amb l&apos;ajuda d&apos;un guia que conduïx i proporciona informació sobre el que es mostra.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Intereseko leku edo esparru batean zeharreko ibilbidea barne hartzen duen turismo-esperientzia, normalean taldean eta gidari baten laguntzarekin egiten dena; gidariak taldea gidatu eta erakusten denari buruzko informazioa ematen du.</rdfs:comment>
        <rdfs:comment xml:lang="en">Tourist experience that includes a tour of a place or area of ​​interest, which is generally done in a group and with the help of a guide who drives and provides information about what is shown.</rdfs:comment>
        <rdfs:label xml:lang="eu">Bisita gidatua</rdfs:label>
        <rdfs:label xml:lang="en">Tour</rdfs:label>
        <rdfs:label xml:lang="ca">Visita guiada</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Visita guiada</rdfs:label>
        <rdfs:label xml:lang="es">Visita guiada</rdfs:label>
        <rdfs:label xml:lang="gl">Visita guiada</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#TourGuide -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#TourGuide">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrganisation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#offers"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#Tour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#tourSpecialty"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#registrationNumber"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Helmuga ondo ezagutzen duen eta bi hizkuntzatan edo gehiagotan aritzeko gai den pertsona, turistei egiten dituzten bisitetan arreta, informazioa eta laguntza emateko ardura duena.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Persoa con amplo coñecemento do destino, capaz de expresarse en dous ou máis idiomas, cuxa responsabilidade é atender, informar e asistir os turistas nas visitas que realizan.</rdfs:comment>
        <rdfs:comment xml:lang="en">Person with extensive knowledge of the destination, capable of expressing himself in two or more languages, whose responsibility is to serve, inform and assist tourists on the tours they take.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Persona amb un coneixement ampli de la destinació, capaç d&apos;expressar-se en dos o més idiomes, responsable d&apos;atendre, informar i assistir els turistes en les visites que fan.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Persona amb un coneixement ampli de la destinació, capaç d&apos;expressar-se en dos o més idiomes, responsable d&apos;atendre, informar i assistir els turistes en les visites que fan.</rdfs:comment>
        <rdfs:comment xml:lang="es">Persona con amplio conocimiento del destino, capaz de expresarse en dos o más idiomas, cuya responsabilidad es atender, informar y asistir a los turistas en los tours que realizan.</rdfs:comment>
        <rdfs:label xml:lang="ca">Guia turístic</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Guia turístic</rdfs:label>
        <rdfs:label xml:lang="es">Guía turístico</rdfs:label>
        <rdfs:label xml:lang="gl">Guía turístico</rdfs:label>
        <rdfs:label xml:lang="en">Tour guide</rdfs:label>
        <rdfs:label xml:lang="eu">Turismo-gidaria</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#TourismDestination -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismDestination">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#Place"/>
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#destinationType"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAcknowledgement"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#Acknowledgement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasRulesAndTips"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#RulesAndTips"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasSocialMediaProfile"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#SocialMediaProfile"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#nearTo"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Route"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TransportInfrastructure"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#offeredBy"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#DestinationExperience"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismService"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#offers"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#DestinationExperience"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Event"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Tour"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#relatedTourismDestination"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismDestination"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#touristType"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Bisitari batek gaua igaro dezakeen espazio fisikoa, administrazio-mugak eta/edo muga analitikoak dituena edo ez dituena, turismoaren balio-katean zehar produktuak, zerbitzuak, jarduerak eta esperientziak multzokatzen edo batera kokatzen dituena eta turismoa aztertzeko oinarrizko unitatea dena. Hainbat alderdi interesdun biltzen ditu eta sarean lotu daiteke helmuga handiagoak osatzeko. Ukiezina ere bada, eta haren irudiak eta nortasunak merkatuko lehiakortasunean eragin dezakete.</rdfs:comment>
        <rdfs:comment xml:lang="es">Espacio físico con o sin límites administrativos y/o analíticos en el que un visitante puede pasar la noche, que consiste en una agrupación o coubicación de productos y servicios, así como de actividades y experiencias a lo largo de la cadena de valor del turismo, y que constituye una unidad básica de análisis del turismo. Incorpora a diversas partes interesadas y puede conectarse en red para formar destinos más grandes. También es intangible, con su imagen e identidad, que pueden influir en su competitividad en el mercado.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espai físic amb límits administratius i/o analítics o sense, on un visitant pot passar la nit, que consisteix en una agrupació o col·localització de productes i serveis, així com d&apos;activitats i experiències al llarg de la cadena de valor del turisme, i que constitueix una unitat bàsica d&apos;anàlisi del turisme. Incorpora diverses parts interessades i es pot connectar en xarxa per formar destinacions més grans. També és intangible, amb una imatge i identitat que poden influir en la competitivitat al mercat.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espai físic amb límits administratius i/o analítics o sense, on un visitant pot passar la nit, que consisteix en una agrupació o col·localització de productes i servicis, així com d&apos;activitats i experiències al llarg de la cadena de valor del turisme, i que constituïx una unitat bàsica d&apos;anàlisi del turisme. Incorpora diverses parts interessades i es pot connectar en xarxa per formar destinacions més grans. També és intangible, amb una imatge i identitat que poden influir en la competitivitat al mercat.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazo físico con ou sen límites administrativos e/ou analíticos no que un visitante pode pasar a noite, que consiste nunha agrupación ou coubicación de produtos e servizos, así como de actividades e experiencias ao longo da cadea de valor do turismo, e que constitúe unha unidade básica de análise do turismo. Incorpora diversas partes interesadas e pode conectarse en rede para formar destinos máis grandes. Tamén é intanxible, coa súa imaxe e identidade, que poden influír na súa competitividade no mercado.</rdfs:comment>
        <rdfs:comment xml:lang="en">Physical space with or without administrative and/or analytical boundaries in which a visitor can spend an overnight, consisting of a clustering or co-location of products and services and of activities and experiences along the tourism value chain and a basic unit of analysis of tourism. It incorporates various stakeholders and can network to form larger destinations. It is also intangible with its image and identity, which can influence its market competitiveness.</rdfs:comment>
        <rdfs:label xml:lang="ca">Destinació turística</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Destinació turística</rdfs:label>
        <rdfs:label xml:lang="es">Destino turístico</rdfs:label>
        <rdfs:label xml:lang="gl">Destino turístico</rdfs:label>
        <rdfs:label xml:lang="eu">Helmuga turistikoa</rdfs:label>
        <rdfs:label xml:lang="en">Tourism destination</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#TourismEntity -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismEntity">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasSocialMediaProfile"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#SocialMediaProfile"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#isVisible"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#Visibility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#relatedTourismDestination"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismDestination"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasDescription"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#Description"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasMultimedia"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#Multimedia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalInformation"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#AdditionalInformation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#name"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="ca">Concepte general que agrupa els elements públics i privats amb capacitat d&apos;intervenir en el cicle de viatge del turista.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Concepte general que agrupa els elements públics i privats amb capacitat d&apos;intervenir en el cicle de viatge del turista.</rdfs:comment>
        <rdfs:comment xml:lang="es">Concepto general que agrupa los elementos públicos y privados con capacidad de intervenir en el ciclo de viaje del turista.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Concepto xeral que agrupa os elementos públicos e privados con capacidade de intervir no ciclo de viaxe do turista.</rdfs:comment>
        <rdfs:comment xml:lang="en">General concept that groups public and private elements capable of intervening in the tourist&apos;s travel cycle.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Turistaren bidaia-zikloan esku hartzeko gaitasuna duten elementu publikoak eta pribatuak biltzen dituen kontzeptu orokorra.</rdfs:comment>
        <rdfs:label xml:lang="es">Entidad turística</rdfs:label>
        <rdfs:label xml:lang="gl">Entidade turística</rdfs:label>
        <rdfs:label xml:lang="ca">Entitat turística</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Entitat turística</rdfs:label>
        <rdfs:label xml:lang="en">Tourism entity</rdfs:label>
        <rdfs:label xml:lang="eu">Turismo-entitatea</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#TourismIntermediary -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismIntermediary">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrganisation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasTourismOrRelatedFacility"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#offers"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#HolidayPackage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#touristType"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#travelUnit"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="ca">Agent de distribució que participa en la venda i/o intermediació de productes i serveis relacionats amb els viatges i el turisme.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Agent de distribució que participa en la venda i/o intermediació de productes i servicis relacionats amb els viatges i el turisme.</rdfs:comment>
        <rdfs:comment xml:lang="es">Agente de distribución que participa en la venta y/o corretaje de productos y servicios relacionados con viajes y turismo.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Axente de distribución que participa na venda e/ou corretaxe de produtos e servizos relacionados coas viaxes e co turismo.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Bidaiekin eta turismoarekin lotutako produktu eta zerbitzuen salmentan eta/edo bitartekaritzan parte hartzen duen banaketa-agentea.</rdfs:comment>
        <rdfs:comment xml:lang="en">Distribution agent that participates in the sale and/or brokerage of products and services related to travel and tourism.</rdfs:comment>
        <rdfs:label xml:lang="ca">Intermediari turístic</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Intermediari turístic</rdfs:label>
        <rdfs:label xml:lang="es">Intermediario turístico</rdfs:label>
        <rdfs:label xml:lang="gl">Intermediario turístico</rdfs:label>
        <rdfs:label xml:lang="en">Tourism intermediary</rdfs:label>
        <rdfs:label xml:lang="eu">Turismo-bitartekaria</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#Place"/>
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAcknowledgement"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#Acknowledgement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAdditionalTourismOrRelatedFacilityService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasSocialMediaProfile"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#SocialMediaProfile"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#paymentMethod"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#touristType"/>
