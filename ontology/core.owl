                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#allowedPetFreeRoamingAreas"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#notPetFriendlyAreas"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#petAdmissionDeposit"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="ca">Criteri de permís o restricció de les empreses que ofereixen allotjament per a l&apos;hostalatge de mascotes.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Criteri de permís o restricció de les empreses que oferixen allotjament per a l&apos;hostalatge de mascotes.</rdfs:comment>
        <rdfs:comment xml:lang="en">Criteria for permitting or restricting companies that offer accommodation for pets.</rdfs:comment>
        <rdfs:comment xml:lang="es">Criterio de permisión o restricción de las empresas que ofrecen alojamiento para el hospedaje de mascotas.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Criterio de permiso ou restrición das empresas que ofrecen aloxamento para a hospedaxe de mascotas.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ostatua eskaintzen duten enpresek maskotak ostatuan hartzeko ezarritako baimen- edo murrizketa-irizpidea.</rdfs:comment>
        <rdfs:label xml:lang="eu">Maskotekin ostatu hartzeko politika</rdfs:label>
        <rdfs:label xml:lang="en">Pet accommodation policy</rdfs:label>
        <rdfs:label xml:lang="ca">Política d&apos;allotjament amb mascotes</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Política d&apos;allotjament amb mascotes</rdfs:label>
        <rdfs:label xml:lang="es">Política de alojamiento con mascotas</rdfs:label>
        <rdfs:label xml:lang="gl">Política de aloxamento con mascotas</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


