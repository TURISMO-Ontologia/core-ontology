        <rdfs:label xml:lang="es">especialidad de la visita guiada</rdfs:label>
        <rdfs:label xml:lang="gl">especialidade da visita guiada</rdfs:label>
        <rdfs:label xml:lang="ca">especialitat de la visita guiada</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">especialitat de la visita guiada</rdfs:label>
        <rdfs:label xml:lang="en">tour specialty</rdfs:label>
