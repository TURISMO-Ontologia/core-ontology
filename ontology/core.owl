    <!-- https://ontologia.segittur.es/turismo/def/core#Playground -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Playground">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#LeisureAndCultureFacility"/>
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
        <rdfs:comment xml:lang="es">Espacio recreativo enfocado a los niños, que cuenta con juegos infantiles y que suele estar en espacios abiertos.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espai recreatiu enfocat als infants, amb jocs infantils i que sol estar en espais oberts.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espai recreatiu enfocat als infants, amb jocs infantils i que sol estar en espais oberts.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazo recreativo enfocado aos nenos, que conta con xogos infantís e que adoita estar en espazos abertos.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Haurrei zuzendutako jolas-espazioa, haurrentzako jolasak dituena eta normalean espazio irekietan egoten dena.</rdfs:comment>
        <rdfs:comment xml:lang="en">Recreational space focused on children, which has children&apos;s games and is usually in open spaces.</rdfs:comment>
        <rdfs:label xml:lang="eu">Haur-parkea</rdfs:label>
        <rdfs:label xml:lang="ca">Parc infantil</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Parc infantil</rdfs:label>
        <rdfs:label xml:lang="es">Parque infantil</rdfs:label>
        <rdfs:label xml:lang="gl">Parque infantil</rdfs:label>
        <rdfs:label xml:lang="en">Playground</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Playroom -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Playroom">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#LeisureAndCultureFacility"/>
        <rdfs:comment xml:lang="ca">Centre d&apos;esbarjo on es guarden jocs i joguines per a l&apos;ús i el préstec</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Centre d&apos;esbarjo on es guarden jocs i joguines per a l&apos;ús i el préstec</rdfs:comment>
        <rdfs:comment xml:lang="gl">Centro de lecer onde se gardan xogos e xoguetes para o seu uso e préstamo</rdfs:comment>
        <rdfs:comment xml:lang="es">Centro de recreo donde se guardan juegos y juguetes para su uso y préstamo</rdfs:comment>
        <rdfs:comment xml:lang="eu">Jokoak eta jostailuak erabiltzeko eta maileguan emateko gordetzen diren aisialdi-zentroa</rdfs:comment>
        <rdfs:comment xml:lang="en">Recreation center where games and toys are stored for use and loan</rdfs:comment>
        <rdfs:label xml:lang="ca">Ludoteca</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Ludoteca</rdfs:label>
        <rdfs:label xml:lang="es">Ludoteca</rdfs:label>
        <rdfs:label xml:lang="gl">Ludoteca</rdfs:label>
        <rdfs:label xml:lang="eu">Ludoteka</rdfs:label>
        <rdfs:label xml:lang="en">Playroom</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#PoliceStation -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#PoliceStation">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
        <rdfs:comment xml:lang="en">Building where police activities are centralized of a neighborhood or district under the command of a commissioner</rdfs:comment>
        <rdfs:comment xml:lang="ca">Edifici on se centralitzen les activitats policials d&apos;un barri o districte sota el comandament d&apos;un comissari.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Edifici on se centralitzen les activitats policials d&apos;un barri o districte sota el comandament d&apos;un comissari.</rdfs:comment>
        <rdfs:comment xml:lang="es">Edificio donde se centralizan las actividades policiales de un barrio o distrito bajo el mando de un comisario.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Edificio onde se centralizan as actividades policiais dun barrio ou distrito baixo o mando dun comisario.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Komisario baten agindupean auzo edo barruti bateko polizia-jarduerak zentralizatzen diren eraikina.</rdfs:comment>
        <rdfs:label xml:lang="es">Comisaría de policía</rdfs:label>
        <rdfs:label xml:lang="gl">Comisaría de policía</rdfs:label>
        <rdfs:label xml:lang="ca">Comissaria de policia</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Comissaria de policia</rdfs:label>
        <rdfs:label xml:lang="en">Police station</rdfs:label>
        <rdfs:label xml:lang="eu">Polizia-etxea</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#PortPassengerTerminal -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#PortPassengerTerminal">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TransportInfrastructure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#transportInfrastructureContains"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Portu baten barruan edo kanpoan ezarritako unitatea, obrez, instalazioez eta azaleraz osatua, ur-eremua barne, bidaiarien joan-etorriko portu-eragiketa osoa egitea ahalbidetzen duena, bidaiariak eta ekipajeak ontziratzea eta ontzitik portura lehorreratzea barne.</rdfs:comment>
        <rdfs:comment xml:lang="es">Unidad establecida en un puerto o fuera de él, formada por obras, instalaciones y superficies, incluida su zona de agua, que permite la realización íntegra de la operación portuaria de tránsito de pasajeros, incluyendo el embarque y el desembarque de pasajeros y equipajes del buque al puerto.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Unidade establecida nun porto ou fóra del, formada por obras, instalacións e superficies, incluída a súa zona de auga, que permite a realización íntegra da operación portuaria de tránsito de pasaxeiros, incluídos o embarque e desembarque de pasaxeiros e equipaxes do buque ao porto.</rdfs:comment>
        <rdfs:comment xml:lang="en">Unit established in a port or outside it, made up of works, facilities and surfaces, including its water area, that allows the full implementation of the port operation of passenger transit, including the boarding and disembarkation of passengers and luggage from the ship to the port.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Unitat establerta dins o fora d&apos;un port, formada per obres, instal·lacions i superfícies, inclosa la zona d&apos;aigua, que permet dur a terme íntegrament l&apos;operació portuària de trànsit de passatgers, incloent-hi l&apos;embarcament i desembarcament de passatgers i equipatges del vaixell al port.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Unitat establerta dins o fora d&apos;un port, formada per obres, instal·lacions i superfícies, inclosa la zona d&apos;aigua, que permet dur a terme íntegrament l&apos;operació portuària de trànsit de passatgers, incloent-hi l&apos;embarcament i desembarcament de passatgers i equipatges del vaixell al port.</rdfs:comment>
        <rdfs:label xml:lang="eu">Bidaiarientzako portu-terminala</rdfs:label>
        <rdfs:label xml:lang="en">Port passenger terminal</rdfs:label>
        <rdfs:label xml:lang="es">Terminal portuaria de pasajeros</rdfs:label>
        <rdfs:label xml:lang="gl">Terminal portuaria de pasaxeiros</rdfs:label>
        <rdfs:label xml:lang="ca">Terminal portuària de passatgers</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Terminal portuària de passatgers</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#PostOffice -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#PostOffice">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
        <rdfs:comment xml:lang="gl">Establecemento encargado de enviar, recibir, ordenar, manexar, transmitir e entregar o correo. Nalgúns ofrécense servizos como formularios, xiros de diñeiro, cambio de moedas e servizos bancarios, entre outros.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento encargado de enviar, recibir, ordenar, manejar, transmitir y entregar el correo. En algunas de ellas se ofrecen servicios como formularios, giros de dinero, cambio de monedas y servicios bancarios, entre otros.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment encarregat d&apos;enviar, rebre, ordenar, gestionar, transmetre i lliurar el correu. En alguns s&apos;ofereixen serveis com ara formularis, girs de diners, canvi de monedes i serveis bancaris, entre d&apos;altres.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment encarregat d&apos;enviar, rebre, ordenar, gestionar, transmetre i lliurar el correu. En alguns s&apos;oferixen servicis com ara formularis, girs de diners, canvi de monedes i servicis bancaris, entre d&apos;altres.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment responsible for sending, receiving, sorting, handling, transmitting and delivering mail. Some of them offer services such as forms, money transfers, currency exchange and banking services, among others</rdfs:comment>
        <rdfs:comment xml:lang="eu">Posta bidali, jaso, sailkatu, kudeatu, transmititu eta entregatzeaz arduratzen den establezimendua. Batzuetan inprimakiak, diru-igorpenak, dibisa-trukea eta banku-zerbitzuak eskaintzen dira, besteak beste.</rdfs:comment>
        <rdfs:label xml:lang="es">Oficina de correos</rdfs:label>
        <rdfs:label xml:lang="gl">Oficina de correos</rdfs:label>
        <rdfs:label xml:lang="ca">Oficina de correus</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Oficina de correus</rdfs:label>
        <rdfs:label xml:lang="en">Post office</rdfs:label>
        <rdfs:label xml:lang="eu">Postetxea</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#PriceSpecification -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#PriceSpecification">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#priceSchedule"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#Schedule"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#eligibleQuantity"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#isAccessibleForFree"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#maxPrice"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#minPrice"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#petDeposit"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#petFee"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#price"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#priceCurrency"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#taxesAndFeesIncluded"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="ca">Cost total del producte o servei que pot incloure impostos, càrrecs o reduccions de tarifes.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Cost total del producte o servici que pot incloure impostos, càrrecs o reduccions de tarifes.</rdfs:comment>
        <rdfs:comment xml:lang="es">Coste total del producto o servicio que puede incluir impuestos, cargos o reducciones en las tarifas.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Custo total do produto ou servizo que pode incluír impostos, cargos ou reducións nas tarifas.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Produktu edo zerbitzuaren guztizko kostua, zergak, karguak edo tarifa-murrizketak barne har ditzakeena.</rdfs:comment>
        <rdfs:comment xml:lang="en">Total cost of the product or service that may include taxes, charges, or rate reductions.</rdfs:comment>
        <rdfs:label xml:lang="ca">Especificació del preu</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Especificació del preu</rdfs:label>
        <rdfs:label xml:lang="es">Especificación del precio</rdfs:label>
        <rdfs:label xml:lang="gl">Especificación do prezo</rdfs:label>
        <rdfs:label xml:lang="eu">Prezioaren zehaztapena</rdfs:label>
        <rdfs:label xml:lang="en">Price specification</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#PrimaryCare -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#PrimaryCare">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
        <rdfs:comment xml:lang="en">Building where the population is served at a first level of health care</rdfs:comment>
        <rdfs:comment xml:lang="ca">Edifici on s&apos;atén la població en un primer nivell d&apos;assistència sanitària</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Edifici on s&apos;atén la població en un primer nivell d&apos;assistència sanitària</rdfs:comment>
        <rdfs:comment xml:lang="es">Edificio donde se atiende a la población en un primer nivel asistencial sanitario</rdfs:comment>
        <rdfs:comment xml:lang="gl">Edificio onde se atende a poboación nun primeiro nivel de asistencia sanitaria</rdfs:comment>
        <rdfs:comment xml:lang="eu">Herritarrei osasun-arretaren lehen mailan arreta ematen zaien eraikina</rdfs:comment>
        <rdfs:label xml:lang="ca">Centre d&apos;atenció primària</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Centre d&apos;atenció primària</rdfs:label>
        <rdfs:label xml:lang="es">Centro de atención primaria</rdfs:label>
        <rdfs:label xml:lang="gl">Centro de atención primaria</rdfs:label>
        <rdfs:label xml:lang="eu">Lehen mailako arretako zentroa</rdfs:label>
        <rdfs:label xml:lang="en">Primary care</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#PrivateHireCompany -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#PrivateHireCompany">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PassengerTransportCompany"/>
        <rdfs:comment xml:lang="en">Company that provides passenger transportation services using private vehicles and professional drivers.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Empresa que proporciona serveis de transport de passatgers utilitzant vehicles privats i conductors professionals.</rdfs:comment>
        <rdfs:comment xml:lang="es">Empresa que proporciona servicios de transporte de pasajeros utilizando vehículos privados y conductores profesionales.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Empresa que proporciona servicis de transport de passatgers utilitzant vehicles privats i conductors professionals.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Empresa que proporciona servizos de transporte de pasaxeiros utilizando vehículos privados e condutores profesionais.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ibilgailu pribatuak eta gidari profesionalak erabiliz bidaiariak garraiatzeko zerbitzuak eskaintzen dituen enpresa.</rdfs:comment>
        <rdfs:label xml:lang="es">Empresa VTC</rdfs:label>
        <rdfs:label xml:lang="ca">Empresa de VTC</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Empresa de VTC</rdfs:label>
        <rdfs:label xml:lang="gl">Empresa de VTC</rdfs:label>
        <rdfs:label xml:lang="eu">Gidaridun ibilgailuen alokairu-enpresa (VTC)</rdfs:label>
        <rdfs:label xml:lang="en">Private hire company</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#PrivateHospital -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#PrivateHospital">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#MedicalBusiness"/>
        <rdfs:comment xml:lang="gl">Establecemento destinado ao diagnóstico e tratamento de enfermos, cuxo financiamento corre a cargo dos propios pacientes, das aseguradoras ou de embaixadas estranxeiras.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento destinado al diagnóstico y tratamiento de enfermos, cuya financiación corre a cargo de los propios pacientes, de las aseguradoras o de embajadas extranjeras.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment destinat al diagnòstic i tractament de malalts, finançat pels mateixos pacients, asseguradores o ambaixades estrangeres.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment destinat al diagnòstic i tractament de malalts, finançat pels mateixos pacients, asseguradores o ambaixades estrangeres.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment intended for the diagnosis and treatment of patients, whose financing is provided by the patients themselves, by insurance companies or by foreign embassies.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Gaixoak diagnostikatzeko eta tratatzeko establezimendua, pazienteek eurek, aseguratzaileek edo atzerriko enbaxadek finantzatua.</rdfs:comment>
        <rdfs:label xml:lang="es">Hospital privado</rdfs:label>
        <rdfs:label xml:lang="gl">Hospital privado</rdfs:label>
        <rdfs:label xml:lang="ca">Hospital privat</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Hospital privat</rdfs:label>
        <rdfs:label xml:lang="eu">Ospitale pribatua</rdfs:label>
        <rdfs:label xml:lang="en">Private hospital</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Promotion -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Promotion">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PriceSpecification"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasDescription"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#Description"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#name"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#finalPrice"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#discount"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Advertising campaign carried out on a specific product or service for a limited time through an attractive offer.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Campanya publicitària d&apos;un producte o servei determinat durant un temps limitat mitjançant una oferta atractiva.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Campanya publicitària d&apos;un producte o servici determinat durant un temps limitat mitjançant una oferta atractiva.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Campaña publicitaria dun determinado produto ou servizo durante un tempo limitado mediante unha oferta atractiva.</rdfs:comment>
        <rdfs:comment xml:lang="es">Campaña publicitaria que se hace de un determinado producto o servicio durante un tiempo limitado mediante una oferta atractiva.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Produktu edo zerbitzu jakin bati buruzko publizitate-kanpaina, denbora mugatu batez eskaintza erakargarri baten bidez egiten dena.</rdfs:comment>
        <rdfs:label xml:lang="ca">Promoció</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Promoció</rdfs:label>
        <rdfs:label xml:lang="es">Promoción</rdfs:label>
        <rdfs:label xml:lang="gl">Promoción</rdfs:label>
        <rdfs:label xml:lang="en">Promotion</rdfs:label>
        <rdfs:label xml:lang="eu">Sustapena</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Pub -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Pub">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PartyAndEntertainmentFacility"/>
        <rdfs:comment xml:lang="eu">Edari alkoholdunak zerbitzatzen eta kontsumitzen diren establezimendua. Taberna batetik bereizten da dekorazioagatik, irekiera-ordutegiagatik eta zerbitzatzen diren edari eta janari motengatik.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento onde se serven e consomen bebidas alcohólicas. Diferénciase dun bar pola decoración, o horario de apertura e o tipo de bebidas e comida que se serve.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento donde se sirven y consumen bebidas alcohólicas. Se diferencia de un bar por la decoración, el horario de apertura y el tipo de bebidas y comida que se sirve.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment on se serveixen i es consumeixen begudes alcohòliques. Es diferencia d&apos;un bar per la decoració, l&apos;horari d&apos;obertura i el tipus de begudes i menjars que s&apos;hi serveixen.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment on se servixen i es consumixen begudes alcohòliques. Es diferencia d&apos;un bar per la decoració, l&apos;horari d&apos;obertura i el tipus de begudes i menjars que s&apos;hi servixen.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment where alcoholic beverages are served and consumed. It is differentiated from a bar based on the decoration, opening times and type of beverages and food served.</rdfs:comment>
        <rdfs:label xml:lang="ca">Pub</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Pub</rdfs:label>
        <rdfs:label xml:lang="en">Pub</rdfs:label>
        <rdfs:label xml:lang="es">Pub</rdfs:label>
        <rdfs:label xml:lang="gl">Pub</rdfs:label>
        <rdfs:label xml:lang="eu">Puba</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#PublicHospital -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#PublicHospital">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
        <rdfs:comment xml:lang="gl">Establecemento financiado con fondos estatais destinado ao diagnóstico e tratamento de enfermos, onde a miúdo se practican a investigación e a docencia.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento financiado con fondos estatales destinado al diagnóstico y tratamiento de enfermos, donde a menudo se practican la investigación y la docencia.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment finançat amb fons estatals destinat al diagnòstic i tractament de malalts, on sovint es duen a terme recerca i docència.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment finançat amb fons estatals destinat al diagnòstic i tractament de malalts, on sovint es duen a terme recerca i docència.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment financed by state funds for the diagnosis and treatment of patients, where research and teaching are often practiced</rdfs:comment>
        <rdfs:comment xml:lang="eu">Estatuko funtsekin finantzatutako establezimendua, gaixoak diagnostikatzeko eta tratatzeko erabiltzen dena eta maiz ikerketa eta irakaskuntza ere egiten dituena.</rdfs:comment>
        <rdfs:label xml:lang="ca">Hospital públic</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Hospital públic</rdfs:label>
        <rdfs:label xml:lang="es">Hospital público</rdfs:label>
        <rdfs:label xml:lang="gl">Hospital público</rdfs:label>
        <rdfs:label xml:lang="eu">Ospitale publikoa</rdfs:label>
        <rdfs:label xml:lang="en">Public hospital</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#PublicRestroom -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#PublicRestroom">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#adaptedPublicRestroom"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="ca">Habitació o edificació petita amb un o més vàters per a ús del públic general.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Habitació o edificació xicoteta amb un o més vàters per a ús del públic general.</rdfs:comment>
        <rdfs:comment xml:lang="es">Habitación o edificación pequeña con uno o más inodoros para uso del público en general.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Habitación ou pequena edificación cun ou máis inodoros para uso do público en xeral.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Jende orokorrak erabiltzeko komunontzi bat edo gehiago dituen gela edo eraikin txikia.</rdfs:comment>
        <rdfs:comment xml:lang="en">Room or small building with one or more toilets for use by the general public</rdfs:comment>
        <rdfs:label xml:lang="es">Baño público</rdfs:label>
        <rdfs:label xml:lang="gl">Baño público</rdfs:label>
        <rdfs:label xml:lang="eu">Komun publikoa</rdfs:label>
        <rdfs:label xml:lang="ca">Lavabo públic</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Lavabo públic</rdfs:label>
        <rdfs:label xml:lang="en">Public restroom</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#PublicService -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#PublicService">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#Place"/>
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasAcknowledgement"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#Acknowledgement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#additionalClassification"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A publicly accessible physical or institutional entity serving a civic function that supports community life and governance.</rdfs:comment>
        <rdfs:comment xml:lang="es">Entidad física o institucional de acceso público que desempeña una función cívica y apoya la vida comunitaria y la gobernanza.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Entidade física ou institucional de acceso público que desempeña unha función cívica e apoia a vida comunitaria e a gobernanza.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Entitat física o institucional d&apos;accés públic que exerceix una funció cívica i dona suport a la vida comunitària i la governança.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Entitat física o institucional d&apos;accés públic que exercix una funció cívica i dona suport a la vida comunitària i la governança.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Sarbide publikoko entitate fisiko edo instituzionala, funtzio zibikoa betetzen duena eta komunitate-bizitza eta gobernantza babesten dituena.</rdfs:comment>
        <rdfs:label xml:lang="en">Public service</rdfs:label>
        <rdfs:label xml:lang="ca">Servei públic</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Servici públic</rdfs:label>
        <rdfs:label xml:lang="es">Servicio público</rdfs:label>
        <rdfs:label xml:lang="gl">Servizo público</rdfs:label>
        <rdfs:label xml:lang="eu">Zerbitzu publikoa</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#PublicTransportStop -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#PublicTransportStop">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TransportInfrastructure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#stationType"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#publicTransportStopCode"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#publicTransportStopZone"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A specific and marked location on an established route where vehicles (such as buses, trams, or trains) stop regularly to allow passengers to board or get off.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ezarritako ibilbide batean seinaleztatutako leku zehatza, ibilgailuak (autobusak, tranbiak edo trenak, esaterako) aldizka gelditzen direna bidaiariak igo edo jaitsi daitezen.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Lloc específic i senyalitzat en una ruta establerta on els vehicles (com ara autobusos, tramvies o trens) s&apos;aturen regularment perquè els passatgers hi pugin o en baixin.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Lloc específic i senyalitzat en una ruta establerta on els vehicles (com ara autobusos, tramvies o trens) s&apos;aturen regularment perquè els passatgers hi pugin o en baixin.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugar específico e sinalizado nunha ruta establecida onde os vehículos (como autobuses, tranvías ou trens) se deteñen regularmente para permitir que os pasaxeiros suban ou baixen.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugar específico y señalizado en una ruta establecida donde los vehículos (como autobuses, tranvías o trenes) se detienen regularmente para permitir que los pasajeros suban o bajen.</rdfs:comment>
        <rdfs:label xml:lang="eu">Garraio publikoko geltokia</rdfs:label>
        <rdfs:label xml:lang="ca">Parada de transport públic</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Parada de transport públic</rdfs:label>
        <rdfs:label xml:lang="es">Parada de transporte público</rdfs:label>
        <rdfs:label xml:lang="gl">Parada de transporte público</rdfs:label>
        <rdfs:label xml:lang="en">Public transport stop</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Quarter -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Quarter">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#historicalOrCulturalResourceContains"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
                            <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A group of streets in a city that offer tourist attractions of interest, usually related to a specific theme</rdfs:comment>
        <rdfs:comment xml:lang="ca">Conjunt de carrers d&apos;una ciutat que acull oferta turística d&apos;interès, habitualment relacionada amb un tema</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Conjunt de carrers d&apos;una ciutat que acull oferta turística d&apos;interès, habitualment relacionada amb un tema</rdfs:comment>
        <rdfs:comment xml:lang="es">Conjunto de calles de una ciudad que alberga oferta turística de interés, habitualmente relacionada con un tema</rdfs:comment>
        <rdfs:comment xml:lang="gl">Conxunto de rúas dunha cidade que acolle oferta turística de interese, habitualmente relacionada cun tema</rdfs:comment>
        <rdfs:comment xml:lang="eu">Intereseko turismo-eskaintza biltzen duen hiriko kale-multzoa, normalean gai batekin lotua</rdfs:comment>
        <rdfs:label xml:lang="eu">Auzoa</rdfs:label>
        <rdfs:label xml:lang="ca">Barri</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Barri</rdfs:label>
        <rdfs:label xml:lang="es">Barrio</rdfs:label>
        <rdfs:label xml:lang="gl">Barrio</rdfs:label>
        <rdfs:label xml:lang="en">Quarter</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Racetrack -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Racetrack">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#SportFacility"/>
        <rdfs:comment xml:lang="ca">Lloc destinat a curses de cavalls</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Lloc destinat a curses de cavalls</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugar destinado a carreiras de cabalos</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugar destinado a carreras de caballos</rdfs:comment>
        <rdfs:comment xml:lang="en">Place for horse racing</rdfs:comment>
        <rdfs:comment xml:lang="eu">Zaldi-lasterketetarako lekua</rdfs:comment>
        <rdfs:label xml:lang="eu">Hipodromoa</rdfs:label>
        <rdfs:label xml:lang="ca">Hipòdrom</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Hipòdrom</rdfs:label>
        <rdfs:label xml:lang="es">Hipódromo</rdfs:label>
        <rdfs:label xml:lang="gl">Hipódromo</rdfs:label>
        <rdfs:label xml:lang="en">Race track</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Reservoir -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Reservoir">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
        <rdfs:comment xml:lang="en">Accumulation of water produced by a construction in the bed of a river or stream that partially or totally closes its channel</rdfs:comment>
        <rdfs:comment xml:lang="ca">Acumulació d&apos;aigua produïda per una construcció a la llera d&apos;un riu o rierol que en tanca parcialment o totalment el curs.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Acumulació d&apos;aigua produïda per una construcció a la llera d&apos;un riu o rierol que en tanca parcialment o totalment el curs.</rdfs:comment>
        <rdfs:comment xml:lang="es">Acumulación de agua producida por una construcción en el lecho de un río o arroyo que cierra parcial o totalmente su cauce.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Acumulación de auga producida por unha construción no leito dun río ou regato que pecha parcial ou totalmente o seu curso.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ibai edo erreka baten ibilgua partzialki edo erabat ixten duen eraikuntzak sortutako ur-metaketa.</rdfs:comment>
        <rdfs:label xml:lang="es">Embalse</rdfs:label>
        <rdfs:label xml:lang="ca">Embassament</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Embassament</rdfs:label>
        <rdfs:label xml:lang="gl">Encoro</rdfs:label>
        <rdfs:label xml:lang="en">Reservoir</rdfs:label>
        <rdfs:label xml:lang="eu">Urtegia</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Residence -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Residence">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment"/>
        <rdfs:comment xml:lang="en">Accommodation establishment offering extended stays, in many cases on a semi-permanent or temporary basis, with services similar to those of a household.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Egonaldi luzeak eskaintzen dituen ostatu-establezimendua, askotan erdiiraunkorrak edo aldi baterakoak, eta etxe baten antzeko zerbitzuak dituena.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento de aloxamento que ofrece estadías prolongadas, en moitos casos de carácter semipermanente ou temporal, e con servizos semellantes aos dun fogar.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento alojativo que ofrece estancias prolongadas, en muchos casos con carácter semi-permanente o temporal, y con servicios similares a los de un hogar.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment d&apos;allotjament que ofereix estades prolongades, en molts casos de caràcter semipermanent o temporal, i serveis semblants als d&apos;una llar.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment d&apos;allotjament que oferix estades prolongades, en molts casos de caràcter semipermanent o temporal, i servicis semblants als d&apos;una llar.</rdfs:comment>
        <rdfs:label xml:lang="eu">Egoitza</rdfs:label>
        <rdfs:label xml:lang="en">Residence</rdfs:label>
        <rdfs:label xml:lang="es">Residencia</rdfs:label>
        <rdfs:label xml:lang="gl">Residencia</rdfs:label>
        <rdfs:label xml:lang="ca">Residència</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Residència</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Resort -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Resort">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#resortContains"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="ca">Lloc habilitat per desenvolupar l&apos;activitat turística on s&apos;ofereix una àmplia gamma de serveis i instal·lacions d&apos;hostaleria, especialment dedicats al descans i l&apos;esbarjo.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Lloc habilitat per desenvolupar l&apos;activitat turística on s&apos;oferix una àmplia gamma de servicis i instal·lacions d&apos;hostaleria, especialment dedicats al descans i l&apos;esbarjo.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugar habilitado para el desarrollo de la actividad turística en el que se ofrece una gama amplia de servicios e instalaciones relacionadas con la hostelería, especialmente dedicadas al descanso y esparcimiento.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugar habilitado para o desenvolvemento da actividade turística no que se ofrece unha ampla gama de servizos e instalacións relacionados coa hostalaría, especialmente dedicados ao descanso e ao esparexemento.</rdfs:comment>
        <rdfs:comment xml:lang="en">Place enabled for the development of tourist activity in which a wide range of services and facilities related to hospitality are offered, especially dedicated to rest and recreation.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Turismo-jarduera garatzeko prestatutako lekua, ostalaritzarekin lotutako zerbitzu eta instalazio ugari eskaintzen dituena, bereziki atsedenerako eta aisialdirako.</rdfs:comment>
        <rdfs:label xml:lang="es">Complejo turístico</rdfs:label>
        <rdfs:label xml:lang="ca">Complex turístic</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Complex turístic</rdfs:label>
        <rdfs:label xml:lang="gl">Complexo turístico</rdfs:label>
        <rdfs:label xml:lang="en">Resort</rdfs:label>
        <rdfs:label xml:lang="eu">Turismo-konplexua</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#Restaurant -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#Restaurant">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment"/>
        <rdfs:comment xml:lang="eu">Elikagaiak eta edariak sukalde batean prestatu eta bezeroei zerbitzatzen zaizkien establezimendua.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Establecemento no que se preparan alimentos e bebidas nunha cociña e se serven aos clientes.</rdfs:comment>
        <rdfs:comment xml:lang="es">Establecimiento en el que se preparan alimentos y bebidas en una cocina y se sirven a los clientes.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Establiment on es preparen aliments i begudes en una cuina i se serveixen als clients.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Establiment on es preparen aliments i begudes en una cuina i se servixen als clients.</rdfs:comment>
        <rdfs:comment xml:lang="en">Establishment where food and beverages are prepared in a kitchen and served to customers.</rdfs:comment>
        <rdfs:label xml:lang="eu">Jatetxea</rdfs:label>
        <rdfs:label xml:lang="ca">Restaurant</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Restaurant</rdfs:label>
        <rdfs:label xml:lang="en">Restaurant</rdfs:label>
        <rdfs:label xml:lang="es">Restaurante</rdfs:label>
        <rdfs:label xml:lang="gl">Restaurante</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#RestaurantCompany -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#RestaurantCompany">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrganisation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasTourismOrRelatedFacility"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#offers"/>
                <owl:allValuesFrom rdf:resource="https://ontologia.segittur.es/turismo/def/core#FoodAndBeverageService"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasTourismOrRelatedFacility"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Company that offers restaurant services</rdfs:comment>
        <rdfs:comment xml:lang="ca">Empresa que s&apos;encarrega d&apos;oferir serveis de restauració</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Empresa que s&apos;encarrega d&apos;oferir servicis de restauració</rdfs:comment>
        <rdfs:comment xml:lang="es">Empresa que se encarga de ofrecer servicios de restauración</rdfs:comment>
        <rdfs:comment xml:lang="gl">Empresa que se encarga de ofrecer servizos de restauración</rdfs:comment>
        <rdfs:comment xml:lang="eu">Jatetxe-zerbitzuak eskaintzeaz arduratzen den enpresa</rdfs:comment>
        <rdfs:label xml:lang="ca">Empresa de restauració</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Empresa de restauració</rdfs:label>
        <rdfs:label xml:lang="es">Empresa de restauración</rdfs:label>
        <rdfs:label xml:lang="gl">Empresa de restauración</rdfs:label>
        <rdfs:label xml:lang="eu">Jatetxe-enpresa</rdfs:label>
        <rdfs:label xml:lang="en">Restaurant company</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#RetailAndFashionBusiness -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#RetailAndFashionBusiness">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#LocalBusiness"/>
        <rdfs:comment xml:lang="es">Espacios físicos que ofrecen un lugar accesible y conveniente para que los consumidores adquieran diversos productos.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Espais físics que ofereixen un lloc accessible i pràctic perquè els consumidors adquireixin diversos productes.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Espais físics que oferixen un lloc accessible i pràctic perquè els consumidors adquirisquen diversos productes.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Espazos físicos que ofrecen un lugar accesible e práctico para que os consumidores adquiran diversos produtos.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Kontsumitzaileek hainbat produktu erosteko leku irisgarri eta erosoa eskaintzen duten espazio fisikoak.</rdfs:comment>
        <rdfs:comment xml:lang="en">Physical spaces that offer an accessible and convenient place for consumers to purchase various products.</rdfs:comment>
        <rdfs:label xml:lang="eu">Merkataritza- eta moda-negozioa</rdfs:label>
        <rdfs:label xml:lang="ca">Negoci de comerç i moda</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Negoci de comerç i moda</rdfs:label>
        <rdfs:label xml:lang="gl">Negocio de comercio e moda</rdfs:label>
        <rdfs:label xml:lang="es">Negocio de comercio y moda</rdfs:label>
        <rdfs:label xml:lang="en">Retail and fashion business</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#River -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#River">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#hasRiverService"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="eu">Beste ur-laster batera, laku batera edo itsasora isurtzen den ur-laster jarraitua eta emari handiagokoa edo txikiagokoa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Continuous and more or less large current of water that flows into another, a lake or the sea</rdfs:comment>
        <rdfs:comment xml:lang="ca">Corrent d&apos;aigua continu i més o menys cabalós que desemboca en un altre, en un llac o al mar.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Corrent d&apos;aigua continu i més o menys cabalós que desemboca en un altre, en un llac o al mar.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Corrente de auga continua e máis ou menos caudalosa que desemboca noutra, nun lago ou no mar.</rdfs:comment>
        <rdfs:comment xml:lang="es">Corriente de agua continua y más o menos caudalosa que va a desembocar en otra, en un lago o en el mar.</rdfs:comment>
        <rdfs:label xml:lang="eu">Ibaia</rdfs:label>
        <rdfs:label xml:lang="ca">Riu</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Riu</rdfs:label>
        <rdfs:label xml:lang="en">River</rdfs:label>
        <rdfs:label xml:lang="es">Río</rdfs:label>
        <rdfs:label xml:lang="gl">Río</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


