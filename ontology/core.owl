        <rdfs:label xml:lang="gl">Servizo adicional da instalación turística ou vinculada</rdfs:label>
        <rdfs:label xml:lang="eu">Turismo-instalazioaren edo hari lotutako instalazioaren zerbitzu gehigarria</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://ontologia.segittur.es/turismo/def/core/kos/skos-AdditionalTourismOrRelatedFacilityService.ttl"/>
    </owl:NamedIndividual>
    


