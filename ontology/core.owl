        <rdfs:comment xml:lang="eu">Lurrinak saltzen diren denda.</rdfs:comment>
        <rdfs:comment xml:lang="en">Store where perfumes are sold.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Tenda onde se venden perfumes.</rdfs:comment>
        <rdfs:comment xml:lang="es">Tienda donde se venden perfumes.</rdfs:comment>
        <rdfs:label xml:lang="eu">Lurrindegia</rdfs:label>
        <rdfs:label xml:lang="gl">Perfumaría</rdfs:label>
        <rdfs:label xml:lang="ca">Perfumeria</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Perfumeria</rdfs:label>
        <rdfs:label xml:lang="en">Perfumery</rdfs:label>
        <rdfs:label xml:lang="es">Perfumería</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#PetAccommodationPolicy -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#PetAccommodationPolicy">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PetAdmissionPolicy"/>
