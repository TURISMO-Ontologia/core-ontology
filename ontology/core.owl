    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#labelType -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#labelType">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#Label"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/LabelType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="eu">Ekitaldi, helmuga, baliabide turistiko, zerbitzu publiko eta turismo-enpresentzako erreferentziazko turismo-bereizgarrien zerrenda, haien instalazioak eta zerbitzuak barne.</rdfs:comment>
        <rdfs:comment xml:lang="en">List of tourism labels of reference for events, destinations, tourism resources, public services and tourism organisations, including their facilities and services.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lista de distintivos turísticos de referencia para eventos, destinos, recursos turísticos, servizos públicos e empresas turísticas, incluídas as súas instalacións e servizos.</rdfs:comment>
        <rdfs:comment xml:lang="es">Listado de distintivos turísticos de referencia para eventos, destinos, recursos turísticos, servicios públicos y empresas turísticas, incluyendo sus instalaciones y servicios.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Llista de distintius turístics de referència per a esdeveniments, destinacions, recursos turístics, serveis públics i empreses turístiques, incloent-hi les seves instal·lacions i serveis.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Llista de distintius turístics de referència per a esdeveniments, destinacions, recursos turístics, servicis públics i empreses turístiques, incloent-hi les seues instal·lacions i servicis.</rdfs:comment>
        <rdfs:label xml:lang="eu">bereizgarri mota</rdfs:label>
        <rdfs:label xml:lang="en">label type</rdfs:label>
        <rdfs:label xml:lang="es">tipo de distintivo</rdfs:label>
        <rdfs:label xml:lang="gl">tipo de distintivo</rdfs:label>
        <rdfs:label xml:lang="ca">tipus de distintiu</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">tipus de distintiu</rdfs:label>
        <estur-annot:orderInCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</estur-annot:orderInCategory>
        <estur-annot:presentationOrderCategory>acknowledgement</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#locomotionMode -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#locomotionMode">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Route"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Trail"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/LocomotionMode"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Forma específica en que se realiza el desplazamiento durante una ruta o actividad organizada, definida por el medio o método de transporte utilizado.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Forma específica en què es realitza el desplaçament durant una ruta o activitat organitzada, definida pel mitjà o mètode de transport utilitzat.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Forma específica en què es realitza el desplaçament durant una ruta o activitat organitzada, definida pel mitjà o mètode de transport utilitzat.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Forma específica na que se realiza o desprazamento durante unha ruta ou actividade organizada, definida polo medio ou método de transporte utilizado.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ibilbide edo jarduera antolatu batean zehar joan-etorria egiteko modu zehatza, erabilitako garraiobideak edo garraio-metodoak definitua.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specific way in which movement is carried out during a route or organized activity, defined by the means or method of transportation used.</rdfs:comment>
        <rdfs:label xml:lang="eu">lekualdatzeko modalitatea</rdfs:label>
        <rdfs:label xml:lang="en">locomotion mode</rdfs:label>
        <rdfs:label xml:lang="es">modalidad de locomoción</rdfs:label>
        <rdfs:label xml:lang="gl">modalidade de locomoción</rdfs:label>
        <rdfs:label xml:lang="ca">modalitat de locomoció</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">modalitat de locomoció</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#meetingPoint -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#meetingPoint">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#AdventureActivity"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Tour"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://ontologia.segittur.es/turismo/def/core#Place"/>
        <rdfs:comment xml:lang="en">A geographically defined place where people receiving a tourism service gather to start, coordinate, or carry out an activity.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Lloc geogràficament definit on les persones que reben un servei turístic es reuneixen per iniciar, coordinar o desenvolupar una activitat</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Lloc geogràficament definit on les persones que reben un servici turístic es reunixen per iniciar, coordinar o desenvolupar una activitat</rdfs:comment>
        <rdfs:comment xml:lang="es">Lugar geográficamente definido donde las personas que reciben un servicio turístico se reúnen para iniciar, coordinar o desarrollar una actividad</rdfs:comment>
        <rdfs:comment xml:lang="gl">Lugar xeograficamente definido onde as persoas que reciben un servizo turístico se reúnen para iniciar, coordinar ou desenvolver unha actividade</rdfs:comment>
        <rdfs:comment xml:lang="eu">Turismo-zerbitzu bat jasotzen duten pertsonak jarduera bat hasteko, koordinatzeko edo garatzeko elkartzen diren leku geografikoki zehaztua</rdfs:comment>
        <rdfs:label xml:lang="eu">elkargunea</rdfs:label>
        <rdfs:label xml:lang="en">meeting point</rdfs:label>
        <rdfs:label xml:lang="ca">punt de trobada</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">punt de trobada</rdfs:label>
        <rdfs:label xml:lang="gl">punto de encontro</rdfs:label>
        <rdfs:label xml:lang="es">punto de encuentro</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#menuOptions -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#menuOptions">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#FoodAndBeverageService"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/MenuOptions"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Alternativas o elecciones que están disponibles en un establecimiento de restauración en relación a los tipos de alimentos que se ofrecen. Estas opciones pueden adaptarse a las preferencias y necesidades dietéticas de los comensales, incluyendo alergias alimentarias, restricciones dietéticas, preferencias vegetarianas o veganas, entre otros.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Alternativas ou opcións que están dispoñibles nun establecemento de restauración en relación cos tipos de alimentos que se ofrecen. Estas opcións poden adaptarse ás preferencias e necesidades dietéticas dos comensais, incluídas alerxias alimentarias, restricións dietéticas e preferencias vexetarianas ou veganas, entre outras.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Alternatives o opcions disponibles en un establiment de restauració pel que fa als tipus d&apos;aliments que s&apos;hi ofereixen. Aquestes opcions es poden adaptar a les preferències i necessitats dietètiques dels comensals, incloent-hi al·lèrgies alimentàries, restriccions dietètiques i preferències vegetarianes o veganes, entre d&apos;altres.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Alternatives o opcions disponibles en un establiment de restauració pel que fa als tipus d&apos;aliments que s&apos;hi oferixen. Estes opcions es poden adaptar a les preferències i necessitats dietètiques dels comensals, incloent-hi al·lèrgies alimentàries, restriccions dietètiques i preferències vegetarianes o veganes, entre d&apos;altres.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Jatetxe-establezimendu batean eskaintzen diren elikagai motei dagokienez dauden aukerak. Aukera horiek mahaikideen lehentasun eta behar dietetikoetara egokitu daitezke, besteak beste elikadura-alergietara, dieta-murrizketetara eta lehentasun begetariano edo beganoetara.</rdfs:comment>
        <rdfs:comment xml:lang="en">Options or choices available in a food establishment regarding the types of food offered. These options may be adapted to diners’ preferences and dietary needs, including food allergies, dietary restrictions, vegetarian or vegan preferences, among others.</rdfs:comment>
        <rdfs:label xml:lang="eu">kartako aukerak</rdfs:label>
        <rdfs:label xml:lang="en">menu options</rdfs:label>
        <rdfs:label xml:lang="es">opciones de la carta</rdfs:label>
        <rdfs:label xml:lang="ca">opcions de la carta</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">opcions de la carta</rdfs:label>
        <rdfs:label xml:lang="gl">opcións da carta</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#museumType -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#museumType">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#Museum"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://ontologia.segittur.es/turismo/kos/MuseumType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="ca-valencia">Categories o classificacions que s&apos;utilitzen per diferenciar els museus segons la seua temàtica, enfocament o col·leccions. Cada tipus de museu se centra en un àmbit específic de l&apos;art, la història, la ciència o altres camps d&apos;interès.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Categories o classificacions que s&apos;utilitzen per diferenciar els museus segons la seva temàtica, enfocament o col·leccions. Cada tipus de museu se centra en un àmbit específic de l&apos;art, la història, la ciència o altres camps d&apos;interès.</rdfs:comment>
        <rdfs:comment xml:lang="en">Categories or classifications used to differentiate museums according to their theme, focus, or collections. Each museum type focuses on a specific field of art, history, science, or other areas of interest.</rdfs:comment>
        <rdfs:comment xml:lang="es">Categorías o clasificaciones que se utilizan para diferenciar los museos según su temática, enfoque o colecciones. Cada tipo de museo se centra en un ámbito específico del arte, la historia, la ciencia u otros campos de interés.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Categorías ou clasificacións que se utilizan para diferenciar os museos segundo a súa temática, enfoque ou coleccións. Cada tipo de museo céntrase nun ámbito específico da arte, da historia, da ciencia ou doutros campos de interese.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Museoak gaiaren, ikuspegiaren edo bildumen arabera bereizteko erabiltzen diren kategoriak edo sailkapenak. Museo mota bakoitzak artearen, historiaren, zientziaren edo beste interes-eremu batzuen arlo jakin bat du ardatz.</rdfs:comment>
        <rdfs:label xml:lang="eu">museo mota</rdfs:label>
        <rdfs:label xml:lang="en">museum type</rdfs:label>
        <rdfs:label xml:lang="es">tipo de museo</rdfs:label>
        <rdfs:label xml:lang="gl">tipo de museo</rdfs:label>
        <rdfs:label xml:lang="ca">tipus de museu</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">tipus de museu</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#naturalResourceContains -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#naturalResourceContains">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Beach"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Desert"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Forest"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Mountain"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#NaturalPark"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Valley"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Indica instalaciones turísticas o vinculadas, recursos naturales, y servicios públicos que un recurso natural puede contener.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Indica instalacións turísticas ou vinculadas, recursos naturais e servizos públicos que un recurso natural pode conter.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Indica instal·lacions turístiques o vinculades, recursos naturals i serveis públics que pot contenir un recurs natural.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Indica instal·lacions turístiques o vinculades, recursos naturals i servicis públics que pot contenir un recurs natural.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates tourism or related facilities, natural resources, and public services that a natural resource may contain.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Natura-baliabide batek izan ditzakeen turismo-instalazioak edo haiei lotutako instalazioak, natura-baliabideak eta zerbitzu publikoak adierazten ditu.</rdfs:comment>
        <rdfs:label xml:lang="ca">el recurs natural conté</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">el recurs natural conté</rdfs:label>
        <rdfs:label xml:lang="eu">natura-baliabideak dauka</rdfs:label>
        <rdfs:label xml:lang="en">natural resource contains</rdfs:label>
        <rdfs:label xml:lang="gl">o recurso natural contén</rdfs:label>
        <rdfs:label xml:lang="es">recurso natural contiene</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
        <estur-annot:tooltip xml:lang="es">Indica instalaciones turísticas o vinculadas, recursos naturales, y servicios públicos que un recurso natural puede contener</estur-annot:tooltip>
        <estur-annot:tooltip xml:lang="en">Indicates tourist or related facilities, natural resources, and public services that a natural resource may contain</estur-annot:tooltip>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#nearTo -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#nearTo">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Event"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Place"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://ontologia.segittur.es/turismo/def/core#Place"/>
        <rdfs:comment xml:lang="ca">Assenyala llocs rellevants als quals un lloc determinat pot ser proper i la proximitat dels quals pot ser útil o interessant per al turista.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Assenyala llocs rellevants als quals un lloc determinat pot ser proper i la proximitat dels quals pot ser útil o interessant per al turista.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates relevant places that a particular place may be close to and whose proximity may be useful or interesting to tourists.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Leku jakin batetik hurbil egon daitezkeen leku esanguratsuak adierazten ditu, haien hurbiltasuna turistarentzat baliagarria edo interesgarria izan daitekeenean.</rdfs:comment>
        <rdfs:comment xml:lang="es">Señala lugares relevantes a los que un determinado lugar puede estar próximo y cuya proximidad puede ser útil o interesante para el turista.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Sinala lugares relevantes aos que un determinado lugar pode estar próximo e cuxa proximidade pode ser útil ou interesante para o turista.</rdfs:comment>
        <rdfs:label xml:lang="ca">a prop de</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">a prop de</rdfs:label>
        <rdfs:label xml:lang="es">cerca de</rdfs:label>
        <rdfs:label xml:lang="eu">honetatik hurbil</rdfs:label>
        <rdfs:label xml:lang="en">near to</rdfs:label>
        <rdfs:label xml:lang="gl">preto de</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
        <estur-annot:tooltip xml:lang="en">Points out relevant places to which a given place may be close, and whose proximity may be useful or interesting for tourists</estur-annot:tooltip>
        <estur-annot:tooltip xml:lang="es">Señala lugares relevantes a los que un determinado lugar puede estar próximo y cuya proximidad puede ser útil o interesante para el turista.</estur-annot:tooltip>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#offerSchedule -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#offerSchedule">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#SpecialOffer"/>
        <rdfs:range rdf:resource="https://ontologia.segittur.es/turismo/def/core#Schedule"/>
        <rdfs:comment xml:lang="es">Asocia una oferta a una programación.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Asocia unha oferta a unha programación.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Associa una oferta a una programació.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Associa una oferta a una programació.</rdfs:comment>
        <rdfs:comment xml:lang="en">Association of an offer with a schedule.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Eskaintza bat programazio batekin lotzen du.</rdfs:comment>
        <rdfs:label xml:lang="eu">eskaintzaren programazioa</rdfs:label>
        <rdfs:label xml:lang="en">offer schedule</rdfs:label>
        <rdfs:label xml:lang="ca">programació de l&apos;oferta</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">programació de l&apos;oferta</rdfs:label>
        <rdfs:label xml:lang="gl">programación da oferta</rdfs:label>
        <rdfs:label xml:lang="es">programación de la oferta</rdfs:label>
        <estur-annot:orderInCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</estur-annot:orderInCategory>
        <estur-annot:presentationOrderCategory>contact</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#offeredBy -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#offeredBy">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Event"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#SpecialOffer"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismService"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismDestination"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrganisation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Asocia un servicio turístico, un evento, una propuesta especial y una instalación turística o vinculada con una organización turística o un destino turístico.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Asocia un servizo turístico, un evento, unha proposta especial e unha instalación turística ou vinculada cunha organización turística ou un destino turístico.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Associa un servei turístic, un esdeveniment, una proposta especial i una instal·lació turística o vinculada amb una organització turística o una destinació turística.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Associa un servici turístic, un esdeveniment, una proposta especial i una instal·lació turística o vinculada amb una organització turística o una destinació turística.</rdfs:comment>
        <rdfs:comment xml:lang="en">Associates a tourism service, event, special offer, and tourism or related facility with a tourism organisation or tourism destination.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Turismo-zerbitzu bat, ekitaldi bat, proposamen berezi bat eta turismo-instalazio edo hari lotutako instalazio bat turismo-erakunde edo helmuga turistiko batekin lotzen ditu.</rdfs:comment>
        <rdfs:label xml:lang="eu">honek eskainia</rdfs:label>
        <rdfs:label xml:lang="ca">ofert per</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">ofert per</rdfs:label>
        <rdfs:label xml:lang="en">offered by</rdfs:label>
        <rdfs:label xml:lang="es">ofrecido por</rdfs:label>
        <rdfs:label xml:lang="gl">ofrecido por</rdfs:label>
        <estur-annot:orderInCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</estur-annot:orderInCategory>
        <estur-annot:presentationOrderCategory>acknowledgement</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#offers -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#offers">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismDestination"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrganisation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Event"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#SpecialOffer"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismService"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Asociación de una organización o destino turístico con los eventos, propuestas especiales y/o servicios turísticos que estos ponen a disposición de los turistas.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Asociación dunha organización ou destino turístico cos eventos, propostas especiais e/ou servizos turísticos que poñen á disposición dos turistas.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Associació d&apos;una organització o destinació turística amb els esdeveniments, propostes especials i/o serveis turístics que posen a disposició dels turistes.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Associació d&apos;una organització o destinació turística amb els esdeveniments, propostes especials i/o servicis turístics que posen a disposició dels turistes.</rdfs:comment>
        <rdfs:comment xml:lang="en">Association of a tourism organisation or destination with the events, special offers and tourism services that they provide to tourists.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Erakunde edo helmuga turistiko bat turisten eskura jartzen dituen ekitaldiekin, proposamen bereziekin eta/edo turismo-zerbitzuekin lotzea.</rdfs:comment>
        <rdfs:label xml:lang="eu">eskaintzen du</rdfs:label>
        <rdfs:label xml:lang="ca">ofereix</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">oferix</rdfs:label>
        <rdfs:label xml:lang="en">offers</rdfs:label>
        <rdfs:label xml:lang="es">ofrece</rdfs:label>
        <rdfs:label xml:lang="gl">ofrece</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#offersGastronomicResource -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#offersGastronomicResource">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#FoodAndBeverageService"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://ontologia.segittur.es/turismo/def/core#GastronomicResource"/>
        <rdfs:comment xml:lang="es">Asociación de un establecimiento de restauración y/o un servicio de comidas y bebidas con un recurso gastronómico.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Asociación dun establecemento de restauración e/ou un servizo de comidas e bebidas cun recurso gastronómico.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Associació d&apos;un establiment de restauració i/o un servei de menjars i begudes amb un recurs gastronòmic.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Associació d&apos;un establiment de restauració i/o un servici de menjars i begudes amb un recurs gastronòmic.</rdfs:comment>
        <rdfs:comment xml:lang="en">Association of a food establishment and a food and beverage service with a gastronomic resource.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Jatetxe-establezimendu bat eta/edo janari- eta edari-zerbitzu bat baliabide gastronomiko batekin lotzea.</rdfs:comment>
        <rdfs:label xml:lang="eu">baliabide gastronomikoa eskaintzen du</rdfs:label>
        <rdfs:label xml:lang="ca">ofereix recurs gastronòmic</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">oferix recurs gastronòmic</rdfs:label>
        <rdfs:label xml:lang="en">offers gastronomic resource</rdfs:label>
        <rdfs:label xml:lang="es">ofrece recurso gastronómico</rdfs:label>
        <rdfs:label xml:lang="gl">ofrece recurso gastronómico</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#onSite -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#onSite">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#BookingChannel"/>
        <rdfs:range rdf:resource="https://ontologia.segittur.es/turismo/def/core#Place"/>
        <rdfs:comment xml:lang="en">A booking channel through which reservations are made in person at a specific place.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Canal de reserva que es realitza de manera presencial en un lloc determinat.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Canal de reserva que es realitza de manera presencial en un lloc determinat.</rdfs:comment>
        <rdfs:comment xml:lang="es">Canal de reserva que se realiza de manera presencial en un lugar determinado.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Canle de reserva que se realiza de maneira presencial nun lugar determinado.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Leku jakin batean aurrez aurre egiten den erreserba-kanala.</rdfs:comment>
        <rdfs:label xml:lang="eu">aurrez aurrekoa</rdfs:label>
        <rdfs:label xml:lang="en">on site</rdfs:label>
        <rdfs:label xml:lang="ca">presencial</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">presencial</rdfs:label>
        <rdfs:label xml:lang="es">presencial</rdfs:label>
        <rdfs:label xml:lang="gl">presencial</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#paymentMethod -->

    <owl:ObjectProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#paymentMethod">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#Route"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TransportService"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
