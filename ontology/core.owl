        <rdfs:label xml:lang="gl">instalacións do polideportivo</rdfs:label>
        <rdfs:label xml:lang="ca">instal·lacions del poliesportiu</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">instal·lacions del poliesportiu</rdfs:label>
        <rdfs:label xml:lang="eu">kiroldegiko instalazioak</rdfs:label>
        <rdfs:label xml:lang="en">sports centre premises</rdfs:label>
