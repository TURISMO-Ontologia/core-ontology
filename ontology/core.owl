                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismService"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://ontologia.segittur.es/turismo/def/core#Keyword"/>
        <rdfs:comment xml:lang="en">A significant word or phrase that emphasizes the content of a description.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Deskribapen baten edukia nabarmentzen duen hitz edo esaldi esanguratsua.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una palabra o frase significativa que enfatiza el contenido de una descripción.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Una paraula o frase significativa que emfatitza el contingut d&apos;una descripció.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Una paraula o frase significativa que emfatitza el contingut d&apos;una descripció.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Unha palabra ou frase significativa que salienta o contido dunha descrición.</rdfs:comment>
        <rdfs:label xml:lang="eu">gako-hitza du</rdfs:label>
        <rdfs:label xml:lang="en">has keyword</rdfs:label>
        <rdfs:label xml:lang="gl">ten palabra clave</rdfs:label>
        <rdfs:label xml:lang="es">tiene palabra clave</rdfs:label>
        <rdfs:label xml:lang="ca">té paraula clau</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">té paraula clau</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:ObjectProperty>
    


