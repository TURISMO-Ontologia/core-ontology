    <!-- https://ontologia.segittur.es/turismo/def/core#adaptedPublicRestroom -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#adaptedPublicRestroom">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#PublicRestroom"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="gl">Indica se o baño público está adaptado a persoas con discapacidade.</rdfs:comment>
        <rdfs:comment xml:lang="es">Indica si el baño público está adaptado a personas con discapacidad.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Indica si el lavabo públic està adaptat a persones amb discapacitat.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Indica si el lavabo públic està adaptat a persones amb discapacitat.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates whether the public restroom is adapted for people with disabilities.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Komun publikoa desgaitasuna duten pertsonentzat egokituta dagoen adierazten du.</rdfs:comment>
        <rdfs:label xml:lang="en">adapted public restroom</rdfs:label>
        <rdfs:label xml:lang="es">baño público adaptado</rdfs:label>
        <rdfs:label xml:lang="gl">baño público adaptado</rdfs:label>
        <rdfs:label xml:lang="eu">egokitutako komun publikoa</rdfs:label>
        <rdfs:label xml:lang="ca">lavabo públic adaptat</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">lavabo públic adaptat</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#additionalClassification -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#additionalClassification">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#HistoricalOrCulturalResource"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#NaturalResource"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#PublicService"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrRelatedFacility"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismOrganisation"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TourismService"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#TransportInfrastructure"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="eu">Ereduan formalki jasota ez dauden barne-sailkapen edo sailkapen propio zehatzak adierazteko balio osagarriak.</rdfs:comment>
        <rdfs:comment xml:lang="en">Supplementary values to represent specific internal or proprietary classifications that are not formally included in the model.</rdfs:comment>
        <rdfs:comment xml:lang="es">Valores complementarios para representar clasificaciones internas o propias específicas que no están incluidas formalmente en el modelo.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Valores complementarios para representar clasificacións internas ou propias específicas que non están incluídas formalmente no modelo.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Valors complementaris per representar classificacions internes o pròpies específiques que no estan incloses formalment en el model.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Valors complementaris per representar classificacions internes o pròpies específiques que no estan incloses formalment en el model.</rdfs:comment>
        <rdfs:label xml:lang="en">additional classification</rdfs:label>
        <rdfs:label xml:lang="es">clasificación adicional</rdfs:label>
        <rdfs:label xml:lang="gl">clasificación adicional</rdfs:label>
        <rdfs:label xml:lang="ca">classificació addicional</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">classificació addicional</rdfs:label>
        <rdfs:label xml:lang="eu">sailkapen gehigarria</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
        <estur-annot:tooltip xml:lang="es">Facilita valores complementarios para representar clasificaciones internas o propias específicas que no están incluidas formalmente en el modelo. Las propuestas introducidas podrán revisarse para futuras actualizaciones</estur-annot:tooltip>
        <estur-annot:tooltip xml:lang="en">Provides complementary values to represent specific internal classifications that are not formally included in the model. The proposals introduced may be reviewed for future updates.</estur-annot:tooltip>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#additionalVisibilityCriteria -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#additionalVisibilityCriteria">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#Visibility"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="eu">Edozein baliabide turistikotan aurrez kontuan hartu ez diren ikusgarritasun-irizpideak adierazteko balio osagarriak (desasetasuna, desestazionalizazioa, deszentralizazioa). Ikusgarritasun-irizpide gisa Beste bat hautatu denean soilik erabil daiteke.</rdfs:comment>
        <rdfs:comment xml:lang="en">Supplementary values to represent visibility criteria that has not been already considered (desaturation, deseasonalisation, decentralisation). To be used only when the selected visibility criteria is set to Other.</rdfs:comment>
        <rdfs:comment xml:lang="es">Valores complementarios para representar criterios de visibilidad en cualquier recurso turístico que no estén contemplados previamente (desaturación, desestacionalización, descentralización). Utilizable únicamente en el caso de que se haya seleccionado Otro como criterio de visibilidad.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Valores complementarios para representar criterios de visibilidade en calquera recurso turístico que non estean contemplados previamente (desaturación, desestacionalización, descentralización). Utilizable unicamente no caso de que se seleccionase Outro como criterio de visibilidade.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Valors complementaris per representar criteris de visibilitat en qualsevol recurs turístic que no s&apos;hagen previst prèviament (desaturació, desestacionalització, descentralització). Utilitzable únicament si s&apos;ha seleccionat Altre com a criteri de visibilitat.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Valors complementaris per representar criteris de visibilitat en qualsevol recurs turístic que no s&apos;hagin previst prèviament (desaturació, desestacionalització, descentralització). Utilitzable únicament si s&apos;ha seleccionat Altre com a criteri de visibilitat.</rdfs:comment>
        <rdfs:label xml:lang="en">additional visibility criteria</rdfs:label>
        <rdfs:label xml:lang="ca">criteri de visibilitat addicional</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">criteri de visibilitat addicional</rdfs:label>
        <rdfs:label xml:lang="es">criterio de visibilidad adicional</rdfs:label>
        <rdfs:label xml:lang="gl">criterio de visibilidade adicional</rdfs:label>
        <rdfs:label xml:lang="eu">ikusgarritasun-irizpide gehigarria</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#allowedPetAreasOnANonStrechtableLeash -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#allowedPetAreasOnANonStrechtableLeash">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#PetAccommodationPolicy"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="en">Areas designated by the accommodation where pets are allowed to stay provided they are kept on a leash that cannot be extended.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ostatuak maskotak bertan egoteko prestatutako eremuak, betiere luzatu ezin den uhala badaramate.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Àrees habilitades per l&apos;allotjament perquè les mascotes hi puguen romandre sempre que duguin una corretja que no es puga estendre.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Àrees habilitades per l&apos;allotjament perquè les mascotes hi puguin romandre sempre que duguin una corretja que no es pugui estendre.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Áreas habilitadas polo aloxamento para que as mascotas poidan permanecer sempre que leven unha correa que non poida estenderse.</rdfs:comment>
        <rdfs:comment xml:lang="es">Áreas habilitadas por el alojamiento para que las mascotas puedan permanecer siempre que lleven correa que no pueda extenderse.</rdfs:comment>
        <rdfs:label xml:lang="en">allowed pet areas on a non-stretchable leash</rdfs:label>
        <rdfs:label xml:lang="eu">uhal luzaezina duten maskotentzako baimendutako eremuak</rdfs:label>
        <rdfs:label xml:lang="es">zonas permitidas para mascotas con correa no extensible</rdfs:label>
        <rdfs:label xml:lang="gl">zonas permitidas para mascotas con correa non extensible</rdfs:label>
        <rdfs:label xml:lang="ca">zones permeses per a mascotes amb corretja no extensible</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">zones permeses per a mascotes amb corretja no extensible</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#allowedPetFreeRoamingAreas -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#allowedPetFreeRoamingAreas">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#PetAccommodationPolicy"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="en">Areas designated by the accommodation where pets may remain without the need for a muzzle or non-extendable leash.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ostatuak maskotak bertan egoteko prestatutako eremuak, muturrekoa edo uhal luzaezina eramateko beharrik gabe.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Àrees habilitades per l&apos;allotjament perquè les mascotes hi puguen romandre sense necessitat de dur morrió o corretja no extensible.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Àrees habilitades per l&apos;allotjament perquè les mascotes hi puguin romandre sense necessitat de dur morrió o corretja no extensible.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Áreas habilitadas polo aloxamento para que as mascotas poidan permanecer sen necesidade de levar bozo ou correa non extensible.</rdfs:comment>
        <rdfs:comment xml:lang="es">Áreas habilitadas por el alojamiento para que las mascotas puedan permanecer sin la necesidad de llevar bozal o correa no extensible.</rdfs:comment>
        <rdfs:label xml:lang="en">allowed pet free roaming areas</rdfs:label>
        <rdfs:label xml:lang="eu">aske dauden maskotentzako baimendutako eremuak</rdfs:label>
        <rdfs:label xml:lang="gl">zonas permitidas para mascotas en liberdade</rdfs:label>
        <rdfs:label xml:lang="es">zonas permitidas para mascotas en libertad</rdfs:label>
        <rdfs:label xml:lang="ca">zones permeses per a mascotes en llibertat</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">zones permeses per a mascotes en llibertat</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#answer -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#answer">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#FrequentlyAskedQuestion"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="eu">Erabiltzaileek egindako ohiko galdera bati erantzuteko argibidea, konponbidea edo informazio xehatua ematen duen testua.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Text que proporciona un aclariment, una solució o informació detallada en resposta a una pregunta freqüent formulada pels usuaris.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Text que proporciona un aclariment, una solució o informació detallada en resposta a una pregunta freqüent formulada pels usuaris.</rdfs:comment>
        <rdfs:comment xml:lang="en">Text that provides clarification, a solution, or detailed information in response to a frequently asked  question posed by users.</rdfs:comment>
        <rdfs:comment xml:lang="es">Texto que proporciona una aclaración, solución o información detallada en respuesta a una pregunta frecuente formulada por los usuarios.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Texto que proporciona unha aclaración, solución ou información detallada en resposta a unha pregunta frecuente formulada polos usuarios.</rdfs:comment>
        <rdfs:label xml:lang="en">answer</rdfs:label>
        <rdfs:label xml:lang="eu">erantzuna</rdfs:label>
        <rdfs:label xml:lang="ca">resposta</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">resposta</rdfs:label>
        <rdfs:label xml:lang="gl">resposta</rdfs:label>
        <rdfs:label xml:lang="es">respuesta</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#app -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#app">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#ContactPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="eu">Erabiltzailea aplikazio informatiko jakin batera birbideratzeko testua; aplikazioa telefono adimendun, tableta edo beste gailu mugikor batetik informazioa, tresnak edo zerbitzuak azkar eta modu interaktiboan eskuratzeko diseinatuta dago.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Text que permet redirigir l&apos;usuari a una aplicació informàtica específica, dissenyada per facilitar l&apos;accés ràpid i interactiu a informació, eines o serveis des d&apos;un telèfon intel·ligent, tauleta o altre dispositiu mòbil.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Text que permet redirigir l&apos;usuari a una aplicació informàtica específica, dissenyada per facilitar l&apos;accés ràpid i interactiu a informació, ferramentes o servicis des d&apos;un telèfon intel·ligent, tauleta o altre dispositiu mòbil.</rdfs:comment>
        <rdfs:comment xml:lang="en">Text that allows redirecting the user to a specific software application, designed to facilitate fast and interactive access to information, tools, or services from a smartphone, tablet, or other mobile device.</rdfs:comment>
        <rdfs:comment xml:lang="es">Texto que permite redirigir al usuario a una aplicación informática específica, diseñada para facilitar el acceso rápido e interactivo a información, herramientas o servicios desde un teléfono inteligente, tableta u otro dispositivo móvil.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Texto que permite redirixir o usuario a unha aplicación informática específica, deseñada para facilitar o acceso rápido e interactivo a información, ferramentas ou servizos desde un teléfono intelixente, tableta ou outro dispositivo móbil.</rdfs:comment>
        <rdfs:label xml:lang="ca">aplicació mòbil</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">aplicació mòbil</rdfs:label>
        <rdfs:label xml:lang="gl">aplicación móbil</rdfs:label>
        <rdfs:label xml:lang="en">app</rdfs:label>
        <rdfs:label xml:lang="es">app</rdfs:label>
        <rdfs:label xml:lang="eu">mugikorreko aplikazioa</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
        <estur-annot:tooltip xml:lang="es">Facilita la URL para redirigir a un usuario al programa informático de interés en su teléfono inteligente, tableta u otro dispositivo móvil</estur-annot:tooltip>
        <estur-annot:tooltip xml:lang="en">Provides the URL to redirect a user to the relevant software application on their smartphone, tablet, or other mobile device</estur-annot:tooltip>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#audio -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#audio">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#Multimedia"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="en">A URL to a digital file or stream containing recorded sound, such as guided tour narration, ambient audio, or language translations, intended for playback in a tourism context.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Testuinguru batean erreproduzitzeko grabatutako soinua duen fitxategi digital edo emankizun baten URLa, hala nola bisita gidatuetako narrazioak, giro-audioa edo hizkuntza-itzulpenak</rdfs:comment>
        <rdfs:comment xml:lang="es">URL a un archivo digital o retransmisión que contiene sonido grabado, como narraciones de visitas guiadas, audio ambiental o traducciones lingüísticas, destinado a su reproducción en un contexto</rdfs:comment>
        <rdfs:comment xml:lang="ca">URL d&apos;un fitxer digital o retransmissió que conté so enregistrat, com ara narracions de visites guiades, àudio ambiental o traduccions lingüístiques, destinat a la reproducció en un context</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">URL d&apos;un fitxer digital o retransmissió que conté so enregistrat, com ara narracions de visites guiades, àudio ambiental o traduccions lingüístiques, destinat a la reproducció en un context</rdfs:comment>
        <rdfs:comment xml:lang="gl">URL dun ficheiro dixital ou retransmisión que contén son gravado, como narracións de visitas guiadas, audio ambiental ou traducións lingüísticas, destinado á súa reprodución nun contexto</rdfs:comment>
        <rdfs:label xml:lang="en">audio</rdfs:label>
        <rdfs:label xml:lang="es">audio</rdfs:label>
        <rdfs:label xml:lang="gl">audio</rdfs:label>
        <rdfs:label xml:lang="eu">audioa</rdfs:label>
        <rdfs:label xml:lang="ca">àudio</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">àudio</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#autonomousCheckIn -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#autonomousCheckIn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="gl">Indica a posibilidade de realizar o rexistro de entrada de forma autónoma.</rdfs:comment>
        <rdfs:comment xml:lang="es">Indica la posibilidad de realizar el check-in de forma autónoma.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Indica la possibilitat de fer el registre d&apos;entrada de manera autònoma.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Indica la possibilitat de fer el registre d&apos;entrada de manera autònoma.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates whether check-in can be carried out autonomously.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Sarrera-erregistroa modu autonomoan egiteko aukera adierazten du.</rdfs:comment>
        <rdfs:label xml:lang="en">autonomous check-in</rdfs:label>
        <rdfs:label xml:lang="es">check-in autónomo</rdfs:label>
        <rdfs:label xml:lang="ca">registre d&apos;entrada autònom</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">registre d&apos;entrada autònom</rdfs:label>
        <rdfs:label xml:lang="gl">rexistro de entrada autónomo</rdfs:label>
        <rdfs:label xml:lang="eu">sarrera-erregistro autonomoa</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#autonomousCommunity -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#autonomousCommunity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="en">A broad territorial division that groups several provinces or homogeneous geographic areas.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Divisió territorial de caràcter ampli que agrupa diverses províncies o zones geogràfiques homogènies.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Divisió territorial de caràcter ampli que agrupa diverses províncies o zones geogràfiques homogènies.</rdfs:comment>
        <rdfs:comment xml:lang="es">División territorial de carácter amplio que agrupa varias provincias o zonas geográficas homogéneas.</rdfs:comment>
        <rdfs:comment xml:lang="gl">División territorial de carácter amplo que agrupa varias provincias ou zonas xeográficas homoxéneas.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Hainbat probintzia edo eremu geografiko homogeneo biltzen dituen lurralde-banaketa zabala.</rdfs:comment>
        <rdfs:label xml:lang="eu">autonomia-erkidegoa</rdfs:label>
        <rdfs:label xml:lang="en">autonomous community</rdfs:label>
        <rdfs:label xml:lang="es">comunidad autónoma</rdfs:label>
        <rdfs:label xml:lang="gl">comunidade autónoma</rdfs:label>
        <rdfs:label xml:lang="ca">comunitat autònoma</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">comunitat autònoma</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#averagePricePerPerson -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#averagePricePerPerson">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#FoodAndBeverageService"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#FoodEstablishment"/>
                    <rdf:Description rdf:about="https://ontologia.segittur.es/turismo/def/core#LodgingService"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">The average value of a set of prices or rates charged per person by a service provider.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Valor medio dun conxunto de prezos ou tarifas dun provedor de servizos por persoa.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Valor mitjà d&apos;un conjunt de preus o tarifes d&apos;un proveïdor de serveis per persona.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Valor mitjà d&apos;un conjunt de preus o tarifes d&apos;un proveïdor de servicis per persona.</rdfs:comment>
        <rdfs:comment xml:lang="es">Valor promedio de un conjunto de precios o tarifas de un proveedor de servicios por persona.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Zerbitzu-hornitzaile baten pertsonako prezio edo tarifa multzo baten batez besteko balioa.</rdfs:comment>
        <rdfs:label xml:lang="en">average price per person</rdfs:label>
        <rdfs:label xml:lang="eu">pertsonako batez besteko prezioa</rdfs:label>
        <rdfs:label xml:lang="es">precio medio por persona</rdfs:label>
        <rdfs:label xml:lang="ca">preu mitjà per persona</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">preu mitjà per persona</rdfs:label>
        <rdfs:label xml:lang="gl">prezo medio por persoa</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#brachycephalicPetsAllowed -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#brachycephalicPetsAllowed">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#PetTransportPolicy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="eu">Buruaren, muturraren eta eztarriaren forma txikiaren ondorioz buxadurak eta arnasketa-arazoak izateko joera duten animaliak garraiatzeko aukera.</rdfs:comment>
        <rdfs:comment xml:lang="es">Posibilidad de transportar animales propensos a las obstrucciones y problemas respiratorios debido a la forma pequeña de su cabeza, hocico y garganta.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Posibilidade de transportar animais propensos ás obstrucións e aos problemas respiratorios debido á forma pequena da súa cabeza, fociño e gorxa.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Possibilitat de transportar animals propensos a obstruccions i problemes respiratoris a causa de la forma petita del cap, el musell i la gola.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Possibilitat de transportar animals propensos a obstruccions i problemes respiratoris a causa de la forma xicoteta del cap, el musell i la gola.</rdfs:comment>
        <rdfs:comment xml:lang="en">Possibility of transporting animals prone to obstructions and respiratory problems due to the small size of their head, snout and throat.</rdfs:comment>
        <rdfs:label xml:lang="ca">admet mascotes braquicèfales</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">admet mascotes braquicèfales</rdfs:label>
        <rdfs:label xml:lang="gl">admite mascotas braquicéfalas</rdfs:label>
        <rdfs:label xml:lang="es">admite mascotas braquicéfalos</rdfs:label>
        <rdfs:label xml:lang="en">brachycephalic pets allowed</rdfs:label>
        <rdfs:label xml:lang="eu">maskota brakizefaloak onartzen ditu</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#byMonthDay -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#byMonthDay">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#Schedule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="ca">Dia o dies recurrents del mes de la programació, per exemple, obert el primer dia de cada mes.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Dia o dies recurrents del mes de la programació, per exemple, obert el primer dia de cada mes.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Día ou días recorrentes do mes da programación, por exemplo, aberto o primeiro día de cada mes.</rdfs:comment>
        <rdfs:comment xml:lang="es">Día(s) recurrente(s) del mes de la programación, por ejemplo, abierto el primer día de cada mes.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Programazioko hilabetean errepikatzen den eguna edo egunak; adibidez, hilabete bakoitzeko lehen egunean irekita.</rdfs:comment>
        <rdfs:comment xml:lang="en">Recurring month day(s) of the schedule, e.g. open the first day of the month.</rdfs:comment>
        <rdfs:label xml:lang="en">by month day</rdfs:label>
        <rdfs:label xml:lang="eu">hileko egunaren arabera</rdfs:label>
        <rdfs:label xml:lang="ca">per dia del mes</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">per dia del mes</rdfs:label>
        <rdfs:label xml:lang="es">por día del mes</rdfs:label>
        <rdfs:label xml:lang="gl">por día do mes</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
        <estur-annot:tooltip xml:lang="es">Indica el día del mes en que se repite esta</estur-annot:tooltip>
        <estur-annot:tooltip xml:lang="en">Indicates the day of the month on which this schedule repeats (1–31). For example, open on the first day of every month</estur-annot:tooltip>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#byMonthWeek -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#byMonthWeek">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#Schedule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="eu">Programazioan errepikatzen den astea edo asteak; adibidez, hilabete bakoitzeko hirugarren astean irekita.</rdfs:comment>
        <rdfs:comment xml:lang="en">Recurring week(s) of the schedule, e.g. open the third week of the month.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Semana ou semanas recorrentes da programación, por exemplo, aberto a terceira semana de cada mes.</rdfs:comment>
        <rdfs:comment xml:lang="es">Semana(s) recurrente(s) de la programación, por ejemplo, abierto la tercera semana de cada mes.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Setmana o setmanes recurrents de la programació, per exemple, obert la tercera setmana de cada mes.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Setmana o setmanes recurrents de la programació, per exemple, obert la tercera setmana de cada mes.</rdfs:comment>
        <rdfs:label xml:lang="en">by month week</rdfs:label>
        <rdfs:label xml:lang="eu">hileko astearen arabera</rdfs:label>
        <rdfs:label xml:lang="ca">per setmana del mes</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">per setmana del mes</rdfs:label>
        <rdfs:label xml:lang="es">por semana del mes</rdfs:label>
        <rdfs:label xml:lang="gl">por semana do mes</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
        <estur-annot:tooltip xml:lang="es">Indica la semana del mes en la que se aplica esta programación (1–5). Por ejemplo, abierto la tercera semana de cada mes.a</estur-annot:tooltip>
        <estur-annot:tooltip xml:lang="en">Indicates the week of the month in which this schedule applies (1–5). For example, open during the third week of every month</estur-annot:tooltip>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#checkInTime -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#checkInTime">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="gl">A hora máis temperá na que os hóspedes poden comezar o proceso de rexistro nun aloxamento.</rdfs:comment>
        <rdfs:comment xml:lang="ca">L&apos;hora més primerenca en què els hostes poden començar el procés de registre en un allotjament.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">L&apos;hora més primerenca en què els hostes poden començar el procés de registre en un allotjament.</rdfs:comment>
        <rdfs:comment xml:lang="es">La hora más temprana en la que los huéspedes pueden comenzar el proceso de registro en un alojamiento.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ostatuko bezeroek ostatuan erregistratzeko prozesua hasteko duten ordurik goiztiarrena.</rdfs:comment>
        <rdfs:comment xml:lang="en">The earliest allowable time at which guests may begin the check-in process for an accommodation.</rdfs:comment>
        <rdfs:label xml:lang="en">check-in time</rdfs:label>
        <rdfs:label xml:lang="ca">hora d&apos;arribada</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">hora d&apos;arribada</rdfs:label>
        <rdfs:label xml:lang="gl">hora de chegada</rdfs:label>
        <rdfs:label xml:lang="es">hora de llegada</rdfs:label>
        <rdfs:label xml:lang="eu">iristeko ordua</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#checkOutTime -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#checkOutTime">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#AccommodationEstablishment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="gl">A hora á que os hóspedes deben completar a súa saída e desocupar o aloxamento.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">L&apos;hora en què els hostes han de completar la eixida i desocupar l&apos;allotjament.</rdfs:comment>
        <rdfs:comment xml:lang="ca">L&apos;hora en què els hostes han de completar la sortida i desocupar l&apos;allotjament.</rdfs:comment>
        <rdfs:comment xml:lang="es">La hora a la que los huéspedes deben completar su salida y desocupar su alojamiento.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Ostatuko bezeroek irteera osatu eta ostatua hutsik utzi behar duten ordua.</rdfs:comment>
        <rdfs:comment xml:lang="en">The time by which guests must complete their departure and vacate their accommodation.</rdfs:comment>
        <rdfs:label xml:lang="en">check-out time</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">hora de eixida</rdfs:label>
        <rdfs:label xml:lang="es">hora de salida</rdfs:label>
        <rdfs:label xml:lang="gl">hora de saída</rdfs:label>
        <rdfs:label xml:lang="ca">hora de sortida</rdfs:label>
        <rdfs:label xml:lang="eu">irteera-ordua</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#civilLiabilityInsuranceRequired -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#civilLiabilityInsuranceRequired">
        <rdfs:domain rdf:resource="https://ontologia.segittur.es/turismo/def/core#PetAdmissionPolicy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="eu">Kalte-aseguru bat izateko beharra; haren bidez, aseguratzaileak hirugarren bati kalte-ordaina emateko betebeharra hartzen du, aseguratua ondorioen erantzule den gertaera batek eragindako kalte-galerengatik.</rdfs:comment>
        <rdfs:comment xml:lang="es">Necesidad de disponer de un tipo de seguro contra daños por el que el asegurador se obliga a indemnizar a un tercero de los daños y perjuicios causados por un hecho de cuyas consecuencias sea responsable el asegurado.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Necesidade de dispoñer dun tipo de seguro contra danos polo que o asegurador se obriga a indemnizar un terceiro polos danos e perdas causados por un feito de cuxas consecuencias sexa responsable o asegurado.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Necessitat de disposar d&apos;un tipus d&apos;assegurança de danys per la qual l&apos;assegurador s&apos;obliga a indemnitzar un tercer pels danys i perjudicis causats per un fet de les conseqüències del qual siga responsable l&apos;assegurat.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Necessitat de disposar d&apos;un tipus d&apos;assegurança de danys per la qual l&apos;assegurador s&apos;obliga a indemnitzar un tercer pels danys i perjudicis causats per un fet de les conseqüències del qual sigui responsable l&apos;assegurat.</rdfs:comment>
        <rdfs:comment xml:lang="en">The need for a type of insurance against damages whereby the insurer undertakes to compensate a third party for damages caused by an event for which the insured party is liable.</rdfs:comment>
        <rdfs:label xml:lang="en">civil liability insurance required</rdfs:label>
        <rdfs:label xml:lang="eu">erantzukizun zibileko asegurua behar du</rdfs:label>
        <rdfs:label xml:lang="ca">requereix assegurança de responsabilitat civil</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">requerix assegurança de responsabilitat civil</rdfs:label>
        <rdfs:label xml:lang="es">requiere seguro de responsabilidad civil</rdfs:label>
        <rdfs:label xml:lang="gl">require seguro de responsabilidade civil</rdfs:label>
        <estur-annot:presentationOrderCategory>other</estur-annot:presentationOrderCategory>
    </owl:DatatypeProperty>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#closesAt -->

    <owl:DatatypeProperty rdf:about="https://ontologia.segittur.es/turismo/def/core#closesAt">
