        <rdfs:label xml:lang="es">tiene servicio de lago</rdfs:label>
        <rdfs:label xml:lang="ca">té servei de llac</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">té servici de llac</rdfs:label>
