        <rdfs:label xml:lang="eu">Maskoten ile-apaindegia</rdfs:label>
        <rdfs:label xml:lang="es">Peluquería de mascotas</rdfs:label>
        <rdfs:label xml:lang="gl">Perrucaría de mascotas</rdfs:label>
        <rdfs:label xml:lang="ca">Perruqueria de mascotes</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Perruqueria de mascotes</rdfs:label>
        <rdfs:label xml:lang="en">Pet grooming salon</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#PetShipper -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#PetShipper">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#MiscellaneousBusiness"/>
        <rdfs:comment xml:lang="en">An organisation dedicated to the professional transport of animals, guaranteeing their care during transit.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Animaliak profesionalki garraiatzen dituen entitatea, joan-etorrian haien zaintza bermatzen duena.</rdfs:comment>
        <rdfs:comment xml:lang="es">Entidad que se dedica al transporte profesional de animales, garantizando su cuidado durante el desplazamiento.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Entidade dedicada ao transporte profesional de animais, garantindo o seu coidado durante o desprazamento.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Entitat dedicada al transport professional d&apos;animals, garantint-ne la cura durant el desplaçament.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Entitat dedicada al transport professional d&apos;animals, garantint-ne la cura durant el desplaçament.</rdfs:comment>
        <rdfs:label xml:lang="eu">Maskoten garraiolaria</rdfs:label>
        <rdfs:label xml:lang="en">Pet shipper</rdfs:label>
        <rdfs:label xml:lang="es">Transportista de mascotas</rdfs:label>
        <rdfs:label xml:lang="gl">Transportista de mascotas</rdfs:label>
        <rdfs:label xml:lang="ca">Transportista de mascotes</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Transportista de mascotes</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#PetShop -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#PetShop">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#RetailAndFashionBusiness"/>
        <rdfs:comment xml:lang="es">Comercio al por menor dedicado a la venta de productos para mascotas como alimentos, juguetes, golosinas, cepillos y accesorios para mascotas en general.</rdfs:comment>
        <rdfs:comment xml:lang="gl">Comercio polo miúdo dedicado á venda de produtos para mascotas, como alimentos, xoguetes, lambetadas, cepillos e accesorios para mascotas en xeral.</rdfs:comment>
        <rdfs:comment xml:lang="ca">Comerç al detall dedicat a vendre productes per a mascotes, com ara aliments, joguines, llaminadures, raspalls i accessoris per a mascotes en general.</rdfs:comment>
        <rdfs:comment xml:lang="ca-valencia">Comerç al detall dedicat a vendre productes per a mascotes, com ara aliments, joguines, llaminadures, raspalls i accessoris per a mascotes en general.</rdfs:comment>
        <rdfs:comment xml:lang="eu">Maskotentzako produktuak txikizka saltzen dituen saltokia, hala nola elikagaiak, jostailuak, gozokiak, eskuilak eta, oro har, maskotentzako osagarriak.</rdfs:comment>
        <rdfs:comment xml:lang="en">Retail business dedicated to the sale of pet products such as food, toys, treats, brushes, and general pet accessories.</rdfs:comment>
        <rdfs:label xml:lang="ca">Botiga per a mascotes</rdfs:label>
        <rdfs:label xml:lang="ca-valencia">Botiga per a mascotes</rdfs:label>
        <rdfs:label xml:lang="eu">Maskotentzako denda</rdfs:label>
        <rdfs:label xml:lang="en">Pet shop</rdfs:label>
        <rdfs:label xml:lang="gl">Tenda para mascotas</rdfs:label>
        <rdfs:label xml:lang="es">Tienda para mascotas</rdfs:label>
        <estur-annot:visibleResource rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estur-annot:visibleResource>
    </owl:Class>
    


    <!-- https://ontologia.segittur.es/turismo/def/core#PetTransportPolicy -->

    <owl:Class rdf:about="https://ontologia.segittur.es/turismo/def/core#PetTransportPolicy">
        <rdfs:subClassOf rdf:resource="https://ontologia.segittur.es/turismo/def/core#PetAdmissionPolicy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://ontologia.segittur.es/turismo/def/core#travelContainerType"/>
