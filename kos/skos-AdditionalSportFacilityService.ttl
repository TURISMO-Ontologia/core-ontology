    rdfs:comment "Este esquema de conceptos pertence ao conxunto de tesauros SKOS empregados pola ontoloxía de turismo de SEGITTUR."@gl ;
    rdfs:comment "Kontzeptu-eskema hau SEGITTURen turismo-ontologiak erabiltzen dituen SKOS tesauroen multzokoa da."@eu ;
    rdfs:label "Additional sport facility service"@en ;
    rdfs:label "Servicio adicional de instalación deportiva"@es ;
    rdfs:label "Servei addicional d'instal·lació esportiva"@ca ;
    rdfs:label "Servici addicional d'instal·lació esportiva"@ca-valencia ;
    rdfs:label "Servizo adicional de instalación deportiva"@gl ;
    rdfs:label "Kirol-instalazioaren zerbitzu gehigarria"@eu ;
    dct:title "Concept scheme grouping addicional sport facility services"@en ;
    dct:title "Esquema de conceptos agrupando servicios adicionales de instalaciones deportivas"@es ;
    dct:title "Esquema de conceptes que agrupa serveis addicionals d'instal·lacions esportives"@ca ;
    dct:title "Esquema de conceptes que agrupa servicis addicionals d'instal·lacions esportives"@ca-valencia ;
    dct:title "Esquema de conceptos que agrupa servizos adicionais de instalacións deportivas"@gl ;
    dct:title "Kirol-instalazioen zerbitzu gehigarriak biltzen dituen kontzeptu-eskema"@eu .

