@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix estur-core: <https://ontologia.segittur.es/turismo/def/core#> .
@prefix estur-kos: <https://ontologia.segittur.es/turismo/kos/> .

@prefix estur-dayoftheweek: <https://ontologia.segittur.es/turismo/kos/DayOfTheWeek/> .

#################################################################
#
#    Concept Scheme
#
#################################################################

estur-kos:DayOfTheWeek a skos:ConceptScheme ; 
    dct:issued "2026-01-24"^^xsd:date ;
    dct:modified "2026-01-24"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the SEGITTUR tourism ontology."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por la ontología de turismo de SEGITTUR."@es ;
    rdfs:comment "Aquest esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca ;
    rdfs:comment "Este esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca-valencia ;
    rdfs:comment "Este esquema de conceptos pertence ao conxunto de tesauros SKOS empregados pola ontoloxía de turismo de SEGITTUR."@gl ;
    rdfs:comment "Kontzeptu-eskema hau SEGITTURen turismo-ontologiak erabiltzen dituen SKOS tesauroen multzokoa da."@eu ;
    rdfs:label "Day of the week"@en ;
    rdfs:label "Día de la semana"@es ;
    rdfs:label "Dia de la setmana"@ca ;
    rdfs:label "Dia de la setmana"@ca-valencia ;
    rdfs:label "Día da semana"@gl ;
    rdfs:label "Asteko eguna"@eu ;
    dct:title "Concept scheme grouping days of the week"@en ;
    dct:title "Esquema de conceptos agrupando días de la semana"@es ;
    dct:title "Esquema de conceptes que agrupa dies de la setmana"@ca ;
    dct:title "Esquema de conceptes que agrupa dies de la setmana"@ca-valencia ;
    dct:title "Esquema de conceptos que agrupa días da semana"@gl ;
    dct:title "Asteko egunak biltzen dituen kontzeptu-eskema"@eu .

#################################################################
#
#    Concepts
#
#################################################################

estur-dayoftheweek:Monday a skos:Concept;
  skos:inScheme estur-kos:DayOfTheWeek;
  skos:prefLabel "Monday"@en ;
  skos:prefLabel "Lunes"@es ;
  skos:prefLabel "Dilluns"@ca ;
  skos:prefLabel "Dilluns"@ca-valencia ;
  skos:prefLabel "Luns"@gl ;
  skos:prefLabel "Astelehena"@eu .

estur-dayoftheweek:Tuesday a skos:Concept;
  skos:inScheme estur-kos:DayOfTheWeek;
  skos:prefLabel "Tuesday"@en ;
  skos:prefLabel "Martes"@es ;
  skos:prefLabel "Dimarts"@ca ;
  skos:prefLabel "Dimarts"@ca-valencia ;
  skos:prefLabel "Martes"@gl ;
  skos:prefLabel "Asteartea"@eu .

estur-dayoftheweek:Wednesday a skos:Concept;
  skos:inScheme estur-kos:DayOfTheWeek;
  skos:prefLabel "Wednesday"@en ;
  skos:prefLabel "Miércoles"@es ;
  skos:prefLabel "Dimecres"@ca ;
  skos:prefLabel "Dimecres"@ca-valencia ;
  skos:prefLabel "Mércores"@gl ;
  skos:prefLabel "Asteazkena"@eu .

estur-dayoftheweek:Thursday a skos:Concept;
  skos:inScheme estur-kos:DayOfTheWeek;
  skos:prefLabel "Thursday"@en ;
  skos:prefLabel "Jueves"@es ;
  skos:prefLabel "Dijous"@ca ;
  skos:prefLabel "Dijous"@ca-valencia ;
  skos:prefLabel "Xoves"@gl ;
  skos:prefLabel "Osteguna"@eu .

estur-dayoftheweek:Friday a skos:Concept;
  skos:inScheme estur-kos:DayOfTheWeek;
  skos:prefLabel "Friday"@en ;
  skos:prefLabel "Viernes"@es ;
  skos:prefLabel "Divendres"@ca ;
  skos:prefLabel "Divendres"@ca-valencia ;
  skos:prefLabel "Venres"@gl ;
  skos:prefLabel "Ostirala"@eu .

estur-dayoftheweek:Saturday a skos:Concept;
  skos:inScheme estur-kos:DayOfTheWeek;
  skos:prefLabel "Saturday"@en ;
  skos:prefLabel "Sábado"@es ;
  skos:prefLabel "Dissabte"@ca ;
