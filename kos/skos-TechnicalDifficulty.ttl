@prefix estur-technicaldifficulty: <https://ontologia.segittur.es/turismo/kos/TechnicalDifficulty/> .

#################################################################
#
#    Concept Scheme
#
#################################################################

estur-kos:TechnicalDifficulty a skos:ConceptScheme ; 
    dct:issued "2026-05-25"^^xsd:date ;
    dct:modified "2026-05-25"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the SEGITTUR tourism ontology."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por la ontología de turismo de SEGITTUR."@es ;
    rdfs:comment "Aquest esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca ;
    rdfs:comment "Este esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca-valencia ;
    rdfs:comment "Este esquema de conceptos pertence ao conxunto de tesauros SKOS empregados pola ontoloxía de turismo de SEGITTUR."@gl ;
    rdfs:comment "Kontzeptu-eskema hau SEGITTURen turismo-ontologiak erabiltzen dituen SKOS tesauroen multzokoa da."@eu ;
    rdfs:label "Technical difficulty"@en ;
    rdfs:label "Dificultad técnica"@es ;
    rdfs:label "Dificultat tècnica"@ca ;
    rdfs:label "Dificultat tècnica"@ca-valencia ;
    rdfs:label "Dificultade técnica"@gl ;
    rdfs:label "Zailtasun teknikoa"@eu ;
    dct:title "Concept scheme for representing the difficulty level of an adventure activity, considering technical complexity, physical demand, and perceived risk."@en ;
    dct:title "Esquema de conceptos para la representación del nivel de dificultad de una actividad de turismo activo, considerando la complejidad técnica, la exigencia física y el riesgo percibido"@es ;
    dct:title "Esquema de conceptes per representar el nivell de dificultat d'una activitat de turisme actiu, tenint en compte la complexitat tècnica, l'exigència física i el risc percebut"@ca ;
    dct:title "Esquema de conceptes per representar el nivell de dificultat d'una activitat de turisme actiu, tenint en compte la complexitat tècnica, l'exigència física i el risc percebut"@ca-valencia ;
    dct:title "Esquema de conceptos para representar o nivel de dificultade dunha actividade de turismo activo, tendo en conta a complexidade técnica, a esixencia física e o risco percibido"@gl ;
    dct:title "Turismo aktiboko jarduera baten zailtasun-maila adierazteko kontzeptu-eskema, konplexutasun teknikoa, eskakizun fisikoa eta hautemandako arriskua kontuan hartuta"@eu .

