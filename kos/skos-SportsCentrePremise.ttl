#################################################################
#
#    Concept Scheme
#
#################################################################

estur-kos:SportsCentrePremise a skos:ConceptScheme ; 
    dct:issued "2025-08-25"^^xsd:date ;
    dct:modified "2025-08-25"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the SEGITTUR tourism ontology."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por la ontología de turismo de SEGITTUR."@es ;
    rdfs:comment "Aquest esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca ;
    rdfs:comment "Este esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca-valencia ;
    rdfs:comment "Este esquema de conceptos pertence ao conxunto de tesauros SKOS empregados pola ontoloxía de turismo de SEGITTUR."@gl ;
    rdfs:comment "Kontzeptu-eskema hau SEGITTURen turismo-ontologiak erabiltzen dituen SKOS tesauroen multzokoa da."@eu ;
    rdfs:label "Sports centre premise"@en ;
    rdfs:label "Instalación de polideportivo"@es ;
    rdfs:label "Instal·lació de poliesportiu"@ca ;
    rdfs:label "Instal·lació de poliesportiu"@ca-valencia ;
    rdfs:label "Instalación de polideportivo"@gl ;
    rdfs:label "Kiroldegiko instalazioa"@eu ;
    dct:title "Concept scheme grouping sports centre premises"@en ;
    dct:title "Esquema de conceptos agrupando instalaciones de polideportivo"@es ;
    dct:title "Esquema de conceptes que agrupa instal·lacions de poliesportiu"@ca ;
    dct:title "Esquema de conceptes que agrupa instal·lacions de poliesportiu"@ca-valencia ;
    dct:title "Esquema de conceptos que agrupa instalacións de polideportivo"@gl ;
    dct:title "Kiroldegiko instalazioak biltzen dituen kontzeptu-eskema"@eu .

#################################################################
#
#    Concepts
#
#################################################################

