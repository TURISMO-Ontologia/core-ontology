@prefix cc: <http://creativecommons.org/ns#> .
@prefix estur-core: <https://ontologia.segittur.es/turismo/def/core#> .
@prefix estur-kos: <https://ontologia.segittur.es/turismo/kos/> .

@prefix estur-additionalpetfoodestablishmentservice: <https://ontologia.segittur.es/turismo/kos/AdditionalPetFoodEstablishmentService/> .

#################################################################
#
#    Concept Scheme
#
#################################################################

estur-kos:AdditionalPetFoodEstablishmentService a skos:ConceptScheme ; 
    dct:issued "2026-03-06"^^xsd:date ;
    dct:modified "2026-03-06"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the SEGITTUR tourism ontology."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por la ontología de turismo de SEGITTUR."@es ;
    rdfs:comment "Aquest esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca ;
    rdfs:comment "Este esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca-valencia ;
    rdfs:comment "Este esquema de conceptos pertence ao conxunto de tesauros SKOS empregados pola ontoloxía de turismo de SEGITTUR."@gl ;
    rdfs:comment "Kontzeptu-eskema hau SEGITTURen turismo-ontologiak erabiltzen dituen SKOS tesauroen multzokoa da."@eu ;
    rdfs:label "Additional pet food establishment service"@en ;
    rdfs:label "Servicio adicional de establecimiento de restauración con mascotas"@es ;
    rdfs:label "Servei addicional d'establiment de restauració amb animals de companyia"@ca ;
    rdfs:label "Servici addicional d'establiment de restauració amb animals de companyia"@ca-valencia ;
    rdfs:label "Servizo adicional de establecemento de restauración con mascotas"@gl ;
    rdfs:label "Maskotak onartzen dituen sukaldaritza-establezimenduaren zerbitzu gehigarria"@eu ;
    dct:title "Concept scheme grouping complementary or additional services that a food establishment may offer alongside its main service or activity in order to enhance or improve the experience of a tourist with pets."@en ;
    dct:title "Esquema de conceptos agrupando servicios complementarios o adicionales que puede ofrecer un establecimiento de restauración junto a su servicio o actividad principal para ampliar o mejorar la experiencia del turista con mascotas."@es ;
    dct:title "Esquema de conceptes que agrupa serveis complementaris o addicionals que pot oferir un establiment de restauració juntament amb el seu servei o activitat principal per ampliar o millorar l'experiència del turista amb animals de companyia."@ca ;
    dct:title "Esquema de conceptes que agrupa servicis complementaris o addicionals que pot oferir un establiment de restauració juntament amb el seu servici o activitat principal per ampliar o millorar l'experiència del turista amb animals de companyia."@ca-valencia ;
    dct:title "Esquema de conceptos que agrupa servizos complementarios ou adicionais que pode ofrecer un establecemento de restauración xunto co seu servizo ou actividade principal para ampliar ou mellorar a experiencia do turista con mascotas."@gl ;
    dct:title "Sukaldaritza-establezimendu batek bere zerbitzu edo jarduera nagusiarekin batera eskain ditzakeen zerbitzu osagarriak edo gehigarriak biltzen dituen kontzeptu-eskema, maskotak dituzten turisten esperientzia zabaltzeko edo hobetzeko."@eu .

