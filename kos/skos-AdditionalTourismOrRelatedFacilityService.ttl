#################################################################
#
#    Concept Scheme
#
#################################################################

estur-kos:AdditionalTourismOrRelatedFacilityService a skos:ConceptScheme ; 
    dct:issued "2024-05-24"^^xsd:date ;
    dct:modified "2026-03-06"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the SEGITTUR tourism ontology."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por la ontología de turismo de SEGITTUR."@es ;
    rdfs:comment "Aquest esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca ;
    rdfs:comment "Este esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca-valencia ;
    rdfs:comment "Este esquema de conceptos pertence ao conxunto de tesauros SKOS empregados pola ontoloxía de turismo de SEGITTUR."@gl ;
    rdfs:comment "Kontzeptu-eskema hau SEGITTURen turismo-ontologiak erabiltzen dituen SKOS tesauroen multzokoa da."@eu ;
    rdfs:label "Additional tourism or related facility services"@en ;
    rdfs:label "Servicios adicionales de una instalación turística o relacionada"@es ;
    rdfs:label "Serveis addicionals d'una instal·lació turística o relacionada"@ca ;
    rdfs:label "Servicis addicionals d'una instal·lació turística o relacionada"@ca-valencia ;
    rdfs:label "Servizos adicionais dunha instalación turística ou relacionada"@gl ;
    rdfs:label "Turismo-instalazio baten edo harekin lotutako instalazio baten zerbitzu gehigarriak"@eu ;
    dct:title "Concept scheme grouping additional tourism or related facility services"@en ;
    dct:title "Esquema de conceptos agrupando servicios adicionales de una instalación turística o relacionada"@es ;
    dct:title "Esquema de conceptes que agrupa serveis addicionals d'una instal·lació turística o relacionada"@ca ;
    dct:title "Esquema de conceptes que agrupa servicis addicionals d'una instal·lació turística o relacionada"@ca-valencia ;
    dct:title "Esquema de conceptos que agrupa servizos adicionais dunha instalación turística ou relacionada"@gl ;
    dct:title "Turismo-instalazio baten edo harekin lotutako instalazio baten zerbitzu gehigarriak biltzen dituen kontzeptu-eskema"@eu .

