    rdfs:comment "Este esquema de conceptos pertence ao conxunto de tesauros SKOS empregados pola ontoloxía de turismo de SEGITTUR."@gl ;
    rdfs:comment "Kontzeptu-eskema hau SEGITTURen turismo-ontologiak erabiltzen dituen SKOS tesauroen multzokoa da."@eu ;
    rdfs:label "Additional travel agency service"@en ;
    rdfs:label "Servicio adicional de una agencia de viajes"@es ;
    rdfs:label "Servei addicional d'una agència de viatges"@ca ;
    rdfs:label "Servici addicional d'una agència de viatges"@ca-valencia ;
    rdfs:label "Servizo adicional dunha axencia de viaxes"@gl ;
    rdfs:label "Bidaia-agentzia baten zerbitzu gehigarria"@eu ;
    dct:title "Concept scheme grouping additional travel agency services"@en ;
    dct:title "Esquema de conceptos agrupando servicios adicionales de una agencia de viajes"@es ;
    dct:title "Esquema de conceptes que agrupa serveis addicionals d'una agència de viatges"@ca ;
    dct:title "Esquema de conceptes que agrupa servicis addicionals d'una agència de viatges"@ca-valencia ;
    dct:title "Esquema de conceptos que agrupa servizos adicionais dunha axencia de viaxes"@gl ;
    dct:title "Bidaia-agentzia baten zerbitzu gehigarriak biltzen dituen kontzeptu-eskema"@eu .

