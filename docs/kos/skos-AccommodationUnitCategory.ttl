#################################################################
#
#    Concept Scheme
#
#################################################################

estur-kos:AccommodationUnitCategory a skos:ConceptScheme ; 
    dct:issued "2024-07-22"^^xsd:date ;
    dct:modified "2025-07-22"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the SEGITTUR tourism ontology."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por la ontología de turismo de SEGITTUR."@es ;
    rdfs:comment "Aquest esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca ;
    rdfs:comment "Este esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca-valencia ;
    rdfs:comment "Este esquema de conceptos pertence ao conxunto de tesauros SKOS empregados pola ontoloxía de turismo de SEGITTUR."@gl ;
    rdfs:comment "Kontzeptu-eskema hau SEGITTURen turismo-ontologiak erabiltzen dituen SKOS tesauroen multzokoa da."@eu ;
    rdfs:label "Accommodation unit category"@en ;
    rdfs:label "Categorías de unidades de alojamiento"@es ;
    rdfs:label "Categories d'unitats d'allotjament"@ca ;
    rdfs:label "Categories d'unitats d'allotjament"@ca-valencia ;
    rdfs:label "Categorías de unidades de aloxamento"@gl ;
    rdfs:label "Ostatu-unitateen kategoriak"@eu ;
    dct:title "Concept scheme grouping accommodation unit categories"@en ;
    dct:title "Esquema de conceptos agrupando categorías de unidades de alojamiento"@es ;
    dct:title "Esquema de conceptes que agrupa categories d'unitats d'allotjament"@ca ;
    dct:title "Esquema de conceptes que agrupa categories d'unitats d'allotjament"@ca-valencia ;
    dct:title "Esquema de conceptos que agrupa categorías de unidades de aloxamento"@gl ;
    dct:title "Ostatu-unitateen kategoriak biltzen dituen kontzeptu-eskema"@eu .

