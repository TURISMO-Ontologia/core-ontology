#################################################################
#
#    Concept Scheme
#
#################################################################

estur-kos:AdditionalTransportInfrastructureService a skos:ConceptScheme ; 
    dct:issued "2024-05-24"^^xsd:date ;
    dct:modified "2026-03-06"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the SEGITTUR tourism ontology."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por la ontología de turismo de SEGITTUR."@es ;
    rdfs:comment "Aquest esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca ;
    rdfs:comment "Este esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca-valencia ;
    rdfs:comment "Este esquema de conceptos pertence ao conxunto de tesauros SKOS empregados pola ontoloxía de turismo de SEGITTUR."@gl ;
    rdfs:comment "Kontzeptu-eskema hau SEGITTURen turismo-ontologiak erabiltzen dituen SKOS tesauroen multzokoa da."@eu ;
    rdfs:label "Additional transport infrastructure service"@en ;
    rdfs:label "Servicio adicional de infraestructura de transporte"@es ;
    rdfs:label "Servei addicional d'infraestructura de transport"@ca ;
    rdfs:label "Servici addicional d'infraestructura de transport"@ca-valencia ;
    rdfs:label "Servizo adicional de infraestrutura de transporte"@gl ;
    rdfs:label "Garraio-azpiegituraren zerbitzu gehigarria"@eu ;
    dct:title "Concept scheme grouping additional transport infrastructure services"@en ;
    dct:title "Esquema de conceptos agrupando servicios adicionales de infraestructura de transporte"@es ;
    dct:title "Esquema de conceptes que agrupa serveis addicionals d'infraestructura de transport"@ca ;
    dct:title "Esquema de conceptes que agrupa servicis addicionals d'infraestructura de transport"@ca-valencia ;
    dct:title "Esquema de conceptos que agrupa servizos adicionais de infraestrutura de transporte"@gl ;
    dct:title "Garraio-azpiegituraren zerbitzu gehigarriak biltzen dituen kontzeptu-eskema"@eu .

