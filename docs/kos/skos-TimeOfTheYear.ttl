@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix estur-core: <https://ontologia.segittur.es/turismo/def/core#> .
@prefix estur-kos: <https://ontologia.segittur.es/turismo/kos/> .

@prefix estur-timeoftheyear: <https://ontologia.segittur.es/turismo/kos/TimeOfTheYear/> .

#################################################################
#
#    Concept Scheme
#
#################################################################

estur-kos:TimeOfTheYear a skos:ConceptScheme ; 
    dct:issued "2026-03-06"^^xsd:date ;
    dct:modified "2026-03-06"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the SEGITTUR tourism ontology."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por la ontología de turismo de SEGITTUR."@es ;
    rdfs:comment "Aquest esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca ;
    rdfs:comment "Este esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca-valencia ;
    rdfs:comment "Este esquema de conceptos pertence ao conxunto de tesauros SKOS empregados pola ontoloxía de turismo de SEGITTUR."@gl ;
    rdfs:comment "Kontzeptu-eskema hau SEGITTURen turismo-ontologiak erabiltzen dituen SKOS tesauroen multzokoa da."@eu ;
    rdfs:label "Time of the year"@en ;
    rdfs:label "Temporada del año"@es ;
    rdfs:label "Temporada de l'any"@ca ;
    rdfs:label "Temporada de l'any"@ca-valencia ;
    rdfs:label "Tempada do ano"@gl ;
    rdfs:label "Urteko denboraldia"@eu ;
    dct:title "Concept scheme grouping times of the year"@en ;
    dct:title "Esquema de conceptos agrupando temporadas del año"@es ;
    dct:title "Esquema de conceptes que agrupa temporades de l'any"@ca ;
    dct:title "Esquema de conceptes que agrupa temporades de l'any"@ca-valencia ;
    dct:title "Esquema de conceptos que agrupa tempadas do ano"@gl ;
    dct:title "Urteko denboraldiak biltzen dituen kontzeptu-eskema"@eu .

#################################################################
#
#    Concepts
#
#################################################################

estur-timeoftheyear:Spring a skos:Concept;
  skos:inScheme estur-kos:TimeOfTheYear;
  skos:prefLabel "Spring"@en ;
  skos:prefLabel "Primavera"@es ;
  skos:prefLabel "Primavera"@ca ;
  skos:prefLabel "Primavera"@ca-valencia ;
  skos:prefLabel "Primavera"@gl ;
  skos:prefLabel "Udaberria"@eu .

estur-timeoftheyear:Summer a skos:Concept;
  skos:inScheme estur-kos:TimeOfTheYear;
  skos:prefLabel "Summer"@en ;
  skos:prefLabel "Verano"@es ;
  skos:prefLabel "Estiu"@ca ;
  skos:prefLabel "Estiu"@ca-valencia ;
  skos:prefLabel "Verán"@gl ;
  skos:prefLabel "Uda"@eu .

estur-timeoftheyear:Fall a skos:Concept;
  skos:inScheme estur-kos:TimeOfTheYear;
  skos:prefLabel "Fall"@en ;
  skos:prefLabel "Otoño"@es ;
  skos:prefLabel "Tardor"@ca ;
  skos:prefLabel "Tardor"@ca-valencia ;
  skos:prefLabel "Outono"@gl ;
  skos:prefLabel "Udazkena"@eu .

estur-timeoftheyear:Winter a skos:Concept;
  skos:inScheme estur-kos:TimeOfTheYear;
  skos:prefLabel "Winter"@en ;
  skos:prefLabel "Invierno"@es ;
  skos:prefLabel "Hivern"@ca ;
  skos:prefLabel "Hivern"@ca-valencia ;
  skos:prefLabel "Inverno"@gl ;
  skos:prefLabel "Negua"@eu .

estur-timeoftheyear:Christmas a skos:Concept;
  skos:inScheme estur-kos:TimeOfTheYear;
  skos:prefLabel "Christmas"@en ;
  skos:prefLabel "Navidad"@es ;
  skos:prefLabel "Nadal"@ca ;
  skos:prefLabel "Nadal"@ca-valencia ;
  skos:prefLabel "Nadal"@gl ;
  skos:prefLabel "Eguberriak"@eu .

estur-timeoftheyear:Easter a skos:Concept;
  skos:inScheme estur-kos:TimeOfTheYear;
  skos:prefLabel "Easter"@en ;
  skos:prefLabel "Semana Santa"@es ;
  skos:prefLabel "Setmana Santa"@ca ;
  skos:prefLabel "Setmana Santa"@ca-valencia ;
  skos:prefLabel "Semana Santa"@gl ;
  skos:prefLabel "Aste Santua"@eu .
