  skos:prefLabel "Facebook"@es ;
  skos:prefLabel "Facebook"@ca ;
  skos:prefLabel "Facebook"@ca-valencia ;
  skos:prefLabel "Facebook"@gl ;
  skos:prefLabel "Facebook"@eu .

