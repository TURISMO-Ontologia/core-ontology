  skos:prefLabel "Destinació de costa"@ca ;
  skos:prefLabel "Destinació de costa"@ca-valencia ;
  skos:prefLabel "Destino de costa"@gl ;
  skos:prefLabel "Kostaldeko helmuga"@eu .

