#################################################################
#
#    Concept Scheme
#
#################################################################

estur-kos:AgrotourismExperienceRelatedProduct a skos:ConceptScheme ; 
    dct:issued "2025-08-18"^^xsd:date ;
    dct:modified "2026-03-06"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the SEGITTUR tourism ontology."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por la ontología de turismo de SEGITTUR."@es ;
    rdfs:comment "Aquest esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca ;
    rdfs:comment "Este esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca-valencia ;
    rdfs:comment "Este esquema de conceptos pertence ao conxunto de tesauros SKOS empregados pola ontoloxía de turismo de SEGITTUR."@gl ;
    rdfs:comment "Kontzeptu-eskema hau SEGITTURen turismo-ontologiak erabiltzen dituen SKOS tesauroen multzokoa da."@eu ;
    rdfs:label "Agrotourism experience related product"@en ;
    rdfs:label "Producto relacionado con una experiencia agriturística"@es ;
    rdfs:label "Producte relacionat amb una experiència agroturística"@ca ;
    rdfs:label "Producte relacionat amb una experiència agroturística"@ca-valencia ;
    rdfs:label "Produto relacionado cunha experiencia agroturística"@gl ;
    rdfs:label "Agroturismo-esperientzia batekin lotutako produktua"@eu ;
    dct:title "Concept scheme grouping agrotourism experience related products"@en ;
    dct:title "Esquema de conceptos agrupando productos relacionados con experiencias agroturísticas"@es ;
    dct:title "Esquema de conceptes que agrupa productes relacionats amb experiències agroturístiques"@ca ;
    dct:title "Esquema de conceptes que agrupa productes relacionats amb experiències agroturístiques"@ca-valencia ;
    dct:title "Esquema de conceptos que agrupa produtos relacionados con experiencias agroturísticas"@gl ;
    dct:title "Agroturismo-esperientziekin lotutako produktuak biltzen dituen kontzeptu-eskema"@eu .

