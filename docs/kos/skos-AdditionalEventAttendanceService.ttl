    rdfs:comment "Kontzeptu-eskema hau SEGITTURen turismo-ontologiak erabiltzen dituen SKOS tesauroen multzokoa da."@eu ;
    rdfs:label "Additional event attendance facility service"@en ;
    rdfs:label "Servicio adicional de la instalación para eventos"@es ;
    rdfs:label "Servei addicional de la instal·lació per a esdeveniments"@ca ;
