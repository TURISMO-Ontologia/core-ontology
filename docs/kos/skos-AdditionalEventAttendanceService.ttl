    rdfs:label "Servizo adicional da instalación para eventos"@gl ;
    rdfs:label "Ekitaldietarako instalazioaren zerbitzu gehigarria"@eu ;
    dct:title "Concept scheme grouping additional event attendance facility services"@en ;
    dct:title "Esquema de conceptos agrupando servicios adicionales de instalaciones para eventos"@es ;
    dct:title "Esquema de conceptes que agrupa serveis addicionals d'instal·lacions per a esdeveniments"@ca ;
    dct:title "Esquema de conceptes que agrupa servicis addicionals d'instal·lacions per a esdeveniments"@ca-valencia ;
    dct:title "Esquema de conceptos que agrupa servizos adicionais de instalacións para eventos"@gl ;
    dct:title "Ekitaldietarako instalazioen zerbitzu gehigarriak biltzen dituen kontzeptu-eskema"@eu .

