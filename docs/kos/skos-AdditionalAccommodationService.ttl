#################################################################
#
#    Concept Scheme
#
#################################################################

estur-kos:AdditionalAccommodationService a skos:ConceptScheme ; 
    dct:issued "2024-05-24"^^xsd:date ;
    dct:modified "2026-01-24"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the SEGITTUR tourism ontology."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por la ontología de turismo de SEGITTUR."@es ;
    rdfs:comment "Aquest esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca ;
    rdfs:comment "Este esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca-valencia ;
    rdfs:comment "Este esquema de conceptos pertence ao conxunto de tesauros SKOS empregados pola ontoloxía de turismo de SEGITTUR."@gl ;
    rdfs:comment "Kontzeptu-eskema hau SEGITTURen turismo-ontologiak erabiltzen dituen SKOS tesauroen multzokoa da."@eu ;
    rdfs:label "Additional accommodation service"@en ;
    rdfs:label "Servicio adicional del alojamiento"@es ;
    rdfs:label "Servei addicional de l'allotjament"@ca ;
    rdfs:label "Servici addicional de l'allotjament"@ca-valencia ;
    rdfs:label "Servizo adicional do aloxamento"@gl ;
    rdfs:label "Ostatuaren zerbitzu gehigarria"@eu ;
    dct:title "Concept scheme grouping additional accommodation services"@en ;
    dct:title "Esquema de conceptos agrupando servicios adicionales del alojamiento"@es ;
    dct:title "Esquema de conceptes que agrupa serveis addicionals de l'allotjament"@ca ;
    dct:title "Esquema de conceptes que agrupa servicis addicionals de l'allotjament"@ca-valencia ;
    dct:title "Esquema de conceptos que agrupa servizos adicionais do aloxamento"@gl ;
    dct:title "Ostatuaren zerbitzu gehigarriak biltzen dituen kontzeptu-eskema"@eu .

