  skos:prefLabel "Certificació turística"@ca ;
  skos:prefLabel "Certificació turística"@ca-valencia ;
  skos:prefLabel "Certificación turística"@gl ;
  skos:prefLabel "Turismo-ziurtapena"@eu .

