#################################################################

estur-kos:AdditionalFoodEstablishmentService a skos:ConceptScheme ; 
    dct:issued "2024-05-24"^^xsd:date ;
    dct:modified "2026-03-06"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the SEGITTUR tourism ontology."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por la ontología de turismo de SEGITTUR."@es ;
    rdfs:comment "Aquest esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca ;
    rdfs:comment "Este esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca-valencia ;
    rdfs:comment "Este esquema de conceptos pertence ao conxunto de tesauros SKOS empregados pola ontoloxía de turismo de SEGITTUR."@gl ;
    rdfs:comment "Kontzeptu-eskema hau SEGITTURen turismo-ontologiak erabiltzen dituen SKOS tesauroen multzokoa da."@eu ;
    rdfs:label "Additional food establishment service"@en ;
    rdfs:label "Servicio adicional de un establecimiento de restauración"@es ;
    rdfs:label "Servei addicional d'un establiment de restauració"@ca ;
    rdfs:label "Servici addicional d'un establiment de restauració"@ca-valencia ;
    rdfs:label "Servizo adicional dun establecemento de restauración"@gl ;
    rdfs:label "Sukaldaritza-establezimendu baten zerbitzu gehigarria"@eu ;
    dct:title "Concept scheme grouping additional food establishment services"@en ;
    dct:title "Esquema de conceptos agrupando servicios adicionales de un establecimiento de restauración"@es ;
    dct:title "Esquema de conceptes que agrupa serveis addicionals d'un establiment de restauració"@ca ;
    dct:title "Esquema de conceptes que agrupa servicis addicionals d'un establiment de restauració"@ca-valencia ;
    dct:title "Esquema de conceptos que agrupa servizos adicionais dun establecemento de restauración"@gl ;
    dct:title "Sukaldaritza-establezimendu baten zerbitzu gehigarriak biltzen dituen kontzeptu-eskema"@eu .

