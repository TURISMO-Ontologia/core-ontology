#################################################################
#
#    Concept Scheme
#
#################################################################

estur-kos:AdditionalTourismResourceService a skos:ConceptScheme ; 
    dct:issued "2024-05-24"^^xsd:date ;
    dct:modified "2026-03-06"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the SEGITTUR tourism ontology."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por la ontología de turismo de SEGITTUR."@es ;
    rdfs:comment "Aquest esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca ;
    rdfs:comment "Este esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca-valencia ;
    rdfs:comment "Este esquema de conceptos pertence ao conxunto de tesauros SKOS empregados pola ontoloxía de turismo de SEGITTUR."@gl ;
    rdfs:comment "Kontzeptu-eskema hau SEGITTURen turismo-ontologiak erabiltzen dituen SKOS tesauroen multzokoa da."@eu ;
    rdfs:label "Additional ourism resource service"@en ;
    rdfs:label "Servicio adicional de un recurso turístico"@es ;
    rdfs:label "Servei addicional d'un recurs turístic"@ca ;
    rdfs:label "Servici addicional d'un recurs turístic"@ca-valencia ;
    rdfs:label "Servizo adicional dun recurso turístico"@gl ;
    rdfs:label "Turismo-baliabide baten zerbitzu gehigarria"@eu ;
    dct:title "Concept scheme grouping additional tourism resource services"@en ;
    dct:title "Esquema de conceptos agrupando servicios adicionales de un recurso turístico"@es ;
    dct:title "Esquema de conceptes que agrupa serveis addicionals d'un recurs turístic"@ca ;
    dct:title "Esquema de conceptes que agrupa servicis addicionals d'un recurs turístic"@ca-valencia ;
    dct:title "Esquema de conceptos que agrupa servizos adicionais dun recurso turístico"@gl ;
    dct:title "Turismo-baliabide baten zerbitzu gehigarriak biltzen dituen kontzeptu-eskema"@eu .

