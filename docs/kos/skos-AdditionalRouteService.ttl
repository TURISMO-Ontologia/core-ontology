@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix estur-core: <https://ontologia.segittur.es/turismo/def/core#> .
@prefix estur-kos: <https://ontologia.segittur.es/turismo/kos/> .

@prefix estur-additionalrouteservice: <https://ontologia.segittur.es/turismo/kos/AdditionalRouteService/> .

#################################################################
#
#    Concept Scheme
#
#################################################################

estur-kos:AdditionalRouteService a skos:ConceptScheme ; 
    dct:issued "2024-07-23"^^xsd:date ;
    dct:modified "2026-03-06"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the SEGITTUR tourism ontology."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por la ontología de turismo de SEGITTUR."@es ;
    rdfs:comment "Aquest esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca ;
    rdfs:comment "Este esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca-valencia ;
    rdfs:comment "Este esquema de conceptos pertence ao conxunto de tesauros SKOS empregados pola ontoloxía de turismo de SEGITTUR."@gl ;
    rdfs:comment "Kontzeptu-eskema hau SEGITTURen turismo-ontologiak erabiltzen dituen SKOS tesauroen multzokoa da."@eu ;
    rdfs:label "Additional route service"@en ;
    rdfs:label "Servicio adicional asociado a una ruta"@es ;
    rdfs:label "Servei addicional associat a una ruta"@ca ;
    rdfs:label "Servici addicional associat a una ruta"@ca-valencia ;
    rdfs:label "Servizo adicional asociado a unha ruta"@gl ;
    rdfs:label "Ibilbide bati lotutako zerbitzu gehigarria"@eu ;
    dct:title "Concept scheme grouping additional route services"@en ;
    dct:title "Esquema de conceptos agrupando servicios adicionales asociados a una ruta"@es ;
    dct:title "Esquema de conceptes que agrupa serveis addicionals associats a una ruta"@ca ;
    dct:title "Esquema de conceptes que agrupa servicis addicionals associats a una ruta"@ca-valencia ;
    dct:title "Esquema de conceptos que agrupa servizos adicionais asociados a unha ruta"@gl ;
    dct:title "Ibilbide bati lotutako zerbitzu gehigarriak biltzen dituen kontzeptu-eskema"@eu .

#################################################################
#
#    Concepts
#
#################################################################

estur-additionalrouteservice:Signaling a skos:Concept;
  skos:inScheme estur-kos:AdditionalRouteService;
  skos:prefLabel "Signaling"@en ;
  skos:prefLabel "Señalización"@es ;
  skos:prefLabel "Senyalització"@ca ;
  skos:prefLabel "Senyalització"@ca-valencia ;
  skos:prefLabel "Sinalización"@gl ;
  skos:prefLabel "Seinaleztapena"@eu .

estur-additionalrouteservice:Lighting a skos:Concept;
  skos:inScheme estur-kos:AdditionalRouteService;
  skos:prefLabel "Ligthing"@en ;
  skos:prefLabel "Alumbrado"@es ;
  skos:prefLabel "Enllumenat"@ca ;
  skos:prefLabel "Enllumenat"@ca-valencia ;
  skos:prefLabel "Iluminación"@gl ;
  skos:prefLabel "Argiteria"@eu .

estur-additionalrouteservice:AccessibleSignage a skos:Concept;
  skos:inScheme estur-kos:AdditionalRouteService;
  skos:prefLabel "Accessible signage"@en ;
  skos:prefLabel "Señalética accesible"@es ;
  skos:prefLabel "Senyalística accessible"@ca ;
  skos:prefLabel "Senyalística accessible"@ca-valencia ;
  skos:prefLabel "Sinalética accesible"@gl ;
  skos:prefLabel "Seinaleztapen irisgarria"@eu .
