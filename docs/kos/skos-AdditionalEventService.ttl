#################################################################
#
#    Concept Scheme
#
#################################################################

estur-kos:AdditionalEventService a skos:ConceptScheme ; 
    dct:issued "2024-05-24"^^xsd:date ;
    dct:modified "2026-11-13"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the SEGITTUR tourism ontology."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por la ontología de turismo de SEGITTUR."@es ;
    rdfs:comment "Aquest esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca ;
    rdfs:comment "Este esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca-valencia ;
    rdfs:comment "Este esquema de conceptos pertence ao conxunto de tesauros SKOS empregados pola ontoloxía de turismo de SEGITTUR."@gl ;
    rdfs:comment "Kontzeptu-eskema hau SEGITTURen turismo-ontologiak erabiltzen dituen SKOS tesauroen multzokoa da."@eu ;
    rdfs:label "Additional event service"@en ;
    rdfs:label "Servicio adicional asociado a un evento"@es ;
    rdfs:label "Servei addicional associat a un esdeveniment"@ca ;
    rdfs:label "Servici addicional associat a un esdeveniment"@ca-valencia ;
    rdfs:label "Servizo adicional asociado a un evento"@gl ;
    rdfs:label "Ekitaldi bati lotutako zerbitzua"@eu ;
    dct:title "Concept scheme grouping additional event services"@en ;
    dct:title "Esquema de conceptos agrupando servicios adicionales asociados a un evento"@es ;
    dct:title "Esquema de conceptes que agrupa serveis addicionales associats a un esdeveniment"@ca ;
    dct:title "Esquema de conceptes que agrupa servicis addicionales associats a un esdeveniment"@ca-valencia ;
    dct:title "Esquema de conceptos que agrupa servizos adicionales asociados a un evento"@gl ;
    dct:title "Ekitaldi bati lotutako zerbitzuak biltzen dituen kontzeptu-eskema"@eu .

