@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix estur-core: <https://ontologia.segittur.es/turismo/def/core#> .
@prefix estur-kos: <https://ontologia.segittur.es/turismo/kos/> .

@prefix estur-species: <https://ontologia.segittur.es/turismo/kos/Species/> .

#################################################################
#
#    Concept Scheme
#
#################################################################

estur-kos:Species a skos:ConceptScheme ; 
    dct:issued "2026-03-06"^^xsd:date ;
    dct:modified "2026-03-06"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the SEGITTUR tourism ontology."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por la ontología de turismo de SEGITTUR."@es ;
    rdfs:comment "Aquest esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca ;
    rdfs:comment "Este esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca-valencia ;
    rdfs:comment "Este esquema de conceptos pertence ao conxunto de tesauros SKOS empregados pola ontoloxía de turismo de SEGITTUR."@gl ;
    rdfs:comment "Kontzeptu-eskema hau SEGITTURen turismo-ontologiak erabiltzen dituen SKOS tesauroen multzokoa da."@eu ;
    rdfs:label "Species"@en ;
    rdfs:label "Especies"@es ;
    rdfs:label "Espècies"@ca ;
    rdfs:label "Espècies"@ca-valencia ;
    rdfs:label "Especies"@gl ;
    rdfs:label "Espezieak"@eu ;
    dct:title "Concept scheme grouping biological species of pets whose entry is permitted."@en ;
    dct:title "Esquema de conceptos agrupando especies biológicas de mascotas cuyo ingreso es permitido."@es ;
    dct:title "Esquema de conceptes que agrupa espècies biològiques d'animals de companyia l'entrada dels quals és permesa."@ca ;
    dct:title "Esquema de conceptes que agrupa espècies biològiques d'animals de companyia l'entrada dels quals és permesa."@ca-valencia ;
    dct:title "Esquema de conceptos que agrupa especies biolóxicas de mascotas cuxa entrada está permitida."@gl ;
    dct:title "Sarrera baimenduta duten maskoten espezie biologikoak biltzen dituen kontzeptu-eskema."@eu .

