#################################################################
#
#    Concept Scheme
#
#################################################################

estur-kos:AgrotourismExperienceType a skos:ConceptScheme ; 
    dct:issued "2025-08-18"^^xsd:date ;
    dct:modified "2026-01-24"^^xsd:date ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the SEGITTUR tourism ontology."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por la ontología de turismo de SEGITTUR."@es ;
    rdfs:comment "Aquest esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca ;
    rdfs:comment "Este esquema de conceptes pertany al conjunt de tesaurus SKOS utilitzats per l'ontologia de turisme de SEGITTUR."@ca-valencia ;
    rdfs:comment "Este esquema de conceptos pertence ao conxunto de tesauros SKOS empregados pola ontoloxía de turismo de SEGITTUR."@gl ;
    rdfs:comment "Kontzeptu-eskema hau SEGITTURen turismo-ontologiak erabiltzen dituen SKOS tesauroen multzokoa da."@eu ;
    rdfs:label "Agrotourism experience type"@en ;
    rdfs:label "Tipo de experiencia agroturística"@es ;
    rdfs:label "Tipus d'experiència agroturística"@ca ;
    rdfs:label "Tipus d'experiència agroturística"@ca-valencia ;
    rdfs:label "Tipo de experiencia agroturística"@gl ;
    rdfs:label "Agroturismo-esperientzia mota"@eu ;
    dct:title "Concept scheme grouping agrotourism experience types"@en ;
    dct:title "Esquema de conceptos agrupando tipos de experiencias agroturísticas"@es ;
    dct:title "Esquema de conceptes que agrupa tipus d'experiències agroturístiques"@ca ;
    dct:title "Esquema de conceptes que agrupa tipus d'experiències agroturístiques"@ca-valencia ;
    dct:title "Esquema de conceptos que agrupa tipos de experiencias agroturísticas"@gl ;
    dct:title "Agroturismo-esperientzia motak biltzen dituen kontzeptu-eskema"@eu .

